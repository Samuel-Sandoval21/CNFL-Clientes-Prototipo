@model List<CNFL_Clientes_Prototipo.Models.Suscripcion>

@{
    ViewBag.Title = "Suscripciones";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="suscripciones-container">
    <h2>Suscripciones</h2>
    <p>Servicios contratados y suscripciones activas.</p>

    @if (Model != null && Model.Any())
    {
        <div class="suscripciones-lista">
            @foreach (var suscripcion in Model)
            {
                <div class="suscripcion-card">
                    <h3>@suscripcion.Servicio</h3>
                    <p>
                        <strong>Estado:</strong>
                        @if (suscripcion.Activa)
                        {
                            <span class="estado-activa">Activa</span>
                        }
                        else
                        {
                            <span class="estado-inactiva">Inactiva</span>
                        }
                    </p>
                    <p><strong>Fecha Inicio:</strong> @suscripcion.FechaInicio.ToString("dd/MM/yyyy")</p>
                    @if (suscripcion.FechaFin.HasValue)
                    {
                        <p><strong>Fecha Fin:</strong> @suscripcion.FechaFin.Value.ToString("dd/MM/yyyy")</p>
                    }
                    @if (suscripcion.MontoMensual.HasValue)
                    {
                        <p><strong>Monto Mensual:</strong> ₡@suscripcion.MontoMensual.Value.ToString("N0")</p>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <p>No tienes suscripciones activas.</p>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/suscripciones.css" />
}