@model CNFL_Clientes_Prototipo.Models.Usuario

@{
    ViewBag.Title = "Editar Perfil";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var nombreCompleto = (Model.Nombre + " " + Model.Apellidos).Trim();
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Select2 */
        .select2-container {
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single {
            height: auto !important;
            border: none !important;
            background: transparent !important;
            padding: 0 !important;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #0E1116 !important;
                font-size: 14px !important;
                line-height: normal !important;
                padding-left: 0 !important;
                padding-right: 20px !important;
            }

            .select2-container--default .select2-selection--single .select2-selection__placeholder {
                color: #aab0be !important;
                font-size: 14px !important;
            }

            .select2-container--default .select2-selection--single .select2-selection__arrow {
                height: 100% !important;
                right: 0 !important;
            }

        .select2-container--open {
            z-index: 99999 !important;
        }

        .select2-dropdown {
            z-index: 99999 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(16,20,40,.15) !important;
            border: 1px solid #EDEFF3 !important;
        }

        .select2-results__option {
            font-size: 13px !important;
            padding: 8px 12px !important;
        }

        .select2-search--dropdown .select2-search__field {
            border-radius: 8px !important;
            border: 1px solid #EDEFF3 !important;
            padding: 6px 10px !important;
            font-family: inherit !important;
            font-size: 13px !important;
        }

        /* HERO */
        .ed-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 20px;
            padding: 18px 18px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 10px 24px -12px rgba(16,20,60,.45);
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

            .ed-hero::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 150px;
                height: 150px;
                background: radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
            }

            .ed-hero .avatar {
                width: 52px;
                height: 52px;
                border-radius: 16px;
                background: rgba(255,255,255,.2);
                display: grid;
                place-items: center;
                font-size: 22px;
                font-weight: 800;
                border: 2px solid rgba(255,255,255,.4);
                flex-shrink: 0;
                position: relative;
                z-index: 2;
            }

            .ed-hero .info {
                position: relative;
                z-index: 2;
            }

            .ed-hero h1 {
                margin: 0;
                font-size: 17px;
                font-weight: 800;
                letter-spacing: -.01em;
                line-height: 1.2;
            }

            .ed-hero p {
                margin: 4px 0 0;
                font-size: 12px;
                opacity: .9;
                line-height: 1.35;
            }

        /* ALERTA DE ÉXITO */
        .ed-alert {
            background: linear-gradient(135deg, #e9f7ec, #d6f0dc);
            border: 1px solid #cdeed4;
            border-radius: 14px;
            padding: 12px 14px;
            margin-top: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            font-weight: 700;
            color: #2f8f3e;
        }

        /* SECCIONES */
        .ed-section {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 18px 16px;
            margin-top: 14px;
            box-shadow: var(--shadow-sm);
        }

        .ed-section-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--line);
        }

            .ed-section-head .ico {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 16px;
                flex-shrink: 0;
            }

                .ed-section-head .ico.blue {
                    background: #eef0ff;
                }

                .ed-section-head .ico.green {
                    background: #e9f7ec;
                }

                .ed-section-head .ico.amber {
                    background: #fef3e0;
                }

            .ed-section-head .ttl {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                letter-spacing: -.01em;
            }

            .ed-section-head .sub {
                font-size: 11px;
                color: var(--muted);
                margin-top: 1px;
            }

        /* CAMPOS */
        .ed-field {
            margin-bottom: 14px;
        }

            .ed-field:last-child {
                margin-bottom: 0;
            }

        .ed-label {
            font-size: 11.5px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .04em;
            display: block;
            margin-bottom: 6px;
        }

            .ed-label .req {
                color: #d33;
                margin-left: 2px;
            }

        .ed-input {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 13.5px;
            font-family: inherit;
            color: var(--ink);
            background: #fafbff;
            outline: none;
            transition: border-color .15s, background .15s;
        }

            .ed-input:focus {
                border-color: var(--blue);
                background: #fff;
            }

        .ed-hint {
            font-size: 11px;
            color: var(--muted);
            margin-top: 4px;
            padding-left: 2px;
            line-height: 1.35;
        }

        .ed-badge-opt {
            background: #eef0ff;
            color: var(--blue);
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 999px;
            letter-spacing: .04em;
            margin-left: 6px;
        }

        /* SELECT2 DENTRO DE CAMPO */
        .ed-select-wrap {
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: 8px 14px;
            background: #fafbff;
            transition: border-color .15s, background .15s;
        }

            .ed-select-wrap:focus-within {
                border-color: var(--blue);
                background: #fff;
            }

        /* BOTONES */
        .ed-actions {
            display: flex;
            gap: 10px;
            margin-top: 18px;
            margin-bottom: 24px;
        }

        .ed-btn-primary {
            flex: 1;
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            cursor: pointer;
            transition: transform .12s, box-shadow .2s;
            box-shadow: 0 8px 18px -8px rgba(30,35,230,.6);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .ed-btn-primary:active {
                transform: scale(.97);
            }

        .ed-btn-secondary {
            flex: 1;
            background: #fff;
            color: var(--ink);
            border: 1.5px solid var(--line);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .15s;
        }

            .ed-btn-secondary:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--ink);
            }
    </style>
}

<!-- HERO -->
<div class="ed-hero">
    <div class="avatar">✏️</div>
    <div class="info">
        <h1 data-i18n="ed.hero.title">Editar Perfil</h1>
        <p data-i18n="ed.hero.sub">Actualizá o completá tus datos cuando quieras</p>
    </div>
</div>

<!-- ALERTA DE ÉXITO -->
@if (TempData["Mensaje"] != null)
{
    <div class="ed-alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@using (Html.BeginForm("EditarDatos", "Clientes", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <!-- ══════════ SECCIÓN 1: DATOS PERSONALES ══════════ -->
    <div class="ed-section">
        <div class="ed-section-head">
            <div class="ico blue">👤</div>
            <div>
                <div class="ttl" data-i18n="ed.sec.personal.title">Datos personales</div>
                <div class="sub" data-i18n="ed.sec.personal.sub">Tu nombre legal completo</div>
            </div>
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.nombreCompleto">NOMBRE COMPLETO</span> <span class="req">*</span></label>
            <input type="text" name="NombreCompleto" value="@nombreCompleto"
                   class="ed-input" placeholder="Ej: María José Rodríguez Vargas" required />
            <div class="ed-hint" data-i18n="ed.hint.nombreCompleto">Incluí nombre(s) y ambos apellidos</div>
        </div>
    </div>

    <!-- ══════════ SECCIÓN 2: CONTACTO ══════════ -->
    <div class="ed-section">
        <div class="ed-section-head">
            <div class="ico green">📞</div>
            <div>
                <div class="ttl" data-i18n="ed.sec.contacto.title">Contacto</div>
                <div class="sub" data-i18n="ed.sec.contacto.sub">Correos y teléfonos registrados</div>
            </div>
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.correoPrincipal">CORREO PRINCIPAL</span> <span class="req">*</span></label>
            <input type="email" name="Correo" value="@Model.Correo"
                   class="ed-input" placeholder="usuario@correo.com" required />
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.correoSecundario">CORREO SECUNDARIO</span> <span class="ed-badge-opt" data-i18n="ed.badge.opcional">OPCIONAL</span></label>
            <input type="email" name="CorreoSecundario" value="@Model.CorreoSecundario"
                   class="ed-input" placeholder="otro@correo.com" />
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.telefonoPrincipal">TELÉFONO PRINCIPAL</span> <span class="req">*</span></label>
            <input type="text" name="Telefono" value="@Model.Telefono"
                   class="ed-input" placeholder="8888-8888" required />
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.telefonoSecundario">TELÉFONO SECUNDARIO</span> <span class="ed-badge-opt" data-i18n="ed.badge.opcional">OPCIONAL</span></label>
            <input type="text" name="TelefonoSecundario" value="@Model.TelefonoSecundario"
                   class="ed-input" placeholder="8888-0000" />
        </div>
    </div>

    <!-- ══════════ SECCIÓN 3: ACTIVIDAD ECONÓMICA ══════════ -->
    <div class="ed-section">
        <div class="ed-section-head">
            <div class="ico amber">🏢</div>
            <div>
                <div class="ttl" data-i18n="ed.sec.actividad.title">Actividad económica</div>
                <div class="sub" data-i18n="ed.sec.actividad.sub">Completala si aplica a tu caso</div>
            </div>
        </div>

        <div class="ed-field">
            <label class="ed-label"><span data-i18n="ed.label.actividad">ACTIVIDAD ECONÓMICA</span> <span class="ed-badge-opt" data-i18n="ed.badge.opcional">OPCIONAL</span></label>
            <div class="ed-select-wrap">
                <select id="actividadEconomica" name="ActividadEconomicaId" style="width:100%;">
                    @if (Model.ActividadEconomica != null)
                    {
                        <option value="@Model.ActividadEconomicaId" selected="selected">
                            @Model.ActividadEconomica.Codigo - @Model.ActividadEconomica.Nombre
                        </option>
                    }
                </select>
            </div>
            <div class="ed-hint" data-i18n="ed.hint.actividad">Buscá por código CIIU o por nombre</div>
        </div>
    </div>

    <!-- BOTONES -->
    <div class="ed-actions">
        <button type="submit" class="ed-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                <polyline points="17 21 17 13 7 13 7 21" />
                <polyline points="7 3 7 8 15 8" />
            </svg>
            <span data-i18n="ed.btn.save">Guardar cambios</span>
        </button>
        <a href="@Url.Action("MiPerfil", "Clientes")" class="ed-btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
            <span data-i18n="ed.btn.cancel">Cancelar</span>
        </a>
    </div>
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(function () {
            $('#actividadEconomica').select2({
                placeholder: 'Seleccione o busque una actividad (opcional)...',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                language: {
                    noResults: function () { return "Sin resultados"; },
                    searching: function () { return "Buscando..."; },
                    inputTooShort: function () { return "Escriba para buscar..."; }
                },
                ajax: {
                    url: '@Url.Action("SearchActividades", "Cuenta")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { q: params.term || '' };
                    },
                    processResults: function (data) {
                        return { results: data };
                    },
                    cache: true
                }
            });
        });
    </script>
}