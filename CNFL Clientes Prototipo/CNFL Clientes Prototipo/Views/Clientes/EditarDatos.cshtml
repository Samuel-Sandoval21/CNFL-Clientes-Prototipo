@model CNFL_Clientes_Prototipo.Models.Usuario

@{
    ViewBag.Title = "Editar Perfil";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="editar-container">
    <h2>Editar Perfil</h2>

    @using (Html.BeginForm("EditarDatos", "Clientes", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="editar-card">
            <div class="form-group">
                <label>Nombre</label>
                @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label>Apellidos</label>
                @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label>Correo</label>
                @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email" })
            </div>
            <div class="form-group">
                <label>Teléfono</label>
                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
            </div>
            <button type="submit" class="btn-guardar">Guardar Cambios</button>
            <a href="@Url.Action("MiPerfil", "Clientes")" class="btn-cancelar">Cancelar</a>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/editar-datos.css" />
}

@section Scripts {
    <script src="~/Scripts/cliente/editar-datos.js"></script>
}