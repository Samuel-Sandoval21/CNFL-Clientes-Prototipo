@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";

    var facturaActual = ViewBag.FacturaActual as CNFL_Clientes_Prototipo.Models.Factura;

    // Tipado fuerte con los DTOs públicos
    var averias = (ViewBag.AveriasActivas as List<CNFL_Clientes_Prototipo.Models.AveriaResumenDto>)
                  ?? new List<CNFL_Clientes_Prototipo.Models.AveriaResumenDto>();
    var tramites = (ViewBag.TramitesActivos as List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>)
                   ?? new List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>();
    var notifs = (ViewBag.Notificaciones as List<CNFL_Clientes_Prototipo.Models.NotificacionResumenDto>)
                 ?? new List<CNFL_Clientes_Prototipo.Models.NotificacionResumenDto>();

    var nombre = ViewBag.Nombre as string ?? "Usuario";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : (hora < 19 ? "Buenas tardes" : "Buenas noches");

    int averiasCount = averias.Count;
    int tramitesCount = tramites.Count;
}

@section Styles {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* HERO */
        .db-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 22px;
            padding: 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(16,20,60,.45);
            position: relative;
            overflow: hidden;
        }

            .db-hero::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 180px;
                height: 180px;
                background: radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
            }

            .db-hero .greet {
                font-size: 12.5px;
                opacity: .85;
            }

            .db-hero h1 {
                margin: 4px 0 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
                line-height: 1.15;
            }

            .db-hero .sub {
                font-size: 12px;
                opacity: .85;
                margin-top: 6px;
                line-height: 1.4;
            }

        .db-kpis {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.2);
            position: relative;
            z-index: 2;
        }

        .db-kpi {
            text-align: center;
        }

            .db-kpi .v {
                font-size: 20px;
                font-weight: 800;
            }

            .db-kpi .l {
                font-size: 10px;
                opacity: .8;
                font-weight: 800;
                letter-spacing: .04em;
                margin-top: 2px;
            }

        /* TÍTULOS */
        .db-title {
            font-size: 14.5px;
            font-weight: 800;
            color: var(--ink);
            margin: 22px 0 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            letter-spacing: -.01em;
        }

            .db-title .lnk {
                font-size: 11.5px;
                font-weight: 800;
                color: var(--blue);
                text-decoration: none;
            }

                .db-title .lnk:hover {
                    text-decoration: underline;
                }

        /* FACTURA ACTUAL */
        .db-bill {
            background: linear-gradient(135deg, var(--navy), var(--blue));
            border-radius: 20px;
            padding: 18px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 12px 26px -12px rgba(0,20,130,.6);
        }

            .db-bill::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 160px;
                height: 160px;
                background: radial-gradient(circle, rgba(255,255,255,.12), transparent 70%);
            }

            .db-bill .lbl {
                font-size: 10.5px;
                font-weight: 800;
                opacity: .8;
                letter-spacing: .06em;
            }

            .db-bill .amt {
                font-size: 28px;
                font-weight: 800;
                margin: 6px 0 4px;
                letter-spacing: -.02em;
            }

            .db-bill .due {
                font-size: 11.5px;
                opacity: .85;
            }

            .db-bill .nise {
                font-size: 11px;
                opacity: .75;
                margin-top: 2px;
            }

            .db-bill .row {
                display: flex;
                gap: 8px;
                margin-top: 14px;
                position: relative;
                z-index: 2;
            }

            .db-bill .btn-pay {
                flex: 1;
                background: var(--orange);
                color: #fff;
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 13px;
                padding: 12px;
                border-radius: 12px;
                cursor: pointer;
                transition: transform .12s;
                box-shadow: 0 6px 14px -6px rgba(255,105,45,.7);
            }

                .db-bill .btn-pay:active {
                    transform: scale(.97);
                }

            .db-bill .btn-detail {
                flex: 1;
                background: rgba(255,255,255,.16);
                color: #fff;
                border: 1px solid rgba(255,255,255,.25);
                font-family: inherit;
                font-weight: 800;
                font-size: 13px;
                padding: 12px;
                border-radius: 12px;
                cursor: pointer;
                transition: transform .12s;
                text-decoration: none;
                text-align: center;
            }

                .db-bill .btn-detail:hover {
                    background: rgba(255,255,255,.24);
                    color: #fff;
                    text-decoration: none;
                }

        /* CARDS DE GRÁFICOS */
        .db-chart-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 10px;
        }

        .db-chart-wrap {
            position: relative;
            height: 200px;
        }

            .db-chart-wrap.doughnut {
                height: 200px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .db-chart-wrap.doughnut canvas {
                    max-height: 200px;
                }

        /* TABS */
        .db-chart-tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .db-chart-tab {
            background: #f4f6fb;
            color: var(--muted);
            border: 0;
            font-family: inherit;
            font-size: 11px;
            font-weight: 800;
            padding: 6px 12px;
            border-radius: 999px;
            cursor: pointer;
            transition: .15s;
        }

            .db-chart-tab.active {
                background: var(--blue);
                color: #fff;
            }

        /* LEYENDA DONA */
        .db-doughnut-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
            justify-content: center;
        }

            .db-doughnut-legend .lg {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 10.5px;
                font-weight: 700;
                color: var(--ink);
                padding: 4px 10px;
                border-radius: 999px;
                background: #f7f8fc;
            }

                .db-doughnut-legend .lg .dot {
                    width: 10px;
                    height: 10px;
                    border-radius: 3px;
                }

        /* KPIs SECUNDARIOS */
        .db-kpi-mini {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

            .db-kpi-mini .k {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 14px;
                padding: 12px 10px;
                box-shadow: var(--shadow-sm);
                text-align: center;
            }

                .db-kpi-mini .k .v {
                    font-size: 18px;
                    font-weight: 800;
                    color: var(--ink);
                }

                    .db-kpi-mini .k .v.ok {
                        color: #2f8f3e;
                    }

                    .db-kpi-mini .k .v.warn {
                        color: #b9791a;
                    }

                    .db-kpi-mini .k .v.danger {
                        color: #d33;
                    }

                .db-kpi-mini .k .l {
                    font-size: 10px;
                    font-weight: 800;
                    color: var(--muted);
                    letter-spacing: .04em;
                    margin-top: 3px;
                }

        /* ACCESOS RÁPIDOS */
        .db-quick {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

            .db-quick a {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 14px;
                padding: 12px 6px;
                text-decoration: none;
                color: inherit;
                box-shadow: var(--shadow-sm);
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 6px;
                transition: transform .15s, box-shadow .2s;
            }

                .db-quick a:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 18px -8px rgba(16,20,60,.25);
                    text-decoration: none;
                    color: inherit;
                }

            .db-quick .ico {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 16px;
            }

            .db-quick .lbl {
                font-size: 9.5px;
                font-weight: 800;
                text-align: center;
                color: var(--ink);
                line-height: 1.1;
            }

            .db-quick a.q1 .ico {
                background: #eef0ff;
            }

            .db-quick a.q2 .ico {
                background: #eaf6fa;
            }

            .db-quick a.q3 .ico {
                background: #e9f7ec;
            }

            .db-quick a.q4 .ico {
                background: #fef3e0;
            }

        /* LISTA DE ESTADOS */
        .db-rows {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .db-row {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: inherit;
            transition: transform .12s;
        }

            .db-row:hover {
                transform: translateX(2px);
                text-decoration: none;
                color: inherit;
            }

            .db-row .ico {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 16px;
                flex-shrink: 0;
            }

            .db-row .body {
                flex: 1;
                min-width: 0;
            }

            .db-row .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .db-row .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
            }

            .db-row .badge {
                font-size: 10px;
                font-weight: 800;
                padding: 3px 8px;
                border-radius: 999px;
                white-space: nowrap;
            }

                .db-row .badge.pend {
                    background: #fef3e0;
                    color: #b9791a;
                }

                .db-row .badge.ok {
                    background: #e9f7ec;
                    color: #2f8f3e;
                }

                .db-row .badge.ing {
                    background: #eef0ff;
                    color: var(--blue);
                }

        /* NOTIFICACIONES */
        .db-notif {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 14px;
            display: flex;
            gap: 10px;
            margin-bottom: 8px;
        }

            .db-notif .ic {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 15px;
                flex-shrink: 0;
                background: #eef0ff;
            }

            .db-notif .body {
                flex: 1;
            }

            .db-notif .t {
                font-size: 12px;
                font-weight: 800;
                color: var(--ink);
            }

            .db-notif .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
                line-height: 1.4;
            }

        /* EMPTY */
        .db-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 22px;
            text-align: center;
        }

            .db-empty .e {
                font-size: 30px;
                margin-bottom: 6px;
            }

            .db-empty .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
            }

            .db-empty .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 4px;
            }
    </style>
}

<!-- ═══════════════ HERO ═══════════════ -->
<div class="db-hero">
    <div class="greet">@saludo,</div>
    <h1>@nombre</h1>
    <div class="sub">Gestioná tu servicio eléctrico desde tu celular.</div>

    <div class="db-kpis">
        <div class="db-kpi">
            <div class="v">@ViewBag.TotalNISEs</div>
            <div class="l">NISEs</div>
        </div>
        <div class="db-kpi">
            <div class="v">@ViewBag.TotalFacturasPendientes</div>
            <div class="l">FACTURAS</div>
        </div>
        <div class="db-kpi">
            <div class="v">@(averiasCount + tramitesCount)</div>
            <div class="l">EN PROCESO</div>
        </div>
    </div>
</div>

<!-- ═══════════════ FACTURA ACTUAL ═══════════════ -->
@if (facturaActual != null)
{
    <div class="db-title">
        <span>Factura actual</span>
        <a href="@Url.Action("MisFacturas", "Clientes")" class="lnk">Ver todas →</a>
    </div>
    <div class="db-bill">
        <div class="lbl">FACTURA PENDIENTE</div>
        <div class="amt">₡@facturaActual.Monto.ToString("N0")</div>
        <div class="due">📅 Vence el @facturaActual.FechaVencimiento.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("es-CR"))</div>
        @if (facturaActual.NISE != null)
        {
            <div class="nise">🔌 NISE @facturaActual.NISE.NumeroNise · @facturaActual.NumeroFactura</div>
        }
        <div class="row">
            <button type="button" class="btn-pay" onclick="pagarFactura(@facturaActual.FacturaId, '@facturaActual.NumeroFactura', @facturaActual.Monto)">
                💳 Pagar ahora
            </button>
            <a href="@Url.Action("MisFacturas", "Clientes")" class="btn-detail">Ver detalle</a>
        </div>
    </div>
}
else
{
    <div class="db-title">Factura actual</div>
    <div class="db-empty">
        <div class="e">🎉</div>
        <div class="t">¡Todo al día!</div>
        <div class="s">No tenés facturas pendientes de pago.</div>
    </div>
}

<!-- ═══════════════ GRÁFICO 1: DONA ═══════════════ -->
<div class="db-title">
    <span>Consumo por NISE</span>
    <span style="font-size:10.5px;color:var(--muted);font-weight:700;">Total facturado</span>
</div>
<div class="db-chart-card">
    <div class="db-chart-wrap doughnut">
        <canvas id="chartDona"></canvas>
    </div>
    <div class="db-doughnut-legend" id="legendDona"></div>
</div>

<!-- ═══════════════ GRÁFICO 2: LÍNEA ═══════════════ -->
<div class="db-title">
    <span>Evolución de consumo</span>
    <span style="font-size:10.5px;color:var(--muted);font-weight:700;">Últimos 6 meses</span>
</div>
<div class="db-chart-card">
    <div class="db-chart-tabs">
        <button class="db-chart-tab active" onclick="cambiarConsumo('monto', this)">Monto ₡</button>
        <button class="db-chart-tab" onclick="cambiarConsumo('kwh', this)">Consumo kWh</button>
    </div>
    <div class="db-chart-wrap">
        <canvas id="chartConsumo"></canvas>
    </div>
</div>

<!-- ═══════════════ GRÁFICO 3: BARRAS APILADAS ═══════════════ -->
<div class="db-title">
    <span>Mi actividad en la app</span>
    <span style="font-size:10.5px;color:var(--muted);font-weight:700;">Esta semana</span>
</div>
<div class="db-chart-card">
    <div class="db-chart-wrap">
        <canvas id="chartActividad"></canvas>
    </div>
    <div class="db-doughnut-legend" style="justify-content:flex-start;">
        <div class="lg"><span class="dot" style="background:#1E23E6;"></span>Facturas</div>
        <div class="lg"><span class="dot" style="background:#FF692D;"></span>Reportes</div>
        <div class="lg"><span class="dot" style="background:#64B95A;"></span>Trámites</div>
        <div class="lg"><span class="dot" style="background:#64B9CD;"></span>Perfil</div>
    </div>
</div>

<!-- ═══════════════ GRÁFICO 4: BARRAS HORIZONTALES ═══════════════ -->
<div class="db-title">
    <span>Secciones más visitadas</span>
    <span style="font-size:10.5px;color:var(--muted);font-weight:700;">Total histórico</span>
</div>
<div class="db-chart-card">
    <div class="db-chart-wrap" style="height: 220px;">
        <canvas id="chartSecciones"></canvas>
    </div>
</div>

<!-- ═══════════════ KPIs SECUNDARIOS ═══════════════ -->
<div class="db-title">Resumen del mes</div>
<div class="db-kpi-mini">
    <div class="k">
        <div class="v @(averiasCount > 0 ? "warn" : "ok")">@averiasCount</div>
        <div class="l">AVERÍAS</div>
    </div>
    <div class="k">
        <div class="v @(tramitesCount > 0 ? "warn" : "ok")">@tramitesCount</div>
        <div class="l">TRÁMITES</div>
    </div>
    <div class="k">
        <div class="v">₡@(((decimal)ViewBag.MontoPendiente).ToString("N0"))</div>
        <div class="l">PENDIENTE</div>
    </div>
</div>

<!-- ═══════════════ ACCESOS RÁPIDOS ═══════════════ -->
<div class="db-title">Accesos rápidos</div>
<div class="db-quick">
    <a href="@Url.Action("MisFacturas", "Clientes")" class="q1">
        <div class="ico">📄</div>
        <div class="lbl">Facturas</div>
    </a>
    <a href="@Url.Action("Reportes", "Clientes")" class="q2">
        <div class="ico">⚠️</div>
        <div class="lbl">Reportes</div>
    </a>
    <a href="@Url.Action("Index", "Tramites")" class="q3">
        <div class="ico">📋</div>
        <div class="lbl">Trámites</div>
    </a>
    <a href="@Url.Action("MiPerfil", "Clientes")" class="q4">
        <div class="ico">👤</div>
        <div class="lbl">Perfil</div>
    </a>
</div>

<!-- ═══════════════ AVERÍAS ACTIVAS ═══════════════ -->
@if (averias.Any())
{
    <div class="db-title">
        <span>Averías en seguimiento</span>
        <a href="@Url.Action("HistorialReportes", "Clientes")" class="lnk">Ver todas →</a>
    </div>
    <div class="db-rows">
        @foreach (var a in averias)
        {
            <a href="@Url.Action("EstadoAveria", "Clientes", new { id = a.AveriaId })" class="db-row">
                <div class="ico" style="background:#fef3e0;">⚡</div>
                <div class="body">
                    <div class="t">#@a.AveriaId · @a.Tipo</div>
                    <div class="s">@a.FechaReporte.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="badge pend">@a.Estado</div>
            </a>
        }
    </div>
}

<!-- ═══════════════ TRÁMITES ACTIVOS ═══════════════ -->
@if (tramites.Any())
{
    <div class="db-title">
        <span>Trámites en proceso</span>
        <a href="@Url.Action("MisTramites", "Tramites")" class="lnk">Ver todos →</a>
    </div>
    <div class="db-rows">
        @foreach (var t in tramites)
        {
            <div class="db-row">
                <div class="ico" style="background:#eef0ff;">📋</div>
                <div class="body">
                    <div class="t">@t.Tipo</div>
                    <div class="s">@t.NumeroReferencia · @t.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="badge ing">@t.Estado</div>
            </div>
        }
    </div>
}

<!-- ═══════════════ NOTIFICACIONES ═══════════════ -->
@if (notifs.Any())
{
    <div class="db-title">
        <span>Notificaciones recientes</span>
        <a href="@Url.Action("MisNotificaciones", "Clientes")" class="lnk">Ver todas →</a>
    </div>
    foreach (var n in notifs)
    {
        <div class="db-notif">
            <div class="ic">🔔</div>
            <div class="body">
                <div class="t">@n.Titulo</div>
                <div class="s">@n.Mensaje</div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════
        // DATOS DESDE EL CONTROLADOR
        // ═══════════════════════════════════════════════════════════
        var distribucionData = @Html.Raw(ViewBag.DistribucionJson ?? "[]");
        var consumoData = @Html.Raw(ViewBag.ConsumoJson ?? "[]");
        var actividadData = @Html.Raw(ViewBag.ActividadJson ?? "[]");
        var seccionesData = @Html.Raw(ViewBag.SeccionesJson ?? "[]");

        var chartDona, chartConsumo, chartActividad, chartSecciones;
        var consumoModo = 'monto';

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 1: DONA
        // ═══════════════════════════════════════════════════════════
        function initDona() {
            var ctx = document.getElementById('chartDona').getContext('2d');
            var labels = distribucionData.map(function (d) { return 'NISE ' + d.label; });
            var values = distribucionData.map(function (d) { return d.value; });
            var colors = distribucionData.map(function (d) { return d.color; });

            if (values.length === 0) {
                document.getElementById('chartDona').parentElement.innerHTML =
                    '<div style="text-align:center; padding:40px 0; color:#727A86; font-size:12px;">Sin NISEs registrados</div>';
                return;
            }

            chartDona = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: function (context) {
                                    var total = context.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                    return context.label + ': ₡' + context.parsed.toLocaleString('es-CR') + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });

            var legendHtml = '';
            var total = values.reduce(function (a, b) { return a + b; }, 0);
            distribucionData.forEach(function (d) {
                var pct = total > 0 ? ((d.value / total) * 100).toFixed(0) : 0;
                legendHtml += '<div class="lg"><span class="dot" style="background:' + d.color + '"></span>NISE ' + d.label + ' · ' + pct + '%</div>';
            });
            document.getElementById('legendDona').innerHTML = legendHtml;
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 2: LÍNEA
        // ═══════════════════════════════════════════════════════════
        function initConsumo() {
            var ctx = document.getElementById('chartConsumo').getContext('2d');

            if (consumoData.length === 0) {
                document.getElementById('chartConsumo').parentElement.innerHTML =
                    '<div style="text-align:center; padding:40px 0; color:#727A86; font-size:12px;">Sin datos de consumo</div>';
                return;
            }

            var gradient = ctx.createLinearGradient(0, 0, 0, 220);
            gradient.addColorStop(0, 'rgba(30, 35, 230, 0.35)');
            gradient.addColorStop(1, 'rgba(30, 35, 230, 0.02)');

            chartConsumo = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: consumoData.map(function (d) { return d.mes; }),
                    datasets: [{
                        label: 'Monto',
                        data: consumoData.map(function (d) { return d.monto; }),
                        borderColor: '#1E23E6',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#1E23E6',
                        pointBorderWidth: 3,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointHoverBackgroundColor: '#1E23E6',
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    if (consumoModo === 'monto') {
                                        return '₡' + context.parsed.y.toLocaleString('es-CR');
                                    }
                                    return context.parsed.y + ' kWh';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#EDEFF3', drawBorder: false },
                            ticks: {
                                color: '#727A86',
                                font: { size: 10, weight: '600' },
                                callback: function (v) {
                                    if (consumoModo === 'monto') return '₡' + (v / 1000) + 'k';
                                    return v;
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#727A86', font: { size: 11, weight: '700' } }
                        }
                    }
                }
            });
        }

        function cambiarConsumo(modo, btn) {
            consumoModo = modo;
            document.querySelectorAll('.db-chart-tab').forEach(function (b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');

            var valores = modo === 'monto'
                ? consumoData.map(function (d) { return d.monto; })
                : consumoData.map(function (d) { return d.kwh; });

            chartConsumo.data.datasets[0].data = valores;
            chartConsumo.data.datasets[0].label = modo === 'monto' ? 'Monto' : 'Consumo';
            chartConsumo.update();
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 3: BARRAS APILADAS
        // ═══════════════════════════════════════════════════════════
        function initActividad() {
            var ctx = document.getElementById('chartActividad').getContext('2d');
            var dias = actividadData.map(function (d) { return d.dia; });

            chartActividad = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: dias,
                    datasets: [
                        { label: 'Facturas', data: actividadData.map(function (d) { return d.facturas; }), backgroundColor: '#1E23E6', borderRadius: 6, borderSkipped: false },
                        { label: 'Reportes', data: actividadData.map(function (d) { return d.reportes; }), backgroundColor: '#FF692D', borderRadius: 6, borderSkipped: false },
                        { label: 'Trámites', data: actividadData.map(function (d) { return d.tramites; }), backgroundColor: '#64B95A', borderRadius: 6, borderSkipped: false },
                        { label: 'Perfil',   data: actividadData.map(function (d) { return d.perfil; }),   backgroundColor: '#64B9CD', borderRadius: 6, borderSkipped: false }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ': ' + context.parsed.y + ' visitas';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { stacked: true, grid: { display: false }, ticks: { color: '#727A86', font: { size: 11, weight: '700' } } },
                        y: { stacked: true, beginAtZero: true, grid: { color: '#EDEFF3', drawBorder: false }, ticks: { color: '#727A86', font: { size: 10, weight: '600' } } }
                    }
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 4: BARRAS HORIZONTALES
        // ═══════════════════════════════════════════════════════════
        function initSecciones() {
            var ctx = document.getElementById('chartSecciones').getContext('2d');
            var labels = seccionesData.map(function (d) { return d.nombre; });
            var values = seccionesData.map(function (d) { return d.visitas; });

            chartSecciones = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Visitas',
                        data: values,
                        backgroundColor: ['#1E23E6', '#FF692D', '#64B95A', '#64B9CD', '#F5A623', '#727A86'],
                        borderRadius: 8,
                        borderSkipped: false,
                        barThickness: 22
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    return context.parsed.x + ' visitas';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#EDEFF3', drawBorder: false }, ticks: { color: '#727A86', font: { size: 10, weight: '600' } } },
                        y: { grid: { display: false }, ticks: { color: '#0E1116', font: { size: 11, weight: '700' } } }
                    }
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // PAGAR FACTURA
        // ═══════════════════════════════════════════════════════════
        function pagarFactura(id, num, monto) {
            if (!confirm('¿Confirmás el pago de la factura ' + num + ' por ₡' + monto.toLocaleString('es-CR') + '?')) return;
            fetch('@Url.Action("PagarFactura", "Clientes")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'facturaId=' + id
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) { alert('✅ ' + data.message); location.reload(); }
                else { alert('❌ ' + data.message); }
            })
            .catch(function () { alert('Error al procesar el pago.'); });
        }

        // ═══════════════════════════════════════════════════════════
        // INIT
        // ═══════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart !== 'undefined') {
                initDona();
                initConsumo();
                initActividad();
                initSecciones();
            }
        });
    </script>
}