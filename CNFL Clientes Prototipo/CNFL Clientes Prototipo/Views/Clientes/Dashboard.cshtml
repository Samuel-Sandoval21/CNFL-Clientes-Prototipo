<div class="db-toast" id="dbToast"></div>

@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════
        // DATOS DESDE EL CONTROLLER
        // ═══════════════════════════════════════════════════════════
        var datosRazor = {
            distribucionData:   @Html.Raw(distribucionJson),
            consumoData:        @Html.Raw(consumoJson),
            actividadData:      @Html.Raw(actividadJson),
            seccionesData:      @Html.Raw(seccionesJson),
            nombreUsuario:      "@Html.Raw(nombre)",
            averiasCount:       @averiasCount,
            tramitesCount:      @tramitesCount,
            totalNISEs:         @totalNISEs,
            totalFacturas:      @totalFacturasPendientes,
            montoPendiente:     @montoPendiente.ToString("0"),
            facturaMonto:       "@facturaActualMonto",
            facturaVence:       "@facturaActualVence"
        };

        var distribucionData = datosRazor.distribucionData;
        var consumoData      = datosRazor.consumoData;
        var actividadData    = datosRazor.actividadData;
        var seccionesData    = datosRazor.seccionesData;
        var nombreUsuario    = datosRazor.nombreUsuario;

        var chartDona, chartConsumo, chartActividad, chartSecciones;
        var consumoModo = 'monto';

        // ═══════════════════════════════════════════════════════════
        // TOAST
        // ═══════════════════════════════════════════════════════════
        function showToast(msg) {
            var el = document.getElementById('dbToast');
            el.textContent = msg;
            el.classList.add('show');
            setTimeout(function () { el.classList.remove('show'); }, 2500);
        }

        // ═══════════════════════════════════════════════════════════
        // REGISTRAR DESCARGA (backend)
        // ═══════════════════════════════════════════════════════════
        function registrarDescarga(nombre, tipo, seccion, tamanoKB) {
            fetch('@Url.Action("RegistrarDescarga", "Clientes")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'nombre=' + encodeURIComponent(nombre) +
                      '&tipo=' + encodeURIComponent(tipo) +
                      '&seccion=' + encodeURIComponent(seccion) +
                      '&tamanoKB=' + (tamanoKB || 0)
            }).catch(function () { /* silencioso */ });
        }

        // ═══════════════════════════════════════════════════════════
        // REDESCARGAR (botón de la lista)
        // ═══════════════════════════════════════════════════════════
        function redescargar(nombre, tipo) {
            var mensaje = '¿Volver a generar "' + nombre + '" (' + tipo + ')?';
            if (confirm(mensaje)) {
                if (tipo === 'PDF') {
                    if (nombre.indexOf('Factura') >= 0) { descargarFacturaPDF(0); }
                    else if (nombre.indexOf('Resumen') >= 0) { exportarResumenPDF(); }
                    else { exportarTodoPDF(); }
                } else if (tipo === 'Excel') {
                    if (nombre.indexOf('Consumo') >= 0) { exportarDonaExcel(); }
                    else if (nombre.indexOf('Evolucion') >= 0) { exportarConsumoExcel(); }
                    else if (nombre.indexOf('Secciones') >= 0) { exportarSeccionesExcel(); }
                    else if (nombre.indexOf('Actividad') >= 0) { exportarActividadExcel(); }
                    else { exportarResumenExcel(); }
                }
                showToast('📥 Regenerando "' + nombre + '"...');
            }
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 1: DONA
        // ═══════════════════════════════════════════════════════════
        function initDona() {
            var canvas = document.getElementById('chartDona');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var labels = distribucionData.map(function (d) { return 'NISE ' + d.label; });
            var values = distribucionData.map(function (d) { return d.value; });
            var colors = distribucionData.map(function (d) { return d.color; });

            if (values.length === 0) {
                canvas.parentElement.innerHTML =
                    '<div style="text-align:center; padding:40px 0; color:#727A86; font-size:12px;">Sin NISEs registrados</div>';
                return;
            }

            chartDona = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderColor: '#fff',
                        borderWidth: 3,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: function (context) {
                                    var total = context.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                    return context.label + ': ₡' + context.parsed.toLocaleString('es-CR') + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            });

            var legendHtml = '';
            var total = values.reduce(function (a, b) { return a + b; }, 0);
            distribucionData.forEach(function (d) {
                var pct = total > 0 ? ((d.value / total) * 100).toFixed(0) : 0;
                legendHtml += '<div class="lg"><span class="dot" style="background:' + d.color + '"></span>NISE ' + d.label + ' · ' + pct + '%</div>';
            });
            document.getElementById('legendDona').innerHTML = legendHtml;
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 2: LÍNEA
        // ═══════════════════════════════════════════════════════════
        function initConsumo() {
            var canvas = document.getElementById('chartConsumo');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');

            if (consumoData.length === 0) {
                canvas.parentElement.innerHTML =
                    '<div style="text-align:center; padding:40px 0; color:#727A86; font-size:12px;">Sin datos de consumo</div>';
                return;
            }

            var gradient = ctx.createLinearGradient(0, 0, 0, 220);
            gradient.addColorStop(0, 'rgba(30, 35, 230, 0.35)');
            gradient.addColorStop(1, 'rgba(30, 35, 230, 0.02)');

            chartConsumo = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: consumoData.map(function (d) { return d.mes; }),
                    datasets: [{
                        label: 'Monto',
                        data: consumoData.map(function (d) { return d.monto; }),
                        borderColor: '#1E23E6',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#1E23E6',
                        pointBorderWidth: 3,
                        pointRadius: 5,
                        pointHoverRadius: 8,
                        pointHoverBackgroundColor: '#1E23E6',
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    if (consumoModo === 'monto') {
                                        return '₡' + context.parsed.y.toLocaleString('es-CR');
                                    }
                                    return context.parsed.y + ' kWh';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#EDEFF3', drawBorder: false },
                            ticks: {
                                color: '#727A86',
                                font: { size: 10, weight: '600' },
                                callback: function (v) {
                                    if (consumoModo === 'monto') return '₡' + (v / 1000) + 'k';
                                    return v;
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#727A86', font: { size: 11, weight: '700' } }
                        }
                    }
                }
            });
        }

        function cambiarConsumo(modo, btn) {
            consumoModo = modo;
            document.querySelectorAll('.db-chart-tab').forEach(function (b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');

            var valores = modo === 'monto'
                ? consumoData.map(function (d) { return d.monto; })
                : consumoData.map(function (d) { return d.kwh; });

            chartConsumo.data.datasets[0].data = valores;
            chartConsumo.data.datasets[0].label = modo === 'monto' ? 'Monto' : 'Consumo';
            chartConsumo.update();
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 3: BARRAS APILADAS
        // ═══════════════════════════════════════════════════════════
        function initActividad() {
            var canvas = document.getElementById('chartActividad');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var dias = actividadData.map(function (d) { return d.dia; });

            chartActividad = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: dias,
                    datasets: [
                        { label: 'Facturas', data: actividadData.map(function (d) { return d.facturas; }), backgroundColor: '#1E23E6', borderRadius: 6, borderSkipped: false },
                        { label: 'Reportes', data: actividadData.map(function (d) { return d.reportes; }), backgroundColor: '#FF692D', borderRadius: 6, borderSkipped: false },
                        { label: 'Trámites', data: actividadData.map(function (d) { return d.tramites; }), backgroundColor: '#64B95A', borderRadius: 6, borderSkipped: false },
                        { label: 'Perfil',   data: actividadData.map(function (d) { return d.perfil; }),   backgroundColor: '#64B9CD', borderRadius: 6, borderSkipped: false }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            callbacks: {
                                label: function (context) {
                                    return context.dataset.label + ': ' + context.parsed.y + ' visitas';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { stacked: true, grid: { display: false }, ticks: { color: '#727A86', font: { size: 11, weight: '700' } } },
                        y: { stacked: true, beginAtZero: true, grid: { color: '#EDEFF3', drawBorder: false }, ticks: { color: '#727A86', font: { size: 10, weight: '600' } } }
                    }
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // GRÁFICO 4: BARRAS HORIZONTALES
        // ═══════════════════════════════════════════════════════════
        function initSecciones() {
            var canvas = document.getElementById('chartSecciones');
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var labels = seccionesData.map(function (d) { return d.nombre; });
            var values = seccionesData.map(function (d) { return d.visitas; });

            chartSecciones = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Visitas',
                        data: values,
                        backgroundColor: ['#1E23E6', '#FF692D', '#64B95A', '#64B9CD', '#F5A623', '#727A86'],
                        borderRadius: 8,
                        borderSkipped: false,
                        barThickness: 22
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0E1116',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 12,
                            cornerRadius: 10,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    return context.parsed.x + ' visitas';
                                }
                            }
                        }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: '#EDEFF3', drawBorder: false }, ticks: { color: '#727A86', font: { size: 10, weight: '600' } } },
                        y: { grid: { display: false }, ticks: { color: '#0E1116', font: { size: 11, weight: '700' } } }
                    }
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // PAGAR FACTURA
        // ═══════════════════════════════════════════════════════════
        function pagarFactura(id, num, monto) {
            if (!confirm('¿Confirmás el pago de la factura ' + num + ' por ₡' + monto.toLocaleString('es-CR') + '?')) return;
            fetch('@Url.Action("PagarFactura", "Clientes")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'facturaId=' + id
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) { alert('✅ ' + data.message); location.reload(); }
                else { alert('❌ ' + data.message); }
            })
            .catch(function () { alert('Error al procesar el pago.'); });
        }

        // ═══════════════════════════════════════════════════════════
        // EXPORTAR A EXCEL (XLSX)
        // ═══════════════════════════════════════════════════════════
        function descargarExcel(nombreHoja, datos, nombreArchivo) {
            if (typeof XLSX === 'undefined') {
                showToast('❌ Librería Excel no cargada');
                return;
            }
            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.json_to_sheet(datos);
            XLSX.utils.book_append_sheet(wb, ws, nombreHoja);
            var nombreFinal = nombreArchivo + '_' + new Date().toISOString().slice(0, 10) + '.xlsx';
            XLSX.writeFile(wb, nombreFinal);

            registrarDescarga(nombreFinal, 'Excel', nombreHoja, 0);

            showToast('📊 Excel descargado');
        }

        function exportarResumenExcel() {
            var datos = [
                { Concepto: 'Averías activas', Valor: datosRazor.averiasCount },
                { Concepto: 'Trámites en proceso', Valor: datosRazor.tramitesCount },
                { Concepto: 'Monto pendiente (₡)', Valor: datosRazor.montoPendiente },
                { Concepto: 'NISEs activos', Valor: datosRazor.totalNISEs },
                { Concepto: 'Facturas pendientes', Valor: datosRazor.totalFacturas },
                { Concepto: 'Fecha de exportación', Valor: new Date().toLocaleString('es-CR') }
            ];
            descargarExcel('Resumen', datos, 'CNFL_Resumen');
        }

        function exportarDonaExcel() {
            if (distribucionData.length === 0) { showToast('⚠️ Sin datos para exportar'); return; }
            var total = distribucionData.reduce(function (a, b) { return a + b.value; }, 0);
            var datos = distribucionData.map(function (d) {
                return {
                    NISE: d.label,
                    'Monto (₡)': d.value,
                    'Porcentaje (%)': total > 0 ? ((d.value / total) * 100).toFixed(1) : 0
                };
            });
            descargarExcel('Consumo por NISE', datos, 'CNFL_Consumo_NISE');
        }

        function exportarConsumoExcel() {
            if (consumoData.length === 0) { showToast('⚠️ Sin datos para exportar'); return; }
            var datos = consumoData.map(function (d) {
                return {
                    Mes: d.mes,
                    'Monto (₡)': d.monto,
                    'Consumo (kWh)': d.kwh
                };
            });
            descargarExcel('Evolución de consumo', datos, 'CNFL_Evolucion_Consumo');
        }

        function exportarActividadExcel() {
            if (actividadData.length === 0) { showToast('⚠️ Sin datos para exportar'); return; }
            var datos = actividadData.map(function (d) {
                return {
                    Día: d.dia,
                    Facturas: d.facturas,
                    Reportes: d.reportes,
                    Trámites: d.tramites,
                    Perfil: d.perfil,
                    'Total visitas': d.facturas + d.reportes + d.tramites + d.perfil
                };
            });
            descargarExcel('Actividad semanal', datos, 'CNFL_Actividad_Semanal');
        }

        function exportarSeccionesExcel() {
            if (seccionesData.length === 0) { showToast('⚠️ Sin datos para exportar'); return; }
            var datos = seccionesData.map(function (d) {
                return {
                    Sección: d.nombre,
                    'Visitas totales': d.visitas
                };
            });
            descargarExcel('Secciones top', datos, 'CNFL_Secciones_Top');
        }

        // ═══════════════════════════════════════════════════════════
        // EXPORTAR A PDF (jsPDF)
        // ═══════════════════════════════════════════════════════════
        function nuevoPDF() {
            if (typeof window.jspdf === 'undefined' && typeof jsPDF === 'undefined') {
                showToast('❌ Librería PDF no cargada');
                return null;
            }
            var JsPDF = (window.jspdf && window.jspdf.jsPDF) ? window.jspdf.jsPDF : jsPDF;
            return new JsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
        }

        function encabezadoPDF(doc, titulo) {
            doc.setFillColor(30, 35, 230);
            doc.rect(0, 0, 210, 28, 'F');
            doc.setTextColor(255, 255, 255);
            doc.setFontSize(16);
            doc.setFont(undefined, 'bold');
            doc.text('CNFL · ' + titulo, 14, 13);
            doc.setFontSize(9);
            doc.setFont(undefined, 'normal');
            doc.text('Usuario: ' + nombreUsuario + '  ·  ' + new Date().toLocaleString('es-CR'), 14, 21);
            doc.setTextColor(0, 0, 0);
        }

        function exportarResumenPDF() {
            var doc = nuevoPDF();
            if (!doc) return;
            encabezadoPDF(doc, 'Resumen del mes');

            doc.setFontSize(11);
            doc.setFont(undefined, 'bold');
            doc.text('Resumen general', 14, 42);
            doc.setDrawColor(230, 230, 235);
            doc.line(14, 45, 196, 45);

            var filas = [
                ['Averías activas', String(datosRazor.averiasCount)],
                ['Trámites en proceso', String(datosRazor.tramitesCount)],
                ['Monto pendiente', '₡' + Number(datosRazor.montoPendiente).toLocaleString('es-CR')],
                ['NISEs activos', String(datosRazor.totalNISEs)],
                ['Facturas pendientes', String(datosRazor.totalFacturas)]
            ];

            doc.setFontSize(10);
            var y = 54;
            filas.forEach(function (f) {
                doc.setFont(undefined, 'normal');
                doc.text(f[0], 16, y);
                doc.setFont(undefined, 'bold');
                doc.text(f[1], 196, y, { align: 'right' });
                y += 9;
            });

            y += 4;
            doc.setFontSize(11);
            doc.setFont(undefined, 'bold');
            doc.text('Consumo por NISE', 14, y);
            y += 4;
            doc.line(14, y, 196, y);
            y += 8;

            if (distribucionData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.setFontSize(10);
                doc.text('Sin NISEs registrados.', 16, y);
                y += 9;
            } else {
                var totalDona = distribucionData.reduce(function (a, b) { return a + b.value; }, 0);
                doc.setFontSize(10);
                distribucionData.forEach(function (d) {
                    var pct = totalDona > 0 ? ((d.value / totalDona) * 100).toFixed(1) : 0;
                    doc.setFont(undefined, 'normal');
                    doc.text('NISE ' + d.label + '  (' + pct + '%)', 16, y);
                    doc.setFont(undefined, 'bold');
                    doc.text('₡' + d.value.toLocaleString('es-CR'), 196, y, { align: 'right' });
                    y += 8;
                });
            }

            if (y > 250) { doc.addPage(); y = 20; }

            y += 6;
            doc.setFontSize(11);
            doc.setFont(undefined, 'bold');
            doc.text('Evolución de consumo (últimos meses)', 14, y);
            y += 4;
            doc.line(14, y, 196, y);
            y += 8;

            if (consumoData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.setFontSize(10);
                doc.text('Sin datos de consumo.', 16, y);
            } else {
                doc.setFontSize(10);
                consumoData.forEach(function (d) {
                    if (y > 270) { doc.addPage(); y = 20; }
                    doc.setFont(undefined, 'normal');
                    doc.text(String(d.mes), 16, y);
                    doc.text(String(d.kwh) + ' kWh', 110, y);
                    doc.setFont(undefined, 'bold');
                    doc.text('₡' + d.monto.toLocaleString('es-CR'), 196, y, { align: 'right' });
                    y += 8;
                });
            }

            var nombreFinal = 'CNFL_Resumen_' + new Date().toISOString().slice(0, 10) + '.pdf';
            doc.save(nombreFinal);
            registrarDescarga(nombreFinal, 'PDF', 'Resumen', 0);
            showToast('📄 PDF generado');
        }

        function exportarTodoPDF() {
            var doc = nuevoPDF();
            if (!doc) return;
            encabezadoPDF(doc, 'Dashboard completo');

            var y = 42;

            doc.setFontSize(12);
            doc.setFont(undefined, 'bold');
            doc.text('Indicadores', 14, y); y += 5;
            doc.setDrawColor(230, 230, 235);
            doc.line(14, y, 196, y); y += 9;
            doc.setFontSize(10);
            var kpis = [
                ['NISEs activos', String(datosRazor.totalNISEs)],
                ['Facturas pendientes', String(datosRazor.totalFacturas)],
                ['En proceso (averías + trámites)', String(datosRazor.averiasCount + datosRazor.tramitesCount)],
                ['Monto pendiente', '₡' + Number(datosRazor.montoPendiente).toLocaleString('es-CR')]
            ];
            kpis.forEach(function (k) {
                doc.setFont(undefined, 'normal');
                doc.text(k[0], 16, y);
                doc.setFont(undefined, 'bold');
                doc.text(k[1], 196, y, { align: 'right' });
                y += 8;
            });

            y += 4;
            doc.setFontSize(12);
            doc.setFont(undefined, 'bold');
            doc.text('Consumo por NISE', 14, y); y += 5;
            doc.line(14, y, 196, y); y += 9;
            doc.setFontSize(10);
            if (distribucionData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.text('Sin NISEs registrados.', 16, y); y += 8;
            } else {
                var tD = distribucionData.reduce(function (a, b) { return a + b.value; }, 0);
                distribucionData.forEach(function (d) {
                    var pct = tD > 0 ? ((d.value / tD) * 100).toFixed(1) : 0;
                    doc.setFont(undefined, 'normal');
                    doc.text('NISE ' + d.label + ' (' + pct + '%)', 16, y);
                    doc.setFont(undefined, 'bold');
                    doc.text('₡' + d.value.toLocaleString('es-CR'), 196, y, { align: 'right' });
                    y += 8;
                });
            }

            if (y > 240) { doc.addPage(); y = 20; }
            y += 4;
            doc.setFontSize(12);
            doc.setFont(undefined, 'bold');
            doc.text('Evolución de consumo', 14, y); y += 5;
            doc.line(14, y, 196, y); y += 9;
            doc.setFontSize(10);
            if (consumoData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.text('Sin datos de consumo.', 16, y); y += 8;
            } else {
                consumoData.forEach(function (d) {
                    if (y > 270) { doc.addPage(); y = 20; }
                    doc.setFont(undefined, 'normal');
                    doc.text(String(d.mes), 16, y);
                    doc.text(String(d.kwh) + ' kWh', 110, y);
                    doc.setFont(undefined, 'bold');
                    doc.text('₡' + d.monto.toLocaleString('es-CR'), 196, y, { align: 'right' });
                    y += 8;
                });
            }

            if (y > 240) { doc.addPage(); y = 20; }
            y += 4;
            doc.setFontSize(12);
            doc.setFont(undefined, 'bold');
            doc.text('Actividad semanal', 14, y); y += 5;
            doc.line(14, y, 196, y); y += 9;
            doc.setFontSize(9);
            if (actividadData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.text('Sin actividad registrada.', 16, y); y += 8;
            } else {
                doc.setFont(undefined, 'bold');
                doc.text('Día', 16, y);
                doc.text('Fact.', 70, y);
                doc.text('Rep.', 95, y);
                doc.text('Trám.', 120, y);
                doc.text('Perfil', 150, y);
                doc.text('Total', 180, y);
                y += 7;
                doc.setFont(undefined, 'normal');
                actividadData.forEach(function (d) {
                    if (y > 270) { doc.addPage(); y = 20; }
                    var total = (d.facturas || 0) + (d.reportes || 0) + (d.tramites || 0) + (d.perfil || 0);
                    doc.text(String(d.dia), 16, y);
                    doc.text(String(d.facturas || 0), 70, y);
                    doc.text(String(d.reportes || 0), 95, y);
                    doc.text(String(d.tramites || 0), 120, y);
                    doc.text(String(d.perfil || 0), 150, y);
                    doc.setFont(undefined, 'bold');
                    doc.text(String(total), 180, y);
                    doc.setFont(undefined, 'normal');
                    y += 7;
                });
            }

            if (y > 240) { doc.addPage(); y = 20; }
            y += 4;
            doc.setFontSize(12);
            doc.setFont(undefined, 'bold');
            doc.text('Secciones más visitadas', 14, y); y += 5;
            doc.line(14, y, 196, y); y += 9;
            doc.setFontSize(10);
            if (seccionesData.length === 0) {
                doc.setFont(undefined, 'normal');
                doc.text('Sin datos de secciones.', 16, y); y += 8;
            } else {
                seccionesData.forEach(function (d) {
                    if (y > 270) { doc.addPage(); y = 20; }
                    doc.setFont(undefined, 'normal');
                    doc.text(String(d.nombre), 16, y);
                    doc.setFont(undefined, 'bold');
                    doc.text(String(d.visitas) + ' visitas', 196, y, { align: 'right' });
                    y += 8;
                });
            }

            var nombreFinal = 'CNFL_Dashboard_' + new Date().toISOString().slice(0, 10) + '.pdf';
            doc.save(nombreFinal);
            registrarDescarga(nombreFinal, 'PDF', 'Dashboard', 0);
            showToast('📄 PDF completo generado');
        }

        function descargarFacturaPDF(facturaId) {
            var doc = nuevoPDF();
            if (!doc) return;
            encabezadoPDF(doc, 'Factura #' + facturaId);
            doc.setFontSize(11);
            doc.setFont(undefined, 'normal');
            doc.text('Comprobante generado desde el Dashboard.', 14, 50);
            doc.text('Monto: ₡' + datosRazor.facturaMonto, 14, 60);
            doc.text('Vencimiento: ' + datosRazor.facturaVence, 14, 70);
            var nombreFinal = 'CNFL_Factura_' + facturaId + '.pdf';
            doc.save(nombreFinal);
            registrarDescarga(nombreFinal, 'PDF', 'Factura', 0);
            showToast('📄 PDF de factura generado');
        }

        // ═══════════════════════════════════════════════════════════
        // INIT
        // ═══════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart !== 'undefined') {
                initDona();
                initConsumo();
                initActividad();
                initSecciones();
            }
        });
    </script>
}