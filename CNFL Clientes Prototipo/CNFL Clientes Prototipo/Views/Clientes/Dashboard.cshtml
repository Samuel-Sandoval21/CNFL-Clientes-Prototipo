@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";

    var facturaActual = ViewBag.FacturaActual as CNFL_Clientes_Prototipo.Models.Factura;

    var averias = (ViewBag.AveriasActivas as List<CNFL_Clientes_Prototipo.Models.AveriaResumenDto>)
                  ?? new List<CNFL_Clientes_Prototipo.Models.AveriaResumenDto>();
    var tramites = (ViewBag.TramitesActivos as List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>)
                   ?? new List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>();
    var notifs = (ViewBag.Notificaciones as List<CNFL_Clientes_Prototipo.Models.NotificacionResumenDto>)
                 ?? new List<CNFL_Clientes_Prototipo.Models.NotificacionResumenDto>();

    var metricas = ViewBag.Metricas as CNFL_Clientes_Prototipo.Models.MetricasUsoDto
                   ?? new CNFL_Clientes_Prototipo.Models.MetricasUsoDto();
    var descargas = ViewBag.Descargas as List<CNFL_Clientes_Prototipo.Models.DescargaUsuario>
                    ?? new List<CNFL_Clientes_Prototipo.Models.DescargaUsuario>();

    var nombre = ViewBag.Nombre as string ?? "Usuario";
    var inicial = string.IsNullOrEmpty(nombre) ? "U" : nombre.Substring(0, 1).ToUpper();

    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : (hora < 19 ? "Buenas tardes" : "Buenas noches");
    var saludoKey = hora < 12 ? "db.greet.morning" : (hora < 19 ? "db.greet.afternoon" : "db.greet.evening");
    var fechaLarga = DateTime.Now.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-CR"));

    int averiasCount = averias.Count;
    int tramitesCount = tramites.Count;

    var montoPendiente = ((decimal)ViewBag.MontoPendiente);
    var totalNISEs = (int)ViewBag.TotalNISEs;
    var totalFacturasPendientes = (int)ViewBag.TotalFacturasPendientes;
    var facturaActualMonto = facturaActual != null ? facturaActual.Monto.ToString("N0") : "0";
    var facturaActualVence = facturaActual != null ? facturaActual.FechaVencimiento.ToString("dd/MM/yyyy") : "-";

    var distribucionJson = ViewBag.DistribucionJson as string ?? "[]";
    var consumoJson = ViewBag.ConsumoJson as string ?? "[]";
    var actividadJson = ViewBag.ActividadJson as string ?? "[]";
    var seccionesJson = ViewBag.SeccionesJson as string ?? "[]";

    var descargasRecientes = descargas.Take(5).ToList();
    var descargasFacturas = descargas.Where(d => d.Seccion == "Factura").Take(5).ToList();
}

@section Styles {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <style>
        /* ═══════════════ HERO ═══════════════ */
        .db-hero {
            background: linear-gradient(135deg, #0d1b6b 0%, var(--blue) 55%, #3b6ce0 100%);
            border-radius: 24px;
            padding: 24px 20px 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 20px 40px -18px rgba(16,20,60,.55);
            position: relative;
            overflow: hidden;
        }

            .db-hero::before {
                content: "";
                position: absolute;
                left: -80px;
                bottom: -80px;
                width: 240px;
                height: 240px;
                background: radial-gradient(circle, rgba(255,255,255,.14), transparent 70%);
            }

            .db-hero::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

        .db-hero-top {
            display: flex;
            align-items: center;
            gap: 14px;
            position: relative;
            z-index: 2;
        }

        .db-avatar {
            width: 54px;
            height: 54px;
            border-radius: 18px;
            background: rgba(255,255,255,.22);
            border: 1.5px solid rgba(255,255,255,.35);
            display: grid;
            place-items: center;
            font-size: 24px;
            font-weight: 800;
            backdrop-filter: blur(6px);
            flex-shrink: 0;
            box-shadow: 0 8px 20px -8px rgba(0,0,0,.4);
        }

        .db-hero-info {
            flex: 1;
            min-width: 0;
        }

            .db-hero-info .greet {
                font-size: 12.5px;
                opacity: .9;
                font-weight: 600;
            }

            .db-hero-info h1 {
                margin: 3px 0 0;
                font-size: 21px;
                font-weight: 800;
                letter-spacing: -.02em;
                line-height: 1.15;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .db-hero-info .fecha {
                font-size: 11.5px;
                opacity: .8;
                margin-top: 3px;
                text-transform: capitalize;
            }

        .db-export {
            position: absolute;
            top: 18px;
            right: 18px;
            background: rgba(255,255,255,.22);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,.38);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 11px;
            padding: 9px 14px;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 5;
            transition: .15s;
        }

            .db-export:hover {
                background: rgba(255,255,255,.32);
                transform: translateY(-1px);
            }

        .db-hero-sub {
            font-size: 12.5px;
            opacity: .9;
            margin-top: 16px;
            line-height: 1.5;
            position: relative;
            z-index: 2;
        }

        .db-kpis {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 18px;
            padding-top: 18px;
            border-top: 1px solid rgba(255,255,255,.18);
            position: relative;
            z-index: 2;
        }

        .db-kpi {
            text-align: center;
        }

            .db-kpi .v {
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .db-kpi .l {
                font-size: 9.5px;
                opacity: .8;
                font-weight: 800;
                letter-spacing: .06em;
                margin-top: 3px;
            }

        /* ═══════════════ TÍTULOS ═══════════════ */
        .db-title {
            font-size: 14.5px;
            font-weight: 800;
            color: var(--ink);
            margin: 24px 0 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            letter-spacing: -.01em;
            flex-wrap: wrap;
            gap: 8px;
        }

            .db-title .lnk {
                font-size: 11.5px;
                font-weight: 800;
                color: var(--blue);
                text-decoration: none;
            }

                .db-title .lnk:hover {
                    text-decoration: underline;
                }

            .db-title .actions {
                display: flex;
                gap: 6px;
            }

            .db-title .btn-exp {
                background: #f4f6fb;
                color: var(--ink);
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 10.5px;
                padding: 6px 11px;
                border-radius: 999px;
                cursor: pointer;
                transition: .15s;
            }

                .db-title .btn-exp:hover {
                    background: #e5e9f5;
                }

                .db-title .btn-exp.pdf {
                    color: #c93a3f;
                    background: #fdeaea;
                }

                    .db-title .btn-exp.pdf:hover {
                        background: #fcd4d4;
                    }

                .db-title .btn-exp.excel {
                    color: #2f8f3e;
                    background: #e9f7ec;
                }

                    .db-title .btn-exp.excel:hover {
                        background: #d2f0d9;
                    }

        /* ═══════════════ FACTURA ═══════════════ */
        .db-bill {
            background: linear-gradient(135deg, var(--navy), var(--blue));
            border-radius: 22px;
            padding: 22px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 14px 30px -14px rgba(0,20,130,.65);
        }

            .db-bill::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 180px;
                height: 180px;
                background: radial-gradient(circle, rgba(255,255,255,.14), transparent 70%);
            }

            .db-bill .lbl {
                font-size: 10.5px;
                font-weight: 800;
                opacity: .85;
                letter-spacing: .08em;
            }

            .db-bill .amt {
                font-size: 32px;
                font-weight: 800;
                margin: 8px 0 4px;
                letter-spacing: -.02em;
            }

            .db-bill .due {
                font-size: 12px;
                opacity: .88;
            }

            .db-bill .nise {
                font-size: 11.5px;
                opacity: .78;
                margin-top: 3px;
            }

            .db-bill .row {
                display: flex;
                gap: 8px;
                margin-top: 18px;
                position: relative;
                z-index: 2;
            }

            .db-bill .btn-pay {
                flex: 1;
                background: var(--orange);
                color: #fff;
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 13px;
                padding: 13px;
                border-radius: 12px;
                cursor: pointer;
                transition: transform .12s;
                box-shadow: 0 8px 18px -8px rgba(255,105,45,.8);
            }

                .db-bill .btn-pay:active {
                    transform: scale(.97);
                }

            .db-bill .btn-detail {
                flex: 1;
                background: rgba(255,255,255,.16);
                color: #fff;
                border: 1px solid rgba(255,255,255,.28);
                font-family: inherit;
                font-weight: 800;
                font-size: 13px;
                padding: 13px;
                border-radius: 12px;
                cursor: pointer;
                text-decoration: none;
                text-align: center;
                transition: .15s;
            }

                .db-bill .btn-detail:hover {
                    background: rgba(255,255,255,.26);
                    color: #fff;
                    text-decoration: none;
                }

            .db-bill .btn-pdf {
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.28);
                color: #fff;
                width: 46px;
                border-radius: 12px;
                cursor: pointer;
                display: grid;
                place-items: center;
                font-size: 16px;
                transition: .15s;
            }

                .db-bill .btn-pdf:hover {
                    background: rgba(255,255,255,.26);
                }

        /* ═══════════════ TARJETAS DE MÉTRICAS ═══════════════ */
        .db-metrics {
            background: linear-gradient(135deg, #eef2ff 0%, #f7f5ff 100%);
            border-radius: 22px;
            padding: 18px;
            margin-top: 8px;
            border: 1px solid #dde4ff;
            position: relative;
            overflow: hidden;
        }

            .db-metrics::after {
                content: "⏱️";
                position: absolute;
                right: 16px;
                top: 12px;
                font-size: 46px;
                opacity: .08;
            }

            .db-metrics h3 {
                margin: 0 0 14px;
                font-size: 13.5px;
                font-weight: 800;
                color: #3a3fb8;
                display: flex;
                align-items: center;
                gap: 8px;
                position: relative;
                z-index: 2;
            }

                .db-metrics h3 .live {
                    font-size: 9px;
                    background: #d43a3a;
                    color: #fff;
                    padding: 2px 7px;
                    border-radius: 999px;
                    font-weight: 800;
                    letter-spacing: .06em;
                    animation: pulse 1.6s infinite;
                }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .5;
            }
        }

        .db-metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            position: relative;
            z-index: 2;
        }

        .db-metric {
            background: #fff;
            border-radius: 16px;
            padding: 14px;
            box-shadow: 0 3px 12px rgba(58,63,184,.08);
            border: 1px solid rgba(58,63,184,.08);
            position: relative;
            overflow: hidden;
        }

            .db-metric .ico {
                position: absolute;
                right: 12px;
                top: 12px;
                font-size: 20px;
                opacity: .65;
            }

            .db-metric .lbl {
                font-size: 10px;
                font-weight: 800;
                color: #8a8fc4;
                letter-spacing: .06em;
            }

            .db-metric .val {
                font-size: 22px;
                font-weight: 800;
                color: #3a3fb8;
                margin-top: 6px;
                letter-spacing: -.02em;
            }

                .db-metric .val small {
                    font-size: 12px;
                    opacity: .7;
                    font-weight: 700;
                }

            .db-metric .sub {
                font-size: 11px;
                color: #8a8fc4;
                margin-top: 4px;
                font-weight: 600;
            }

            .db-metric .bar {
                height: 5px;
                background: #eef2ff;
                border-radius: 999px;
                margin-top: 8px;
                overflow: hidden;
            }

                .db-metric .bar > i {
                    display: block;
                    height: 100%;
                    background: linear-gradient(90deg, #3a3fb8, #6b7dff);
                    border-radius: 999px;
                    transition: width .6s ease;
                }

        /* ═══════════════ DESCARGAS ═══════════════ */
        .db-downloads {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 6px 16px;
            box-shadow: var(--shadow-sm);
        }

        .db-download-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
        }

            .db-download-item:last-child {
                border-bottom: 0;
            }

            .db-download-item .ico {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                font-size: 19px;
                flex-shrink: 0;
            }

                .db-download-item .ico.pdf {
                    background: #fdeaea;
                    color: #c93a3f;
                }

                .db-download-item .ico.excel {
                    background: #e9f7ec;
                    color: #2f8f3e;
                }

                .db-download-item .ico.other {
                    background: #eef2ff;
                    color: #3a3fb8;
                }

            .db-download-item .body {
                flex: 1;
                min-width: 0;
            }

            .db-download-item .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .db-download-item .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 3px;
            }

            .db-download-item .action {
                background: #f4f6fb;
                color: var(--blue);
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 10.5px;
                padding: 7px 12px;
                border-radius: 10px;
                cursor: pointer;
                transition: .15s;
                white-space: nowrap;
            }

                .db-download-item .action:hover {
                    background: #e5e9f5;
                }

        /* ═══════════════ GRÁFICOS ═══════════════ */
        .db-chart-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 10px;
        }

        .db-chart-wrap {
            position: relative;
            height: 200px;
        }

            .db-chart-wrap.doughnut {
                height: 200px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .db-chart-wrap.doughnut canvas {
                    max-height: 200px;
                }

        .db-chart-tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .db-chart-tab {
            background: #f4f6fb;
            color: var(--muted);
            border: 0;
            font-family: inherit;
            font-size: 11px;
            font-weight: 800;
            padding: 6px 12px;
            border-radius: 999px;
            cursor: pointer;
            transition: .15s;
        }

            .db-chart-tab.active {
                background: var(--blue);
                color: #fff;
            }

        .db-doughnut-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
            justify-content: center;
        }

            .db-doughnut-legend .lg {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 10.5px;
                font-weight: 700;
                color: var(--ink);
                padding: 4px 10px;
                border-radius: 999px;
                background: #f7f8fc;
            }

                .db-doughnut-legend .lg .dot {
                    width: 10px;
                    height: 10px;
                    border-radius: 3px;
                }

        /* ═══════════════ KPIs MINI ═══════════════ */
        .db-kpi-mini {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 8px;
        }

            .db-kpi-mini .k {
                background: #fff;
                border: 1px solid var(--line);
                border-radius: 16px;
                padding: 16px 10px;
                box-shadow: var(--shadow-sm);
                text-align: center;
                transition: transform .12s;
            }

                .db-kpi-mini .k:hover {
                    transform: translateY(-2px);
                }

                .db-kpi-mini .k .v {
                    font-size: 22px;
                    font-weight: 800;
                    color: var(--ink);
                    letter-spacing: -.02em;
                }

                    .db-kpi-mini .k .v.ok {
                        color: #2f8f3e;
                    }

                    .db-kpi-mini .k .v.warn {
                        color: #b9791a;
                    }

                    .db-kpi-mini .k .v.danger {
                        color: #d33;
                    }

                .db-kpi-mini .k .l {
                    font-size: 9.5px;
                    font-weight: 800;
                    color: var(--muted);
                    letter-spacing: .06em;
                    margin-top: 5px;
                }

        /* ═══════════════ FILAS ═══════════════ */
        .db-rows {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .db-row {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: inherit;
            transition: transform .12s, box-shadow .12s;
        }

            .db-row:hover {
                transform: translateX(3px);
                box-shadow: 0 6px 18px -8px rgba(0,0,0,.1);
                text-decoration: none;
                color: inherit;
            }

            .db-row .ico {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                display: grid;
                place-items: center;
                font-size: 18px;
                flex-shrink: 0;
            }

            .db-row .body {
                flex: 1;
                min-width: 0;
            }

            .db-row .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .db-row .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 3px;
            }

            .db-row .badge {
                font-size: 10px;
                font-weight: 800;
                padding: 4px 9px;
                border-radius: 999px;
                white-space: nowrap;
            }

                .db-row .badge.pend {
                    background: #fef3e0;
                    color: #b9791a;
                }

                .db-row .badge.ok {
                    background: #e9f7ec;
                    color: #2f8f3e;
                }

                .db-row .badge.ing {
                    background: #eef0ff;
                    color: var(--blue);
                }

        /* ═══════════════ NOTIFICACIONES ═══════════════ */
        .db-notif {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 13px 15px;
            display: flex;
            gap: 12px;
            margin-bottom: 8px;
        }

            .db-notif .ic {
                width: 34px;
                height: 34px;
                border-radius: 11px;
                display: grid;
                place-items: center;
                font-size: 16px;
                flex-shrink: 0;
                background: linear-gradient(135deg, #eef0ff, #e3e7ff);
            }

            .db-notif .body {
                flex: 1;
            }

            .db-notif .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .db-notif .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }

        /* ═══════════════ EMPTY ═══════════════ */
        .db-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 18px;
            padding: 26px 20px;
            text-align: center;
        }

            .db-empty .e {
                font-size: 34px;
                margin-bottom: 8px;
            }

            .db-empty .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
            }

            .db-empty .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 4px;
            }

        /* ═══════════════ TOAST ═══════════════ */
        .db-toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: #0E1116;
            color: #fff;
            padding: 12px 18px;
            border-radius: 14px;
            font-size: 12.5px;
            font-weight: 700;
            opacity: 0;
            pointer-events: none;
            transition: .3s;
            z-index: 9999;
            white-space: nowrap;
            box-shadow: 0 10px 24px rgba(0,0,0,.3);
        }

            .db-toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
    </style>
}

<!-- ═══════════════ HERO ═══════════════ -->
<div class="db-hero">
    <button type="button" class="db-export" onclick="exportarTodoPDF()">📄 Exportar PDF</button>
    <div class="db-hero-top">
        <div class="db-avatar">@inicial</div>
        <div class="db-hero-info">
            <div class="greet"><span data-i18n="@saludoKey">@saludo</span>,</div>
            <h1>@nombre</h1>
            <div class="fecha">📅 @fechaLarga</div>
        </div>
    </div>
    <div class="db-hero-sub" data-i18n="db.subtitle">
