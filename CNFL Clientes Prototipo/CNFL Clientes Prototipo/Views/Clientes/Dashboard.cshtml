@section Scripts {
    <script>
        // ═══════════ GRÁFICA ═══════════
        (function () {
            var tabs = document.querySelectorAll('.chart-tab');
            var bars = document.querySelectorAll('#barChart .bar');

            function aplicarModo(modo) {
                for (var i = 0; i < bars.length; i++) {
                    var bar = bars[i];
                    var v = parseInt(bar.getAttribute('data-' + modo), 10);
                    if (isNaN(v)) v = 0;
                    bar.style.height = v + '%';
                }
            }

            for (var i = 0; i < tabs.length; i++) {
                tabs[i].addEventListener('click', function () {
                    for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
                    this.classList.add('active');
                    aplicarModo(this.getAttribute('data-mode'));
                });
            }

            aplicarModo('6m');
        })();

        // ═══════════ MODAL LLAMADA ═══════════
        function abrirModalLlamada() {
            var modal = document.getElementById('modalLlamada');
            if (modal) {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        }

        function cerrarModalLlamada() {
            var modal = document.getElementById('modalLlamada');
            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = '';
            }
        }

        // Cerrar al hacer click fuera del box
        document.addEventListener('click', function (e) {
            var modal = document.getElementById('modalLlamada');
            var box = document.getElementById('modalLlamadaBox');
            if (modal && box && e.target === modal) {
                cerrarModalLlamada();
            }
        });

        // Cerrar con Escape
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') cerrarModalLlamada();
        });

        // Copiar teléfono
        function copiarTelefono() {
            var texto = '8000-2635';
            var txt = document.getElementById('txtCopiar');

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(texto).then(function () {
                    if (txt) {
                        txt.textContent = '¡Copiado!';
                        setTimeout(function () { txt.textContent = 'Copiar número'; }, 1800);
                    }
                }).catch(function () { fallbackCopiar(texto, txt); });
            } else {
                fallbackCopiar(texto, txt);
            }
        }

        function fallbackCopiar(texto, txt) {
            var input = document.createElement('input');
            input.value = texto;
            document.body.appendChild(input);
            input.select();
            try { document.execCommand('copy'); } catch (e) { }
            document.body.removeChild(input);
            if (txt) {
                txt.textContent = '¡Copiado!';
                setTimeout(function () { txt.textContent = 'Copiar número'; }, 1800);
            }
        }
    </script>
}