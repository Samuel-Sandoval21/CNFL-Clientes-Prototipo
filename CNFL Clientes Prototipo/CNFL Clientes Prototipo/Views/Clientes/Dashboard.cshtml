@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var facturaActual = ViewBag.FacturaActual as CNFL_Clientes_Prototipo.Models.Factura;
    var tramites = (ViewBag.TramitesActivos as List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>) ?? new List<CNFL_Clientes_Prototipo.Models.TramiteResumenDto>();

    var nombre = ViewBag.Nombre as string;
    if (string.IsNullOrWhiteSpace(nombre))
    {
        nombre = Session["Nombre"] as string;
    }
    if (string.IsNullOrWhiteSpace(nombre))
    {
        nombre = Session["NombreUsuario"] as string;
    }
    if (string.IsNullOrWhiteSpace(nombre))
    {
        nombre = "Cliente";
    }

    var primerNombre = nombre.Split(' ').FirstOrDefault() ?? nombre;

    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días," : (hora < 19 ? "Buenas tardes," : "Buenas noches,");
}

<!-- APPBAR -->
<div class="appbar">
    <div class="brand">
        <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
             onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
    </div>
    <div class="actions">
        <button type="button" class="icon-btn" onclick="abrirConfig();" title="Configuración">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
        </button>

        <a href="@Url.Action("Alertas", "Clientes")" class="icon-btn">
            <span class="badge">3</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            </svg>
        </a>

        <a href="@Url.Action("Cuenta", "Clientes")" class="icon-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
            </svg>
        </a>
    </div>
</div>

<!-- SALUDO -->
<p class="h-greet">@saludo</p>
<h1 class="h-name">@primerNombre</h1>

<!-- HERO CARD -->
<div class="hero-card" style="margin-top:14px;">
    <p class="greet">Bienvenido a CNFL</p>
    <h1>Tu energía,<br>en una sola app.</h1>
    <p class="sub">Gestioná tus servicios, reportá averías y pagá tus facturas desde un solo lugar.</p>
</div>

<!-- FACTURAS PENDIENTES -->
<div class="eyebrow" style="display:flex; justify-content:space-between; align-items:center;">
    <span>💰 Facturas pendientes</span>
    <a href="@Url.Action("MisFacturas", "Clientes")"
       style="font-size:11px; color:var(--blue); font-weight:800; text-decoration:none;">
        Ver todas →
    </a>
</div>

@if (facturaActual != null)
{
    <div class="bill">
        <div class="lbl">
            FACTURA PENDIENTE
            @if (facturaActual.NISE != null)
            {
                <text>· NISE @facturaActual.NISE.NumeroNise</text>
            }
        </div>
        <div class="amt">₡ @facturaActual.Monto.ToString("N0")</div>
        <div class="due">
            📅 Vence el @facturaActual.FechaVencimiento.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("es-CR"))
            · @facturaActual.NumeroFactura
        </div>
        <div class="row">
            <a href="@Url.Action("MisFacturas", "Clientes")" class="btn btn-ghost" style="text-decoration:none;">Ver detalle</a>
            <a href="@Url.Action("MisFacturas", "Clientes")" class="btn btn-cta" style="text-decoration:none;">Pagar ahora</a>
        </div>
    </div>
}
else
{
    <div class="card" style="text-align:center; padding:26px 18px;">
        <div style="font-size:44px; line-height:1;">🎉</div>
        <p style="font-weight:800; font-size:15px; margin-top:12px; color:var(--ink);">¡Todo al día!</p>
        <p style="font-size:12.5px; color:var(--muted); margin-top:6px;">No tenés facturas pendientes de pago.</p>
        <a href="@Url.Action("MisFacturas", "Clientes")"
           style="display:inline-block; margin-top:14px; font-size:12.5px; font-weight:800; color:var(--blue); text-decoration:none;">
            Ver historial de facturas →
        </a>
    </div>
}

<!-- TRÁMITES EN PROCESO -->
@if (tramites.Any())
{
    <div class="eyebrow" style="display:flex; justify-content:space-between; align-items:center;">
        <span>Trámites en proceso</span>
        <a href="@Url.Action("Tramites", "Clientes")"
           style="font-size:11px; color:var(--blue); font-weight:800; text-decoration:none;">
            Ver todos →
        </a>
    </div>

    <div class="rows">
        @foreach (var t in tramites)
        {
            <div class="row-item">
                <div class="ic" style="background:#eef0ff;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h4" />
                    </svg>
                </div>
                <div class="tx">
                    <div class="t">@t.Tipo</div>
                    <div class="s">@t.NumeroReferencia · @t.FechaSolicitud.ToString("dd/MM/yyyy")</div>
                </div>
                <span class="pill st-normal"><span class="dot"></span>@t.Estado</span>
            </div>
        }
    </div>
}

<!-- GRÁFICA DE CONSUMO -->
<div class="eyebrow">Consumo kWh · NISE 4021</div>

<div class="chart-card" style="margin-top:0;">
    <div class="bar-chart" id="barChart">
        <div class="bar" data-6m="40" data-31d="55" data-lecturas="30"><span>Mar</span></div>
        <div class="bar" data-6m="62" data-31d="35" data-lecturas="70"><span>Abr</span></div>
        <div class="bar" data-6m="48" data-31d="80" data-lecturas="45"><span>May</span></div>
        <div class="bar" data-6m="75" data-31d="42" data-lecturas="60"><span>Jun</span></div>
        <div class="bar" data-6m="55" data-31d="90" data-lecturas="38"><span>Jul</span></div>
        <div class="bar hi" data-6m="95" data-31d="65" data-lecturas="85"><span>Ago</span></div>
    </div>

    <div class="chart-tabs">
        <button type="button" class="chart-tab active" data-mode="6m">Últimos 6 meses</button>
        <button type="button" class="chart-tab" data-mode="31d">31 días</button>
        <button type="button" class="chart-tab" data-mode="lecturas">Lecturas</button>
    </div>
</div>

<!-- RESUMEN DEL MES -->
<div class="eyebrow">Resumen del mes</div>

<div class="card">
    <div class="mgrid">
        <div class="mcell">
            <div class="k">Consumo actual</div>
            <div class="v">312 <small>kWh</small></div>
        </div>
        <div class="mcell">
            <div class="k">Mes anterior</div>
            <div class="v">287 <small>kWh</small></div>
        </div>
        <div class="mcell">
            <div class="k">Promedio diario</div>
            <div class="v">10.4 <small>kWh</small></div>
        </div>
        <div class="mcell">
            <div class="k">Próxima lectura</div>
            <div class="v">15 <small>set</small></div>
        </div>
    </div>
    <div class="social">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5" />
        </svg>
        <span>12% menos que el mes anterior · ¡buen ahorro!</span>
    </div>
</div>

<!-- CONTÁCTANOS -->
@Html.Partial("_Contactanos")

@section Scripts {
    <script>
        // ═══════════ GRÁFICA ═══════════
        (function () {
            var tabs = document.querySelectorAll('.chart-tab');
            var bars = document.querySelectorAll('#barChart .bar');

            function aplicarModo(modo) {
                for (var i = 0; i < bars.length; i++) {
                    var bar = bars[i];
                    var v = parseInt(bar.getAttribute('data-' + modo), 10);
                    if (isNaN(v)) v = 0;
                    bar.style.height = v + '%';
                }
            }

            for (var i = 0; i < tabs.length; i++) {
                tabs[i].addEventListener('click', function () {
                    for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
                    this.classList.add('active');
                    aplicarModo(this.getAttribute('data-mode'));
                });
            }

            aplicarModo('6m');
        })();

        // ═══════════════════════════════════════════════════════════
        // NOTA: La función abrirConfig() NO está definida aquí.
        // Se usa la función global definida en el _LayoutCliente.cshtml
        // que abre el modal de configuración.
        // ═══════════════════════════════════════════════════════════
    </script>
}