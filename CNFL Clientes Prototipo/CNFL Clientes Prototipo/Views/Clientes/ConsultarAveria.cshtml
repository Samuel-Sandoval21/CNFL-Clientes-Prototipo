@{
    ViewBag.Title = "Consultar Avería";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .ca-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .ca-back:hover {
                text-decoration: underline;
            }

        .ca-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .ca-header .ca-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        .ca-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 22px 20px;
            margin-top: 20px;
            box-shadow: var(--shadow-sm);
        }

        .ca-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .ca-input {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: #fff;
            transition: border-color .15s;
        }

            .ca-input:focus {
                border-color: var(--blue);
            }

        .ca-btn {
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 14px;
            border-radius: 14px;
            margin-top: 16px;
            cursor: pointer;
            transition: transform .12s;
        }

            .ca-btn:active {
                transform: scale(.97);
            }

        .ca-result {
            background: #e9f7ec;
            border: 1px solid #cdeed4;
            border-radius: 16px;
            padding: 16px;
            margin-top: 18px;
            display: none;
        }

            .ca-result .t {
                font-size: 13px;
                font-weight: 800;
                color: #2f8f3e;
                margin-bottom: 6px;
            }

            .ca-result .s {
                font-size: 12.5px;
                color: #4a9a57;
                line-height: 1.5;
            }
    </style>
}

<div class="ca-header" style="text-align:left;">
    <a href="@Url.Action("Reportes", "Clientes")" class="ca-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a Reportes
    </a>
    <h1>Consultar avería</h1>
    <div class="ca-sub">Ingresá el número de reporte para ver su estado actual.</div>
</div>

<div class="ca-card">
    <label class="ca-label">NÚMERO DE REPORTE</label>
    <input type="text" id="numAveria" class="ca-input" placeholder="Ej: 12345" />
    <button type="button" class="ca-btn" onclick="consultarAveria()">Consultar</button>

    <div class="ca-result" id="resultado">
        <div class="t">✅ Reporte encontrado</div>
        <div class="s" id="resultadoTexto"></div>
    </div>
</div>

@section Scripts {
    <script>
        function consultarAveria() {
            var num = document.getElementById('numAveria').value.trim();
            if (!num) {
                alert('Ingresá un número de reporte.');
                return;
            }

            var res = document.getElementById('resultado');
            var txt = document.getElementById('resultadoTexto');

            // Simulación de consulta (después se conecta al backend)
            txt.innerHTML = 'Avería <b>#' + num + '</b> — Estado: <b>En revisión</b>.<br>Última actualización: ' + new Date().toLocaleString('es-CR');
            res.style.display = 'block';
        }
    </script>
}