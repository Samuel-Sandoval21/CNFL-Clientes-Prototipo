@model dynamic

@{
    ViewBag.Title = "Mi Cuenta - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    // ==========================================================
    // OBTENER INICIALES DEL NOMBRE
    // ==========================================================
    var nombreCompleto = Session["Nombre"]?.ToString() ?? "Katherine Villalobos";
    var iniciales = string.Join("", nombreCompleto.Split(' ').Select(s => s.Length > 0 ? s[0].ToString() : ""));
    if (iniciales.Length > 2)
    {
        iniciales = iniciales.Substring(0, 2);
    }
    iniciales = iniciales.ToUpper();
}

<!-- CSS específico para Perfil -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/perfil.css")" />

<!-- ===== BOTÓN VOLVER ===== -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> Volver
</button>

<div class="section-pad">
    <!-- ========================================================== -->
    <!-- PERFIL HEADER -->
    <!-- ========================================================== -->
    <div class="perfil-header">
        <div class="perfil-avatar">
            @iniciales
        </div>
        <div class="perfil-info">
            <div class="perfil-nombre">@nombreCompleto</div>
            <div class="perfil-email">@(Session["Correo"]?.ToString() ?? "k.villalobos@correo.cr")</div>
        </div>
        <span class="perfil-badge">Cliente</span>
    </div>

    <!-- ========================================================== -->
    <!-- DATOS PROTEGIDOS -->
    <!-- ========================================================== -->
    <div class="perfil-protegido">
        <div class="icon">
            <i class="fas fa-shield-alt"></i>
        </div>
        <div>
            <div class="titulo">Datos protegidos</div>
            <div class="subtitulo">Cifrado extremo a extremo · biometría</div>
        </div>
    </div>
</div>

<!-- ========================================================== -->
<!-- MI ACTIVIDAD -->
<!-- ========================================================== -->
<div class="section-pad">
    <div class="section-title">
        <i class="fas fa-chart-line" style="color:var(--blue);"></i>
        Mi actividad
    </div>

    <!-- ===== Historial de compras ===== -->
    <a href="@Url.Action("HistorialCompras", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#fff3ec;">
            <i class="fas fa-shopping-bag" style="color:var(--orange);"></i>
        </div>
        <div class="tx">
            <div class="t">Historial de compras</div>
            <div class="s">Marketplace</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ===== Suscripciones ===== -->
    <a href="@Url.Action("Suscripciones", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#eefbf0;">
            <i class="fas fa-check-circle" style="color:var(--green);"></i>
        </div>
        <div class="tx">
            <div class="t">Suscripciones</div>
            <div class="s">2 activas · 1 inactiva</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ===== Servicios contratados ===== -->
    <a href="@Url.Action("ServiciosContratados", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#eef6ff;">
            <i class="fas fa-list" style="color:var(--blue);"></i>
        </div>
        <div class="tx">
            <div class="t">Servicios contratados</div>
            <div class="s">Todos tus servicios activos</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ===== Editar Mis Datos ===== -->
    <a href="@Url.Action("EditarDatos", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#e8f0fe;">
            <i class="fas fa-user-edit" style="color:var(--blue);"></i>
        </div>
        <div class="tx">
            <div class="t">Editar Mis Datos</div>
            <div class="s">Nombre, correo, teléfono</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ===== Calculadora energética ===== -->
    <a href="@Url.Action("Calculadora", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#fef3e0;">
            <i class="fas fa-calculator" style="color:var(--amber);"></i>
        </div>
        <div class="tx">
            <div class="t">Calculadora energética</div>
            <div class="s">Estima el costo de tus equipos.</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ===== Asistente Virtual ===== -->
    <a href="@Url.Action("Chat", "Clientes")" class="perfil-item">
        <div class="ic" style="background:#f0f2ff;">
            <i class="fas fa-robot" style="color:var(--blue);"></i>
        </div>
        <div class="tx">
            <div class="t">Asistente Virtual</div>
            <div class="s">800 ENERGÍA · 1026</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </a>

    <!-- ========================================================== -->
    <!-- CERRAR SESIÓN -->
    <!-- ========================================================== -->
    <div class="perfil-item cerrar-sesion" onclick="cerrarSesion()">
        <div class="ic" style="background:#fdeaea;">
            <i class="fas fa-sign-out-alt" style="color:var(--red);"></i>
        </div>
        <div class="tx">
            <div class="t">Cerrar Sesión</div>
            <div class="s">Salir de tu cuenta</div>
        </div>
        <i class="fas fa-chevron-right chevron"></i>
    </div>
</div>

<!-- JS específico para Perfil -->
@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/perfil.js")"></script>
}