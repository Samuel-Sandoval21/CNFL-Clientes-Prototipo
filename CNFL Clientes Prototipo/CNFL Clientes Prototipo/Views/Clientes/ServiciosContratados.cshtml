@{
    ViewBag.Title = "Servicios Contratados";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="servicios-container">
    <h2>Servicios Contratados</h2>
    <p>Lista de servicios que tienes contratados con CNFL.</p>

    <div class="servicios-grid">
        <div class="servicio-card">
            <div class="servicio-icon">📡</div>
            <h3>Internet 5G</h3>
            <p>Plan Hogar 300</p>
            <span class="estado-activa">Activo</span>
        </div>
        <div class="servicio-card">
            <div class="servicio-icon">🛡️</div>
            <h3>Seguro Hogar</h3>
            <p>Plan Plus</p>
            <span class="estado-activa">Activo</span>
        </div>
        <div class="servicio-card">
            <div class="servicio-icon">📷</div>
            <h3>Videovigilancia</h3>
            <p>Plan Hogar Pro</p>
            <span class="estado-inactiva">Inactivo</span>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/servicios-contratados.css" />
}