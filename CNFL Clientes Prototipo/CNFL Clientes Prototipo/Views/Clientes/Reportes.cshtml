@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/cliente/reportes.css" />

<div class="reportes-container">
    <h2>Reportes</h2>

    <div class="reportes-grid">
        <a href="@Url.Action("ReportarAveria", "Clientes")" class="reporte-card">
            <span class="reporte-icon">⚡</span>
            <div>
                <strong>Reportar avería eléctrica</strong>
                <span>Problemas con tu servicio</span>
            </div>
        </a>

        <a href="@Url.Action("ReportarAlumbrado", "Clientes")" class="reporte-card">
            <span class="reporte-icon">💡</span>
            <div>
                <strong>Reportar alumbrado público</strong>
                <span>Fallas en tu comunidad</span>
            </div>
        </a>

        <a href="#" class="reporte-card" onclick="alert('Historial de reportes')">
            <span class="reporte-icon">📋</span>
            <div>
                <strong>Historial de reportes</strong>
                <span>Seguimiento de tus reportes</span>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/cliente/reportes.js"></script>
}