@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="appbar">
    <a href="@Url.Action("MisServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Reportar avería</div>
    <div style="width:40px;"></div>
</div>

<p class="h-greet" style="margin-top:4px; line-height:1.5;">
    Reportá una avería con foto y ubicación GPS.
</p>

<div class="eyebrow">¿Qué querés reportar?</div>

<div class="rows">
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 101 })" class="row-item">
        <div class="ic" style="background:#fef3e0;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2">
                <path d="M12 3v3M12 8a4 4 0 0 0-4 4v5h8v-5a4 4 0 0 0-4-4ZM9 21h6" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">Avería en alumbrado público</div>
            <div class="s">Foto + número de poste</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 6 6 6-6 6" />
        </svg>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 102 })" class="row-item">
        <div class="ic" style="background:#fdeaea;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">Avería eléctrica propia</div>
            <div class="s">En tu NISE registrado</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 6 6 6-6 6" />
        </svg>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 103 })" class="row-item">
        <div class="ic" style="background:#eef6ff;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2">
                <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" />
                <circle cx="12" cy="9" r="2.5" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">Avería eléctrica ajena</div>
            <div class="s">Subí fotos y ubicación GPS</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 6 6 6-6 6" />
        </svg>
    </a>
</div>

<div class="eyebrow" style="display:flex; justify-content:space-between; align-items:center;">
    <span>Averías en seguimiento</span>
    <a href="@Url.Action("HistorialReportes", "Clientes")"
       style="font-size:11px; color:var(--blue); font-weight:800; text-decoration:none;">
        Ver todas →
    </a>
</div>

<div class="rows">
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 6 })" class="row-item">
        <div class="ic" style="background:#fff3ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#6 · Transformador dañado</div>
            <div class="s">11/09/2026 · 14:08</div>
        </div>
        <span class="pill st-prev"><span class="dot"></span>Operador en camino</span>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 3 })" class="row-item">
        <div class="ic" style="background:#fff3ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#3 · Transformador dañado</div>
            <div class="s">11/09/2026 · 14:08</div>
        </div>
        <span class="pill st-prev"><span class="dot"></span>Operador en camino</span>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 1 })" class="row-item">
        <div class="ic" style="background:#e9f7ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#1 · Sin energía</div>
            <div class="s">09/09/2026 · 23:25</div>
        </div>
        <span class="pill st-normal"><span class="dot"></span>Resuelto</span>
    </a>
</div>