@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .rp-hero {
            background: linear-gradient(135deg, #d33, #e74c3c);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(211,51,51,.45);
            margin-top: 8px;
        }

            .rp-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .rp-hero p {
                margin: 6px 0 0;
                font-size: 12.5px;
                opacity: .9;
                line-height: 1.4;
            }

        .rp-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 18px;
        }

        .rp-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px 14px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: transform .15s, box-shadow .2s;
        }

            .rp-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 22px -10px rgba(16,20,60,.25);
                text-decoration: none;
                color: inherit;
            }

            .rp-card .ico {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 22px;
                background: #eef0ff;
            }

            .rp-card .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .rp-card .s {
                font-size: 11px;
                color: var(--muted);
                line-height: 1.3;
            }

            .rp-card.c1 .ico {
                background: #fdecea;
            }

            .rp-card.c2 .ico {
                background: #eef0ff;
            }

            .rp-card.c3 .ico {
                background: #e9f7ec;
            }

            .rp-card.c4 .ico {
                background: #fef3e0;
            }

            .rp-card.c5 .ico {
                background: #f0eaf9;
            }

            .rp-card.c6 .ico {
                background: #eaf6fa;
            }
    </style>
}

<div class="rp-hero">
    <h1 data-i18n="reportes.title">📋 Reportes</h1>
    <p data-i18n="reportes.sub">Reportá averías y consultá su estado</p>
</div>

<div class="rp-grid">
    <a href="@Url.Action("TiposReportes", "Clientes")" class="rp-card c1">
        <div class="ico">⚡</div>
        <div class="t" data-i18n="reportes.reportar">Reportar avería</div>
        <div class="s">Poste, cable, transformador</div>
    </a>
    <a href="@Url.Action("ConsultarAveria", "Clientes")" class="rp-card c2">
        <div class="ico">🔍</div>
        <div class="t" data-i18n="reportes.consultar">Consultar avería</div>
        <div class="s">Estado por número de reporte</div>
    </a>
    <a href="@Url.Action("MapaAverias", "Clientes")" class="rp-card c3">
        <div class="ico">🗺️</div>
        <div class="t" data-i18n="reportes.mapa">Mapa de averías</div>
        <div class="s">Reportes en tu zona</div>
    </a>
    <a href="@Url.Action("HistorialReportes", "Clientes")" class="rp-card c4">
        <div class="ico">📄</div>
        <div class="t" data-i18n="reportes.historial">Historial de reportes</div>
        <div class="s">Tus reportes anteriores</div>
    </a>
    <a href="@Url.Action("ReportarAlumbrado", "Clientes")" class="rp-card c5">
        <div class="ico">💡</div>
        <div class="t" data-i18n="reportes.alumbrado">Reportar alumbrado público</div>
        <div class="s">Lámparas y postes</div>
    </a>
    <a href="@Url.Action("GenerarComprobante", "Clientes")" class="rp-card c6">
        <div class="ico">🧾</div>
        <div class="t" data-i18n="reportes.generar">Generar comprobante</div>
        <div class="s">Descargá el comprobante</div>
    </a>
</div>