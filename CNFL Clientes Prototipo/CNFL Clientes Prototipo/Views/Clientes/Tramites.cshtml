@model List<CNFL_Clientes_Prototipo.Models.Tramite>

@{
    ViewBag.Title = "Mis Trámites";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="tramites-container">
    <div class="page-header">
        <h2>Mis Trámites</h2>
        <p>Gestiona tus trámites en línea sin necesidad de ir a sucursal.</p>
    </div>

    <div class="tramites-actions">
        <a href="@Url.Action("NuevoTramite", "Clientes")" class="btn-nuevo-tramite">+ Nuevo Trámite</a>
    </div>

    <div class="tramites-lista">
        @if (Model != null && Model.Any())
        {
            foreach (var tramite in Model)
            {
                <div class="tramite-card">
                    <div class="tramite-header">
                        <span class="tramite-tipo">@tramite.Tipo</span>
                        <span class="estado-badge @tramite.Estado.Replace(" ", "-").ToLower()">@tramite.Estado</span>
                    </div>
                    <div class="tramite-body">
                        <p><strong>Fecha:</strong> @tramite.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Descripción:</strong> @tramite.Descripcion</p>
                    </div>
                    <div class="tramite-footer">
                        <span class="tramite-id">#@tramite.TramiteId</span>
                        <a href="@Url.Action("DetalleTramite", "Clientes", new { id = tramite.TramiteId })" class="btn-ver">Ver detalle</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="tramites-vacio">
                <p>No tienes trámites activos.</p>
                <a href="@Url.Action("NuevoTramite", "Clientes")" class="btn-nuevo-tramite">Iniciar un trámite</a>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/tramites.css" />
}