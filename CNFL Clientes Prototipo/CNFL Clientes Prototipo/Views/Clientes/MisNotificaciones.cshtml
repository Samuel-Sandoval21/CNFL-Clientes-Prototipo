@model List<CNFL_Clientes_Prototipo.Models.Notificacion>

@{
    ViewBag.Title = "Notificaciones";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var notificaciones = Model ?? new List<CNFL_Clientes_Prototipo.Models.Notificacion>();
}

@section Styles {
    <style>
        .nt-hero {
            background: linear-gradient(135deg, #7a4d0e, #b9791a);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(122,77,14,.45);
            margin-top: 8px;
        }

            .nt-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

        .nt-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            margin-top: 10px;
            box-shadow: var(--shadow-sm);
        }

            .nt-item .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
            }

            .nt-item .titulo {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .nt-item .fecha {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
            }

            .nt-item .msg {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 8px;
                line-height: 1.5;
            }

            .nt-item .tipo-badge {
                font-size: 10px;
                font-weight: 800;
                padding: 3px 8px;
                border-radius: 999px;
                background: #eef0ff;
                color: var(--blue);
            }

        .nt-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .nt-empty .e {
                font-size: 40px;
                margin-bottom: 8px;
            }

            .nt-empty .t {
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
            }
    </style>
}

<div class="nt-hero">
    <h1 data-i18n="notif.title">Notificaciones</h1>
</div>

@if (notificaciones.Any())
{
    foreach (var n in notificaciones)
    {
        <div class="nt-item">
            <div class="top">
                <div>
                    <div class="titulo">@n.Titulo</div>
                    <div class="fecha">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (!string.IsNullOrEmpty(n.Tipo))
                {
                    <div class="tipo-badge">@n.Tipo</div>
                }
            </div>
            <div class="msg">@n.Mensaje</div>
        </div>
    }
}
else
{
    <div class="nt-empty">
        <div class="e">🔔</div>
        <div class="t" data-i18n="notif.empty">Sin notificaciones por ahora</div>
    </div>
}