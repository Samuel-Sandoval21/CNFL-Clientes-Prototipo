@model CNFL_Clientes_Prototipo.Models.Tramite

@{
    ViewBag.Title = "Detalle del trámite";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var estadoRaw = (Model.Estado ?? "Activo").Trim().ToLowerInvariant();
    var pillClass = "p-activo";
    var estadoTexto = "Activo";

    switch (estadoRaw)
    {
        case "inactivo":
            pillClass = "p-inactivo"; estadoTexto = "Inactivo"; break;
        case "inactivo con liquidación":
        case "inactivo con liquidacion":
            pillClass = "p-inactivo-liquidacion"; estadoTexto = "Inactivo con liquidación"; break;
        case "suspendido":
            pillClass = "p-suspendido"; estadoTexto = "Suspendido"; break;
        case "suspendido con reconexión":
        case "suspendido con reconexion":
            pillClass = "p-suspendido-reconexion"; estadoTexto = "Suspendido con reconexión"; break;
    }
}

@section Styles {
    <style>
        .dt-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .dt-back:hover {
                text-decoration: underline;
            }

        .dt-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(16,20,60,.45);
            margin-bottom: 16px;
        }

            .dt-hero .ref {
                font-size: 11px;
                opacity: 0.85;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .dt-hero h1 {
                font-size: 19px;
                font-weight: 800;
                letter-spacing: -.02em;
                line-height: 1.2;
                margin: 6px 0 0;
            }

            .dt-hero .fecha {
                font-size: 12px;
                opacity: 0.9;
                margin-top: 8px;
            }

        .dt-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px;
            margin-bottom: 12px;
            box-shadow: var(--shadow-sm);
        }

            .dt-card h3 {
                margin: 0 0 14px;
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .dt-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--line);
            font-size: 13px;
        }

            .dt-row:last-child {
                border-bottom: 0;
            }

            .dt-row .k {
                color: var(--muted);
                font-weight: 700;
            }

            .dt-row .v {
                color: var(--ink);
                font-weight: 800;
                text-align: right;
            }

        .dt-pill {
            font-size: 12px;
            font-weight: 800;
            padding: 7px 14px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

            .dt-pill .dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: currentColor;
            }

            .dt-pill.p-activo {
                background: #e9f7ec;
                color: #2f8f3e;
            }

            .dt-pill.p-inactivo {
                background: #f0f1f4;
                color: #6b7280;
            }

            .dt-pill.p-inactivo-liquidacion {
                background: #fef3e0;
                color: #b9791a;
            }

            .dt-pill.p-suspendido {
                background: #fff3ec;
                color: #c95a1a;
            }

            .dt-pill.p-suspendido-reconexion {
                background: #fdeaea;
                color: #c93a3f;
            }

        .dt-progress {
            height: 8px;
            background: #eef0f7;
            border-radius: 999px;
            overflow: hidden;
            margin-top: 8px;
        }

            .dt-progress > span {
                display: block;
                height: 100%;
                background: linear-gradient(90deg, var(--blue), var(--sky));
                border-radius: 999px;
            }

        .dt-doc {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: #f7f8fc;
            border-radius: 12px;
            margin-bottom: 8px;
        }

            .dt-doc:last-child {
                margin-bottom: 0;
            }

            .dt-doc .ic {
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: #eef0ff;
                color: var(--blue);
                display: grid;
                place-items: center;
                flex-shrink: 0;
                font-size: 18px;
            }

            .dt-doc .tx {
                flex: 1;
                min-width: 0;
            }

            .dt-doc .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .dt-doc .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
                word-break: break-all;
            }

            .dt-doc .btn {
                padding: 8px 14px;
                background: var(--blue);
                color: #fff;
                border-radius: 10px;
                text-decoration: none;
                font-size: 11.5px;
                font-weight: 800;
                flex-shrink: 0;
            }
    </style>
}

<!-- ═══ BOTÓN VOLVER ═══ -->
<a href="@Url.Action("Tramites", "Clientes")" class="dt-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m15 18-6-6 6-6" />
    </svg>
    Volver a trámites
</a>

<!-- ═══ HERO ═══ -->
<div class="dt-hero">
    <div class="ref">@Model.NumeroReferencia</div>
    <h1>@Model.Tipo</h1>
    <div class="fecha">
        Solicitado el @Model.FechaSolicitud.ToString("dd 'de' MMMM, yyyy",
new System.Globalization.CultureInfo("es-CR"))
    </div>
</div>

<!-- ═══ ESTADO ═══ -->
<div class="dt-card">
    <h3>📊 Estado del trámite</h3>

    <div style="text-align:center; margin-bottom:14px;">
        <span class="dt-pill @pillClass">
            <span class="dot"></span>@estadoTexto
        </span>
    </div>

    <div class="dt-progress">
        <span style="width:@(Model.Progreso)%;"></span>
    </div>
    <p style="font-size:11.5px; color:var(--muted); margin-top:8px; text-align:center;">
        Progreso: @Model.Progreso%
    </p>
</div>

<!-- ═══ INFO ═══ -->
<div class="dt-card">
    <h3>📋 Información del trámite</h3>

    <div class="dt-row">
        <span class="k">Referencia</span>
        <span class="v">@Model.NumeroReferencia</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Categoria))
    {
        <div class="dt-row">
            <span class="k">Categoría</span>
            <span class="v">@Model.Categoria</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.NumeroNise))
    {
        <div class="dt-row">
            <span class="k">NISE</span>
            <span class="v">@Model.NumeroNise</span>
        </div>
    }

    <div class="dt-row">
        <span class="k">Fecha de solicitud</span>
        <span class="v">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</span>
    </div>

    @if (Model.FechaEstimadaFinalizacion.HasValue)
    {
        <div class="dt-row">
            <span class="k">Fecha estimada de finalización</span>
            <span class="v">@Model.FechaEstimadaFinalizacion.Value.ToString("dd/MM/yyyy")</span>
        </div>
    }

    @if (Model.FechaFinalizacion.HasValue)
    {
        <div class="dt-row">
            <span class="k">Fecha de finalización</span>
            <span class="v">@Model.FechaFinalizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    }
</div>

<!-- ═══ DESCRIPCIÓN ═══ -->
@if (!string.IsNullOrWhiteSpace(Model.Descripcion))
{
    <div class="dt-card">
        <h3>📝 Descripción</h3>
        <p style="font-size:12.5px; line-height:1.6; color:var(--ink);">
            @Model.Descripcion
        </p>
    </div>
}

<!-- ═══ DOCUMENTOS ═══ -->
@if (Model.TramiteDocumentos != null && Model.TramiteDocumentos.Any())
{
    <div class="dt-card">
        <h3>📎 Documentos adjuntos (@Model.TramiteDocumentos.Count)</h3>

        @foreach (var doc in Model.TramiteDocumentos)
        {
            <div class="dt-doc">
                <div class="ic">
                    @if (!string.IsNullOrEmpty(doc.NombreArchivo) && doc.NombreArchivo.ToLower().EndsWith(".pdf"))
                    {
                        <text>📄</text>
                    }
                    else
                    {
                        <text>🖼️</text>
                    }
                </div>
                <div class="tx">
                    <div class="t">@doc.NombreRequisito</div>
                    <div class="s">@doc.NombreArchivo · @((doc.TamanoBytes / 1024).ToString("N0")) KB</div>
                </div>
                @if (!string.IsNullOrEmpty(doc.RutaArchivo))
                {
                    <a href="@Url.Content(doc.RutaArchivo)" target="_blank" class="btn">Ver</a>
                }
            </div>
        }
    </div>
}