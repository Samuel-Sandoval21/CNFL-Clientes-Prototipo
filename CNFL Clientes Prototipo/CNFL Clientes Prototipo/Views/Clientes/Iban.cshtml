@model dynamic

@{
    ViewBag.Title = "Pago IBAN - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    var facturaId = ViewBag.FacturaId ?? Request.QueryString["facturaId"] ?? "0";
    var monto = ViewBag.Monto ?? Request.QueryString["monto"] ?? "0";
}

<!-- Estilos -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/pagos.css")" />
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/iban.css")" />

<!-- Botón Volver -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<!-- Encabezado -->
<div class="section-pad">
    <div class="h-name-2" data-i18n="pago_iban">
        <i class="fas fa-university" style="color:var(--blue);"></i> Pago por Transferencia IBAN
    </div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;">
        <span data-i18n="producto_factura">Producto/Factura:</span> Factura #@facturaId
    </div>
</div>

<!-- Contenido Principal -->
<div class="section-pad">
    <div class="pago-card" style="text-align:center;">
        <!-- Monto -->
        <div style="font-size:20px; font-weight:800; color:var(--blue);" class="monto-pagar">₡ @monto</div>
        <div style="font-size:13px; color:var(--muted); margin-top:4px;" data-i18n="monto_transferir">Monto a transferir</div>

        <hr style="border-color:var(--line); margin:16px 0;" />

        <!-- Detalles de Transferencia -->
        <div style="display:flex; flex-direction:column; gap:14px; text-align:left;">
            <div class="iban-campo">
                <label data-i18n="nombre_titular">Nombre del titular</label>
                <div class="iban-valor">Katherine Villalobos</div>
            </div>

            <div class="iban-campo">
                <label data-i18n="cuenta_destino">Cuenta destino (IBAN)</label>
                <input type="text" id="cuentaIban" class="iban-input" placeholder="CR00000000000000000000" value="CR1234567890" maxlength="22" />
            </div>

            <div class="iban-campo">
                <label data-i18n="monto_transferir">Monto a transferir</label>
                <div class="iban-valor">₡ @monto</div>
            </div>
        </div>

        <input type="hidden" id="facturaId" value="@facturaId" />

        <!-- Botón -->
        <button class="btn-iban btn-pagar" id="btnPagarIban">
            <i class="fas fa-check-circle"></i>
            <span data-i18n="confirmar_transferencia">Confirmar transferencia</span>
        </button>

        <!-- Seguridad -->
        <div style="margin-top:12px; font-size:12px; color:var(--muted);">
            <i class="fas fa-lock" style="margin-right:4px;"></i> Transferencia segura
        </div>
    </div>
</div>

<!-- Scripts -->
@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/pagos.js")"></script>
    <script src="@Url.Content("~/Scripts/cliente/iban.js")"></script>
}