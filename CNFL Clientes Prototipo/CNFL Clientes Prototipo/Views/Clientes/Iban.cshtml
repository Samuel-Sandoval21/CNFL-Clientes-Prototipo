@model dynamic

@{
    ViewBag.Title = "Pago IBAN - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- CSS externo para Pagos -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/pagos.css")" />

<!-- ===== BOTÓN VOLVER ===== -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<div class="section-pad">
    <div class="h-name-2" data-i18n="pago_iban">Pago por Transferencia IBAN</div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;">
        <span data-i18n="producto_factura">Producto/Factura:</span> Panel Solar
    </div>
</div>

<div class="section-pad">
    <div class="pago-card">
        <div style="text-align:center; font-size:20px; font-weight:800; color:var(--blue);">₡ 185.000</div>
        <div style="text-align:center; font-size:13px; color:var(--muted); margin-top:4px;" data-i18n="monto_transferir">Monto a transferir</div>

        <hr style="border-color:var(--line); margin:16px 0;" />

        <div style="display:flex; flex-direction:column; gap:12px;">
            <div>
                <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="nombre_titular">Nombre del titular</label>
                <input type="text" value="Katherine Villalobos" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" readonly />
            </div>
            <div>
                <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="cuenta_destino">Cuenta destino</label>
                <input type="text" value="CR1234567890" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" readonly />
            </div>
            <div>
                <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="monto_transferir">Monto a transferir</label>
                <input type="text" value="₡185.000" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" readonly />
            </div>
        </div>

        <button class="btn-cta" style="width:100%; margin-top:16px;" onclick="alert('✅ Transferencia confirmada exitosamente')">
            <span data-i18n="confirmar_transferencia">Confirmar transferencia</span>
        </button>
    </div>
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/pagos.js")"></script>
}