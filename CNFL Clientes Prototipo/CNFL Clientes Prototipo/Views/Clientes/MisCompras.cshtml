@{
    ViewBag.Title = "Mis compras";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

@section Styles {
    <style>
        /* ═══════════ RESUMEN GENERAL ═══════════ */
        .compras-resumen {
            background: linear-gradient(135deg, var(--navy), var(--blue));
            border-radius: 20px;
            padding: 20px;
            color: #fff;
            margin-top: 16px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 16px 32px -16px rgba(16,20,60,.55);
        }

            .compras-resumen::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 190px;
                height: 190px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

            .compras-resumen .greet {
                font-size: 12px;
                opacity: .9;
                position: relative;
                z-index: 2;
                font-weight: 700;
                letter-spacing: .04em;
            }

            .compras-resumen .monto {
                font-size: 32px;
                font-weight: 800;
                margin: 8px 0 0;
                letter-spacing: -.02em;
                position: relative;
                z-index: 2;
            }

            .compras-resumen .stats {
                display: flex;
                gap: 20px;
                margin-top: 14px;
                position: relative;
                z-index: 2;
            }

                .compras-resumen .stats .stat {
                    flex: 1;
                }

                    .compras-resumen .stats .stat .k {
                        font-size: 11px;
                        opacity: .8;
                        font-weight: 700;
                    }

                    .compras-resumen .stats .stat .v {
                        font-size: 18px;
                        font-weight: 800;
                        margin-top: 2px;
                    }

        /* ═══════════ FILTROS ═══════════ */
        .compras-filtros {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin: 20px 0 4px;
        }

        .filtro-chip {
            font-size: 11px;
            font-weight: 800;
            padding: 7px 13px;
            border-radius: 999px;
            background: #eef0f7;
            color: var(--muted);
            cursor: pointer;
            border: 0;
            font-family: inherit;
            transition: background .15s, color .15s;
        }

            .filtro-chip.active {
                background: var(--blue);
                color: #fff;
            }

        /* ═══════════ TARJETA DE COMPRA ═══════════ */
        .compra-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 12px;
            transition: box-shadow .15s;
        }

            .compra-card:hover {
                box-shadow: 0 6px 20px rgba(16, 20, 40, 0.09);
            }

        .compra-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .compra-id {
            font-size: 11px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .compra-fecha {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--ink);
            margin-top: 4px;
        }

        .compra-emojis {
            font-size: 22px;
            margin-top: 6px;
            letter-spacing: 2px;
        }

        .compra-total {
            font-size: 18px;
            font-weight: 800;
            color: var(--orange);
            margin-top: 8px;
        }

        .compra-metodo {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            font-weight: 800;
            color: var(--blue);
            background: #eef0ff;
            padding: 4px 10px;
            border-radius: 999px;
            margin-top: 8px;
        }

        .compra-estado {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 10px;
            font-weight: 800;
            background: #e9f7ec;
            color: #2f8f3e;
            padding: 5px 10px;
            border-radius: 999px;
            white-space: nowrap;
        }

            .compra-estado .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: var(--green);
            }

        /* ═══════════ DETALLE EXPANDIBLE ═══════════ */
        .compra-toggle {
            width: 100%;
            background: #f7f8fc;
            border: 0;
            border-radius: 12px;
            padding: 10px 14px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 800;
            color: var(--blue);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 12px;
            transition: background .15s;
        }

            .compra-toggle:hover {
                background: #eef0ff;
            }

            .compra-toggle .arrow {
                transition: transform .2s;
                font-size: 10px;
            }

            .compra-toggle.open .arrow {
                transform: rotate(180deg);
            }

        .compra-detalle {
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
            margin-top: 0;
        }

            .compra-detalle.open {
                max-height: 500px;
                margin-top: 10px;
            }

        .detalle-items {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .detalle-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            background: #fafbfe;
            border-radius: 10px;
            font-size: 12px;
        }

            .detalle-item .emoji {
                font-size: 20px;
                flex-shrink: 0;
            }

            .detalle-item .nombre {
                flex: 1;
                min-width: 0;
                font-weight: 700;
                color: var(--ink);
                line-height: 1.3;
            }

            .detalle-item .cantidad {
                font-size: 11px;
                color: var(--muted);
                font-weight: 700;
            }

            .detalle-item .precio {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--orange);
                white-space: nowrap;
            }

        /* ═══════════ BOTÓN ELIMINAR ═══════════ */
        .compra-acciones {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        .compra-accion {
            flex: 1;
            background: transparent;
            border: 1.5px solid var(--line);
            padding: 10px;
            border-radius: 11px;
            font-family: inherit;
            font-size: 11.5px;
            font-weight: 800;
            cursor: pointer;
            transition: .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            color: var(--ink);
        }

            .compra-accion:hover {
                background: #fafbfe;
            }

            .compra-accion.peligro {
                color: var(--red);
                border-color: #fbd5d5;
            }

                .compra-accion.peligro:hover {
                    background: #fdeaea;
                }

        /* ═══════════ ESTADO VACÍO ═══════════ */
        .compras-vacio {
            text-align: center;
            padding: 40px 20px;
        }

            .compras-vacio .ico {
                font-size: 52px;
                line-height: 1;
            }

            .compras-vacio h3 {
                font-size: 15px;
                font-weight: 800;
                color: var(--ink);
                margin: 12px 0 0;
            }

            .compras-vacio p {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 6px;
                line-height: 1.5;
            }
    </style>
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">📦 Mis compras</div>
    <div style="width:40px;"></div>
</div>

<h1 class="h-name" style="font-size:26px;">Mis compras</h1>
<p class="h-greet" style="margin-top:6px; line-height:1.5;">
    Historial completo de tus pedidos en CNFL.
</p>

<!-- ═══════════ RESUMEN GENERAL ═══════════ -->
<div id="comprasResumen" class="compras-resumen" style="display:none;">
    <div class="greet">TOTAL GASTADO EN CNFL</div>
    <div class="monto" id="totalGastado">₡0</div>
    <div class="stats">
        <div class="stat">
            <div class="k">Compras</div>
            <div class="v" id="totalCompras">0</div>
        </div>
        <div class="stat">
            <div class="k">Items</div>
            <div class="v" id="totalItems">0</div>
        </div>
        <div class="stat">
            <div class="k">Este mes</div>
            <div class="v" id="comprasMes">0</div>
        </div>
    </div>
</div>

<!-- ═══════════ FILTROS ═══════════ -->
<div id="comprasFiltros" class="compras-filtros" style="display:none;">
    <button type="button" class="filtro-chip active" data-filtro="todas" onclick="filtrarCompras('todas', this);">Todas</button>
    <button type="button" class="filtro-chip" data-filtro="factura" onclick="filtrarCompras('factura', this);">💡 Factura</button>
    <button type="button" class="filtro-chip" data-filtro="tarjeta" onclick="filtrarCompras('tarjeta', this);">💳 Tarjeta</button>
    <button type="button" class="filtro-chip" data-filtro="sinpe" onclick="filtrarCompras('sinpe', this);">📱 SINPE</button>
    <button type="button" class="filtro-chip" data-filtro="iban" onclick="filtrarCompras('iban', this);">🏦 IBAN</button>
    <button type="button" class="filtro-chip" data-filtro="token" onclick="filtrarCompras('token', this);">🔐 Token</button>
</div>

<!-- ═══════════ ESTADO VACÍO ═══════════ -->
<div id="comprasVacio" class="card compras-vacio" style="margin-top:14px;">
    <div class="ico">📦</div>
    <h3>Sin compras todavía</h3>
    <p>Explorá el marketplace y empezá a comprar.</p>
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="reg-btn"
       style="display:inline-block; margin-top:16px; text-decoration:none; padding:12px 22px; width:auto;">
        Ver productos →
    </a>
</div>

<!-- ═══════════ LISTA DE COMPRAS ═══════════ -->
<div id="listaCompras" style="margin-top:14px;"></div>

<!-- ═══════════ ACCIONES INFERIORES ═══════════ -->
<div style="margin-top:22px; display:flex; flex-direction:column; gap:10px;">
    <a href="@Url.Action("MetodosPago", "Clientes")" class="row-item" style="text-decoration:none; color:inherit;">
        <div class="ic" style="background:#e9f7ec; font-size:18px; display:grid; place-items:center;">💳</div>
        <div class="tx">
            <div class="t">Administrar métodos de pago</div>
            <div class="s">Tarjetas, SINPE e IBAN</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </a>

    <a href="@Url.Action("ProductosServicios", "Clientes")" class="row-item" style="text-decoration:none; color:inherit;">
        <div class="ic" style="background:#eef0ff; font-size:18px; display:grid; place-items:center;">🛍️</div>
        <div class="tx">
            <div class="t">Seguir comprando</div>
            <div class="s">Marketplace, planes y servicios</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </a>
</div>

@section Scripts {
    <script>
        var STORAGE_KEY = 'cnfl_compras';
        var filtroActual = 'todas';
        var comprasCache = [];

        // ═══════════ Utilidades ═══════════
        function formatearCRC(n) {
            return '₡' + Math.round(n).toLocaleString('es-CR');
        }

        function getCompras() {
            try {
                return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            } catch (e) { return []; }
        }

        function setCompras(compras) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(compras));
        }

        function formatoFecha(iso) {
            var d = new Date(iso);
            var fecha = d.toLocaleDateString('es-CR', { day: '2-digit', month: 'short', year: 'numeric' });
            var hora = d.toLocaleTimeString('es-CR', { hour: '2-digit', minute: '2-digit' });
            return fecha + ' · ' + hora;
        }

        function metodoInfo(metodo) {
            var mapa = {
                factura: { label: '💡 Factura', color: '#eef0ff' },
                tarjeta: { label: '💳 Tarjeta', color: '#fef3e0' },
                sinpe: { label: '📱 SINPE', color: '#e9f7ec' },
                iban: { label: '🏦 IBAN', color: '#f3f0ff' },
                token: { label: '🔐 Token', color: '#fdeaea' }
            };
            return mapa[metodo] || { label: metodo, color: '#eef0f7' };
        }

        // ═══════════ Render ═══════════
        function renderResumen(compras) {
            var cont = document.getElementById('comprasResumen');
            var totalGastado = document.getElementById('totalGastado');
            var totalCompras = document.getElementById('totalCompras');
            var totalItems = document.getElementById('totalItems');
            var comprasMes = document.getElementById('comprasMes');

            if (compras.length === 0) {
                cont.style.display = 'none';
                return;
            }
            cont.style.display = 'block';

            var total = 0;
            var items = 0;
            var mesActual = new Date().getMonth();
            var anioActual = new Date().getFullYear();
            var esteMes = 0;

            compras.forEach(function (c) {
                // El total guardado es un string tipo "₡12.345", lo parseamos
                var num = 0;
                if (c.total) {
                    num = parseInt(String(c.total).replace(/[₡.,\s]/g, ''), 10) || 0;
                }
                total += num;

                if (c.items && c.items.length) {
                    c.items.forEach(function (i) { items += (i.cantidad || 1); });
                }

                var fecha = new Date(c.fecha);
                if (fecha.getMonth() === mesActual && fecha.getFullYear() === anioActual) {
                    esteMes++;
                }
            });

            totalGastado.textContent = formatearCRC(total);
            totalCompras.textContent = compras.length;
            totalItems.textContent = items;
            comprasMes.textContent = esteMes;
        }

        function renderCompras(compras) {
            var cont = document.getElementById('listaCompras');
            var vacio = document.getElementById('comprasVacio');
            var filtros = document.getElementById('comprasFiltros');

            if (compras.length === 0) {
                vacio.style.display = 'block';
                filtros.style.display = 'none';
                cont.innerHTML = '';
                return;
            }

            vacio.style.display = 'none';
            filtros.style.display = 'flex';

            // Filtrar
            var filtradas = compras;
            if (filtroActual !== 'todas') {
                filtradas = compras.filter(function (c) { return c.metodo === filtroActual; });
            }

            // Orden descendente por fecha
            filtradas.sort(function (a, b) { return new Date(b.fecha) - new Date(a.fecha); });

            if (filtradas.length === 0) {
                cont.innerHTML = '<div class="card" style="text-align:center; padding:30px 20px;">' +
                    '<div style="font-size:38px;">🔍</div>' +
                    '<p style="font-weight:800; font-size:14px; margin-top:10px; color:var(--ink);">Sin compras con este filtro</p>' +
                    '<p style="font-size:12px; color:var(--muted); margin-top:4px;">Probá con otro método de pago</p>' +
                    '</div>';
                return;
            }

            cont.innerHTML = '';

            filtradas.forEach(function (c, idx) {
                var emojis = (c.items || []).map(function (i) { return i.emoji || '📦'; }).slice(0, 3).join(' ');
                var cantItems = (c.items || []).reduce(function (s, i) { return s + (i.cantidad || 1); }, 0);
                var metodo = metodoInfo(c.metodo);

                // ID único para el toggle
                var idUnico = 'compra-' + idx;

                var div = document.createElement('div');
                div.className = 'compra-card';

                // Detalle de items
                var itemsHtml = '';
                (c.items || []).forEach(function (item) {
                    var cantidad = item.cantidad || 1;
                    var precioUnit = item.precio || 0;
                    var linea = precioUnit * cantidad;

                    itemsHtml +=
                        '<div class="detalle-item">' +
                        '<span class="emoji">' + (item.emoji || '📦') + '</span>' +
                        '<span class="nombre">' + item.nombre + '</span>' +
                        '<span class="cantidad">x' + cantidad + '</span>' +
                        '<span class="precio">' + formatearCRC(linea) + '</span>' +
                        '</div>';
                });

                div.innerHTML =
                    '<div class="compra-head">' +
                    '<div style="flex:1; min-width:0;">' +
                    '<div class="compra-id">Pedido #' + String(idx + 1).padStart(4, '0') + '</div>' +
                    '<div class="compra-fecha">' + formatoFecha(c.fecha) + '</div>' +
                    '<div class="compra-emojis">' + emojis + '</div>' +
                    '<div class="compra-total">' + (c.total || '₡0') + '</div>' +
                    '<div class="compra-metodo">' + metodo.label + '</div>' +
                    '</div>' +
                    '<span class="compra-estado"><span class="dot"></span>Pagada</span>' +
                    '</div>' +

                    '<button type="button" class="compra-toggle" onclick="toggleCompra(\'' + idUnico + '\', this);">' +
                    '<span>Ver ' + cantItems + ' item' + (cantItems === 1 ? '' : 's') + '</span>' +
                    '<span class="arrow">▼</span>' +
                    '</button>' +

                    '<div class="compra-detalle" id="' + idUnico + '">' +
                    '<div class="detalle-items">' + itemsHtml + '</div>' +
                    '</div>' +

                    '<div class="compra-acciones">' +
                    '<button type="button" class="compra-accion" onclick="reenviarFactura(' + idx + ');">📧 Reenviar factura</button>' +
                    '<button type="button" class="compra-accion peligro" onclick="eliminarCompra(' + idx + ');">🗑️ Eliminar</button>' +
                    '</div>';

                cont.appendChild(div);
            });
        }

        // ═══════════ Acciones ═══════════
        function toggleCompra(id, btn) {
            var detalle = document.getElementById(id);
            if (!detalle) return;

            var abierto = detalle.classList.contains('open');

            // Cerrar todos
            document.querySelectorAll('.compra-detalle').forEach(function (el) { el.classList.remove('open'); });
            document.querySelectorAll('.compra-toggle').forEach(function (el) {
                el.classList.remove('open');
                var span = el.querySelector('span:first-child');
                if (span) {
                    var texto = span.textContent;
                    span.textContent = texto.replace('Ocultar', 'Ver').replace('detalle', 'items');
                }
            });

            // Abrir el actual si estaba cerrado
            if (!abierto) {
                detalle.classList.add('open');
                btn.classList.add('open');
            }
        }

        function filtrarCompras(filtro, btn) {
            filtroActual = filtro;

            // Actualizar clases
            document.querySelectorAll('.filtro-chip').forEach(function (el) { el.classList.remove('active'); });
            if (btn) btn.classList.add('active');

            renderCompras(comprasCache);
        }

        function reenviarFactura(idx) {
            var compras = getCompras();
            if (!compras[idx]) return;
            alert('📧 Te enviaremos la factura de tu compra del ' + formatoFecha(compras[idx].fecha) + ' al correo registrado.');
        }

        function eliminarCompra(idx) {
            if (!confirm('¿Eliminar esta compra del historial?\n\nEsta acción no se puede deshacer.')) return;

            var compras = getCompras();
            compras.splice(idx, 1);
            setCompras(compras);
            comprasCache = compras;

            renderResumen(compras);
            renderCompras(compras);
        }

        // ═══════════ Inicializar ═══════════
        comprasCache = getCompras();
        renderResumen(comprasCache);
        renderCompras(comprasCache);
    </script>
}