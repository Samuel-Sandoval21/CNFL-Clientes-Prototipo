@model List<CNFL_Clientes_Prototipo.Models.Factura>
@{
    ViewBag.Title = "Mis Facturas";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var facturas = Model ?? new List<CNFL_Clientes_Prototipo.Models.Factura>();
    var pendientes = facturas.Where(f => !f.Pagada).ToList();
    var pagadas = facturas.Where(f => f.Pagada).ToList();
    var totalPendiente = pendientes.Sum(f => (decimal?)f.Monto) ?? 0m;
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <a href="@Url.Action("Dashboard", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Mis Facturas</div>
    <div style="width:40px;"></div>
</div>

<!-- ═══════════ HEADER AZUL ═══════════ -->
<div class="bill" style="margin-top:8px;">
    <div class="lbl">💡 Mis Facturas</div>
    <div class="due" style="font-size:13px; margin-top:6px; opacity:.9;">
        Gestioná tus pagos pendientes e historial
    </div>
    <div style="margin-top:14px; padding-top:14px; border-top:1px solid rgba(255,255,255,.2);">
        <div class="lbl" style="font-size:11px;">TOTAL PENDIENTE</div>
        <div class="amt" style="font-size:32px;">₡@totalPendiente.ToString("N0")</div>
        <div class="due">@pendientes.Count factura(s) por pagar</div>
    </div>
</div>

<!-- ═══════════ MÉTRICAS ═══════════ -->
<div class="eyebrow">Resumen</div>

<div class="card">
    <div class="mgrid" style="grid-template-columns:1fr 1fr 1fr;">
        <div class="mcell" style="text-align:center;">
            <div class="k">Pendientes</div>
            <div class="v" style="color:var(--orange);">@pendientes.Count</div>
        </div>
        <div class="mcell" style="text-align:center;">
            <div class="k">Pagadas</div>
            <div class="v" style="color:var(--green);">@pagadas.Count</div>
        </div>
        <div class="mcell" style="text-align:center;">
            <div class="k">Total</div>
            <div class="v">@facturas.Count</div>
        </div>
    </div>
</div>

<!-- ═══════════ FACTURAS PENDIENTES ═══════════ -->
@if (pendientes.Any())
{
    <div class="eyebrow">💰 Pendientes de pago</div>

    <div class="rows">
        @foreach (var f in pendientes)
        {
            <div class="row-item">
                <div class="ic" style="background:#fff3ec;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h4" />
                    </svg>
                </div>
                <div class="tx">
                    <div class="t">₡@f.Monto.ToString("N0")</div>
                    <div class="s">@f.NumeroFactura · Vence @f.FechaVencimiento.ToString("dd/MM/yyyy")</div>
                </div>
                <span class="pill st-prev"><span class="dot"></span>Pendiente</span>
            </div>
        }
    </div>
}
else
{
    <div class="card" style="text-align:center; padding:34px 18px; margin-top:14px;">
        <div style="font-size:48px; line-height:1;">🎉</div>
        <p style="font-weight:800; font-size:16px; margin-top:12px; color:var(--ink);">¡Todo al día!</p>
        <p style="font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5;">
            No tenés facturas pendientes de pago. Gracias por tu puntualidad.
        </p>
    </div>
}

<!-- ═══════════ HISTORIAL DE PAGOS ═══════════ -->
<div class="eyebrow" style="display:flex; align-items:center; gap:8px;">
    <span>Historial de pagos</span>
    @if (pagadas.Any())
    {
        <span class="pill st-normal" style="font-size:10px;">
            <span class="dot"></span>@pagadas.Count
        </span>
    }
</div>

@if (pagadas.Any())
{
    <div class="card" style="padding:0; overflow:hidden;">
        <details>
            <summary style="list-style:none; padding:16px; cursor:pointer; display:flex; align-items:center; gap:12px; border-bottom:1px solid var(--line);">
                <div style="width:32px; height:32px; border-radius:10px; background:#e9f7ec; display:grid; place-items:center; flex:none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M9 13h6M9 17h4" />
                    </svg>
                </div>
                <div style="flex:1; font-weight:800; font-size:13.5px; color:var(--ink);">
                    Ver facturas pagadas (@pagadas.Count)
                </div>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </summary>

            <div style="padding:16px;">
                @foreach (var f in pagadas)
                {
                    <div style="border-left:3px solid var(--green); padding:12px 14px; margin-bottom:10px; background:#fafbfe; border-radius:12px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                            @if (f.NISE != null)
                            {
                                <span style="font-size:11px; font-weight:800; color:var(--blue); background:#eef0ff; padding:4px 10px; border-radius:999px;">
                                    NISE @f.NISE.NumeroNise
                                </span>
                            }
                            <span class="pill st-normal" style="font-size:10px;">
                                <span class="dot"></span>Pagada
                            </span>
                        </div>
                        <div style="font-size:22px; font-weight:800; color:var(--ink); margin:6px 0;">
                            ₡@f.Monto.ToString("N0")
                        </div>
                        <div style="font-size:11.5px; color:var(--green); font-weight:700;">
                            ✅ @f.FechaVencimiento.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-CR"))
                        </div>
                        <div style="font-size:11px; color:var(--muted); margin-top:2px;">
                            Factura @f.NumeroFactura
                        </div>
                    </div>
                }
            </div>
        </details>
    </div>
}
else
{
    <div class="card" style="text-align:center; padding:24px 18px;">
        <p style="font-size:12.5px; color:var(--muted);">Sin facturas pagadas todavía.</p>
    </div>
}