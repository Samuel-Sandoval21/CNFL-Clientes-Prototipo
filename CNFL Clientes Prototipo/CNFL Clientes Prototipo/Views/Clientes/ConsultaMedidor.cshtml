@{
    ViewBag.Title = "Consulta al medidor";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="appbar">
    <a href="@Url.Action("MisServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Medidor AMI</div>
    <div style="width:40px;"></div>
</div>

<p class="h-greet" style="margin-top:4px; line-height:1.5;">
    Consultá los datos de tu medidor inteligente en tiempo real.
</p>

<div class="eyebrow">Servicio</div>

<div class="nise">
    <div class="ring" style="background:#e9f7ec;">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
            <path d="M9 21V9l6-6v18M9 13h6" />
            <path d="M3 21h18" />
        </svg>
    </div>
    <div class="info">
        <div class="t">NISE-002 · Residencial</div>
        <div class="s">Medidor #AMI-88421</div>
    </div>
    <span class="pill st-normal"><span class="dot"></span>En línea</span>
</div>

<div class="eyebrow">Última lectura</div>

<div class="card">
    <div class="mgrid">
        <div class="mcell">
            <div class="k">Fecha y hora</div>
            <div class="v" style="font-size:15px;">15/09/26</div>
            <div style="font-size:11px; color:var(--muted); font-weight:700; margin-top:2px;">14:08</div>
        </div>
        <div class="mcell">
            <div class="k">Última lectura</div>
            <div class="v">742 <small>kWh</small></div>
        </div>
        <div class="mcell">
            <div class="k">Última facturada</div>
            <div class="v">630 <small>kWh</small></div>
        </div>
        <div class="mcell">
            <div class="k">Consumo acumulado</div>
            <div class="v">198 <small>kWh</small></div>
        </div>
    </div>

    <div style="margin-top:14px; padding-top:14px; border-top:1px dashed var(--line); display:flex; justify-content:space-between; align-items:center;">
        <div>
            <div style="font-size:11px; color:var(--muted); font-weight:700;">Costo estimado del mes</div>
            <div style="font-size:22px; font-weight:800; color:var(--orange); margin-top:4px;">₡ 21.300</div>
        </div>
        <div style="text-align:right;">
            <div style="font-size:11px; color:var(--muted); font-weight:700;">Voltaje actual</div>
            <div style="font-size:16px; font-weight:800; color:var(--green); margin-top:4px;">120 V ✓</div>
        </div>
    </div>
</div>

<div class="eyebrow">Tendencia kWh / Voltaje</div>

<div class="chart-card" style="margin-top:0;">
    <div class="bar-chart" id="barChart">
        <div class="bar" data-6m="40" data-31d="55" data-lecturas="30"><span>Mar</span></div>
        <div class="bar" data-6m="62" data-31d="35" data-lecturas="70"><span>Abr</span></div>
        <div class="bar" data-6m="48" data-31d="80" data-lecturas="45"><span>May</span></div>
        <div class="bar" data-6m="75" data-31d="42" data-lecturas="60"><span>Jun</span></div>
        <div class="bar" data-6m="55" data-31d="90" data-lecturas="38"><span>Jul</span></div>
        <div class="bar hi" data-6m="95" data-31d="65" data-lecturas="85"><span>Ago</span></div>
    </div>

    <div class="chart-tabs">
        <button type="button" class="chart-tab active" data-mode="6m">Últimos 6 meses</button>
        <button type="button" class="chart-tab" data-mode="31d">31 días</button>
        <button type="button" class="chart-tab" data-mode="lecturas">Lecturas</button>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        var tabs = document.querySelectorAll('.chart-tab');
        var bars = document.querySelectorAll('#barChart .bar');

        function aplicarModo(modo) {
            for (var i = 0; i < bars.length; i++) {
                var bar = bars[i];
                var v = parseInt(bar.getAttribute('data-' + modo), 10);
                if (isNaN(v)) v = 0;
                bar.style.height = v + '%';
            }
        }

        for (var i = 0; i < tabs.length; i++) {
            tabs[i].addEventListener('click', function () {
                for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
                this.classList.add('active');
                aplicarModo(this.getAttribute('data-mode'));
            });
        }

        aplicarModo('6m');
    })();
    </script>
}