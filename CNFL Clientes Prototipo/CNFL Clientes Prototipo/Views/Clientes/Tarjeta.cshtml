@model dynamic

@{
    ViewBag.Title = "Pago Tarjeta - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    var facturaId = ViewBag.FacturaId ?? Request.QueryString["facturaId"] ?? "0";
    var monto = ViewBag.Monto ?? Request.QueryString["monto"] ?? "0";
}

<link rel="stylesheet" href="@Url.Content("~/Content/cliente/pagos.css")" />

<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<div class="section-pad">
    <div class="h-name-2" data-i18n="pago_tarjeta">Pago con Tarjeta</div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;">
        <span data-i18n="producto_factura">Producto/Factura:</span> Factura #@facturaId
    </div>
</div>

<div class="section-pad">
    <div class="pago-card" style="text-align:center;">
        <div style="font-size:20px; font-weight:800; color:var(--orange);">₡ @monto</div>
        <div style="font-size:13px; color:var(--muted); margin-top:4px;" data-i18n="monto_pagar">Monto a pagar</div>

        <hr style="border-color:var(--line); margin:16px 0;" />

        <div style="display:flex; flex-direction:column; gap:14px; text-align:left;">
            <div>
                <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="numero_tarjeta">Número de tarjeta</label>
                <input type="text" placeholder="1234 5678 9012 3456" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" />
            </div>
            <div style="display:flex; gap:12px;">
                <div style="flex:1;">
                    <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="fecha_expiracion">Fecha expiración</label>
                    <input type="text" placeholder="MM/AA" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" />
                </div>
                <div style="flex:0 0 100px;">
                    <label style="font-weight:700; font-size:13px; color:var(--muted);" data-i18n="cw">CVV</label>
                    <input type="text" placeholder="123" style="width:100%; padding:10px 14px; border:1.5px solid var(--line); border-radius:12px; font-family:inherit; font-size:14px; margin-top:4px;" />
                </div>
            </div>
        </div>

        <input type="hidden" id="facturaId" value="@facturaId" />

        <button class="btn-cta" style="width:100%; margin-top:16px;" onclick="confirmarPago('Tarjeta', @facturaId)">
            <span data-i18n="pagar">Pagar</span> ₡@monto
        </button>
    </div>
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/pagos.js")"></script>
}