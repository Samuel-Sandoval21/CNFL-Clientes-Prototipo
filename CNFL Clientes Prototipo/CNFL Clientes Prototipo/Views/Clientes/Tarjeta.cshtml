@model dynamic

@{
    ViewBag.Title = "Pago Tarjeta - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    var facturaId = ViewBag.FacturaId ?? Request.QueryString["facturaId"] ?? "0";
    var monto = ViewBag.Monto ?? Request.QueryString["monto"] ?? "0";
}

<!-- Estilos -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/pagos.css")" />
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/tarjeta.css")" />

<!-- Botón Volver -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<!-- Encabezado -->
<div class="section-pad">
    <div class="h-name-2" data-i18n="pago_tarjeta">
        <i class="fas fa-credit-card" style="color:var(--orange);"></i> Pago con Tarjeta
    </div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;">
        <span data-i18n="producto_factura">Producto/Factura:</span> Factura #@facturaId
    </div>
</div>

<!-- Contenido Principal -->
<div class="section-pad">
    <div class="pago-card" style="text-align:center;">
        <!-- Monto -->
        <div style="font-size:20px; font-weight:800; color:var(--orange);" class="monto-pagar">₡ @monto</div>
        <div style="font-size:13px; color:var(--muted); margin-top:4px;" data-i18n="monto_pagar">Monto a pagar</div>

        <hr style="border-color:var(--line); margin:16px 0;" />

        <!-- Campos de Tarjeta -->
        <div class="tarjeta-campos">
            <!-- Número de Tarjeta -->
            <div class="campo">
                <label data-i18n="numero_tarjeta">Número de tarjeta</label>
                <div class="input-wrapper">
                    <input type="text" id="numeroTarjeta" class="tarjeta-input" placeholder="1234 5678 9012 3456" value="4532 1234 5678 9012" maxlength="16" />
                    <span class="icono">💳</span>
                </div>
            </div>

            <!-- Fila: Fecha + CVV -->
            <div class="campo-row">
                <div class="campo">
                    <label data-i18n="fecha_expiracion">Fecha expiración</label>
                    <input type="text" id="fechaExpiracion" class="tarjeta-input" placeholder="MM/AA" value="12/26" maxlength="5" />
                </div>
                <div class="campo-cvv">
                    <label data-i18n="cw">CVV</label>
                    <input type="text" id="cvvTarjeta" class="tarjeta-input" placeholder="123" value="***" maxlength="3" />
                </div>
            </div>
        </div>

        <input type="hidden" id="facturaId" value="@facturaId" />

        <!-- Botón -->
        <button class="btn-tarjeta btn-pagar" id="btnPagarTarjeta">
            <i class="fas fa-lock"></i>
            <span data-i18n="pagar">Pagar</span> ₡@monto
        </button>

        <!-- Seguridad -->
        <div style="margin-top:12px; font-size:12px; color:var(--muted);">
            <i class="fas fa-lock" style="margin-right:4px;"></i> Pagos seguros con cifrado SSL
        </div>
    </div>
</div>

<!-- Scripts -->
@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/pagos.js")"></script>
    <script src="@Url.Content("~/Scripts/cliente/tarjeta.js")"></script>
}