@{
    ViewBag.Title = "Reportar Avería";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var tipo = ViewBag.Tipo as string ?? "";
}

@section Styles {
    <style>
        .rv-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .rv-back:hover {
                text-decoration: underline;
            }

        .rv-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .rv-header .rv-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        .rv-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 22px 20px;
            margin-top: 20px;
            box-shadow: var(--shadow-sm);
        }

            .rv-card .ico-big {
                width: 64px;
                height: 64px;
                border-radius: 20px;
                background: #fdecea;
                display: grid;
                place-items: center;
                font-size: 30px;
                margin-bottom: 14px;
            }

            .rv-card .tipo-nombre {
                font-size: 18px;
                font-weight: 800;
                color: var(--ink);
                margin-bottom: 6px;
            }

            .rv-card .tipo-desc {
                font-size: 13px;
                color: var(--muted);
                line-height: 1.6;
                margin-bottom: 18px;
            }

        .rv-field {
            margin-bottom: 14px;
        }

        .rv-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .rv-input, .rv-textarea, .rv-select {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 13px 15px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: #fff;
            transition: border-color .15s;
        }

            .rv-input:focus, .rv-textarea:focus, .rv-select:focus {
                border-color: var(--blue);
            }

        .rv-textarea {
            resize: vertical;
            min-height: 90px;
        }

        .rv-btn {
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            margin-top: 8px;
            cursor: pointer;
            transition: transform .12s;
        }

            .rv-btn:active {
                transform: scale(.97);
            }

        .rv-btn-sec {
            width: 100%;
            background: #fff;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 14px;
            border-radius: 14px;
            margin-top: 10px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .rv-btn-sec:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--blue);
            }

        .rv-alert {
            background: #eef0ff;
            color: var(--blue);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 12.5px;
            font-weight: 700;
            margin-bottom: 14px;
        }
    </style>
}

<div class="rv-header" style="text-align:left;">
    <a href="@Url.Action("TiposReportes", "Clientes")" class="rv-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a tipos
    </a>
    <h1>Reportar avería</h1>
    <div class="rv-sub">Completá los datos para que un operador atienda tu reporte.</div>
</div>

@using (Html.BeginForm("ReportarAveria", "Clientes", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="rv-card">
        <div class="ico-big">⚡</div>

        @if (!string.IsNullOrEmpty(tipo))
        {
            <div class="rv-alert">Tipo seleccionado: <b>@tipo</b></div>
            <input type="hidden" name="Tipo" value="@tipo" />
        }

        <div class="tipo-nombre">@(string.IsNullOrEmpty(tipo) ? "Nueva avería" : tipo)</div>
        <div class="tipo-desc">
            Reportá el problema con la mayor cantidad de detalle posible. Un operador lo revisará y te notificará cuando esté en camino.
        </div>

        <div class="rv-field">
            <label class="rv-label">NÚMERO DE NISE</label>
            <input type="text" name="NISE" class="rv-input" placeholder="Ej: 123456789" required />
        </div>

        <div class="rv-field">
            <label class="rv-label">DIRECCIÓN</label>
            <input type="text" name="Direccion" class="rv-input" placeholder="Ej: San José, Avenida 5" required />
        </div>

        <div class="rv-field">
            <label class="rv-label">DESCRIPCIÓN</label>
            <textarea name="Descripcion" class="rv-textarea" placeholder="Describí brevemente el problema..."></textarea>
        </div>

        <button type="submit" class="rv-btn">Enviar reporte</button>
        <a href="@Url.Action("TiposReportes", "Clientes")" class="rv-btn-sec">Cancelar</a>
    </div>
}