@model CNFL_Clientes_Prototipo.Models.Factura

@{
    ViewBag.Title = "Detalle de Factura - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- CSS externo para Pagos -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/pagos.css")" />

<!-- ===== BOTÓN VOLVER ===== -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> Volver
</button>

<div class="section-pad">
    <div class="h-name-2">
        <i class="fas fa-file-invoice" style="color:var(--blue);"></i> Detalle de Factura
    </div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;">
        Revisa la información completa de tu factura.
    </div>
</div>

<div class="section-pad">
    @if (Model != null)
    {
        <div class="pago-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div>
                    <div class="pago-titulo">Factura @Model.Periodo</div>
                    <div class="pago-monto">₡ @Model.Monto.ToString("N0")</div>
                </div>
                <span class="pago-estado @(Model.Estado == "Pagada" ? "pagada" : "pendiente")">
                    @Model.Estado
                </span>
            </div>

            <hr style="border-color:var(--line); margin:14px 0;" />

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                <div><strong>NISE</strong><br /><span style="color:var(--muted);">4021</span></div>
                <div><strong>Tarifa</strong><br /><span style="color:var(--muted);">Residencial</span></div>
                <div><strong>Consumo</strong><br /><span style="color:var(--muted);">387 kWh</span></div>
                <div><strong>Vencimiento</strong><br /><span style="color:var(--muted);">28 de agosto</span></div>
            </div>

            @if (Model.Estado == "Pendiente")
            {
                <hr style="border-color:var(--line); margin:14px 0;" />

                <div style="text-align:center; margin-top:8px;">
                    <p style="font-weight:600; margin-bottom:12px;">¿Deseas pagar esta factura ahora?</p>
                    <div class="pago-metodos">
                        <button class="sinpe" onclick="window.location.href='/Clientes/Sinpe?monto=@Model.Monto'">
                            <i class="fas fa-mobile-alt"></i> SINPE Móvil
                        </button>
                        <button class="iban" onclick="window.location.href='/Clientes/Iban?monto=@Model.Monto'">
                            <i class="fas fa-university"></i> IBAN
                        </button>
                        <button class="tarjeta" onclick="window.location.href='/Clientes/Tarjeta?monto=@Model.Monto'">
                            <i class="fas fa-credit-card"></i> Tarjeta
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-pagos">
            <div class="empty-icon">📄</div>
            <h3>Factura no encontrada</h3>
            <p>La factura que buscas no existe o ha sido eliminada.</p>
        </div>
    }
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/pagos.js")"></script>
}