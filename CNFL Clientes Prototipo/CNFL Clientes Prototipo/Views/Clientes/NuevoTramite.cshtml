@{
    ViewBag.Title = "Nuevo Trámite";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="nuevo-tramite-container">
    <h2>Nuevo Trámite</h2>
    <p>Selecciona el tipo de trámite que deseas realizar.</p>

    <div class="tramite-opciones">
        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Cambio de nombre de abonado" })" class="tramite-opcion">
            <div class="opcion-icon">📝</div>
            <h3>Cambio de nombre de abonado</h3>
            <p>Actualiza el titular del servicio eléctrico.</p>
        </a>

        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Desconexión y reconexión" })" class="tramite-opcion">
            <div class="opcion-icon">🔌</div>
            <h3>Desconexión y reconexión</h3>
            <p>Solicita desconexión o reconexión del servicio.</p>
        </a>

        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Solicitud de servicio nuevo" })" class="tramite-opcion">
            <div class="opcion-icon">⚡</div>
            <h3>Solicitud de servicio nuevo</h3>
            <p>Solicita un nuevo servicio eléctrico.</p>
        </a>

        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Traslado de medidor" })" class="tramite-opcion">
            <div class="opcion-icon">📦</div>
            <h3>Traslado de medidor</h3>
            <p>Solicita el traslado de tu medidor eléctrico.</p>
        </a>

        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Traspaso de servicio eléctrico" })" class="tramite-opcion">
            <div class="opcion-icon">🔄</div>
            <h3>Traspaso de servicio eléctrico</h3>
            <p>Traspasa el servicio a otra persona.</p>
        </a>

        <a href="@Url.Action("SolicitarTramite", "Clientes", new { tipo = "Tarifa residencial horaria" })" class="tramite-opcion">
            <div class="opcion-icon">⏰</div>
            <h3>Tarifa residencial horaria</h3>
            <p>Solicita cambio a tarifa horaria.</p>
        </a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/nuevo-tramite.css" />
}