@{
    ViewBag.Title = "Mapa de Averías";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet Locate Control CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet.locatecontrol@0.79.0/dist/L.Control.Locate.min.css" />
    <!-- Leaflet Geocoder (búsqueda) CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder@2.4.0/dist/Control.Geocoder.css" />

    <style>
        .ma-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .ma-back:hover {
                text-decoration: underline;
            }

        .ma-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .ma-header .ma-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        #mapa-real {
            height: 420px;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--line);
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
            z-index: 1;
        }

        /* Pines personalizados */
        .pin-custom {
            width: 32px;
            height: 32px;
            border-radius: 50% 50% 50% 2px;
            transform: rotate(45deg);
            display: grid;
            place-items: center;
            box-shadow: 0 4px 8px rgba(0,0,0,.25);
        }

            .pin-custom span {
                transform: rotate(-45deg);
                font-size: 15px;
            }

        .pin-rojo .pin-custom {
            background: #e74c3c;
        }

        .pin-ambar .pin-custom {
            background: #f0a020;
        }

        .pin-verde .pin-custom {
            background: #2f8f3e;
        }

        /* Popup de Leaflet */
        .leaflet-popup-content-wrapper {
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,.2);
        }

        .leaflet-popup-content {
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: var(--ink);
            margin: 10px 14px;
            line-height: 1.5;
        }

            .leaflet-popup-content b {
                color: var(--blue);
            }

            .leaflet-popup-content .estado-badge {
                display: inline-block;
                font-size: 10.5px;
                font-weight: 800;
                padding: 3px 8px;
                border-radius: 999px;
                margin-top: 4px;
            }

        .estado-en-revision {
            background: #fdecea;
            color: #d33;
        }

        .estado-en-camino {
            background: #fef3e0;
            color: #b9791a;
        }

        .estado-resuelto {
            background: #e9f7ec;
            color: #2f8f3e;
        }

        .ma-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 12px 16px;
            box-shadow: var(--shadow-sm);
        }

            .ma-legend .lg {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 12px;
                font-weight: 700;
                color: var(--ink);
            }

            .ma-legend .dot {
                width: 12px;
                height: 12px;
                border-radius: 50%;
            }

                .ma-legend .dot.rojo {
                    background: #e74c3c;
                }

                .ma-legend .dot.ambar {
                    background: #f0a020;
                }

                .ma-legend .dot.verde {
                    background: #2f8f3e;
                }

        /* Contador de pines */
        .ma-count {
            font-size: 12px;
            color: var(--muted);
            margin-top: 10px;
            text-align: center;
        }

            .ma-count b {
                color: var(--blue);
                font-weight: 800;
            }
    </style>
}

<div class="ma-header" style="text-align:left;">
    <a href="@Url.Action("Reportes", "Clientes")" class="ma-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a Reportes
    </a>
    <h1>Mapa de averías</h1>
    <div class="ma-sub">Reportes en tiempo real sobre la red eléctrica.</div>
</div>

<div id="mapa-real"></div>

<div class="ma-legend">
    <div class="lg"><span class="dot rojo"></span> En revisión</div>
    <div class="lg"><span class="dot ambar"></span> Operador en camino</div>
    <div class="lg"><span class="dot verde"></span> Resuelto</div>
</div>

<div class="ma-count" id="contador">
    Cargando averías...
</div>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Leaflet Locate (geolocalización) -->
    <script src="https://unpkg.com/leaflet.locatecontrol@0.79.0/dist/L.Control.Locate.min.js"></script>
    <!-- Leaflet Geocoder (búsqueda de direcciones) -->
    <script src="https://unpkg.com/leaflet-control-geocoder@2.4.0/dist/Control.Geocoder.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ============================================================
            // 1. INICIALIZAR EL MAPA (centrado en San José, Costa Rica)
            // ============================================================
            var map = L.map('mapa-real', {
                zoomControl: true,
                scrollWheelZoom: true
            }).setView([9.9333, -84.0833], 11);

            // ============================================================
            // 2. CAPA DE TILES — OpenStreetMap (callejero)
            // ============================================================
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Capa satelital alternativa (descomentá si preferís)
            /*
            L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: 'Tiles &copy; Esri'
            }).addTo(map);
            */

            // ============================================================
            // 3. BOTÓN DE GEOLOCALIZACIÓN
            // ============================================================
            L.control.locate({
                position: 'topright',
                strings: { title: 'Mi ubicación' },
                locateOptions: {
                    enableHighAccuracy: true,
                    maxZoom: 16
                },
                flyTo: true,
                showPopup: false,
                markerStyle: {
                    radius: 8,
                    color: '#2a4fd6',
                    fillColor: '#4a7cff',
                    fillOpacity: 0.5
                }
            }).addTo(map);

            // ============================================================
            // 4. BUSCADOR DE DIRECCIONES
            // ============================================================
            L.Control.geocoder({
                defaultMarkGeocode: false,
                position: 'topright',
                placeholder: 'Buscar dirección...',
                errorMessage: 'No se encontró la dirección.'
            })
            .on('markgeocode', function (e) {
                var center = e.geocode.center;
                map.setView(center, 15);
                L.marker(center).addTo(map)
                    .bindPopup('<b>' + e.geocode.name + '</b>')
                    .openPopup();
            })
            .addTo(map);

            // ============================================================
            // 5. CARGAR AVERÍAS DESDE EL BACKEND
            // ============================================================
            var markerLayer = L.layerGroup().addTo(map);

            fetch('@Url.Action("MapaAveriasData", "Clientes")')
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (!res.success) {
                        document.getElementById('contador').innerText = 'No se pudieron cargar las averías.';
                        return;
                    }

                    var averias = res.data || [];
                    var bounds = [];

                    averias.forEach(function (a) {
                        var clase = getClasePorEstado(a.estado);
                        var iconoHtml = '<div class="pin-custom ' + clase + '"><span>⚡</span></div>';

                        var customIcon = L.divIcon({
                            html: iconoHtml,
                            className: '',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32],
                            popupAnchor: [0, -32]
                        });

                        var marker = L.marker([a.latitud, a.longitud], { icon: customIcon });

                        marker.bindPopup(
                            '<b>' + a.titulo + '</b><br>' +
                            '🔧 ' + a.tipo + '<br>' +
                            '📍 ' + a.direccion + '<br>' +
                            '🔌 NISE ' + a.niseNumero + '<br>' +
                            '<span class="estado-badge ' + getClaseBadge(a.estado) + '">' + a.estado + '</span>'
                        );

                        markerLayer.addLayer(marker);
                        bounds.push([a.latitud, a.longitud]);
                    });

                    // Ajustar el mapa para mostrar todos los pines
                    if (bounds.length > 0) {
                        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
                    }

                    document.getElementById('contador').innerHTML =
                        'Mostrando <b>' + averias.length + '</b> avería' + (averias.length === 1 ? '' : 's') + ' en el mapa';
                })
                .catch(function () {
                    document.getElementById('contador').innerText = 'Error al cargar el mapa. Intentá de nuevo.';
                });

            // ============================================================
            // HELPERS
            // ============================================================
            function getClasePorEstado(estado) {
                var e = (estado || '').toLowerCase();
                if (e.indexOf('resuelto') !== -1 || e.indexOf('problema resuelto') !== -1) return 'pin-verde';
                if (e.indexOf('camino') !== -1 || e.indexOf('operador') !== -1) return 'pin-ambar';
                return 'pin-rojo'; // En revisión, Ingresado, otros
            }

            function getClaseBadge(estado) {
                var e = (estado || '').toLowerCase();
                if (e.indexOf('resuelto') !== -1) return 'estado-resuelto';
                if (e.indexOf('camino') !== -1) return 'estado-en-camino';
                return 'estado-en-revision';
            }
        });
    </script>
}