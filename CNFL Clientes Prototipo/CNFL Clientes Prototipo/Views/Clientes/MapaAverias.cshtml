@{
    ViewBag.Title = "Mapa de Averías";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .ma-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .ma-back:hover {
                text-decoration: underline;
            }

        .ma-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .ma-header .ma-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        .ma-map {
            height: 320px;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            background: linear-gradient(135deg, #e7f0e9, #dfeaf0);
            border: 1px solid var(--line);
            margin-top: 16px;
        }

            .ma-map .road {
                position: absolute;
                background: #fff;
            }

                .ma-map .road.h {
                    height: 6px;
                    left: 0;
                    right: 0;
                }

                .ma-map .road.v {
                    width: 6px;
                    top: 0;
                    bottom: 0;
                }

        .pin {
            position: absolute;
            transform: translate(-50%, -100%);
            cursor: pointer;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,.25));
            transition: transform .15s;
        }

            .pin:hover {
                transform: translate(-50%, -100%) scale(1.15);
            }

            .pin .p {
                width: 32px;
                height: 32px;
                border-radius: 50% 50% 50% 2px;
                transform: rotate(45deg);
                display: grid;
                place-items: center;
            }

                .pin .p span {
                    transform: rotate(-45deg);
                    font-size: 15px;
                }

            .pin.rojo .p {
                background: #e74c3c;
            }

            .pin.ambar .p {
                background: #f0a020;
            }

            .pin.verde .p {
                background: #2f8f3e;
            }

        .ma-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 12px 16px;
            box-shadow: var(--shadow-sm);
        }

            .ma-legend .lg {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 12px;
                font-weight: 700;
                color: var(--ink);
            }

            .ma-legend .dot {
                width: 12px;
                height: 12px;
                border-radius: 50%;
            }

                .ma-legend .dot.rojo {
                    background: #e74c3c;
                }

                .ma-legend .dot.ambar {
                    background: #f0a020;
                }

                .ma-legend .dot.verde {
                    background: #2f8f3e;
                }

        .ma-info {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            margin-top: 14px;
            box-shadow: var(--shadow-sm);
            display: none;
        }

            .ma-info .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                margin-bottom: 4px;
            }

            .ma-info .s {
                font-size: 12.5px;
                color: var(--muted);
                line-height: 1.5;
            }
    </style>
}

<div class="ma-header" style="text-align:left;">
    <a href="@Url.Action("Reportes", "Clientes")" class="ma-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a Reportes
    </a>
    <h1>Mapa de averías</h1>
    <div class="ma-sub">Tocá un pin para ver el detalle de la avería reportada.</div>
</div>

<div class="ma-map" id="mapa">
    <!-- Calles simuladas -->
    <div class="road h" style="top:30%"></div>
    <div class="road h" style="top:65%"></div>
    <div class="road v" style="left:25%"></div>
    <div class="road v" style="left:70%"></div>

    <!-- Pines -->
    <div class="pin rojo" style="top:32%; left:26%;" onclick="verPin('Avería #10234','Poste caído — En revisión','San José Centro')">
        <div class="p"><span>⚡</span></div>
    </div>
    <div class="pin ambar" style="top:67%; left:71%;" onclick="verPin('Avería #10235','Transformador dañado — Operador en camino','Alajuela')">
        <div class="p"><span>🔌</span></div>
    </div>
    <div class="pin verde" style="top:50%; left:50%;" onclick="verPin('Avería #10236','Problema resuelto','Cartago')">
        <div class="p"><span>✅</span></div>
    </div>
    <div class="pin rojo" style="top:80%; left:30%;" onclick="verPin('Avería #10237','Cable cortado — En revisión','Heredia')">
        <div class="p"><span>⚡</span></div>
    </div>
</div>

<div class="ma-legend">
    <div class="lg"><span class="dot rojo"></span> En revisión</div>
    <div class="lg"><span class="dot ambar"></span> Operador en camino</div>
    <div class="lg"><span class="dot verde"></span> Resuelto</div>
</div>

<div class="ma-info" id="infoPin">
    <div class="t" id="infoTitulo"></div>
    <div class="s" id="infoSub"></div>
</div>

@section Scripts {
    <script>
        function verPin(titulo, estado, zona) {
            var box = document.getElementById('infoPin');
            document.getElementById('infoTitulo').innerText = titulo + ' — ' + zona;
            document.getElementById('infoSub').innerText = estado;
            box.style.display = 'block';
        }
    </script>
}