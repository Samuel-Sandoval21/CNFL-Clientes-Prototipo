@{
    ViewBag.Title = "Asistente Virtual";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="chat-container">
    <h2>Asistente Virtual CNFL</h2>
    <p>¿En qué puedo ayudarte hoy?</p>

    <div class="chat-box" id="chatBox">
        <div class="chat-message bot">
            <span class="chat-avatar">🤖</span>
            <span class="chat-text">¡Hola! Soy el asistente virtual de CNFL. ¿Cómo puedo ayudarte?</span>
        </div>
        <div class="chat-message bot">
            <span class="chat-avatar">🤖</span>
            <span class="chat-text">Puedo ayudarte con: facturas, averías, trámites o información general.</span>
        </div>
    </div>

    <div class="chat-input">
        <input type="text" id="chatInput" placeholder="Escribe tu consulta..." />
        <button id="chatSendBtn">Enviar</button>
    </div>

    <div class="chat-quick-actions">
        <button class="quick-btn" data-mensaje="Ver mi factura">Ver mi factura</button>
        <button class="quick-btn" data-mensaje="Reportar avería">Reportar avería</button>
        <button class="quick-btn" data-mensaje="Estado de mi trámite">Estado de mi trámite</button>
        <button class="quick-btn" data-mensaje="Contactar agente">Contactar agente</button>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/chat.css" />
}

@section Scripts {
    <script src="~/Scripts/cliente/chat.js"></script>
}