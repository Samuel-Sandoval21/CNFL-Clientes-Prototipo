@{
    ViewBag.Title = "Reportar Alumbrado";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="reportar-container">
    <h2>Reportar Alumbrado Público</h2>
    <p>Complete el formulario para reportar problemas de alumbrado en su comunidad.</p>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert-success">✅ @ViewBag.Mensaje</div>
    }

    @using (Html.BeginForm("ReportarAlumbrado", "Clientes", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="reportar-card">
            <div class="form-group">
                <label>Tipo de falla *</label>
                @Html.DropDownList("Tipo", new List<SelectListItem>
                {
                    new SelectListItem { Text = "Lámpara apagada", Value = "Lámpara apagada" },
                    new SelectListItem { Text = "Poste dañado", Value = "Poste dañado" },
                    new SelectListItem { Text = "Cable suelto", Value = "Cable suelto" },
                    new SelectListItem { Text = "Otro", Value = "Otro" }
                }, "Seleccione un tipo", new { @class = "form-control" })
            </div>

            <div class="form-group">
                <label>Dirección *</label>
                <input type="text" name="Direccion" class="form-control" placeholder="Calle, barrio, referencia..." />
            </div>

            <div class="form-group">
                <label>Descripción</label>
                <textarea name="Descripcion" class="form-control" rows="4" placeholder="Detalle adicional..."></textarea>
            </div>

            <div class="form-group">
                <label>Adjuntar foto (opcional)</label>
                <input type="file" name="foto" class="form-control" accept="image/*" />
            </div>

            <button type="submit" class="btn-enviar">Enviar Reporte</button>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/reportes.css" />
}
