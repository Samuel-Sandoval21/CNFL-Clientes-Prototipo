@model List<CNFL_Clientes_Prototipo.Models.Factura>

@{
    ViewBag.Title = "Mis Pagos";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="pagos-container">
    <h2>Mis Pagos</h2>
    <p>Historial de pagos realizados.</p>

    @if (Model != null && Model.Any())
    {
        <table class="pagos-table">
            <thead>
                <tr>
                    <th>Factura</th>
                    <th>NISE</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in Model)
                {
                    <tr>
                        <td>@factura.NumeroFactura</td>
                        <td>@factura.NISE.NumeroNise</td>
                        <td>₡@factura.Monto.ToString("N0")</td>
                        <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (factura.Pagada)
                            {
                                <span class="estado-pagado">Pagada</span>
                            }
                            else
                            {
                                <span class="estado-pendiente">Pendiente</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay pagos registrados.</p>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/pagos.css" />
}