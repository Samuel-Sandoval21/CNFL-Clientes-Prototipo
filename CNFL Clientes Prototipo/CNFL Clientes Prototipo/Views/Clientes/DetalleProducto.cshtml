@{
    ViewBag.Title = ViewBag.Titulo ?? "Producto";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var categoriaId = ViewBag.CategoriaId as string ?? "tienda";
    var titulo = ViewBag.Titulo as string ?? "Producto";
    var subtitulo = ViewBag.Subtitulo as string ?? "";
    var productos = ViewBag.Productos as List<CNFL_Clientes_Prototipo.Models.ProductoTiendaDto>
                    ?? new List<CNFL_Clientes_Prototipo.Models.ProductoTiendaDto>();
}

@section Styles {
    <style>
        .dp-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .dp-back:hover {
                text-decoration: underline;
            }

        .dp-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 20px;
            padding: 18px 18px;
            color: #fff;
            box-shadow: 0 10px 24px -12px rgba(16,20,60,.45);
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

            .dp-hero::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 160px;
                height: 160px;
                background: radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
            }

            .dp-hero .ico-big {
                font-size: 34px;
                margin-bottom: 6px;
                position: relative;
                z-index: 2;
            }

            .dp-hero h1 {
                margin: 0;
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -.02em;
                position: relative;
                z-index: 2;
            }

            .dp-hero p {
                margin: 4px 0 0;
                font-size: 12px;
                opacity: .9;
                line-height: 1.4;
                position: relative;
                z-index: 2;
            }

        .dp-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .dp-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .dp-item .ico {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                font-size: 20px;
                flex-shrink: 0;
                background: #eef0ff;
            }

            .dp-item .body {
                flex: 1;
                min-width: 0;
            }

            .dp-item .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .dp-item .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }

            .dp-item .precio {
                font-size: 14px;
                font-weight: 800;
                color: var(--blue);
                margin-top: 6px;
            }

                .dp-item .precio.consultar {
                    color: #b9791a;
                    font-size: 13px;
                }

            .dp-item .btn-add {
                background: linear-gradient(135deg, var(--orange), #ff8a5c);
                color: #fff;
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 11.5px;
                padding: 9px 14px;
                border-radius: 10px;
                cursor: pointer;
                transition: transform .12s;
                white-space: nowrap;
                box-shadow: 0 6px 12px -6px rgba(255,105,45,.6);
            }

                .dp-item .btn-add:active {
                    transform: scale(.94);
                }

                .dp-item .btn-add.consultar {
                    background: linear-gradient(135deg, var(--blue), #2a4fd6);
                    box-shadow: 0 6px 12px -6px rgba(30,35,230,.5);
                }

                .dp-item .btn-add:disabled {
                    opacity: .7;
                    cursor: not-allowed;
                }

        .dp-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .dp-empty .e {
                font-size: 40px;
                margin-bottom: 10px;
            }

            .dp-empty .t {
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
            }

            .dp-empty .s {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 5px;
                line-height: 1.5;
            }
    </style>
}

<a href="@Url.Action("Tienda", "Clientes")" class="dp-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver a la tienda
</a>

<div class="dp-hero">
    <div class="ico-big">🛍️</div>
    <h1>@titulo</h1>
    <p>@subtitulo</p>
</div>

@if (productos.Any())
{
    <div class="dp-list">
        @foreach (var p in productos)
        {
            var consultar = p.Precio == 0;
            <div class="dp-item">
                <div class="ico">@p.Icono</div>
                <div class="body">
                    <div class="t">@p.Nombre</div>
                    <div class="s">@p.Descripcion</div>
                    @if (consultar)
                    {
                        <div class="precio consultar">Consultar precio</div>
                    }
                    else
                    {
                        <div class="precio">₡@p.Precio.ToString("N0")</div>
                    }
                </div>
                <button type="button"
                        class="btn-add @(consultar ? "consultar" : "")"
                        data-id="@p.Id"
                        data-nombre="@p.Nombre"
                        data-descripcion="@p.Descripcion"
                        data-precio="@p.Precio"
                        data-icono="@p.Icono"
                        onclick="agregarAlCarrito(this)">
                    @(consultar ? "Cotizar" : "🛒 Agregar")
                </button>
            </div>
        }
    </div>
}
else
{
    <div class="dp-empty">
        <div class="e">🔍</div>
        <div class="t">Productos próximamente</div>
        <div class="s">Estamos trabajando en esta categoría. Volvé pronto.</div>
    </div>
}

@section Scripts {
    <script>
        function agregarAlCarrito(btn) {
            var productoId = btn.getAttribute('data-id');
            var nombre = btn.getAttribute('data-nombre');
            var descripcion = btn.getAttribute('data-descripcion');
            var precio = parseFloat(btn.getAttribute('data-precio')) || 0;
            var imagen = btn.getAttribute('data-icono') || '🛍️';

            if (precio === 0) {
                alert('Este producto requiere cotización. Un asesor te contactará.');
                return;
            }

            var textoOriginal = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '...';

            fetch('@Url.Action("Agregar", "Carrito")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'productoId=' + encodeURIComponent(productoId) +
                      '&nombre=' + encodeURIComponent(nombre) +
                      '&descripcion=' + encodeURIComponent(descripcion) +
                      '&precio=' + precio +
                      '&imagen=' + encodeURIComponent(imagen)
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    var badge = document.getElementById('cnflCartBadge');
                    if (badge) {
                        badge.textContent = data.totalItems;
                        badge.style.display = 'inline-block';
                    }
                    btn.innerHTML = '✅ Agregado';
                    btn.style.background = 'linear-gradient(135deg, #2f8f3e, #4ac265)';
                    setTimeout(function () {
                        btn.innerHTML = textoOriginal;
                        btn.style.background = '';
                        btn.disabled = false;
                    }, 1500);
                } else {
                    alert('❌ ' + data.message);
                    btn.innerHTML = textoOriginal;
                    btn.disabled = false;
                }
            })
            .catch(function () {
                alert('Error al agregar al carrito.');
                btn.innerHTML = textoOriginal;
                btn.disabled = false;
            });
        }
    </script>
}