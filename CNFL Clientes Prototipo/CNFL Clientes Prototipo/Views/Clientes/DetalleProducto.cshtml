    var subtitulo = ViewBag.Subtitulo as string ?? "";
}

@section Styles {
    <style>
        .dp-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .dp-back:hover {
                text-decoration: underline;
            }

        .dp-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 20px;
            padding: 18px 18px;
            color: #fff;
            box-shadow: 0 10px 24px -12px rgba(16,20,60,.45);
            margin-top: 8px;
        }

            .dp-hero h1 {
                margin: 0;
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .dp-hero p {
                margin: 4px 0 0;
                font-size: 12px;
                opacity: .9;
                line-height: 1.4;
            }

        .dp-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .dp-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: 14px;
        }

            .dp-item .ico {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                font-size: 20px;
                flex-shrink: 0;
                background: #eef0ff;
            }

            .dp-item .body {
                flex: 1;
                min-width: 0;
            }

            .dp-item .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .dp-item .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }

            .dp-item .precio {
                font-size: 14px;
                font-weight: 800;
                color: var(--blue);
                margin-top: 6px;
            }

            .dp-item .btn-sol {
                background: var(--blue);
                color: #fff;
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 11.5px;
                padding: 8px 14px;
                border-radius: 10px;
                cursor: pointer;
                transition: transform .12s;
                white-space: nowrap;
            }

                .dp-item .btn-sol:active {
                    transform: scale(.94);
                }

        .dp-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .dp-empty .e {
                font-size: 40px;
                margin-bottom: 10px;
            }

            .dp-empty .t {
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
            }

            .dp-empty .s {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 5px;
                line-height: 1.5;
            }
    </style>
}

