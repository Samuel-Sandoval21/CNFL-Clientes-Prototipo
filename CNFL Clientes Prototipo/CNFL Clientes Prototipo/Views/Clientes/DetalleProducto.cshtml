@{
    ViewBag.Title = "Detalle del producto";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    var productoId = ViewBag.ProductoId as int? ?? 0;
}

<div class="appbar">
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Producto</div>
    <div style="width:40px;"></div>
</div>

<div class="card" style="padding:0; overflow:hidden;">
    <div style="height:180px; display:grid; place-items:center; background:linear-gradient(135deg, #eef6ff, #eef0ff); font-size:72px;">❄️</div>
    <div style="padding:18px;">
        <div style="font-size:18px; font-weight:800; color:var(--ink); line-height:1.3;">
            Aire acondicionado Inverter 12.000 BTU
        </div>
        <div style="font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5;">
            Eficiencia A+++ · WiFi integrado · Bajo consumo · Garantía 3 años
        </div>
        <div style="font-size:26px; font-weight:800; color:var(--orange); margin-top:14px;">₡289.000</div>
        <div style="font-size:11.5px; color:var(--muted); margin-top:4px;">
            o 12 cuotas de ₡24.083 sin intereses
        </div>
    </div>
</div>

<button type="button" class="btn btn-cta" style="width:100%; padding:17px; margin-top:18px; font-size:15px;"
        onclick="agregarYVolver();">
    🛒 Agregar al carrito
</button>

<button type="button" class="btn btn-line" style="width:100%; padding:16px; margin-top:10px; font-size:14px;"
        onclick="alert('Este producto se puede pagar cargándolo a tu factura eléctrica.');">
    💡 Cargar a factura
</button>

@section Scripts {
    <script>
    function agregarYVolver() {
        var STORAGE_KEY = 'cnfl_carrito';
        var carrito = [];
        try { carrito = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (e) { carrito = []; }

        carrito.push({
            nombre: 'Aire acondicionado Inverter 12.000 BTU',
            precio: 289000,
            cantidad: 1,
            emoji: '❄️'
        });

        localStorage.setItem(STORAGE_KEY, JSON.stringify(carrito));

        if (confirm('Producto agregado al carrito.\n¿Ir al carrito ahora?')) {
            window.location.href = '@Url.Action("Tienda", "Clientes")';
        } else {
            window.history.back();
        }
    }
    </script>
}