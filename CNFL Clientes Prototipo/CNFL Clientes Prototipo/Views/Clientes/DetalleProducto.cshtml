@section Scripts {
    <script>
        function solicitar(nombre, precio) {
            var mensaje = precio > 0
                ? '¿Solicitar "' + nombre + '" por ₡' + precio.toLocaleString('es-CR') + '?'
                : '¿Solicitar información sobre "' + nombre + '"?';

            if (confirm(mensaje)) {
                // Crear notificación via fetch
                fetch('@Url.Action("SuscribirServicio", "Clientes")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'servicio=' + encodeURIComponent(nombre) + '&montoMensual=' + precio
                })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.success) {
                        alert('✅ Solicitud enviada. Un agente te contactará pronto.');
                    } else {
                        alert('✅ Solicitud registrada. Te contactaremos pronto.');
                    }
                })
                .catch(function () {
                    alert('✅ Solicitud registrada. Te contactaremos pronto.');
                });
            }
        }
    </script>
}