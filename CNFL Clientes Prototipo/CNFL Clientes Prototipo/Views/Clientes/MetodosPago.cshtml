@{
    ViewBag.Title = "Métodos de pago";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

@section Styles {
    <style>
        /* ═══════════ FILTROS ═══════════ */
        .metodos-filtros {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin: 18px 0 4px;
        }

        .filtro-chip {
            font-size: 11px;
            font-weight: 800;
            padding: 7px 13px;
            border-radius: 999px;
            background: #eef0f7;
            color: var(--muted);
            cursor: pointer;
            border: 0;
            font-family: inherit;
            transition: background .15s, color .15s;
        }

            .filtro-chip.active {
                background: var(--blue);
                color: #fff;
            }

        /* ═══════════ TARJETA DE MÉTODO ═══════════ */
        .metodo-card {
            display: flex;
            align-items: center;
            gap: 13px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px;
            box-shadow: var(--shadow-sm);
            position: relative;
            transition: box-shadow .15s;
        }

            .metodo-card.predeterminado {
                border-color: var(--blue);
                box-shadow: 0 4px 16px rgba(30, 35, 230, 0.12);
            }

        .metodo-ic {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .metodo-tx {
            flex: 1;
            min-width: 0;
        }

            .metodo-tx .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .metodo-tx .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 3px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .metodo-badge {
            display: inline-flex;
            align-items: center;
            font-size: 9.5px;
            font-weight: 800;
            background: var(--blue);
            color: #fff;
            padding: 2px 7px;
            border-radius: 999px;
            letter-spacing: .04em;
        }

        .metodo-acciones {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }

        .metodo-btn {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: 0;
            cursor: pointer;
            display: grid;
            place-items: center;
            transition: background .15s;
            background: #f5f6fa;
            color: var(--ink);
        }

            .metodo-btn:hover {
                background: #eef0ff;
                color: var(--blue);
            }

            .metodo-btn.peligro {
                background: #fdeaea;
                color: #E5484D;
            }

                .metodo-btn.peligro:hover {
                    background: #fbd5d5;
                }

            .metodo-btn.destacar {
                background: #fff8e6;
                color: #b9791a;
            }

                .metodo-btn.destacar:hover {
                    background: #fef3e0;
                }

        /* ═══════════ AVISO SEGURIDAD ═══════════ */
        .aviso-seguridad {
            display: flex;
            gap: 11px;
            align-items: flex-start;
            background: #e9f7ec;
            border: 1px solid #cdeed4;
            border-radius: 14px;
            padding: 13px;
            margin-top: 16px;
        }

            .aviso-seguridad .ico {
                font-size: 20px;
                flex-shrink: 0;
            }

            .aviso-seguridad .txt {
                flex: 1;
                font-size: 11.5px;
                color: #2f8f3e;
                line-height: 1.5;
            }

                .aviso-seguridad .txt strong {
                    font-weight: 800;
                }
    </style>
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">💳 Métodos de pago</div>
    <div style="width:40px;"></div>
</div>

<h1 class="h-name" style="font-size:26px;">Mis métodos de pago</h1>
<p class="h-greet" style="margin-top:6px; line-height:1.5;">
    Administrá tus tarjetas, SINPE, IBAN y tokens.
</p>

<!-- ═══════════ FILTROS ═══════════ -->
<div id="metodosFiltros" class="metodos-filtros" style="display:none;">
    <button type="button" class="filtro-chip active" data-filtro="todos" onclick="filtrarMetodos('todos', this);">Todos</button>
    <button type="button" class="filtro-chip" data-filtro="tarjeta" onclick="filtrarMetodos('tarjeta', this);">💳 Tarjetas</button>
    <button type="button" class="filtro-chip" data-filtro="sinpe" onclick="filtrarMetodos('sinpe', this);">📱 SINPE</button>
    <button type="button" class="filtro-chip" data-filtro="iban" onclick="filtrarMetodos('iban', this);">🏦 IBAN</button>
    <button type="button" class="filtro-chip" data-filtro="token" onclick="filtrarMetodos('token', this);">🔐 Tokens</button>
</div>

<!-- ═══════════ LISTA DE MÉTODOS ═══════════ -->
<div id="listaMetodos" class="rows" style="margin-top:14px;"></div>

<!-- ═══════════ ESTADO VACÍO ═══════════ -->
<div id="metodosVacio" class="card" style="text-align:center; padding:34px 18px; margin-top:14px;">
    <div style="font-size:52px; line-height:1;">💳</div>
    <p style="font-weight:800; font-size:15px; margin-top:12px; color:var(--ink);">Sin métodos guardados</p>
    <p style="font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5;">
        Agregá un método de pago para agilizar tus compras.
    </p>
</div>

<!-- ═══════════ AGREGAR NUEVO ═══════════ -->
<div class="eyebrow">➕ Agregar nuevo método</div>

<div class="rows">
    <div class="row-item" onclick="abrirFormulario('tarjeta');">
        <div class="ic" style="background:#eef0ff; font-size:20px; display:grid; place-items:center;">💳</div>
        <div class="tx">
            <div class="t">Tarjeta de crédito/débito</div>
            <div class="s">Visa · Mastercard · American Express (Tilopay)</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>

    <div class="row-item" onclick="abrirFormulario('sinpe');">
        <div class="ic" style="background:#e9f7ec; font-size:20px; display:grid; place-items:center;">📱</div>
        <div class="tx">
            <div class="t">SINPE Móvil</div>
            <div class="s">8000-0000 · CNFL</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>

    <div class="row-item" onclick="abrirFormulario('iban');">
        <div class="ic" style="background:#fef3e0; font-size:20px; display:grid; place-items:center;">🏦</div>
        <div class="tx">
            <div class="t">Cuenta IBAN</div>
            <div class="s">Banco Nacional · CR00 0000 0000 0000 0000 00</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>

    <div class="row-item" onclick="abrirFormulario('token');">
        <div class="ic" style="background:#f3f0ff; font-size:20px; display:grid; place-items:center;">🔐</div>
        <div class="tx">
            <div class="t">Token bancario</div>
            <div class="s">BN · BCR · BAC · Popular y más</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>
</div>

<!-- ═══════════ AVISO DE SEGURIDAD ═══════════ -->
<div class="aviso-seguridad">
    <div class="ico">🔒</div>
    <div class="txt">
        <strong>Tu información está segura.</strong> Los datos sensibles de tus tarjetas (CVV, PIN de token) no se guardan en la app. Solo almacenamos los últimos 4 dígitos y el nombre del titular para tu referencia.
    </div>
</div>

<!-- ═══════════ MODAL ═══════════ -->
<div id="modalMetodo"
     style="display:none; position:fixed; inset:0; background:rgba(14,17,22,.55); z-index:300; align-items:flex-end; justify-content:center;">
    <div style="width:100%; max-width:430px; max-height:88vh; overflow-y:auto; background:#f5f6fa; border-radius:24px 24px 0 0; padding:22px 20px 26px; box-shadow:0 -10px 40px rgba(0,0,0,.3);">
        <div style="width:44px; height:4px; background:#d8dde8; border-radius:2px; margin:0 auto 18px;"></div>

        <h3 id="modalMetodoTitulo" style="font-size:17px; font-weight:800; margin:0 0 6px; color:var(--ink);">Nuevo método</h3>
        <p id="modalMetodoSub" style="font-size:12.5px; color:var(--muted); margin:0 0 20px; line-height:1.5;">
            Completá los datos. Podés eliminar el método en cualquier momento.
        </p>

        <div class="reg-card" style="margin-bottom:14px;">
            <!-- TARJETA -->
            <div id="camposTarjeta" style="display:none;">
                <div class="reg-field">
                    <label>Número de tarjeta</label>
                    <input type="text" id="tarjetaNumero" placeholder="0000 0000 0000 0000" maxlength="19" inputmode="numeric" oninput="formatearTarjeta(this);" />
                </div>
                <div class="reg-field">
                    <label>Nombre del titular</label>
                    <input type="text" id="tarjetaTitular" placeholder="Como aparece en la tarjeta" autocomplete="cc-name" />
                </div>
                <div style="display:flex; gap:10px;">
                    <div class="reg-field" style="flex:1;">
                        <label>Vencimiento</label>
                        <input type="text" id="tarjetaVencimiento" placeholder="MM/AA" maxlength="5" inputmode="numeric" oninput="formatearVencimiento(this);" />
                    </div>
                    <div class="reg-field" style="flex:1;">
                        <label>CVV</label>
                        <input type="text" id="tarjetaCvv" placeholder="123" maxlength="4" inputmode="numeric" />
                        <small class="hint">No se guarda.</small>
                    </div>
                </div>
            </div>

            <!-- SINPE -->
            <div id="camposSinpe" style="display:none;">
                <div class="reg-field">
                    <label>Teléfono SINPE Móvil</label>
                    <input type="tel" id="sinpeTelefono" placeholder="8888-8888" inputmode="numeric" oninput="formatearTelefono(this);" />
                </div>
                <div class="reg-field">
                    <label>Nombre del titular</label>
                    <input type="text" id="sinpeTitular" placeholder="Nombre completo" />
                </div>
            </div>

            <!-- IBAN -->
            <div id="camposIban" style="display:none;">
                <div class="reg-field">
                    <label>IBAN</label>
                    <input type="text" id="ibanNumero" placeholder="CR00 0000 0000 0000 0000 00" maxlength="26" autocomplete="off" />
                    <small class="hint">Formato: CR + 20 dígitos.</small>
                </div>
                <div class="reg-field">
                    <label>Banco</label>
                    <input type="text" id="ibanBanco" placeholder="Banco Nacional" />
                </div>
                <div class="reg-field">
                    <label>Nombre del titular</label>
                    <input type="text" id="ibanTitular" placeholder="Nombre completo" />
                </div>
            </div>

            <!-- TOKEN -->
            <div id="camposToken" style="display:none;">
                <div class="reg-field">
                    <label>Banco emisor del token</label>
                    <select id="tokenBanco">
                        <option value="">— Seleccioná un banco —</option>
                        <option value="Banco Nacional">Banco Nacional (BN)</option>
                        <option value="Banco de Costa Rica">Banco de Costa Rica (BCR)</option>
                        <option value="BAC Credomatic">BAC Credomatic</option>
                        <option value="Banco Popular">Banco Popular</option>
                        <option value="Scotiabank">Scotiabank</option>
                        <option value="Davivienda">Davivienda</option>
                        <option value="Banco Promerica">Banco Promerica</option>
                        <option value="Banco Improsa">Banco Improsa</option>
                        <option value="Banco General">Banco General</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="reg-field">
                    <label>Identificador del token</label>
                    <input type="text" id="tokenId" placeholder="Ej: TK-1234-5678" />
                    <small class="hint">Lo encontrás en el reverso del dispositivo o en la app del banco.</small>
                </div>
                <div class="reg-field">
                    <label>Alias del token</label>
                    <input type="text" id="tokenAlias" placeholder="Ej: Token personal BN" />
                </div>
                <div class="reg-field">
                    <label>PIN de activación</label>
                    <input type="password" id="tokenPin" placeholder="••••" maxlength="8" inputmode="numeric" />
                    <small class="hint">Solo se usa para vincular. No se guarda en la app.</small>
                </div>
            </div>

            <label class="reg-check" style="margin-top:14px;">
                <input type="checkbox" id="chkPredeterminado" />
                <span class="txt">
                    <span class="t">Usar como método predeterminado</span>
                    <span class="s">Se seleccionará automáticamente al pagar.</span>
                </span>
            </label>
        </div>

        <div style="display:flex; gap:10px;">
            <button type="button" onclick="cerrarModal();" class="reg-btn"
                    style="background:#fff; color:var(--ink); border:1.5px solid var(--line); box-shadow:none;">
                Cancelar
            </button>
            <button type="button" onclick="guardarMetodo();" class="reg-btn">
                Guardar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var STORAGE_KEY = 'cnfl_metodos_pago';
        var tipoActual = 'tarjeta';
        var filtroActual = 'todos';
        var metodosCache = [];

        // ═══════════ Utilidades ═══════════
        function getMetodos() {
            try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch (e) { return []; }
        }
        function setMetodos(m) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(m));
            metodosCache = m;
            renderMetodos();
        }

        // ═══════════ Formateo de inputs ═══════════
        function formatearTarjeta(input) {
            var v = input.value.replace(/\D/g, '').slice(0, 16);
            var formatted = v.replace(/(\d{4})(?=\d)/g, '$1 ');
            input.value = formatted;
        }

        function formatearVencimiento(input) {
            var v = input.value.replace(/\D/g, '').slice(0, 4);
            if (v.length >= 3) {
                input.value = v.slice(0, 2) + '/' + v.slice(2);
            } else {
                input.value = v;
            }
        }

        function formatearTelefono(input) {
            var v = input.value.replace(/\D/g, '').slice(0, 8);
            if (v.length >= 5) {
                input.value = v.slice(0, 4) + '-' + v.slice(4);
            } else {
                input.value = v;
            }
        }

        // ═══════════ Render ═══════════
        function renderMetodos() {
            var cont = document.getElementById('listaMetodos');
            var vacio = document.getElementById('metodosVacio');
            var filtros = document.getElementById('metodosFiltros');
            if (!cont) return;

            var metodos = metodosCache;

            if (metodos.length === 0) {
                vacio.style.display = 'block';
                filtros.style.display = 'none';
                cont.innerHTML = '';
                return;
            }

            vacio.style.display = 'none';
            filtros.style.display = 'flex';

            var filtrados = metodos;
            if (filtroActual !== 'todos') {
                filtrados = metodos.filter(function (m) { return m.tipo === filtroActual; });
            }

            cont.innerHTML = '';

            if (filtrados.length === 0) {
                cont.innerHTML =
                    '<div class="card" style="text-align:center; padding:30px 20px;">' +
                    '<div style="font-size:38px;">🔍</div>' +
                    '<p style="font-weight:800; font-size:14px; margin-top:10px; color:var(--ink);">Sin métodos de este tipo</p>' +
                    '<p style="font-size:12px; color:var(--muted); margin-top:4px;">Agregá uno con el formulario de abajo.</p>' +
                    '</div>';
                return;
            }

            // Ordenar: predeterminado primero
            filtrados.sort(function (a, b) {
                if (a.predeterminado && !b.predeterminado) return -1;
                if (!a.predeterminado && b.predeterminado) return 1;
                return 0;
            });

            filtrados.forEach(function (m) {
                var idx = metodos.indexOf(m);
                var emoji, bg, titulo, sub;

                if (m.tipo === 'tarjeta') {
                    emoji = '💳'; bg = '#eef0ff';
                    titulo = 'Tarjeta •••• ' + (m.numero ? m.numero.replace(/\s/g, '').slice(-4) : '0000');
                    sub = (m.titular || 'Sin titular') + (m.vencimiento ? ' · Vence ' + m.vencimiento : '');
                } else if (m.tipo === 'sinpe') {
                    emoji = '📱'; bg = '#e9f7ec';
                    titulo = 'SINPE Móvil';
                    sub = (m.telefono || '') + (m.titular ? ' · ' + m.titular : '');
                } else if (m.tipo === 'iban') {
                    emoji = '🏦'; bg = '#fef3e0';
                    titulo = 'Cuenta IBAN';
                    var ibanCorto = m.numero ? m.numero.slice(0, 8) + '...' + m.numero.slice(-4) : '';
                    sub = (m.banco || '') + (ibanCorto ? ' · ' + ibanCorto : '');
                } else {
                    emoji = '🔐'; bg = '#f3f0ff';
                    titulo = 'Token ' + (m.banco || '');
                    sub = (m.alias || 'Token') + (m.tokenId ? ' · ' + m.tokenId : '');
                }

                var div = document.createElement('div');
                div.className = 'metodo-card' + (m.predeterminado ? ' predeterminado' : '');

                var predBadge = m.predeterminado
                    ? '<span class="metodo-badge">⭐ PREDETERMINADO</span>'
                    : '';

                var btnDestacar = m.predeterminado
                    ? ''
                    : '<button type="button" class="metodo-btn destacar" onclick="marcarPredeterminado(' + idx + ');" title="Marcar como predeterminado">' +
                    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' +
                    '</button>';

                div.innerHTML =
                    '<div class="metodo-ic" style="background:' + bg + ';">' + emoji + '</div>' +
                    '<div class="metodo-tx">' +
                    '<div class="t">' + titulo + ' ' + predBadge + '</div>' +
                    '<div class="s">' + sub + '</div>' +
                    '</div>' +
                    '<div class="metodo-acciones">' +
                    btnDestacar +
                    '<button type="button" class="metodo-btn peligro" onclick="eliminarMetodo(' + idx + ');" title="Eliminar">' +
                    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6 6 18M6 6l12 12"/></svg>' +
                    '</button>' +
                    '</div>';
                cont.appendChild(div);
            });
        }

        // ═══════════ Acciones ═══════════
        function filtrarMetodos(filtro, btn) {
            filtroActual = filtro;
            document.querySelectorAll('.filtro-chip').forEach(function (el) { el.classList.remove('active'); });
            if (btn) btn.classList.add('active');
            renderMetodos();
        }

        function marcarPredeterminado(idx) {
            var metodos = getMetodos();
            if (!metodos[idx]) return;
            metodos.forEach(function (m, i) { m.predeterminado = (i === idx); });
            setMetodos(metodos);
        }

        function eliminarMetodo(idx) {
            if (!confirm('¿Eliminar este método de pago?')) return;
            var metodos = getMetodos();
            metodos.splice(idx, 1);
            setMetodos(metodos);
        }

        // ═══════════ Modal ═══════════
        function abrirFormulario(tipo) {
            tipoActual = tipo;
            document.getElementById('camposTarjeta').style.display = tipo === 'tarjeta' ? 'block' : 'none';
            document.getElementById('camposSinpe').style.display = tipo === 'sinpe' ? 'block' : 'none';
            document.getElementById('camposIban').style.display = tipo === 'iban' ? 'block' : 'none';
            document.getElementById('camposToken').style.display = tipo === 'token' ? 'block' : 'none';

            var titulos = {
                tarjeta: '💳 Nueva tarjeta',
                sinpe: '📱 Nuevo SINPE',
                iban: '🏦 Nueva cuenta IBAN',
                token: '🔐 Nuevo token'
            };
            document.getElementById('modalMetodoTitulo').textContent = titulos[tipo];

            // Limpiar campos
            document.querySelectorAll('#modalMetodo input').forEach(function (inp) {
                if (inp.type !== 'checkbox' && inp.tagName !== 'SELECT') inp.value = '';
            });
            document.querySelectorAll('#modalMetodo select').forEach(function (sel) { sel.value = ''; });
            document.getElementById('chkPredeterminado').checked = (getMetodos().length === 0);

            document.getElementById('modalMetodo').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function cerrarModal() {
            document.getElementById('modalMetodo').style.display = 'none';
            document.body.style.overflow = '';
        }

        document.getElementById('modalMetodo').addEventListener('click', function (e) {
            if (e.target === this) cerrarModal();
        });

        // ═══════════ Guardar ═══════════
        function guardarMetodo() {
            var metodos = getMetodos();
            var nuevo = { tipo: tipoActual, predeterminado: document.getElementById('chkPredeterminado').checked };

            if (tipoActual === 'tarjeta') {
                var num = document.getElementById('tarjetaNumero').value.replace(/\s/g, '').trim();
                var titular = document.getElementById('tarjetaTitular').value.trim();
                var venc = document.getElementById('tarjetaVencimiento').value.trim();
                var cvv = document.getElementById('tarjetaCvv').value.trim();

                if (num.length < 15) { alert('Ingresá un número de tarjeta válido (mínimo 15 dígitos).'); return; }
                if (!titular) { alert('Ingresá el nombre del titular.'); return; }
                if (!/^\d{2}\/\d{2}$/.test(venc)) { alert('El vencimiento debe tener formato MM/AA.'); return; }
                if (!/^\d{3,4}$/.test(cvv)) { alert('El CVV debe tener 3 o 4 dígitos.'); return; }

                // ⚠️ NO guardamos el CVV
                nuevo.numero = num;
                nuevo.titular = titular;
                nuevo.vencimiento = venc;

            } else if (tipoActual === 'sinpe') {
                var tel = document.getElementById('sinpeTelefono').value.replace(/\D/g, '').trim();
                if (tel.length < 8) { alert('Ingresá un teléfono válido (8 dígitos).'); return; }
                nuevo.telefono = tel.replace(/(\d{4})(\d{4})/, '$1-$2');
                nuevo.titular = document.getElementById('sinpeTitular').value.trim();

            } else if (tipoActual === 'iban') {
                var iban = document.getElementById('ibanNumero').value.replace(/\s/g, '').trim().toUpperCase();
                var banco = document.getElementById('ibanBanco').value.trim();
                var tit = document.getElementById('ibanTitular').value.trim();
                if (iban.length !== 22) { alert('El IBAN debe tener 22 caracteres (CR + 20 dígitos).'); return; }
                if (!banco) { alert('Ingresá el nombre del banco.'); return; }
                if (!tit) { alert('Ingresá el nombre del titular.'); return; }
                nuevo.numero = iban;
                nuevo.banco = banco;
                nuevo.titular = tit;

            } else if (tipoActual === 'token') {
                var b = document.getElementById('tokenBanco').value;
                var tid = document.getElementById('tokenId').value.trim();
                var pin = document.getElementById('tokenPin').value.trim();
                if (!b) { alert('Seleccioná el banco emisor.'); return; }
                if (!tid) { alert('Ingresá el identificador del token.'); return; }
                if (!pin || pin.length < 4) { alert('Ingresá el PIN de activación (mínimo 4 dígitos).'); return; }
                nuevo.banco = b;
                nuevo.tokenId = tid;
                nuevo.alias = document.getElementById('tokenAlias').value.trim() || 'Token ' + b;
            }

            if (nuevo.predeterminado) {
                metodos.forEach(function (m) { m.predeterminado = false; });
            }

            metodos.push(nuevo);
            setMetodos(metodos);
            cerrarModal();
        }

        // ═══════════ Inicializar ═══════════
        metodosCache = getMetodos();
        renderMetodos();
    </script>
}