@model List<CNFL_Clientes_Prototipo.Models.Notificacion>

@{
    ViewBag.Title = "Notificaciones - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/cliente/notificaciones.css")" />

<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> Volver
</button>

<div class="section-pad">
    <div class="h-name-2" style="display:flex;align-items:center;gap:10px;">
        <i class="fas fa-bell" style="color:var(--blue);"></i> Notificaciones
        <span class="notificacion-badge" id="notificacionBadge">@Model.Count(n => !n.Leida)</span>
    </div>
    <div style="font-size:13px;color:var(--muted);margin-top:2px;">Tus alertas y notificaciones del sistema</div>
</div>

<div class="section-pad">
    @if (Model.Any())
    {
        var noLeidas = Model.Where(n => !n.Leida).ToList();

        @if (noLeidas.Any())
        {
            <button class="btn-marcar-todas" onclick="marcarTodasLeidas()"><i class="fas fa-check-double"></i> Marcar todas como leídas</button>

            foreach (var notificacion in noLeidas)
            {
                <div class="notificacion-item" data-id="@notificacion.Id" onclick="marcarLeida(this, @notificacion.Id)">
                    <div class="icono" style="background:@(notificacion.Tipo == "Bienvenida" ? "#e8f0fe" : "#fdeaea");">
                        <i class="fas @(notificacion.Tipo == "Bienvenida" ? "fa-hand-peace" : "fa-bell")" style="color:@(notificacion.Tipo == "Bienvenida" ? "var(--blue)" : "var(--red)");"></i>
                    </div>
                    <div class="info">
                        <div class="titulo">@notificacion.Titulo</div>
                        <div class="descripcion">@notificacion.Mensaje</div>
                        <div class="fecha">@notificacion.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <button class="btn-leer" onclick="event.stopPropagation(); marcarLeida(this, @notificacion.Id)"><i class="fas fa-check"></i> Marcar leída</button>
                </div>
            }
        }
        else
        {
            <div class="empty-notificaciones">
                <div class="empty-icon">🎉</div>
                <h3>¡No tienes notificaciones pendientes!</h3>
                <p>Todas tus notificaciones han sido leídas.</p>
            </div>
        }

        var leidas = Model.Where(n => n.Leida).ToList();
        if (leidas.Any())
        {
            <div style="margin-top:20px;">
                <div class="eyebrow">Notificaciones leídas</div>
                @foreach (var notificacion in leidas)
                {
                    <div class="notificacion-item leida" data-id="@notificacion.Id">
                        <div class="icono" style="background:#f0f0f0;">
                            <i class="fas fa-check-circle" style="color:#999;"></i>
                        </div>
                        <div class="info">
                            <div class="titulo" style="color:#999;">@notificacion.Titulo</div>
                            <div class="descripcion" style="color:#999;">@notificacion.Mensaje</div>
                            <div class="fecha" style="color:#ccc;">@notificacion.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <span style="color:#999;font-size:12px;">✓ Leída</span>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-notificaciones">
            <div class="empty-icon">🔔</div>
            <h3>No tienes notificaciones</h3>
            <p>Las notificaciones aparecerán aquí cuando tengas novedades.</p>
        </div>
    }
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/notificaciones.js")"></script>
}