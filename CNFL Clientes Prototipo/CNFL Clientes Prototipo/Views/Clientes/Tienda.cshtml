@{
    ViewBag.Title = "Tienda";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var banners = ViewBag.Banners as List<CNFL_Clientes_Prototipo.Models.BannerDto>
                  ?? new List<CNFL_Clientes_Prototipo.Models.BannerDto>();
}

@section Styles {
    <style>
        /* ═══ CARRUSEL ═══ */
        .tn-carousel {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 8px;
            box-shadow: 0 10px 24px -12px rgba(16,20,60,.4);
        }

        .tn-track {
            display: flex;
            transition: transform .4s ease;
            touch-action: pan-y;
        }

        .tn-slide {
            flex: 0 0 100%;
            min-height: 140px;
            padding: 20px 18px;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

            .tn-slide::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 160px;
                height: 160px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

            .tn-slide .ico {
                font-size: 28px;
                margin-bottom: 2px;
            }

            .tn-slide .t {
                font-size: 17px;
                font-weight: 800;
                letter-spacing: -.01em;
            }

            .tn-slide .s {
                font-size: 12px;
                opacity: .88;
                line-height: 1.4;
                max-width: 85%;
            }

        .tn-dots {
            position: absolute;
            bottom: 10px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            gap: 6px;
            z-index: 2;
        }

            .tn-dots span {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: rgba(255,255,255,.45);
                transition: .2s;
            }

                .tn-dots span.active {
                    background: #fff;
                    width: 18px;
                    border-radius: 4px;
                }

        /* ═══ SCROLL DE CATEGORÍAS ═══ */
        .tn-catscroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 14px 2px 4px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

            .tn-catscroll::-webkit-scrollbar {
                display: none;
            }

        .tn-chip {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 6px;
            background: #f4f6fb;
            color: var(--ink);
            border: 1px solid var(--line);
            font-family: inherit;
            font-size: 11.5px;
            font-weight: 800;
            padding: 8px 14px;
            border-radius: 999px;
            cursor: pointer;
            white-space: nowrap;
            transition: .15s;
            text-decoration: none;
        }

            .tn-chip.active {
                background: #2f8f3e;
                color: #fff;
                border-color: #2f8f3e;
            }

            .tn-chip:hover {
                text-decoration: none;
            }

        /* ═══ SECCIONES ═══ */
        .tn-section {
            scroll-margin-top: 70px;
        }

        .ti-section-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            margin: 20px 0 10px;
            letter-spacing: -.01em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .ti-section-title .cnt {
                background: #e9f7ec;
                color: #2f8f3e;
                font-size: 10.5px;
                font-weight: 800;
                padding: 2px 8px;
                border-radius: 999px;
            }

        .ti-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .ti-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 12px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 6px;
            transition: transform .15s, box-shadow .2s;
            min-height: 108px;
        }

            .ti-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 18px -8px rgba(16,20,60,.25);
                text-decoration: none;
                color: inherit;
            }

            .ti-card .ico {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 18px;
                background: #eef0ff;
                flex-shrink: 0;
            }

            .ti-card .t {
                font-size: 11.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.2;
            }

            .ti-card .s {
                font-size: 10px;
                color: var(--muted);
                line-height: 1.3;
            }

            /* Colores por categoría */
            .ti-card.c1 .ico {
                background: #fdecea;
            }

            .ti-card.c2 .ico {
                background: #eaf6fa;
            }

            .ti-card.c3 .ico {
                background: #e9f7ec;
            }

            .ti-card.c4 .ico {
                background: #fef3e0;
            }

            .ti-card.c5 .ico {
                background: #f0eaf9;
            }

            .ti-card.c6 .ico {
                background: #eef0ff;
            }

            .ti-card.c7 .ico {
                background: #fdecea;
            }

            .ti-card.c8 .ico {
                background: #e9f7ec;
            }

            .ti-card.c9 .ico {
                background: #fef3e0;
            }

            .ti-card.c10 .ico {
                background: #eaf6fa;
            }

            .ti-card.c11 .ico {
                background: #f0eaf9;
            }

            .ti-card.c12 .ico {
                background: #eef0ff;
            }

            .ti-card.c13 .ico {
                background: #fdecea;
            }

            .ti-card.c14 .ico {
                background: #e9f7ec;
            }

            .ti-card.c15 .ico {
                background: #fef3e0;
            }

            .ti-card.c16 .ico {
                background: #eaf6fa;
            }
    </style>
}

<!-- ═══════════════ CARRUSEL ═══════════════ -->
@if (banners.Count > 0)
{
    <div class="tn-carousel" id="tnCarousel">
        <div class="tn-track" id="tnTrack">
            @foreach (var b in banners)
            {
                <div class="tn-slide"
                     style="background:linear-gradient(135deg, @b.ColorInicio, @b.ColorFin);"
                     onclick="location.href='@Url.Action("DetalleProducto", "Clientes", new { id = b.CategoriaId })'">
                    <div class="ico">@b.Icono</div>
                    <div class="t">@b.Titulo</div>
                    <div class="s">@b.Subtitulo</div>
                </div>
            }
        </div>
        <div class="tn-dots" id="tnDots"></div>
    </div>
}

