@model dynamic

@{
    ViewBag.Title = "Tienda - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- CSS externo para Tienda -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/tienda.css")" />

<!-- ===== BOTÓN VOLVER ===== -->
<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<div class="section-pad">
    <div class="h-name-2" data-i18n="tienda_titulo">
        <i class="fas fa-store" style="color:var(--orange);"></i> Productos y servicios
    </div>
    <div style="font-size:13px; color:var(--muted); margin-top:2px;" data-i18n="compra_facil">
        Compra fácil, paga con tu factura.
    </div>
</div>

<!-- ===== PROMO ===== -->
<div class="section-pad" style="margin-top:8px;">
    <div class="promo-banner">
        <div class="promo-kicker" data-i18n="hogar_360">⚡ HOGAR 360°</div>
        <div class="promo-title" data-i18n="cargador_auto">Cargador para tu auto eléctrico</div>
        <div class="promo-desc" data-i18n="instalacion_certificada">Instalación certificada. Págalo cómodo en tu factura eléctrica.</div>
        <button class="btn-cotizar" data-i18n="solicitar_cotizacion" onclick="alert('📋 Solicitud de cotización enviada.\n\n📩 Recibirás un correo con los detalles en 24 horas.')">
            Solicitar cotización →
        </button>
    </div>
</div>

<!-- ===== CATEGORÍAS ===== -->
<div class="section-pad">
    <div class="eyebrow" data-i18n="cnfl_te_asiste">CNFL TE ASISTE</div>
    <div class="cat-scroll">
        <div class="cat-card" onclick="alert('🛡️ Seguros CNFL\n\nProtege tu hogar y tu familia con nuestros planes de seguros.')">
            <span class="cat-icon">🛡️</span>
            <span data-i18n="seguros">Seguros</span>
        </div>
        <div class="cat-card" onclick="alert('📶 Internet 5G\n\nConecta tu hogar con la mejor velocidad y estabilidad.')">
            <span class="cat-icon">📶</span>
            <span data-i18n="5g">5G</span>
        </div>
        <div class="cat-card" onclick="alert('📹 Videovigilancia\n\nSeguridad para tu hogar con cámaras inteligentes.')">
            <span class="cat-icon">📹</span>
            <span data-i18n="vigilancia">Vigilancia</span>
        </div>
        <div class="cat-card" onclick="alert('🌱 Consumo Verde\n\nAhorra energía y cuida el medio ambiente con nuestros consejos.')">
            <span class="cat-icon">🌱</span>
            <span data-i18n="consumo_verde">Consumo Verde</span>
        </div>
    </div>
</div>

<!-- ===== MARKETPLACE ===== -->
<div class="section-pad">
    <div class="eyebrow" data-i18n="marketplace">🛒 Marketplace</div>
    <div class="pgrid">
        <!-- Producto 1 -->
        <div class="prod">
            <div class="img">
                ❄️
                <span class="badge-oferta">Oferta</span>
            </div>
            <div class="b">
                <div class="n" data-i18n="aire_acondicionado">Aire acondicionado Inverter 12.000 BTU</div>
                <div class="pr">
                    ₡ 289.000
                    <span class="old-price">₡ 329.000</span>
                </div>
                <button class="add" onclick="cargarAFactura('Aire acondicionado Inverter', 289000, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>

        <!-- Producto 2 -->
        <div class="prod">
            <div class="img">💡</div>
            <div class="b">
                <div class="n" data-i18n="kit_iluminacion">Kit iluminación LED inteligente</div>
                <div class="pr">₡ 42.900</div>
                <button class="add" onclick="cargarAFactura('Kit iluminación LED', 42900, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>

        <!-- Producto 3 -->
        <div class="prod">
            <div class="img">🔌</div>
            <div class="b">
                <div class="n" data-i18n="cargador_ev">Cargador EV residencial 7kW</div>
                <div class="pr">
                    ₡ 615.000
                    <span class="old-price">₡ 690.000</span>
                </div>
                <button class="add" onclick="cargarAFactura('Cargador EV residencial', 615000, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>

        <!-- Producto 4 -->
        <div class="prod">
            <div class="img">⚡</div>
            <div class="b">
                <div class="n" data-i18n="supresor_picos">Supresor de picos + base</div>
                <div class="pr">₡ 74.500</div>
                <button class="add" onclick="cargarAFactura('Supresor de picos', 74500, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>

        <!-- Producto 5 -->
        <div class="prod">
            <div class="img">☀️</div>
            <div class="b">
                <div class="n" data-i18n="panel_solar">Panel Solar 400W</div>
                <div class="pr">₡ 185.000</div>
                <button class="add" onclick="cargarAFactura('Panel Solar 400W', 185000, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>

        <!-- Producto 6 -->
        <div class="prod">
            <div class="img">🌡️</div>
            <div class="b">
                <div class="n" data-i18n="termostato_smart">Termostato Smart</div>
                <div class="pr">₡ 89.000</div>
                <button class="add" onclick="cargarAFactura('Termostato Smart', 89000, this)">
                    <i class="fas fa-cart-plus"></i> Cargar a factura
                </button>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript externo para Tienda -->
@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/tienda.js")"></script>
}