@{
    ViewBag.Title = "Tienda";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/cliente/tienda.css" />

<div class="tienda-container">
    <h2>Tienda CNFL</h2>

    <div class="productos-grid">
        <div class="producto-card">
            <div class="producto-img">🔌</div>
            <h3>Cargador EV 7kW</h3>
            <p class="precio">₡615,000</p>
            <button class="btn-agregar" onclick="alert('Agregado al carrito')">Agregar</button>
        </div>

        <div class="producto-card">
            <div class="producto-img">💡</div>
            <h3>Kit LED</h3>
            <p class="precio">₡42,900</p>
            <button class="btn-agregar" onclick="alert('Agregado al carrito')">Agregar</button>
        </div>

        <div class="producto-card">
            <div class="producto-img">❄️</div>
            <h3>Aire Inverter</h3>
            <p class="precio">₡289,000</p>
            <button class="btn-agregar" onclick="alert('Agregado al carrito')">Agregar</button>
        </div>

        <div class="producto-card">
            <div class="producto-img">🔋</div>
            <h3>Batería</h3>
            <p class="precio">₡145,000</p>
            <button class="btn-agregar" onclick="alert('Agregado al carrito')">Agregar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/cliente/tienda.js"></script>
}