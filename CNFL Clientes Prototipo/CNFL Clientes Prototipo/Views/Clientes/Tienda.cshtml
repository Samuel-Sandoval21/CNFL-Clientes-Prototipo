@{
    ViewBag.Title = "Tienda";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var banners = ViewBag.Banners as List<CNFL_Clientes_Prototipo.Models.BannerDto>
                  ?? new List<CNFL_Clientes_Prototipo.Models.BannerDto>();
}

@section Styles {
    <style>
        /* ═══ CARRUSEL ═══ */
        .tn-carousel {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            margin-top: 8px;
            box-shadow: 0 14px 30px -14px rgba(16,20,60,.45);
        }

        .tn-track {
            display: flex;
            transition: transform .4s cubic-bezier(.4,0,.2,1);
            touch-action: pan-y;
        }

        .tn-slide {
            flex: 0 0 100%;
            min-height: 154px;
            padding: 22px 20px;
            color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }

            .tn-slide::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 190px;
                height: 190px;
                background: radial-gradient(circle, rgba(255,255,255,.20), transparent 70%);
            }

            .tn-slide .ico {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                background: rgba(255,255,255,.22);
                backdrop-filter: blur(6px);
                display: grid;
                place-items: center;
                font-size: 21px;
                margin-bottom: 2px;
            }

            .tn-slide .t {
                font-size: 18px;
                font-weight: 800;
                letter-spacing: -.01em;
            }

            .tn-slide .s {
                font-size: 12px;
                opacity: .9;
                line-height: 1.4;
                max-width: 82%;
            }

        .tn-dots {
            position: absolute;
            bottom: 12px;
            left: 0;
            right: 0;
            display: flex;
            justify-content: center;
            gap: 6px;
            z-index: 2;
        }

            .tn-dots span {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: rgba(255,255,255,.45);
                transition: .25s;
            }

                .tn-dots span.active {
                    background: #fff;
                    width: 20px;
                    border-radius: 4px;
                }

        /* ═══ SCROLL DE CATEGORÍAS ═══ */
        .tn-catscroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 16px 2px 6px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

            .tn-catscroll::-webkit-scrollbar {
                display: none;
            }

        .tn-chip {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 6px;
            background: #fff;
            color: var(--ink);
            border: 1.5px solid var(--line);
            font-family: inherit;
            font-size: 12px;
            font-weight: 800;
            padding: 9px 15px;
            border-radius: 999px;
            cursor: pointer;
            white-space: nowrap;
            transition: .15s;
            text-decoration: none;
            box-shadow: var(--shadow-sm);
        }

            .tn-chip.active {
                background: linear-gradient(135deg, var(--orange), #ff8a5c);
                color: #fff;
                border-color: transparent;
                box-shadow: 0 8px 16px -6px rgba(255,105,45,.55);
            }

            .tn-chip:hover {
                text-decoration: none;
            }

        /* ═══ ENCABEZADO DE SECCIÓN ═══ */
        .tn-section {
            scroll-margin-top: 70px;
            margin-top: 24px;
        }

        .tn-sec-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

            .tn-sec-head .badge-ico {
                width: 30px;
                height: 30px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 15px;
                flex-shrink: 0;
            }

            .tn-sec-head .txt {
                flex: 1;
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
                letter-spacing: -.01em;
            }

            .tn-sec-head .cnt {
                font-size: 10.5px;
                font-weight: 800;
                padding: 3px 9px;
                border-radius: 999px;
                flex-shrink: 0;
            }

        /* ═══ FILAS DE PRODUCTOS/SERVICIOS ═══ */
        .tn-rows {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .tn-row {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 13px 14px;
            display: flex;
            align-items: center;
            gap: 13px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow-sm);
            transition: transform .13s, box-shadow .2s;
        }

            .tn-row:hover {
                transform: translateX(3px);
                box-shadow: 0 8px 18px -8px rgba(16,20,60,.22);
                text-decoration: none;
                color: inherit;
            }

            .tn-row .ico {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                display: grid;
                place-items: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .tn-row .body {
                flex: 1;
                min-width: 0;
            }

            .tn-row .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .tn-row .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
            }

            .tn-row .chev {
                color: #c7cbd6;
                flex-shrink: 0;
            }

                .tn-row .chev svg {
                    width: 18px;
                    height: 18px;
                }

        /* Paletas por grupo de sección (colores oficiales CNFL + auxiliares) */
        .pal-hogar .ico {
            background: #eaf6fa;
            color: var(--sky);
        }

        .pal-hogar .badge-ico {
            background: #eaf6fa;
            color: var(--sky);
        }

        .pal-hogar .cnt {
            background: #eaf6fa;
            color: #2a8aa3;
        }

        .pal-productos .ico {
            background: #fef3e0;
            color: var(--orange);
        }

        .pal-productos .badge-ico {
            background: #fef3e0;
            color: var(--orange);
        }

        .pal-productos .cnt {
            background: #fef3e0;
            color: #b9791a;
        }

        .pal-servicios .ico {
            background: #eef0ff;
            color: var(--blue);
        }

        .pal-servicios .badge-ico {
            background: #eef0ff;
            color: var(--blue);
        }

        .pal-servicios .cnt {
            background: #eef0ff;
            color: var(--blue);
        }

        .pal-conect .ico {
            background: #e9f7ec;
            color: var(--green);
        }

        .pal-conect .badge-ico {
            background: #e9f7ec;
            color: var(--green);
        }

        .pal-conect .cnt {
            background: #e9f7ec;
            color: #2f8f3e;
        }

        .pal-complementarios .ico {
            background: #f0eaf9;
            color: #8a5fc7;
        }

        .pal-complementarios .badge-ico {
            background: #f0eaf9;
            color: #8a5fc7;
        }

        .pal-complementarios .cnt {
            background: #f0eaf9;
            color: #8a5fc7;
        }

        .pal-marketplace .ico {
            background: #fdecea;
            color: #e5484d;
        }

        .pal-marketplace .badge-ico {
            background: #fdecea;
            color: #e5484d;
        }

        .pal-marketplace .cnt {
            background: #fdecea;
            color: #c93a3f;
        }
    </style>
}

<!-- ═══════════════ CARRUSEL ═══════════════ -->
@if (banners.Count > 0)
{
    <div class="tn-carousel" id="tnCarousel">
        <div class="tn-track" id="tnTrack">
            @foreach (var b in banners)
            {
                <div class="tn-slide"
                     style="background:linear-gradient(135deg, @b.ColorInicio, @b.ColorFin);"
                     onclick="location.href='@Url.Action("DetalleProducto", "Clientes", new { id = b.CategoriaId })'">
                    <div class="ico">@b.Icono</div>
                    <div class="t">@b.Titulo</div>
                    <div class="s">@b.Subtitulo</div>
                </div>
            }
        </div>
        <div class="tn-dots" id="tnDots"></div>
    </div>
}

