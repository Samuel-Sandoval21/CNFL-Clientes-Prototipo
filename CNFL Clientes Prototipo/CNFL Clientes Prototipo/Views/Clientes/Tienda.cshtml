@{
    ViewBag.Title = "Tienda";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">🛒 Carrito</div>
    <div style="width:40px;"></div>
</div>

<h1 class="h-name" style="font-size:26px;">Mi carrito</h1>
<p class="h-greet" style="margin-top:6px; line-height:1.5;">
    Revisá tus productos y elegí cómo pagar.
</p>

<!-- ═══════════ CARRITO VACÍO ═══════════ -->
<div id="carritoVacio" class="card" style="text-align:center; padding:34px 18px; margin-top:14px; display:none;">
    <div style="font-size:52px; line-height:1;">🛒</div>
    <p style="font-weight:800; font-size:15px; margin-top:12px; color:var(--ink);">Tu carrito está vacío</p>
    <p style="font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5;">
        Explorá el marketplace y agregá productos.
    </p>
    <a href="@Url.Action("ProductosServicios", "Clientes")" class="reg-btn"
       style="display:inline-block; margin-top:16px; text-decoration:none; padding:12px 22px; width:auto;">
        Ver productos →
    </a>
</div>

<!-- ═══════════ ITEMS DEL CARRITO ═══════════ -->
<div id="carritoItems" class="rows" style="margin-top:14px;"></div>

<!-- ═══════════ RESUMEN + PAGO ═══════════ -->
<div id="resumenCarrito" style="display:none; margin-top:14px;">
    <div class="eyebrow">Resumen de compra</div>

    <div class="card">
        <div style="display:flex; justify-content:space-between; padding:8px 0; font-size:13px;">
            <span style="color:var(--muted); font-weight:700;">Subtotal</span>
            <span style="font-weight:800;" id="subtotal">₡0</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:8px 0; font-size:13px; border-bottom:1px dashed var(--line); padding-bottom:12px; margin-bottom:12px;">
            <span style="color:var(--muted); font-weight:700;">Impuesto (13% IVA)</span>
            <span style="font-weight:800;" id="impuesto">₡0</span>
        </div>
        <div style="display:flex; justify-content:space-between; padding:6px 0; font-size:15px;">
            <span style="font-weight:800;">Total</span>
            <span style="font-weight:800; color:var(--orange);" id="total">₡0</span>
        </div>
    </div>

    <!-- Métodos de pago -->
    <div class="eyebrow">💳 Método de pago</div>

    <div class="rows">
        <label class="reg-check" for="pagoFactura" style="cursor:pointer;">
            <input type="radio" name="metodoPago" id="pagoFactura" value="factura" checked style="accent-color:var(--blue); width:22px; height:22px;" />
            <span class="txt">
                <span class="t">💡 Cargar a factura eléctrica</span>
                <span class="s">Se agrega al próximo recibo. Sin intereses.</span>
            </span>
        </label>

        <label class="reg-check" for="pagoTarjeta" style="cursor:pointer;">
            <input type="radio" name="metodoPago" id="pagoTarjeta" value="tarjeta" style="accent-color:var(--blue); width:22px; height:22px;" />
            <span class="txt">
                <span class="t">💳 Tarjeta de crédito/débito</span>
                <span class="s">Visa · Mastercard · American Express (Tilopay)</span>
            </span>
        </label>

        <label class="reg-check" for="pagoSinpe" style="cursor:pointer;">
            <input type="radio" name="metodoPago" id="pagoSinpe" value="sinpe" style="accent-color:var(--blue); width:22px; height:22px;" />
            <span class="txt">
                <span class="t">📱 SINPE Móvil</span>
                <span class="s">8000-0000 · Compañía Nacional de Fuerza y Luz</span>
            </span>
        </label>

        <label class="reg-check" for="pagoIban" style="cursor:pointer;">
            <input type="radio" name="metodoPago" id="pagoIban" value="iban" style="accent-color:var(--blue); width:22px; height:22px;" />
            <span class="txt">
                <span class="t">🏦 Transferencia IBAN</span>
                <span class="s">Banco Nacional · CR00 0000 0000 0000 0000 00</span>
            </span>
        </label>

        <label class="reg-check" for="pagoToken" style="cursor:pointer;">
            <input type="radio" name="metodoPago" id="pagoToken" value="token" style="accent-color:var(--blue); width:22px; height:22px;" />
            <span class="txt">
                <span class="t">🔐 Token bancario</span>
                <span class="s">BN · BCR · BAC · Popular y más</span>
            </span>
        </label>
    </div>

    <button type="button" id="btnPagar" class="btn btn-cta"
            style="width:100%; padding:17px; margin-top:18px; font-size:15px;"
            onclick="procesarPago();">
        Confirmar compra
    </button>

    <button type="button" onclick="vaciarCarrito();"
            style="width:100%; padding:14px; margin-top:10px; background:transparent; border:0; color:var(--red); font-family:inherit; font-weight:800; font-size:13px; cursor:pointer;">
        Vaciar carrito
    </button>
</div>

<script>
    var STORAGE_KEY = 'cnfl_carrito';

    function getCarrito() {
        try {
            var raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch (e) { return []; }
    }

    function setCarrito(items) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        actualizarBadge();
    }

    function actualizarBadge() {
        var badges = document.querySelectorAll('.badge');
        var total = getCarrito().reduce(function (s, i) { return s + (i.cantidad || 1); }, 0);
        for (var i = 0; i < badges.length; i++) badges[i].textContent = total;
    }

    function formatearCRC(n) {
        return '₡' + Math.round(n).toLocaleString('es-CR');
    }

    function renderCarrito() {
        var items = getCarrito();
        var cont = document.getElementById('carritoItems');
        var vacio = document.getElementById('carritoVacio');
        var resumen = document.getElementById('resumenCarrito');

        cont.innerHTML = '';

        if (items.length === 0) {
            vacio.style.display = 'block';
            resumen.style.display = 'none';
            return;
        }

        vacio.style.display = 'none';
        resumen.style.display = 'block';

        var subtotal = 0;

        items.forEach(function (item, idx) {
            var linea = item.precio * (item.cantidad || 1);
            subtotal += linea;

            var div = document.createElement('div');
            div.className = 'row-item';
            div.style.cursor = 'default';
            div.innerHTML =
                '<div class="ic" style="background:#eef6ff; font-size:22px; display:grid; place-items:center;">' + (item.emoji || '📦') + '</div>' +
                '<div class="tx">' +
                    '<div class="t">' + item.nombre + '</div>' +
                    '<div class="s">' + formatearCRC(item.precio) + ' · Cantidad: ' + (item.cantidad || 1) + '</div>' +
                    '<div style="font-weight:800; color:var(--orange); font-size:13px; margin-top:4px;">' + formatearCRC(linea) + '</div>' +
                '</div>' +
                '<button type="button" onclick="eliminarItem(' + idx + ');" style="background:#fdeaea; border:0; color:#E5484D; width:34px; height:34px; border-radius:10px; cursor:pointer; display:grid; place-items:center; flex-shrink:0;">' +
                    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6 6 18M6 6l12 12"/></svg>' +
                '</button>';
            cont.appendChild(div);
        });

        var iva = subtotal * 0.13;
        var total = subtotal + iva;

        document.getElementById('subtotal').textContent = formatearCRC(subtotal);
        document.getElementById('impuesto').textContent = formatearCRC(iva);
        document.getElementById('total').textContent = formatearCRC(total);
    }

    function eliminarItem(idx) {
        var items = getCarrito();
        items.splice(idx, 1);
        setCarrito(items);
        renderCarrito();
    }

    function vaciarCarrito() {
        if (!confirm('¿Vaciar todo el carrito?')) return;
        setCarrito([]);
        renderCarrito();
    }

    function procesarPago() {
        var items = getCarrito();
        if (items.length === 0) return;

        var metodo = document.querySelector('input[name="metodoPago"]:checked');
        var metodoVal = metodo ? metodo.value : 'factura';

        var mensajes = {
            factura: 'Se cargará a tu factura eléctrica',
            tarjeta: 'Serás redirigido a Tilopay (pago seguro)',
            sinpe: 'Te enviaremos la solicitud SINPE Móvil',
            iban: 'Te mostraremos los datos de IBAN',
            token: 'Se solicitará tu token para confirmar el pago'
        };

        var total = document.getElementById('total').textContent;

        if (confirm('Confirmar compra por ' + total + '?\n\n' + mensajes[metodoVal])) {
            var compras = [];
            try { compras = JSON.parse(localStorage.getItem('cnfl_compras') || '[]'); } catch (e) { compras = []; }

            compras.push({
                fecha: new Date().toISOString(),
                metodo: metodoVal,
                total: total,
                items: items
            });
            localStorage.setItem('cnfl_compras', JSON.stringify(compras));

            setCarrito([]);

            if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
                try {
                    new Notification('CNFL · Compra realizada', {
                        body: 'Total: ' + total + ' · ' + mensajes[metodoVal],
                        icon: '/Content/img/logo-cnfl.png'
                    });
                } catch (e) { }
            }

            alert('✓ Compra realizada\n\nTotal: ' + total + '\nMétodo: ' + metodoVal);
            window.location.href = '@Url.Action("MisCompras", "Clientes")';
        }
    }

    renderCarrito();
    actualizarBadge();
</script>