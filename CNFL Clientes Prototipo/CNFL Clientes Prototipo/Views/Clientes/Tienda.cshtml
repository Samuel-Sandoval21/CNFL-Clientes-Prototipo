@{
    ViewBag.Title = "Tienda";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .ti-hero {
            background: linear-gradient(135deg, #2f8f3e, #4ac265);
            border-radius: 20px;
            padding: 18px 18px;
            color: #fff;
            box-shadow: 0 10px 24px -12px rgba(47,143,62,.45);
            margin-top: 8px;
        }

            .ti-hero h1 {
                margin: 0;
                font-size: 19px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .ti-hero p {
                margin: 4px 0 0;
                font-size: 12px;
                opacity: .9;
                line-height: 1.4;
            }

        .ti-section-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            margin: 20px 0 10px;
            letter-spacing: -.01em;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .ti-section-title .cnt {
                background: #e9f7ec;
                color: #2f8f3e;
                font-size: 10.5px;
                font-weight: 800;
                padding: 2px 8px;
                border-radius: 999px;
            }

        .ti-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .ti-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 12px;
            text-decoration: none;
            color: inherit;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
            gap: 6px;
            transition: transform .15s, box-shadow .2s;
            min-height: 108px;
        }

            .ti-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 18px -8px rgba(16,20,60,.25);
                text-decoration: none;
                color: inherit;
            }

            .ti-card .ico {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                font-size: 18px;
                background: #eef0ff;
                flex-shrink: 0;
            }

            .ti-card .t {
                font-size: 11.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.2;
            }

            .ti-card .s {
                font-size: 10px;
                color: var(--muted);
                line-height: 1.3;
            }

            /* Colores por categoría */
            .ti-card.c1 .ico {
                background: #fdecea;
            }

            .ti-card.c2 .ico {
                background: #eaf6fa;
            }

            .ti-card.c3 .ico {
                background: #e9f7ec;
            }

            .ti-card.c4 .ico {
                background: #fef3e0;
            }

            .ti-card.c5 .ico {
                background: #f0eaf9;
            }

            .ti-card.c6 .ico {
                background: #eef0ff;
            }

            .ti-card.c7 .ico {
                background: #fdecea;
            }

            .ti-card.c8 .ico {
                background: #e9f7ec;
            }

            .ti-card.c9 .ico {
                background: #fef3e0;
            }

            .ti-card.c10 .ico {
                background: #eaf6fa;
            }

            .ti-card.c11 .ico {
                background: #f0eaf9;
            }

            .ti-card.c12 .ico {
                background: #eef0ff;
            }
    </style>
}

<div class="ti-hero">
    <h1 data-i18n="productos.title">🛒 Productos y Servicios</h1>
    <p data-i18n="productos.sub">Explorá nuestra tienda y servicios</p>
</div>

<!-- PRODUCTOS -->
<div class="ti-section-title">
    🔌 Productos <span class="cnt">4</span>
</div>
<div class="ti-grid">
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "supresores" })" class="ti-card c1">
        <div class="ico">🔌</div>
        <div class="t">Supresores y Bases</div>
        <div class="s">Protección eléctrica</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "cargadores" })" class="ti-card c2">
        <div class="ico">🔋</div>
        <div class="t">Cargadores Semirápidos</div>
        <div class="s">Vehículos eléctricos</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "bienes" })" class="ti-card c3">
        <div class="ico">🏢</div>
        <div class="t">Bienes Inmuebles</div>
        <div class="s">Locales y propiedades</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "tienda" })" class="ti-card c4">
        <div class="ico">🛍️</div>
        <div class="t">Tienda CNFL</div>
        <div class="s">Productos del hogar</div>
    </a>
</div>

<!-- SERVICIOS -->
<div class="ti-section-title">
    🛠️ Servicios <span class="cnt">8</span>
</div>
<div class="ti-grid">
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "internet" })" class="ti-card c5">
        <div class="ico">📡</div>
        <div class="t">Internet Fijo 5G</div>
        <div class="s">Viví la velocidad</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "seguro-hogar" })" class="ti-card c6">
        <div class="ico">🏠</div>
        <div class="t">Seguro de Hogar</div>
        <div class="s">Contra incendio y rayo</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "asiste" })" class="ti-card c7">
        <div class="ico">🛟</div>
        <div class="t">CNFL Te Asiste</div>
        <div class="s">Asistencias y seguros</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "sri" })" class="ti-card c8">
        <div class="ico">⚡</div>
        <div class="t">Ingeniería Eléctrica</div>
        <div class="s">Soluciones SIE</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "ambientales" })" class="ti-card c9">
        <div class="ico">🌱</div>
        <div class="t">Servicios Ambientales</div>
        <div class="s">Sostenibilidad</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "calibracion" })" class="ti-card c10">
        <div class="ico">🔬</div>
        <div class="t">Calibración</div>
        <div class="s">Equipos certificados</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "anonos" })" class="ti-card c11">
        <div class="ico">🔧</div>
        <div class="t">Taller Anonos</div>
        <div class="s">Reparación especializada</div>
    </a>
    <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "reparacion" })" class="ti-card c12">
        <div class="ico">🛠️</div>
        <div class="t">Reparación y Mant.</div>
        <div class="s">Servicio técnico</div>
    </a>
</div>