@{
    ViewBag.Title = "Productos y Servicios";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/tienda.css" />
    <style>
        /* ============================================
           PRODUCTOS Y SERVICIOS - Estilos específicos
           ============================================ */
        .ps-header {
            text-align: center;
            margin-bottom: 20px;
        }

            .ps-header .ps-logo {
                height: 38px;
                width: auto;
                margin-bottom: 8px;
            }

            .ps-header h1 {
                font-size: 22px;
                font-weight: 800;
                color: var(--blue);
                margin: 0;
                letter-spacing: -0.02em;
            }

            .ps-header .ps-sub {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 4px;
                line-height: 1.4;
            }

        .ps-section {
            margin-top: 24px;
        }

        .ps-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 12px;
        }

            .ps-section-title::before {
                content: "";
                width: 4px;
                height: 16px;
                border-radius: 2px;
                background: var(--blue);
            }

            .ps-section-title.orange::before {
                background: var(--orange);
            }

        .ps-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .ps-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 16px 12px;
            text-align: center;
            cursor: pointer;
            transition: transform .15s, box-shadow .2s, border-color .15s;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-sm);
        }

            .ps-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px -10px rgba(16,20,60,.25);
                border-color: rgba(30,35,230,.25);
                text-decoration: none;
                color: inherit;
            }

            .ps-card:active {
                transform: scale(.98);
            }

            .ps-card .ps-icon {
                width: 56px;
                height: 56px;
                border-radius: 16px;
                display: grid;
                place-items: center;
                font-size: 28px;
                margin-bottom: 2px;
            }

            .ps-card .ps-title {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
                letter-spacing: -0.01em;
            }

            .ps-card .ps-desc {
                font-size: 10.5px;
                color: var(--muted);
                line-height: 1.3;
                margin-top: -2px;
            }

        /* Colores de los íconos por categoría */
        .ico-orange {
            background: #fff3ec;
            color: var(--orange);
        }

        .ico-blue {
            background: #eef0ff;
            color: var(--blue);
        }

        .ico-green {
            background: #e9f7ec;
            color: var(--green);
        }

        .ico-navy {
            background: #e8ebf9;
            color: var(--navy);
        }

        .ico-sky {
            background: #eaf6fa;
            color: #2c8aa3;
        }

        .ico-amber {
            background: #fef3e0;
            color: var(--amber);
        }

        .ico-red {
            background: #fdeaea;
            color: var(--red);
        }
    </style>
}

<div class="ps-header">
    <img src="~/images/logo-cnfl.png" alt="CNFL" class="ps-logo" />
    <h1>Productos y Servicios</h1>
    <p class="ps-sub">Conocé el detalle de los productos y servicios que CNFL pone a su disposición.</p>
</div>

<!-- ============================================ -->
<!-- PRODUCTOS CNFL -->
<!-- ============================================ -->
<div class="ps-section">
    <div class="ps-section-title orange">Productos CNFL</div>
    <div class="ps-grid">

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "tienda" })" class="ps-card">
            <div class="ps-icon ico-orange">🛍️</div>
            <div class="ps-title">Tienda CNFL</div>
            <div class="ps-desc">Comprá productos del hogar</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "supresores" })" class="ps-card">
            <div class="ps-icon ico-blue">🔌</div>
            <div class="ps-title">Supresores y Bases</div>
            <div class="ps-desc">Protección en cada partido</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "cargadores" })" class="ps-card">
            <div class="ps-icon ico-green">⚡</div>
            <div class="ps-title">Cargadores Semirápidos</div>
            <div class="ps-desc">Energía lista para cada jugada</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "bienes" })" class="ps-card">
            <div class="ps-icon ico-navy">🏠</div>
            <div class="ps-title">Bienes Inmuebles CNFL</div>
            <div class="ps-desc">Locales y propiedades</div>
        </a>

    </div>
</div>

<!-- ============================================ -->
<!-- SERVICIOS CNFL -->
<!-- ============================================ -->
<div class="ps-section">
    <div class="ps-section-title">Servicios CNFL</div>
    <div class="ps-grid">

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "asiste" })" class="ps-card">
            <div class="ps-icon ico-orange">🛡️</div>
            <div class="ps-title">CNFL Te Asiste</div>
            <div class="ps-desc">Asistencias y seguros</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "internet" })" class="ps-card">
            <div class="ps-icon ico-red">📱</div>
            <div class="ps-title">Internet Fijo 5G</div>
            <div class="ps-desc">Viví la velocidad</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "seguro-hogar" })" class="ps-card">
            <div class="ps-icon ico-green">🔥</div>
            <div class="ps-title">Seguro de Hogar</div>
            <div class="ps-desc">Contra incendio y rayo</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "sri" })" class="ps-card">
            <div class="ps-icon ico-navy">⚙️</div>
            <div class="ps-title">Ingeniería Eléctrica (SIE)</div>
            <div class="ps-desc">Soluciones profesionales</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "ambientales" })" class="ps-card">
            <div class="ps-icon ico-green">🌿</div>
            <div class="ps-title">Servicios Ambientales</div>
            <div class="ps-desc">Sostenibilidad y control</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "calibracion" })" class="ps-card">
            <div class="ps-icon ico-sky">📊</div>
            <div class="ps-title">Calibración</div>
            <div class="ps-desc">Equipos certificados</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "anonos" })" class="ps-card">
            <div class="ps-icon ico-amber">🛠️</div>
            <div class="ps-title">Taller Anonos</div>
            <div class="ps-desc">Reparación especializada</div>
        </a>

        <a href="@Url.Action("DetalleProducto", "Clientes", new { id = "reparacion" })" class="ps-card">
            <div class="ps-icon ico-blue">🔧</div>
            <div class="ps-title">Reparación y Mantenimiento</div>
            <div class="ps-desc">Servicio técnico</div>
        </a>

    </div>
</div>

@section Scripts {
    <script src="~/Scripts/cliente/tienda.js"></script>
}