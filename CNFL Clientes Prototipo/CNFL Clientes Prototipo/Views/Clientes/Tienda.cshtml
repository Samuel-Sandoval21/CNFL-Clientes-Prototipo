@section Scripts {
    <script>
        (function () {
            var track = document.getElementById('tnTrack');
            var dotsWrap = document.getElementById('tnDots');
            var catScroll = document.getElementById('tnCatScroll');

            // ═══ CARRUSEL ═══
            if (track) {
                var slides = track.children.length;
                var idx = 0;
                var timer;

                for (var i = 0; i < slides; i++) {
                    var d = document.createElement('span');
                    if (i === 0) d.classList.add('active');
                    dotsWrap.appendChild(d);
                }

                var goTo = function (i) {
                    idx = (i + slides) % slides;
                    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
                    Array.prototype.forEach.call(dotsWrap.children, function (dot, di) {
                        dot.classList.toggle('active', di === idx);
                    });
                };

                var auto = function () {
                    timer = setInterval(function () { goTo(idx + 1); }, 4500);
                };
                var resetAuto = function () {
                    clearInterval(timer);
                    auto();
                };

                var startX = 0;
                track.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
                track.addEventListener('touchend', function (e) {
                    var diff = e.changedTouches[0].clientX - startX;
                    if (diff > 40) goTo(idx - 1);
                    else if (diff < -40) goTo(idx + 1);
                    resetAuto();
                });

                auto();
            }

            // ═══ SCROLL DE CATEGORÍAS ═══
            var appContent = document.querySelector('.app-content');
            var chips = document.querySelectorAll('#tnCatScroll .tn-chip');
            var sections = document.querySelectorAll('.tn-section');

            // Click en chip → salto suave DENTRO de .app-content
            chips.forEach(function (chip) {
                chip.addEventListener('click', function (e) {
                    e.preventDefault();
                    var targetId = chip.getAttribute('href').substring(1);
                    var target = document.getElementById(targetId);
                    if (target && appContent) {
                        var offset = target.offsetTop - 70;
                        appContent.scrollTo({ top: offset, behavior: 'smooth' });
                    }
                });
            });

            // Centrar chip horizontalmente SIN afectar scroll vertical
            function centerChip(chip) {
                if (!catScroll || !chip) return;
                var target = chip.offsetLeft - (catScroll.clientWidth / 2) + (chip.offsetWidth / 2);
                catScroll.scrollTo({ left: target, behavior: 'smooth' });
            }

            // IntersectionObserver usando .app-content como root
            if ('IntersectionObserver' in window && appContent) {
                var obs = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            chips.forEach(function (c) { c.classList.remove('active'); });
                            var match = document.querySelector('#tnCatScroll a[href="#' + entry.target.id + '"]');
                            if (match) {
                                match.classList.add('active');
                                centerChip(match);
                            }
                        }
                    });
                }, {
                    root: appContent,
                    rootMargin: '-90px 0px -70% 0px'
                });
                sections.forEach(function (s) { obs.observe(s); });
            }
        })();
    </script>
}