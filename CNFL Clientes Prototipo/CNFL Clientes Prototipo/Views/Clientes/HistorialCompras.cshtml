@{
    ViewBag.Title = "Historial de Compras";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="historial-container">
    <h2>Historial de Compras</h2>
    <p>Productos y servicios adquiridos.</p>

    <div class="historial-grid">
        <div class="compra-card">
            <div class="compra-thumb">📦</div>
            <div class="compra-body">
                <strong class="compra-title">Cargador EV 7kW</strong>
                <div class="compra-meta">15/08/2026 · ₡615,000</div>
                <div class="compra-status estado-completado">Completado</div>
            </div>
            <div class="compra-actions">
                <a href="#" class="btn-small">Ver recibo</a>
            </div>
        </div>

        <div class="compra-card">
            <div class="compra-thumb">💡</div>
            <div class="compra-body">
                <strong class="compra-title">Kit LED inteligente</strong>
                <div class="compra-meta">10/08/2026 · ₡42,900</div>
                <div class="compra-status estado-completado">Completado</div>
            </div>
            <div class="compra-actions">
                <a href="#" class="btn-small">Ver recibo</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/historial-compras.css" />
}
