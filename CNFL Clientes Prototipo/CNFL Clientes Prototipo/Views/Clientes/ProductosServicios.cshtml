@section Styles {
    <style>
        /* ═══════════ TABS DE PRODUCTOS ═══════════ */
        .prod-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin: 16px 0 4px;
        }

        .prod-tab {
            font-size: 11.5px;
            font-weight: 800;
            padding: 9px 14px;
            border-radius: 999px;
            background: #eef0f7;
            color: var(--muted);
            cursor: pointer;
            border: 0;
            font-family: inherit;
            text-decoration: none;
            transition: background .15s, color .15s;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .prod-tab.active {
                background: var(--blue);
                color: #fff;
            }

        .section-h {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .12em;
            text-transform: uppercase;
            margin: 22px 0 8px;
        }

        /* ═══════════ SERVICIOS — ACORDEÓN ═══════════ */
        .servicios-lista {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 8px;
            padding-bottom: 100px;
        }

        .servicio-item {
            background: #ffffff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 2px 8px rgba(16, 20, 40, 0.04);
            overflow: hidden;
            transition: box-shadow .2s, border-color .2s;
        }

            .servicio-item:hover {
                box-shadow: 0 4px 14px rgba(16, 20, 40, 0.08);
            }

            .servicio-item.abierto {
                border-color: rgba(30, 35, 230, 0.25);
                box-shadow: 0 6px 20px rgba(30, 35, 230, 0.08);
            }

        .servicio-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 16px;
            cursor: pointer;
            background: #ffffff;
            transition: background .15s;
        }

            .servicio-header:hover {
                background: #fafbfe;
            }

        .servicio-icono {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #eef0ff;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            color: var(--blue);
            transition: background .15s, color .15s;
        }

            .servicio-icono svg {
                width: 22px;
                height: 22px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .servicio-item.abierto .servicio-icono {
            background: var(--blue);
            color: #ffffff;
        }

        .servicio-texto {
            flex: 1;
            min-width: 0;
        }

        .servicio-titulo {
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
            line-height: 1.25;
        }

        .servicio-desc {
            font-size: 12px;
            color: var(--muted);
            margin-top: 3px;
            line-height: 1.4;
        }

        .servicio-chev {
            color: #c3c8d4;
            flex-shrink: 0;
            transition: transform .25s ease, color .15s;
        }

            .servicio-chev svg {
                width: 20px;
                height: 20px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .servicio-item.abierto .servicio-chev {
            transform: rotate(180deg);
            color: var(--blue);
        }

        .servicio-contenido {
            max-height: 0;
            overflow: hidden;
            transition: max-height .35s ease;
            background: #fafbfe;
            border-top: 1px solid transparent;
        }

        .servicio-item.abierto .servicio-contenido {
            max-height: 800px;
            border-top-color: var(--line);
        }

        .servicio-contenido-inner {
            padding: 16px;
        }

        .servicio-form .reg-field {
            margin-bottom: 12px;
        }

        .servicio-form textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid var(--line);
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            min-height: 90px;
            resize: vertical;
            outline: none;
            color: var(--ink);
            background: #fff;
            transition: border-color .15s, box-shadow .15s;
        }

            .servicio-form textarea:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(30, 35, 230, 0.1);
            }

        .servicio-btn-enviar {
            width: 100%;
            margin-top: 4px;
            padding: 14px;
            border: 0;
            border-radius: 12px;
            background: var(--orange);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 13.5px;
            cursor: pointer;
            box-shadow: 0 6px 14px -6px rgba(255, 105, 45, 0.6);
            transition: transform .15s, background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .servicio-btn-enviar:hover {
                background: #e55a20;
            }

            .servicio-btn-enviar:active {
                transform: scale(0.98);
            }

            .servicio-btn-enviar:disabled {
                background: #9aa1b0;
                cursor: not-allowed;
                box-shadow: none;
            }

        .servicio-estado {
            display: none;
            margin-top: 12px;
            padding: 12px 14px;
            background: #e9f7ec;
            border: 1px solid #cdeed4;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 800;
            color: #2f8f3e;
            text-align: center;
        }

            .servicio-estado.show {
                display: block;
            }

        .servicios-cta {
            width: 100%;
            padding: 16px;
            margin-top: 16px;
            border: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--blue), #3b6ce0);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 14.5px;
            cursor: pointer;
            box-shadow: 0 10px 22px -8px rgba(30, 35, 230, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform .15s;
        }

            .servicios-cta:active {
                transform: scale(0.98);
            }

        /* ═══════════ INFO EXTRA ═══════════ */
        .info-extra {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 16px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

            .info-extra h4 {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
                margin: 0 0 8px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .info-extra p {
                font-size: 12px;
                color: var(--muted);
                line-height: 1.6;
                margin: 0 0 8px;
            }

                .info-extra p:last-child {
                    margin-bottom: 0;
                }

        /* ═══════════ PLANES ═══════════ */
        .planes-grid {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 8px;
        }

        .plan-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform .15s, box-shadow .15s;
        }

        .plan-head {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
        }

        .plan-img {
            width: 84px;
            height: 84px;
            border-radius: 14px;
            object-fit: cover;
            flex-shrink: 0;
            border: 2px solid var(--line);
            background: #f7f8fc;
        }

        .plan-info {
            flex: 1;
            min-width: 0;
        }

        .plan-nombre {
            font-size: 15px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.2;
            letter-spacing: -.01em;
        }

        .plan-desc {
            font-size: 11.5px;
            color: var(--muted);
            margin-top: 4px;
            line-height: 1.4;
        }

        .plan-precio {
            display: inline-block;
            font-size: 12.5px;
            font-weight: 800;
            color: #fff;
            background: var(--orange);
            padding: 5px 11px;
            border-radius: 8px;
            margin-top: 8px;
        }

        .plan-cats {
            padding: 0 16px 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .plan-cat {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--blue);
            background: #eef0ff;
            padding: 4px 10px;
            border-radius: 999px;
        }

        .plan-toggle {
            width: 100%;
            background: #f7f8fc;
            border: 0;
            border-top: 1px solid var(--line);
            padding: 13px 16px;
            font-family: inherit;
            font-size: 12.5px;
            font-weight: 800;
            color: var(--blue);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background .15s;
        }

            .plan-toggle:hover {
                background: #eef0ff;
            }

            .plan-toggle .arrow {
                transition: transform .2s;
                font-size: 10px;
            }

            .plan-toggle.open .arrow {
                transform: rotate(180deg);
            }

        .plan-coberturas {
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
            background: #fafbfe;
            border-top: 1px solid var(--line);
        }

            .plan-coberturas.open {
                max-height: 900px;
                overflow-y: auto;
            }

        .plan-coberturas-inner {
            padding: 16px;
        }

        .plan-coberturas h4 {
            font-size: 11.5px;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 10px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .plan-coberturas ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .plan-coberturas ul li {
                font-size: 12.5px;
                color: var(--ink);
                line-height: 1.5;
                padding: 7px 0 7px 22px;
                position: relative;
                border-bottom: 1px solid var(--line);
            }

                .plan-coberturas ul li:last-child {
                    border-bottom: 0;
                }

                .plan-coberturas ul li::before {
                    content: "✓";
                    position: absolute;
                    left: 0;
                    top: 7px;
                    color: var(--green);
                    font-weight: 800;
                    font-size: 13px;
                }

        .plan-btn-carrito {
            width: 100%;
            background: var(--orange);
            color: #fff;
            border: 0;
            padding: 15px 16px;
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 800;
            cursor: pointer;
            transition: background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .plan-btn-carrito:hover {
                background: #e55a20;
            }

        /* ═══════════ TOAST ═══════════ */
        .toast {
            position: fixed;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: #0E1116;
            color: #fff;
            padding: 12px 18px;
            border-radius: 14px;
            font-size: 12.5px;
            font-weight: 700;
            z-index: 500;
            box-shadow: 0 10px 24px rgba(0,0,0,.3);
            transition: .3s;
            max-width: 340px;
            text-align: center;
            opacity: 0;
        }

            .toast.show {
                transform: translateX(-50%) translateY(0);
                opacity: 1;
            }
    </style>
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <div class="brand">
        <img src="~/Content/img/logo-cnfl.png" alt="CNFL" class="logo-cnfl-light"
             onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
        <img src="~/Content/img/logo-cnfl-dark.png" alt="CNFL" class="logo-cnfl-dark" />
    </div>
    <div class="actions">
        <button type="button" class="icon-btn" onclick="abrirConfig();" title="Configuración">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
        </button>
        <a href="@Url.Action("Tienda", "Clientes")" class="icon-btn" title="Carrito">
            <span class="badge" id="badgeCarrito">0</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <circle cx="9" cy="20" r="1.6" />
                <circle cx="18" cy="20" r="1.6" />
                <path d="M2 3h3l2.5 12.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 2-1.5L22 7H6" />
            </svg>
        </a>
    </div>
</div>

<!-- ═══════════ BANNER PRINCIPAL ═══════════ -->
<div class="hero-card" style="
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 55%, #3b6ce0 100%);
    padding: 20px 18px;
    border-radius: 22px;
    margin-top: 4px;
">
    <p class="greet">🏠 HOGAR 360°</p>
    <h1 style="font-size:20px;">Productos y Servicios</h1>
    <p class="sub">Servicios, marketplace, subscripciones y mucho más.</p>
</div>

<!-- ═══════════ TABS ═══════════ -->
<div class="chart-tabs" style="margin-top:16px;">
    <button type="button" class="chart-tab active" data-tab="servicios">🏠 Servicios</button>
    <button type="button" class="chart-tab" data-tab="marketplace">🛍️ Marketplace</button>
    <button type="button" class="chart-tab" data-tab="subscripciones">🛡️ Subscripciones</button>
    <button type="button" class="chart-tab" data-tab="tarjeta">💳 Tarjeta de Crédito</button>
    <button type="button" class="chart-tab" data-tab="historial">📚 Historial de Compras</button>
</div>

<!-- ═══════════════════════════════════════════
     SECCIÓN 1: SERVICIOS (ACORDEÓN)
     ═══════════════════════════════════════════ -->
<div id="tab-servicios" class="tab-panel">

    <div class="hero-card" style="margin-top:22px;">
        <p class="greet">🏠 HOGAR 360°</p>
        <h1>Todo para tu hogar,<br>en un solo lugar</h1>
        <p class="sub">Solicitá visita técnica, recibí cotización y cargá el costo a tu factura eléctrica.</p>
    </div>

    <div class="eyebrow" style="margin-top:22px;">Servicios disponibles</div>

    <div class="servicios-lista">

        <!-- Eficiencia energética -->
        <div class="servicio-item" id="serv-eficiencia">
            <div class="servicio-header" onclick="toggleServicio('serv-eficiencia');">
                <div class="servicio-icono">
                    <svg viewBox="0 0 24 24"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V18h6v-1.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z" /></svg>
                </div>
                <div class="servicio-texto">
                    <div class="servicio-titulo">Eficiencia energética</div>
                    <div class="servicio-desc">Diagnóstico y optimización del consumo</div>
                </div>
                <div class="servicio-chev"><svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></div>
            </div>
            <div class="servicio-contenido">
                <div class="servicio-contenido-inner">
                    <div class="servicio-form">
                        <div class="reg-field">
                            <label>Descripción del servicio *</label>
                            <textarea placeholder="Contanos qué necesitás..."></textarea>
                        </div>
                        <div class="reg-field">
                            <label>NISE asociado (opcional)</label>
                            <input type="text" placeholder="Ej: NISE-002" />
                        </div>
                        <div class="reg-field">
                            <label>Teléfono de contacto</label>
                            <input type="tel" placeholder="Ej: 8888-8888" />
