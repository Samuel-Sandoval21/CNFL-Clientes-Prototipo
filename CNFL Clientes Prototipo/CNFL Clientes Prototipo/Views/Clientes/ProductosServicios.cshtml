<!-- ═══════════════════════════════════════════
     SECCIÓN 3: SUBSCRIPCIONES
     ═══════════════════════════════════════════ -->
<div id="tab-subscripciones" class="tab-panel" style="display:none;">

    <div class="hero-card" style="margin-top:22px; background:linear-gradient(135deg, #64B95A, #4a9a57);">
        <p class="greet">🛡️ CNFL TE ASISTE</p>
        <h1>Protegé lo que<br>más querés</h1>
        <p class="sub">Asistencia para tu hogar, tu salud, tu vehículo y el bienestar de tus mascotas. Cobertura 24/7.</p>
    </div>

    <div class="eyebrow" style="margin-top:22px;">Subscripciones disponibles</div>

    <div class="planes-grid">
        @foreach (var plan in planes)
        {
            <div class="plan-card" id="plan-@plan.Id">
                <div class="plan-head" style="border-left: 4px solid @plan.ColorBorde;">
                    <img src="@Url.Content("~/Content/img/planes/" + plan.Imagen)"
                         alt="@plan.Nombre"
                         class="plan-img"
                         loading="lazy"
                         onerror="this.onerror=null; this.style.background='#eef0ff'; this.style.display='none';" />
                    <div class="plan-info">
                        <div class="plan-nombre">@plan.Nombre</div>
                        <div class="plan-desc">@plan.DescripcionCorta</div>
                        <span class="plan-precio">@plan.Precio</span>
                    </div>
                </div>

                <div class="plan-cats">
                    @foreach (var cat in plan.Categorias)
                    {
                        <span class="plan-cat">@cat</span>
                    }
                </div>

                <button type="button" class="plan-toggle" onclick="togglePlan('@plan.Id', this)">
                    <span>+ Detalles del Plan</span>
                    <span class="arrow">▼</span>
                </button>

                <div class="plan-coberturas" id="coberturas-@plan.Id">
                    <div class="plan-coberturas-inner">
                        <h4>Categorías de asistencias:</h4>
                        <ul>
                            @foreach (var cob in plan.Coberturas)
                            {
                                <li>@cob</li>
                            }
                        </ul>
                    </div>
                </div>

                <button type="button" class="plan-btn-carrito" onclick="agregarPlanAlCarrito('@plan.Id', '@plan.Nombre', @plan.PrecioNumerico, '@plan.Precio')">
                    🛒 Agregar al carrito
                </button>
            </div>
        }
    </div>

    <div class="info-extra" style="margin-bottom: 100px;">
        <h4>ℹ️ ¿Cómo afiliarse?</h4>
        <p>Agregá el plan al carrito y completá tu compra con cualquiera de nuestros métodos de pago disponibles.</p>
        <p>El cobro se hará mensualmente en la factura del servicio eléctrico. El plan puede ser suscrito únicamente por el titular del servicio.</p>
        <p>Las asistencias de chequeo al hogar y electro-asistencia solo aplican dentro de la zona servida de la CNFL.</p>
    </div>
</div>

