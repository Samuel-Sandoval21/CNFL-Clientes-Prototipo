@{
    ViewBag.Title = "Historial de reportes";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="appbar">
    <a href="@Url.Action("Reportes", "Clientes")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Historial de reportes</div>
    <div style="width:40px;"></div>
</div>

<p class="h-greet" style="margin-top:4px; line-height:1.5;">
    Todas las averías que reportaste.
</p>

<div class="eyebrow">Últimos 30 días</div>

<div class="rows">
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 6 })" class="row-item">
        <div class="ic" style="background:#fff3ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#6 · Transformador dañado</div>
            <div class="s">11/09/2026 · 14:08 · NISE-002</div>
        </div>
        <span class="pill st-prev"><span class="dot"></span>En proceso</span>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 3 })" class="row-item">
        <div class="ic" style="background:#fff3ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#3 · Transformador dañado</div>
            <div class="s">11/09/2026 · 14:08 · NISE-002</div>
        </div>
        <span class="pill st-prev"><span class="dot"></span>En proceso</span>
    </a>

    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 1 })" class="row-item">
        <div class="ic" style="background:#e9f7ec;">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>
        <div class="tx">
            <div class="t">#1 · Sin energía</div>
            <div class="s">09/09/2026 · 23:25 · NISE-002</div>
        </div>
        <span class="pill st-normal"><span class="dot"></span>Resuelto</span>
    </a>
</div>