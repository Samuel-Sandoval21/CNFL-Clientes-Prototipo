@model List<CNFL_Clientes_Prototipo.Models.Averia>

@{
    ViewBag.Title = "Historial de Reportes";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .hr-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .hr-back:hover {
                text-decoration: underline;
            }

        .hr-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .hr-header .hr-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        .hr-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 14px 16px;
            margin-top: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            text-decoration: none;
            color: inherit;
            transition: transform .15s, box-shadow .2s;
            box-shadow: var(--shadow-sm);
        }

            .hr-item:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 22px -10px rgba(16,20,60,.2);
                text-decoration: none;
                color: inherit;
            }

            .hr-item .row1 {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
            }

            .hr-item .num {
                font-size: 12px;
                font-weight: 800;
                color: var(--muted);
            }

            .hr-item .tipo {
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
            }

            .hr-item .nise {
                font-size: 12px;
                color: var(--muted);
            }

            .hr-item .fecha {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 2px;
            }

        .badge-estado {
            font-size: 10.5px;
            font-weight: 800;
            padding: 5px 10px;
            border-radius: 999px;
        }

        .b-ingresado {
            background: #eef0ff;
            color: var(--blue);
        }

        .b-revision {
            background: #fef3e0;
            color: #b9791a;
        }

        .b-camino {
            background: #eaf6fa;
            color: #2c8aa3;
        }

        .b-resuelto {
            background: #e9f7ec;
            color: #2f8f3e;
        }

        .hr-empty {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .hr-empty .emoji {
                font-size: 48px;
                margin-bottom: 12px;
            }

            .hr-empty .t {
                font-weight: 800;
                font-size: 15px;
                color: var(--ink);
                margin-bottom: 6px;
            }

            .hr-empty .s {
                font-size: 13px;
                color: var(--muted);
                line-height: 1.5;
                margin-bottom: 16px;
            }

            .hr-empty .btn-cta {
                display: inline-block;
                text-decoration: none;
            }
    </style>
}

<div class="hr-header" style="text-align:left;">
    <a href="@Url.Action("Reportes", "Clientes")" class="hr-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a Reportes
    </a>
    <h1>Historial de reportes</h1>
    <div class="hr-sub">Todos tus reportes anteriores y su estado actual.</div>
</div>

@if (Model != null && Model.Any())
{
    foreach (var a in Model)
    {
        var estadoClass = "b-ingresado";
        if (a.Estado == "En revisión") { estadoClass = "b-revision"; }
        else if (a.Estado == "Operador en camino") { estadoClass = "b-camino"; }
        else if (a.Estado == "Problema resuelto" || a.Estado == "Resuelto") { estadoClass = "b-resuelto"; }

        <a href="@Url.Action("EstadoAveria", "Clientes", new { id = a.AveriaId })" class="hr-item">
            <div class="row1">
                <div class="num">#@a.AveriaId</div>
                <div class="badge-estado @estadoClass">@a.Estado</div>
            </div>
            <div>
                <div class="tipo">@a.Tipo</div>
                @if (a.NISE != null)
                {
                    <div class="nise">NISE @a.NISE.NumeroNise</div>
                }
            </div>
            <div class="fecha">📅 @a.FechaReporte.ToString("dd/MM/yyyy HH:mm")</div>
        </a>
    }
}
else
{
    <div class="hr-empty">
        <div class="emoji">📋</div>
        <div class="t">Sin reportes todavía</div>
        <div class="s">Cuando reportes una avería, va a aparecer acá con su estado de seguimiento.</div>
        <a href="@Url.Action("ReportarAveria", "Clientes")" class="btn btn-cta">Reportar avería</a>
    </div>
}