@{
    ViewBag.Title = "Calculadora Energética";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="calculadora-container">
    <h2>Calculadora Energética</h2>
    <p>Estima el costo de tus equipos eléctricos.</p>

    <div class="calculadora-card">
        <div class="form-group">
            <label>Equipo:</label>
            <select id="equipoSelect">
                <option value="100">Refrigeradora (100W)</option>
                <option value="60">Televisor (60W)</option>
                <option value="120">Lavadora (120W)</option>
                <option value="1500">Microondas (1500W)</option>
                <option value="2000">Aire acondicionado (2000W)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Horas al día:</label>
            <input type="number" id="horasDia" value="4" min="1" max="24" />
        </div>
        <button id="calcularBtn" class="btn-calcular">Calcular</button>
    </div>

    <div class="resultado-card" id="resultadoCard" style="display:none;">
        <h3>Resultado estimado</h3>
        <p><strong>Consumo mensual:</strong> <span id="consumoMensual">0</span> kWh</p>
        <p><strong>Costo estimado:</strong> ₡<span id="costoEstimado">0</span></p>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/calculadora.css" />
}

@section Scripts {
    <script src="~/Scripts/cliente/calculadora.js"></script>
}