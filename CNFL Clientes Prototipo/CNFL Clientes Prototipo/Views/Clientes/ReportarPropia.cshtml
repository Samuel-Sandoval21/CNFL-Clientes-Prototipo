@model dynamic

@{
    ViewBag.Title = "Reportar Avería - CNFL";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/cliente/reportes-form.css")" />

<button class="btn-volver" onclick="history.back();">
    <i class="fas fa-arrow-left"></i> <span data-i18n="volver">Volver</span>
</button>

<div class="section-pad">
    <div class="h-name-2">
        <i class="fas fa-home" style="color:var(--red);"></i>
        <span data-i18n="reportar_propia">Reportar Avería Eléctrica Propia</span>
    </div>
    <div style="display:flex; align-items:center; gap:10px; margin-top:4px;">
        <span class="tipo-reporte-badge propia" data-i18n="tipo_seleccionado">Tipo seleccionado: propia</span>
        <span style="font-size:12px; color:var(--muted);">📍 En tu NISE registrado</span>
    </div>
</div>

<div class="section-pad">
    <form class="reporte-form" onsubmit="event.preventDefault(); enviarReporte('propia');">

        <div class="form-group">
            <label>NISE registrado</label>
            <div class="nise-automatico">
                <i class="fas fa-check-circle"></i> @(Session["NISE"] ?? "4021") · Casa
            </div>
        </div>

        <div class="form-group">
            <label for="tituloAveria" data-i18n="titulo_averia">Título de la avería</label>
            <input type="text" id="tituloAveria" placeholder="Ej: Poste con cable caído" class="form-input" required />
        </div>

        <div class="form-group">
            <label for="direccionAveria" data-i18n="direccion">Dirección</label>
            <input type="text" id="direccionAveria" placeholder="Ej: Avenida 2, Calles 3-5" class="form-input" required />
        </div>

        <div class="form-group">
            <label for="tipoProblema" data-i18n="tipo_problema">Tipo de problema</label>
            <select id="tipoProblema" class="form-input">
                <option value="" data-i18n="seleccione_tipo">Seleccione el tipo</option>
                <option value="corto_circuito">⚡ Corto circuito</option>
                <option value="bajo_voltaje">🔋 Bajo voltaje</option>
                <option value="alto_voltaje">⚡ Alto voltaje</option>
                <option value="intermitente">🔌 Servicio intermitente</option>
                <option value="sin_servicio">🚫 Sin servicio eléctrico</option>
                <option value="otro">🔧 Otro</option>
            </select>
        </div>

        <div class="form-group">
            <label for="descripcionAveria" data-i18n="descripcion_problema">Descripción del problema</label>
            <textarea id="descripcionAveria" rows="3" placeholder="Explique brevemente la situación..." class="form-input" required></textarea>
        </div>

        <div class="form-group">
            <label data-i18n="adjuntar_foto">Adjuntar foto / video</label>
            <div class="dropzone" id="dropzone">
                <i class="fas fa-cloud-upload-alt"></i>
                <div class="drop-text" id="dropText" data-i18n="seleccionar_archivo">Seleccionar archivo</div>
                <div class="drop-sub" id="dropSub" data-i18n="sin_archivo">Sin archivo...seleccionados</div>
                <input type="file" id="fileInput" style="display:none;" accept="image/*,video/*" multiple />
            </div>
        </div>

        <div class="form-group">
            <button type="button" class="btn-gps" onclick="obtenerUbicacionReporte()">
                <i class="fas fa-map-pin"></i> <span data-i18n="obtener_ubicacion">Obtener mi ubicación en tiempo real</span>
            </button>
            <div class="ubicacion-texto" id="ubicacionTexto"></div>
        </div>

        <button type="submit" class="btn-enviar-reporte">
            <i class="fas fa-paper-plane"></i> <span data-i18n="enviar_reporte">Enviar Reporte</span>
        </button>
    </form>
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/cliente/reportes-form.js")"></script>
}