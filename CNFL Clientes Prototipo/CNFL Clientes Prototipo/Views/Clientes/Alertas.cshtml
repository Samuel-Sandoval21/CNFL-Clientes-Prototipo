       class="alert-item tipo-pago"
       data-tipo="pago"
       data-seccion="hoy">
        <span class="alert-unread"></span>
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6M9 13h6M9 17h4" />
            </svg>
        </div>
        <div class="alert-body">
            <div class="alert-head">
                <div class="alert-title">Factura por vencer</div>
                <span class="alert-pill st-amber"><span class="dot"></span>5 días</span>
            </div>
            <p class="alert-desc">₡18.450 · F-2026-002 · NISE-002</p>
            <div class="alert-time">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                Vence el 30/08/2026 · posible corte
            </div>
            <button type="button" class="alert-action" onclick="event.preventDefault(); event.stopPropagation(); marcarLeida(this);">
                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                Marcar como leída
            </button>
        </div>
    </a>

</div>

<!-- ═══════════ SECCIÓN: ESTA SEMANA ═══════════ -->
<div class="alert-section" data-seccion="semana">
    <div class="alert-section-title">Esta semana</div>
</div>

<div class="alert-list">

    <!-- ═══ AVERÍA #1 (finalizada) ═══ -->
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 1 })"
       class="alert-item tipo-averia"
       data-tipo="averia"
       data-seccion="semana">
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <path d="M20 6 9 17l-5-5" />
            </svg>
        </div>
        <div class="alert-body">
