            </div>
            <p class="alert-desc">Tu consumo subió 15% vs. el promedio mensual.</p>
            <div class="alert-time">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                10/09/2026 · 08:30
            </div>
        </div>
    </div>

</div>

<!-- ═══════════ ESTADO VACÍO (por filtro) ═══════════ -->
<div id="alertEmpty" class="alert-empty" style="display:none;">
    <div class="ico">
        <svg viewBox="0 0 24 24">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </svg>
    </div>
    <h3>Sin alertas en esta categoría</h3>
    <p>Cuando tengas novedades te avisaremos acá.</p>
</div>

<!-- ═══════════ CONFIGURACIÓN DE NOTIFICACIONES ═══════════ -->
<div class="eyebrow" style="margin-top:24px;">⚙️ Configuración de notificaciones</div>

<div class="card">
    <div style="display:flex; flex-direction:column; gap:14px;">

        <label style="display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer;">
            <div>
                <div style="font-size:13px; font-weight:800; color:var(--ink);">⚡ Averías</div>
                <div style="font-size:11px; color:var(--muted); margin-top:2px;">Reportada, en proceso, finalizada</div>
            </div>
            <input type="checkbox" checked class="notif-check" data-tipo="averia"
                   style="width:22px; height:22px; accent-color:var(--blue); cursor:pointer;" />
        </label>

        <label style="display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer;">
            <div>
                <div style="font-size:13px; font-weight:800; color:var(--ink);">🔧 Suspensiones</div>
                <div style="font-size:11px; color:var(--muted); margin-top:2px;">Avisos con anticipación</div>
            </div>
            <input type="checkbox" checked class="notif-check" data-tipo="suspension"
                   style="width:22px; height:22px; accent-color:var(--blue); cursor:pointer;" />
        </label>

        <label style="display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer;">
            <div>
                <div style="font-size:13px; font-weight:800; color:var(--ink);">💰 Facturas y pagos</div>
                <div style="font-size:11px; color:var(--muted); margin-top:2px;">Vencimientos y medios de pago</div>
            </div>
            <input type="checkbox" checked class="notif-check" data-tipo="pago"
                   style="width:22px; height:22px; accent-color:var(--blue); cursor:pointer;" />
        </label>

        <label style="display:flex; align-items:center; justify-content:space-between; gap:12px; cursor:pointer;">
            <div>
                <div style="font-size:13px; font-weight:800; color:var(--ink);">📊 Eventos técnicos</div>
                <div style="font-size:11px; color:var(--muted); margin-top:2px;">Voltaje y consumo de tu NISE</div>
            </div>
            <input type="checkbox" checked class="notif-check" data-tipo="evento"
                   style="width:22px; height:22px; accent-color:var(--blue); cursor:pointer;" />
        </label>

    </div>
</div>

<!-- ═══════════ BOTÓN PROBAR NOTIFICACIÓN ═══════════ -->
<button type="button" id="btnProbarPush" class="btn-test-push" style="margin-bottom: 100px;">
    <svg viewBox="0 0 24 24">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
    </svg>
    Probar notificación push + correo
</button>

@section Scripts {
    <script>
        // ═══════════════════════════════════════════════════════════
        // FILTROS POR TIPO
        // ═══════════════════════════════════════════════════════════
        (function () {
            var tabs = document.querySelectorAll('.alert-tab');
            var items = document.querySelectorAll('.alert-item');
            var empty = document.getElementById('alertEmpty');

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    this.classList.add('active');

                    var tipo = this.getAttribute('data-tipo');
                    var visibles = 0;

                    items.forEach(function (item) {
                        var itemTipo = item.getAttribute('data-tipo');
                        if (tipo === 'todos' || itemTipo === tipo) {
                            item.style.display = 'flex';
                            visibles++;
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    document.querySelectorAll('.alert-section').forEach(function (sec) {
                        var seccion = sec.getAttribute('data-seccion');
                        var hayVisibles = false;
                        items.forEach(function (item) {
                            if (item.getAttribute('data-seccion') === seccion
                                && (tipo === 'todos' || item.getAttribute('data-tipo') === tipo)) {
                                hayVisibles = true;
                            }
                        });
                        sec.style.display = hayVisibles ? 'flex' : 'none';
                    });

                    if (empty) empty.style.display = visibles === 0 ? 'block' : 'none';
                });
            });
        })();

        // ═══════════════════════════════════════════════════════════
        // MARCAR COMO LEÍDA
        // ═══════════════════════════════════════════════════════════
        function marcarLeida(btn) {
            var item = btn.closest('.alert-item');
            if (!item) return;

            var unread = item.querySelector('.alert-unread');
            if (unread) unread.remove();

            btn.textContent = '✓ Leída';
            btn.disabled = true;
            btn.style.opacity = '0.5';
            btn.style.cursor = 'default';
        }

        // ═══════════════════════════════════════════════════════════
        // NOTIFICACIONES PUSH
        // ═══════════════════════════════════════════════════════════
        (function () {
            var permisoActual = (typeof Notification !== 'undefined') ? Notification.permission : 'unsupported';
            var banner = document.getElementById('pushBanner');
            var btnPermitir = document.getElementById('btnPermitirPush');
            var btnActivar = document.getElementById('btnActivarPush');
            var btnProbar = document.getElementById('btnProbarPush');

            if (permisoActual === 'default' && banner) {
                banner.style.display = 'block';
            }

            function playNotifSound() {
                try {
                    var ctx = new (window.AudioContext || window.webkitAudioContext)();

                    var osc1 = ctx.createOscillator();
                    var gain1 = ctx.createGain();
                    osc1.connect(gain1);
                    gain1.connect(ctx.destination);
                    osc1.type = 'sine';
                    osc1.frequency.setValueAtTime(880, ctx.currentTime);
                    gain1.gain.setValueAtTime(0.001, ctx.currentTime);
                    gain1.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.02);
                    gain1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
                    osc1.start(ctx.currentTime);
                    osc1.stop(ctx.currentTime + 0.15);

                    setTimeout(function () {
                        var osc2 = ctx.createOscillator();
                        var gain2 = ctx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.type = 'sine';
                        osc2.frequency.setValueAtTime(1320, ctx.currentTime);
                        gain2.gain.setValueAtTime(0.001, ctx.currentTime);
                        gain2.gain.exponentialRampToValueAtTime(0.15, ctx.currentTime + 0.02);
                        gain2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);
                        osc2.start(ctx.currentTime);
                        osc2.stop(ctx.currentTime + 0.2);
                    }, 120);
                } catch (e) { /* silencioso */ }
            }

            function pedirPermiso() {
                if (typeof Notification === 'undefined') {
                    alert('Tu navegador no soporta notificaciones push.');
                    return;
                }
                Notification.requestPermission().then(function (permiso) {
                    permisoActual = permiso;
                    if (permiso === 'granted') {
                        if (banner) banner.style.display = 'none';
                        playNotifSound();
                        mostrarNotificacion(
                            '¡Notificaciones activadas!',
                            'Recibirás avisos de CNFL al instante.',
                            false
                        );
                    } else {
                        alert('No se activaron las notificaciones.\n\nPodés activarlas desde la configuración del navegador.');
                    }
                });
            }

            if (btnPermitir) btnPermitir.addEventListener('click', pedirPermiso);
            if (btnActivar) btnActivar.addEventListener('click', pedirPermiso);

            function mostrarNotificacion(titulo, cuerpo, enviarCorreo) {
                playNotifSound();

                if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
                    try {
                        var notif = new Notification(titulo, {
                            body: cuerpo,
                            icon: '/Content/img/logo-cnfl.png',
                            badge: '/Content/img/logo-cnfl.png',
                            tag: 'cnfl-' + Date.now(),
                            requireInteraction: false
                        });

                        notif.onclick = function () {
                            window.focus();
                            notif.close();
                        };

                        setTimeout(function () { notif.close(); }, 8000);
                    } catch (e) { /* silencioso */ }
                }

                if (enviarCorreo) {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]');
                    var tokenValue = token ? token.value : '';

                    var formData = new FormData();
                    formData.append('titulo', titulo);
                    formData.append('mensaje', cuerpo);
                    formData.append('__RequestVerificationToken', tokenValue);

                    fetch('@Url.Action("NotificarPush", "Clientes")', {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin'
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (!data.success) console.warn('No se pudo enviar correo:', data.message);
                    })
                    .catch(function (err) { console.warn('Error AJAX:', err); });
                }
            }

            if (btnProbar) {
                btnProbar.addEventListener('click', function () {
                    if (Notification.permission !== 'granted') {
                        pedirPermiso();
                        return;
                    }
                    mostrarNotificacion(
                        'CNFL · Prueba de notificación',
                        'Notificación + correo enviado correctamente. ¡Todo funciona!',
                        true
                    );
                });
            }

            if (permisoActual === 'granted') {
                setTimeout(function () {
                    mostrarNotificacion(
                        'CNFL · Alertas activas',
                        'Tenés 1 avería en seguimiento y 1 factura por vencer.',
                        false
                    );
                }, 1500);
            }
        })();

        // ═══════════════════════════════════════════════════════════
        // GUARDAR PREFERENCIAS DE NOTIFICACIONES
        // ═══════════════════════════════════════════════════════════
        (function () {
            var checks = document.querySelectorAll('.notif-check');

            checks.forEach(function (chk) {
                var tipo = chk.getAttribute('data-tipo');
                var guardado = localStorage.getItem('cnfl_notif_' + tipo);
                if (guardado !== null) {
                    chk.checked = guardado === '1';
                }

                chk.addEventListener('change', function () {
                    localStorage.setItem('cnfl_notif_' + tipo, this.checked ? '1' : '0');
                });
            });
        })();

        // ═══════════════════════════════════════════════════════════
        // POLLING: Verifica nuevas notificaciones cada 30 segundos
        // ═══════════════════════════════════════════════════════════
        (function () {
            var ultimaVerificacion = new Date().toISOString();
            var intervalo = 30000;

            function verificarNuevas() {
                fetch('@Url.Action("ContarNotificacionesNuevas", "Clientes")?desde=' + encodeURIComponent(ultimaVerificacion))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success && data.total > 0) {
                            // Actualizar badges
                            var badges = document.querySelectorAll('.badge');
                            for (var i = 0; i < badges.length; i++) {
                                badges[i].textContent = data.total;
                            }

                            // Notificación push
                            if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
                                new Notification('CNFL · Nueva alerta', {
                                    body: 'Tenés ' + data.total + ' notificación(es) nueva(s)',
                                    icon: '/Content/img/logo-cnfl.png'
                                });
                            }

                            // Sonido
                            try {
                                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                                var osc = ctx.createOscillator();
                                var gain = ctx.createGain();
                                osc.connect(gain);
                                gain.connect(ctx.destination);
                                osc.type = 'sine';
                                osc.frequency.setValueAtTime(880, ctx.currentTime);
                                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                                osc.start(ctx.currentTime);
                                osc.stop(ctx.currentTime + 0.3);
                            } catch (e) { }

                            ultimaVerificacion = new Date().toISOString();

                            // Recargar después de 3s
                            setTimeout(function () {
                                window.location.reload();
                            }, 3000);
                        }
                    })
                    .catch(function () { /* silencioso */ });
            }

            setInterval(verificarNuevas, intervalo);

            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    verificarNuevas();
                }
            });
        })();
    </script>
}