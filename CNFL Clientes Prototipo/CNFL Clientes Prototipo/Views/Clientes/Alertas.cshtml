                <div class="alert-title">Sin energía</div>
                <span class="alert-pill st-green"><span class="dot"></span>Finalizada</span>
            </div>
            <p class="alert-desc">Resuelta exitosamente el 09/09/2026 a las 23:25.</p>
            <div class="alert-time">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                09/09/2026 · #1
            </div>
        </div>
    </a>

    <!-- ═══ MEDIO DE PAGO VENCIDO ═══ -->
    <a href="@Url.Action("MetodosPago", "Clientes")"
       class="alert-item tipo-pago"
       data-tipo="pago"
       data-seccion="semana">
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <rect x="1" y="4" width="22" height="16" rx="2" />
                <line x1="1" y1="10" x2="23" y2="10" />
            </svg>
        </div>
        <div class="alert-body">
            <div class="alert-head">
                <div class="alert-title">Medio de pago vencido</div>
                <span class="alert-pill st-red"><span class="dot"></span>Urgente</span>
            </div>
            <p class="alert-desc">Tarjeta terminada en ****4521 · venció 07/2026.</p>
            <div class="alert-time">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                Actualizá tu método de pago
            </div>
        </div>
    </a>

    <!-- ═══ EVENTO VOLTAJE ═══ -->
    <div class="alert-item tipo-evento"
         data-tipo="evento"
         data-seccion="semana">
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
        </div>
        <div class="alert-body">
            <div class="alert-head">
                <div class="alert-title">Voltaje fuera de rango</div>
                <span class="alert-pill st-amber"><span class="dot"></span>Advertencia</span>
            </div>
