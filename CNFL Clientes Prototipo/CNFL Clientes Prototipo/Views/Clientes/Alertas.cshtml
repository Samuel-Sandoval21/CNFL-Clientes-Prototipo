            </div>
            <button type="button" class="alert-action" onclick="marcarLeida(this);">
                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                Marcar como leída
            </button>
        </div>
    </div>

    <!-- ═══ FACTURA POR VENCER ═══ -->
