@{
    ViewBag.Title = "Alertas";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var alertas = ViewBag.Alertas as List<CNFL_Clientes_Prototipo.Models.Notificacion>
                  ?? new List<CNFL_Clientes_Prototipo.Models.Notificacion>();
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           ALERTAS — REDISEÑADO
           ═══════════════════════════════════════════ */

        /* Tabs de filtros — GRID responsive */
        .alert-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 12px;
            margin-bottom: 16px;
        }

        .alert-tab {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 10px 6px;
            border-radius: 12px;
            background: #eef0f7;
            color: var(--muted);
            font-family: inherit;
            font-size: 11px;
            font-weight: 800;
            border: 0;
            cursor: pointer;
            transition: background .15s, color .15s;
            white-space: nowrap;
            text-align: center;
        }

            .alert-tab.active {
                background: var(--blue);
                color: #fff;
            }

            .alert-tab .badge-count {
                background: rgba(255,255,255,.25);
                font-size: 9.5px;
                padding: 1px 5px;
                border-radius: 999px;
                min-width: 16px;
                text-align: center;
                font-weight: 800;
            }

            .alert-tab:not(.active) .badge-count {
                background: var(--blue);
                color: #fff;
            }

        /* Lista */
        .alert-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        /* Alert card mejorado */
        .alert-item {
            display: flex;
            gap: 13px;
            padding: 14px;
            background: #ffffff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 2px 10px rgba(16, 20, 40, 0.04);
            transition: transform .15s, box-shadow .15s;
            text-decoration: none;
            color: inherit;
            position: relative;
            overflow: hidden;
        }

            .alert-item:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(16, 20, 40, 0.08);
            }

            .alert-item:active {
                transform: scale(0.99);
            }

            /* Barra lateral de color según tipo */
            .alert-item::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: var(--line);
                border-radius: 16px 0 0 16px;
            }

            .alert-item.tipo-averia::before {
                background: var(--red);
            }

            .alert-item.tipo-suspension::before {
                background: var(--amber);
            }

            .alert-item.tipo-pago::before {
                background: var(--orange);
            }

            .alert-item.tipo-evento::before {
                background: var(--sky);
            }

        /* Ícono */
        .alert-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: #f5f6fa;
            color: var(--muted);
        }

            .alert-icon svg {
                width: 22px;
                height: 22px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .alert-item.tipo-averia .alert-icon {
            background: #fdeaea;
            color: var(--red);
        }

        .alert-item.tipo-suspension .alert-icon {
            background: #fef3e0;
            color: var(--amber);
        }

        .alert-item.tipo-pago .alert-icon {
            background: #fff3ec;
            color: var(--orange);
        }

        .alert-item.tipo-evento .alert-icon {
            background: #eef6ff;
            color: var(--sky);
        }

        /* Texto */
        .alert-body {
            flex: 1;
            min-width: 0;
        }

        .alert-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 4px;
        }

        .alert-title {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.3;
            margin: 0;
        }

        .alert-desc {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.45;
            margin: 4px 0 0;
        }

        .alert-time {
            font-size: 11px;
            color: var(--muted);
            font-weight: 700;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .alert-time svg {
                width: 12px;
                height: 12px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2;
            }

        /* Pill de estado */
        .alert-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 10px;
            font-weight: 800;
            padding: 4px 9px;
            border-radius: 999px;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .alert-pill .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .alert-pill.st-red {
                background: #fdeaea;
                color: var(--red);
            }

            .alert-pill.st-amber {
                background: #fef3e0;
                color: #b9791a;
            }

            .alert-pill.st-green {
                background: #e9f7ec;
                color: var(--green);
            }

            .alert-pill.st-blue {
                background: #eef0ff;
                color: var(--blue);
            }

            .alert-pill.st-sky {
                background: #eef6ff;
                color: #1a73e8;
            }

        /* Unread indicator */
        .alert-unread {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--blue);
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px rgba(30, 35, 230, 0.2);
            animation: pulseDot 2s infinite;
        }

        @@keyframes pulseDot {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.15);
                opacity: .8;
            }
        }

        /* Sección título */
        .alert-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 0 10px;
        }

        .alert-section-title {
            font-size: 11px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        /* Estado vacío */
        .alert-empty {
            text-align: center;
            padding: 48px 20px;
        }

            .alert-empty .ico {
                width: 72px;
                height: 72px;
                margin: 0 auto 16px;
                border-radius: 50%;
                background: #f5f6fa;
                display: grid;
                place-items: center;
                color: #c3c8d4;
            }

                .alert-empty .ico svg {
                    width: 34px;
                    height: 34px;
                    stroke: currentColor;
                    fill: none;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .alert-empty h3 {
                font-size: 15px;
                font-weight: 800;
                color: var(--ink);
                margin: 0 0 6px;
            }

            .alert-empty p {
                font-size: 12.5px;
                color: var(--muted);
                margin: 0;
                line-height: 1.5;
            }

        /* Botón marcar como leída */
        .alert-action {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 10px;
            background: #f5f6fa;
            border: 1px solid var(--line);
            border-radius: 8px;
            color: var(--muted);
            font-family: inherit;
            font-size: 10.5px;
            font-weight: 800;
            cursor: pointer;
            transition: all .15s;
            margin-top: 8px;
        }

            .alert-action:hover {
                background: #eef0ff;
                border-color: var(--blue);
                color: var(--blue);
            }

            .alert-action svg {
                width: 12px;
                height: 12px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.4;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* Botón probar push */
        .btn-test-push {
            width: 100%;
            padding: 14px;
            border: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--blue), #3b6ce0);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 13.5px;
            cursor: pointer;
            box-shadow: 0 10px 22px -8px rgba(30, 35, 230, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform .15s;
            margin-top: 16px;
        }

            .btn-test-push:active {
                transform: scale(0.98);
            }

            .btn-test-push svg {
                width: 18px;
                height: 18px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }
    </style>
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <a href="@Url.Action("Dashboard", "Clientes")" class="icon-btn" title="Volver">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Alertas</div>
    <button type="button" class="icon-btn" id="btnActivarPush" title="Activar notificaciones">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
        </svg>
    </button>
</div>

<p class="h-greet" style="margin-top:4px; line-height:1.5;">
    Notificaciones sobre tus servicios y eventos importantes.
</p>

<!-- ═══════════ BANNER ACTIVAR PUSH ═══════════ -->
<div id="pushBanner" class="card" style="margin-top:14px; display:none; background:linear-gradient(135deg, #eef0ff, #dde3ff); border:1px solid #c7d0f8;">
    <div style="display:flex; gap:12px; align-items:center;">
        <div style="width:44px; height:44px; border-radius:14px; background:var(--blue); display:grid; place-items:center; flex:none; box-shadow:0 6px 14px -4px rgba(30,35,230,.4);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            </svg>
        </div>
        <div style="flex:1; min-width:0;">
            <div style="font-size:13px; font-weight:800; color:var(--ink);">Activá las notificaciones</div>
            <div style="font-size:11.5px; color:var(--muted); margin-top:2px; line-height:1.4;">
                Recibí avisos en tu celular y correo.
            </div>
        </div>
        <button type="button" id="btnPermitirPush"
                style="background:var(--blue); color:#fff; border:0; font-family:inherit; font-weight:800; font-size:12px; padding:10px 14px; border-radius:10px; cursor:pointer; white-space:nowrap;">
            Activar
        </button>
    </div>
</div>

<!-- ═══════════ TABS DE FILTROS ═══════════ -->
<div class="alert-tabs" id="alertTabs">
    <button type="button" class="alert-tab active" data-tipo="todos">
        Todas
        <span class="badge-count">6</span>
    </button>
    <button type="button" class="alert-tab" data-tipo="averia">
        ⚡ Averías
        <span class="badge-count">2</span>
    </button>
    <button type="button" class="alert-tab" data-tipo="suspension">
        🔧 Suspens.
        <span class="badge-count">1</span>
    </button>
    <button type="button" class="alert-tab" data-tipo="pago">
        💰 Pagos
        <span class="badge-count">2</span>
    </button>
    <button type="button" class="alert-tab" data-tipo="evento">
        📊 Eventos
        <span class="badge-count">2</span>
    </button>
</div>

<!-- ═══════════ SECCIÓN: HOY ═══════════ -->
<div class="alert-section" data-seccion="hoy">
    <div class="alert-section-title">Hoy</div>
</div>

<div class="alert-list">

    <!-- ═══ AVERÍA #6 ═══ -->
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 6 })"
       class="alert-item tipo-averia"
       data-tipo="averia"
       data-seccion="hoy">
        <span class="alert-unread"></span>
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
        <div class="alert-body">
            <div class="alert-head">
                <div class="alert-title">Transformador dañado</div>
                <span class="alert-pill st-amber"><span class="dot"></span>En proceso</span>
            </div>
            <p class="alert-desc">Operador en camino al sitio. Llegada estimada 4:30 pm.</p>
            <div class="alert-time">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                Hace 2 horas · #6
            </div>
            <button type="button" class="alert-action" onclick="event.preventDefault(); event.stopPropagation(); marcarLeida(this);">
                <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                Marcar como leída
            </button>
        </div>
    </a>

    <!-- ═══ AVERÍA #3 ═══ -->
    <a href="@Url.Action("EstadoAveria", "Clientes", new { id = 3 })"
       class="alert-item tipo-averia"
       data-tipo="averia"
       data-seccion="hoy">
        <span class="alert-unread"></span>
        <div class="alert-icon">
            <svg viewBox="0 0 24 24">
                <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
            </svg>
        </div>
