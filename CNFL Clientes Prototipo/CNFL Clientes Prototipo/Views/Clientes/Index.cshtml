@model List<CNFL_Clientes_Prototipo.Controllers.Usuario>

@{
    ViewBag.Title = "Listado de Clientes (Solo Admin)";
}

@if (Session["Rol"] != null && Session["Rol"].ToString() == "Admin")
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Clientes Registrados</h2>
        <span class="badge bg-primary">Vista Administrador</span>
    </div>
    <p class="text-muted">Los clientes que se registran en la app aparecen aquí automáticamente.</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Identificación</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>NISE</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Nombre.Substring(0, 1)@u.Apellidos.Substring(0, 1)</td>
                    <td>@u.Nombre @u.Apellidos</td>
                    <td>@u.Cedula</td>
                    <td>@u.Telefono</td>
                    <td>@u.Correo</td>
                    <td>@u.NISE</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No tiene permisos para ver esta sección. <a href="/Cuenta/Login">Inicie sesión como Admin</a></div>
}