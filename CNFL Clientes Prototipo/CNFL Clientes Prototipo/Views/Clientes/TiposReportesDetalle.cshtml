@{
    ViewBag.Title = "Detalle del Reporte";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var tipo = ViewBag.Tipo ?? "Avería";
}

@section Styles {
    <style>
        .td-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .td-back:hover {
                text-decoration: underline;
            }

        .td-header h1 {
            font-size: 24px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
            letter-spacing: -0.02em;
        }

        .td-header .td-sub {
            font-size: 13px;
            color: var(--muted);
            margin-top: 6px;
            line-height: 1.5;
        }

        .td-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 22px 20px;
            margin-top: 20px;
            box-shadow: var(--shadow-sm);
        }

            .td-card .ico-big {
                width: 64px;
                height: 64px;
                border-radius: 20px;
                background: #eef0ff;
                display: grid;
                place-items: center;
                font-size: 30px;
                margin-bottom: 14px;
            }

            .td-card .tipo-nombre {
                font-size: 18px;
                font-weight: 800;
                color: var(--ink);
                margin-bottom: 6px;
            }

            .td-card .tipo-desc {
                font-size: 13px;
                color: var(--muted);
                line-height: 1.6;
                margin-bottom: 18px;
            }

        .td-field {
            margin-bottom: 14px;
        }

        .td-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .td-input, .td-textarea {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 13px 15px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: #fff;
            transition: border-color .15s;
        }

            .td-input:focus, .td-textarea:focus {
                border-color: var(--blue);
            }

        .td-textarea {
            resize: vertical;
            min-height: 90px;
        }

        .td-btn {
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            margin-top: 8px;
            cursor: pointer;
            transition: transform .12s;
        }

            .td-btn:active {
                transform: scale(.97);
            }

        .td-btn-sec {
            width: 100%;
            background: #fff;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 14px;
            border-radius: 14px;
            margin-top: 10px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .td-btn-sec:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--blue);
            }
    </style>
}

<div class="td-header" style="text-align:left;">
    <a href="@Url.Action("TiposReportes", "Clientes")" class="td-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        Volver a tipos
    </a>
    <h1>Detalle del reporte</h1>
    <div class="td-sub">Completá los datos para enviar tu reporte de avería.</div>
</div>

<div class="td-card">
    <div class="ico-big">⚡</div>
    <div class="tipo-nombre">@tipo</div>
    <div class="tipo-desc">
        Reportá este tipo de avería. Un operador revisará tu caso y te notificará cuando esté en camino.
    </div>

    <div class="td-field">
        <label class="td-label">NÚMERO DE NISE</label>
        <input type="text" class="td-input" placeholder="Ej: 123456789" />
    </div>

    <div class="td-field">
        <label class="td-label">DIRECCIÓN</label>
        <input type="text" class="td-input" placeholder="Ej: San José, Avenida 5" />
    </div>

    <div class="td-field">
        <label class="td-label">DESCRIPCIÓN</label>
        <textarea class="td-textarea" placeholder="Describí brevemente el problema..."></textarea>
    </div>

    <button type="button" class="td-btn" onclick="alert('Reporte enviado correctamente.')">Enviar reporte</button>
    <a href="@Url.Action("TiposReportes", "Clientes")" class="td-btn-sec">Cancelar</a>
</div>