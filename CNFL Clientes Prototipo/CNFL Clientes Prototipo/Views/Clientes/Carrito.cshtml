@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="carrito-container">
    <h2>🛒 Mi Carrito</h2>
    <p>Productos seleccionados para comprar.</p>

    <div class="carrito-lista">
        <div class="carrito-item">
            <span>🔌 Cargador EV 7kW</span>
            <span>₡615,000</span>
            <button class="btn-eliminar" data-id="1">✕</button>
        </div>
        <div class="carrito-item">
            <span>💡 Kit LED inteligente</span>
            <span>₡42,900</span>
            <button class="btn-eliminar" data-id="2">✕</button>
        </div>
    </div>

    <div class="carrito-total">
        <h3>Total: ₡657,900</h3>
        <button class="btn-pagar-carrito">Proceder al pago</button>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/Content/cliente/carrito.css" />
}

@section Scripts {
    <script src="~/Scripts/cliente/carrito.js"></script>
}