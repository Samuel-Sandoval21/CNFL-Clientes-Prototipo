@{
    ViewBag.Title = "Generar Comprobante";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .gc-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .gc-back:hover {
                text-decoration: underline;
            }

        .gc-hero {
            background: linear-gradient(135deg, #64B9CD, #2c8aa3);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(100,185,205,.45);
            margin-top: 8px;
        }

            .gc-hero .ico {
                font-size: 34px;
                margin-bottom: 8px;
            }

            .gc-hero h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .gc-hero p {
                margin: 6px 0 0;
                font-size: 12.5px;
                opacity: .9;
                line-height: 1.4;
            }

        .gc-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 20px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .gc-field {
            margin-bottom: 14px;
        }

        .gc-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .gc-select, .gc-input {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 13px 15px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: #fff;
            transition: border-color .15s;
        }

            .gc-select:focus, .gc-input:focus {
                border-color: var(--blue);
            }

        .gc-btn {
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            margin-top: 8px;
            cursor: pointer;
            transition: transform .12s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .gc-btn:active {
                transform: scale(.97);
            }

        .gc-btn-sec {
            width: 100%;
            background: #fff;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 14px;
            border-radius: 14px;
            margin-top: 10px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .gc-btn-sec:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--blue);
            }

        .gc-alert {
            background: #eaf6fa;
            color: #2c8aa3;
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 12.5px;
            font-weight: 700;
            margin-bottom: 14px;
            line-height: 1.5;
        }
    </style>
}

<a href="@Url.Action("Reportes", "Clientes")" class="gc-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver a Reportes
</a>

<div class="gc-hero">
    <div class="ico">🧾</div>
    <h1>Generar comprobante</h1>
    <p>Descargá el comprobante de tu reporte de avería o gestión.</p>
</div>

<div class="gc-card">
    <div class="gc-alert">
        Seleccioná el tipo de comprobante que necesitás y te lo generamos al instante.
    </div>

    <div class="gc-field">
        <label class="gc-label">TIPO DE COMPROBANTE</label>
        <select class="gc-select" id="tipoComprobante">
            <option value="">Seleccioná una opción</option>
            <option value="reporte-averia">Comprobante de reporte de avería</option>
            <option value="pago-factura">Comprobante de pago de factura</option>
            <option value="tramite">Comprobante de trámite</option>
            <option value="suscripcion">Comprobante de suscripción</option>
        </select>
    </div>

    <div class="gc-field">
        <label class="gc-label">NÚMERO DE REFERENCIA</label>
        <input type="text" class="gc-input" id="numReferencia" placeholder="Ej: 10234 o TRM-2026-0001" />
    </div>

    <button type="button" class="gc-btn" onclick="generarComprobante()">
        📄 Generar comprobante
    </button>
    <a href="@Url.Action("Reportes", "Clientes")" class="gc-btn-sec">Cancelar</a>
</div>

@section Scripts {
    <script>
        function generarComprobante() {
            var tipo = document.getElementById('tipoComprobante').value;
            var ref = document.getElementById('numReferencia').value.trim();

            if (!tipo) { alert('Seleccioná un tipo de comprobante.'); return; }
            if (!ref) { alert('Ingresá un número de referencia.'); return; }

            alert('✅ Comprobante generado correctamente.\nReferencia: ' + ref + '\n\nEn el próximo sprint se descargará como PDF.');
        }
    </script>
}