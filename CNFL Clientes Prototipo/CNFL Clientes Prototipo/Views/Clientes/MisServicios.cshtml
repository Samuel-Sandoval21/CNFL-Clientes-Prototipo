@{
    ViewBag.Title = "Mis Servicios";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var nises = ViewBag.NISEs as List<CNFL_Clientes_Prototipo.Models.NISE> ?? new List<CNFL_Clientes_Prototipo.Models.NISE>();
    var facturasPorNise = ViewBag.FacturasPorNise as Dictionary<int, List<CNFL_Clientes_Prototipo.Models.Factura>> ?? new Dictionary<int, List<CNFL_Clientes_Prototipo.Models.Factura>>();
    var averiasActivas = ViewBag.AveriasActivas as List<CNFL_Clientes_Prototipo.Models.Averia> ?? new List<CNFL_Clientes_Prototipo.Models.Averia>();
    var totalNises = nises.Count;

    var nisePrincipal = nises.FirstOrDefault();
    var facturasPrincipal = nisePrincipal != null && facturasPorNise.ContainsKey(nisePrincipal.NiseId)
        ? facturasPorNise[nisePrincipal.NiseId]
        : new List<CNFL_Clientes_Prototipo.Models.Factura>();
    var facturaPendientePrincipal = facturasPrincipal.FirstOrDefault(f => !f.Pagada);
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           MIS SERVICIOS — REDISEÑADO
           ═══════════════════════════════════════════ */

        /* HERO del NISE principal */
        .ms-hero {
            background: linear-gradient(135deg, #001482 0%, #1E23E6 55%, #3b6ce0 100%);
            border-radius: 22px;
            padding: 20px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 18px 34px -12px rgba(30, 35, 230, 0.55);
            margin-bottom: 16px;
        }

            .ms-hero::after {
                content: "";
                position: absolute;
                right: -40px;
                top: -40px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

        .ms-hero-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 14px;
            position: relative;
            z-index: 2;
            gap: 12px;
        }

        .ms-hero .nise-label {
            font-size: 10px;
            font-weight: 800;
            opacity: 0.85;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .ms-hero .nise-numero {
            font-size: 22px;
            font-weight: 900;
            margin-top: 4px;
            letter-spacing: -0.5px;
            line-height: 1.1;
        }

        .ms-hero .nise-tipo {
            font-size: 11.5px;
            opacity: 0.9;
            margin-top: 4px;
        }

        .ms-hero .nise-estado {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255,255,255,0.2);
            color: #fff;
            font-size: 10.5px;
            font-weight: 800;
            padding: 5px 10px;
            border-radius: 999px;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            white-space: nowrap;
            flex-shrink: 0;
        }

            .ms-hero .nise-estado .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #64B95A;
                box-shadow: 0 0 0 2px rgba(100, 185, 90, 0.35);
                animation: pulseDot 2s infinite;
            }

            .ms-hero .nise-estado.alerta {
                background: rgba(245, 166, 35, 0.25);
                border-color: rgba(245, 166, 35, 0.4);
            }

                .ms-hero .nise-estado.alerta .dot {
                    background: #F5A623;
                    box-shadow: 0 0 0 2px rgba(245, 166, 35, 0.35);
                }

            .ms-hero .nise-estado.peligro {
                background: rgba(229, 72, 77, 0.25);
                border-color: rgba(229, 72, 77, 0.4);
            }

                .ms-hero .nise-estado.peligro .dot {
                    background: #E5484D;
                    box-shadow: 0 0 0 2px rgba(229, 72, 77, 0.35);
                }

        @@keyframes pulseDot {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.2);
                opacity: .8;
            }
        }

        .ms-hero .direccion {
            font-size: 12px;
            opacity: 0.9;
            margin-top: 12px;
            display: flex;
            align-items: flex-start;
            gap: 6px;
            line-height: 1.4;
            position: relative;
            z-index: 2;
        }

            .ms-hero .direccion svg {
                width: 14px;
                height: 14px;
                margin-top: 1px;
                flex-shrink: 0;
                opacity: 0.8;
            }

        /* Stats dentro del hero */
        .ms-hero-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 16px;
            position: relative;
            z-index: 2;
        }

        .ms-hero-stat {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 10px;
            backdrop-filter: blur(6px);
        }

            .ms-hero-stat .lbl {
                font-size: 9.5px;
                opacity: 0.85;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .ms-hero-stat .val {
                font-size: 15px;
                font-weight: 900;
                margin-top: 3px;
                letter-spacing: -0.3px;
            }

            .ms-hero-stat .sub {
                font-size: 9.5px;
                opacity: 0.75;
                margin-top: 1px;
            }

        /* Alert de factura pendiente dentro del hero */
        .ms-hero-alert {
            margin-top: 14px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 12px;
            padding: 11px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
            z-index: 2;
            backdrop-filter: blur(6px);
        }

            .ms-hero-alert svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                stroke: #FFD700;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .ms-hero-alert .txt {
                flex: 1;
                font-size: 11.5px;
                font-weight: 700;
                line-height: 1.4;
            }

            .ms-hero-alert .monto {
                font-weight: 900;
                font-size: 13px;
            }

        /* Acciones rápidas */
        .ms-acciones {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
        }

        .ms-accion {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 4px 14px rgba(16, 20, 40, 0.05);
            text-decoration: none;
            color: inherit;
            transition: transform .15s, box-shadow .15s;
        }

            .ms-accion:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(16, 20, 40, 0.1);
            }

            .ms-accion:active {
                transform: scale(0.98);
            }

        .ms-accion-icon {
            width: 42px;
            height: 42px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

            .ms-accion-icon svg {
                width: 20px;
                height: 20px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .ms-accion-icon.pago {
                background: linear-gradient(135deg, #e9f7ec, #d1f0d9);
                color: var(--green);
            }

            .ms-accion-icon.factura {
                background: linear-gradient(135deg, #eef0ff, #dde3ff);
                color: var(--blue);
            }

            .ms-accion-icon.consumo {
                background: linear-gradient(135deg, #fef3e0, #fde0a8);
                color: #c98a00;
            }

            .ms-accion-icon.medidor {
                background: linear-gradient(135deg, #fff3ec, #ffe2d1);
                color: var(--orange);
            }

        .ms-accion-txt .t {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.2;
        }

        .ms-accion-txt .s {
            font-size: 10.5px;
            color: var(--muted);
            margin-top: 2px;
            line-height: 1.3;
        }

        /* Secciones */
        .ms-section {
            margin-bottom: 20px;
        }

        .ms-section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .ms-section-title {
            font-size: 12px;
            font-weight: 800;
            color: var(--ink);
            display: flex;
            align-items: center;
            gap: 6px;
            letter-spacing: -0.01em;
        }

            .ms-section-title svg {
                width: 14px;
                height: 14px;
                stroke: var(--blue);
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .ms-section-link {
            font-size: 11px;
            color: var(--blue);
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .ms-section-link:hover {
                text-decoration: underline;
            }

        /* Cards de opciones */
        .ms-card {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 2px 10px rgba(16, 20, 40, 0.04);
            text-decoration: none;
            color: inherit;
            margin-bottom: 8px;
            transition: transform .15s, box-shadow .15s, border-color .15s;
            position: relative;
            overflow: hidden;
        }

            .ms-card:last-child {
                margin-bottom: 0;
            }

            .ms-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(16, 20, 40, 0.08);
                border-color: #d8dde8;
            }

            .ms-card:active {
                transform: scale(0.99);
            }

        .ms-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

            .ms-card-icon svg {
                width: 22px;
                height: 22px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .ms-card-icon.amber {
                background: linear-gradient(135deg, #fef3e0, #fde0a8);
                color: #c98a00;
            }

            .ms-card-icon.red {
                background: linear-gradient(135deg, #fdeaea, #fbd5d5);
                color: var(--red);
            }

            .ms-card-icon.sky {
                background: linear-gradient(135deg, #eef6ff, #d6ebff);
                color: #1a73e8;
            }

            .ms-card-icon.green {
                background: linear-gradient(135deg, #e9f7ec, #d1f0d9);
                color: var(--green);
            }

            .ms-card-icon.purple {
                background: linear-gradient(135deg, #f3f0ff, #e4daff);
                color: #5b3fbf;
            }

        .ms-card-txt {
            flex: 1;
            min-width: 0;
        }

            .ms-card-txt .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .ms-card-txt .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }

        .ms-card-chev {
            color: #c3c8d4;
            flex-shrink: 0;
        }

            .ms-card-chev svg {
                width: 18px;
                height: 18px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* Averías en seguimiento */
        .ms-averia {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 2px 10px rgba(16, 20, 40, 0.04);
            margin-bottom: 8px;
            text-decoration: none;
            color: inherit;
            position: relative;
            overflow: hidden;
            transition: transform .15s, box-shadow .15s;
        }

            .ms-averia:last-child {
                margin-bottom: 0;
            }

            .ms-averia:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(16, 20, 40, 0.08);
            }

            .ms-averia::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background: var(--amber);
            }

            .ms-averia.estado-ingresado::before {
                background: var(--red);
            }

            .ms-averia.estado-enproceso::before {
                background: var(--amber);
            }

            .ms-averia.estado-finalizado::before {
                background: var(--green);
            }

        .ms-averia-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: #fff3ec;
            color: var(--orange);
            flex-shrink: 0;
        }

            .ms-averia-icon svg {
                width: 20px;
                height: 20px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .ms-averia-txt {
            flex: 1;
            min-width: 0;
        }

            .ms-averia-txt .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .ms-averia-txt .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 3px;
            }

        .ms-pill {
            font-size: 10px;
            font-weight: 800;
            padding: 4px 9px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .ms-pill .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: currentColor;
            }

            .ms-pill.p-amber {
                background: #fef3e0;
                color: #b9791a;
            }

            .ms-pill.p-red {
                background: #fdeaea;
                color: var(--red);
            }

            .ms-pill.p-green {
                background: #e9f7ec;
                color: var(--green);
            }

        /* Estado vacío */
        .ms-empty {
            text-align: center;
            padding: 30px 20px;
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
        }

            .ms-empty .ico {
                font-size: 32px;
                margin-bottom: 8px;
            }

            .ms-empty .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                margin-bottom: 4px;
            }

            .ms-empty .s {
                font-size: 11.5px;
                color: var(--muted);
                line-height: 1.4;
            }

        /* Leyenda */
        .ms-leyenda {
            display: flex;
            gap: 11px;
            align-items: flex-start;
            padding: 14px;
            background: #f7f8fc;
            border: 1px dashed var(--line);
            border-radius: 16px;
            margin-top: 16px;
            margin-bottom: 100px;
        }

            .ms-leyenda .ico {
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: #eef0ff;
                display: grid;
                place-items: center;
                flex-shrink: 0;
                color: var(--blue);
            }

                .ms-leyenda .ico svg {
                    width: 18px;
                    height: 18px;
                    stroke: currentColor;
                    fill: none;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .ms-leyenda .txt .t {
                font-size: 12.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .ms-leyenda .txt .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.4;
            }
    </style>
}

<!-- ═══════════ APPBAR ═══════════ -->
<div class="appbar">
    <div class="brand">
        <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
             onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
    </div>
    <div class="actions">
        <a href="@Url.Action("Alertas", "Clientes")" class="icon-btn">
            @if (averiasActivas.Any())
            {
                <span class="badge">@averiasActivas.Count</span>
            }
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            </svg>
        </a>
    </div>
</div>

<h1 class="h-name" style="font-size:26px;">Mis Servicios</h1>
<p class="h-greet" style="margin-top:6px; line-height:1.5; margin-bottom:20px;">
    Todo lo relacionado con tus NISEs en un solo lugar.
</p>

<!-- ═══════════════ HERO DEL NISE PRINCIPAL ═══════════════ -->
@if (nisePrincipal != null)
{
    var facturaPendiente = facturaPendientePrincipal;
    var tieneDeuda = facturaPendiente != null;

    var estadoClase = "Normal";
    if (tieneDeuda) { estadoClase = "Pendiente"; }
    else if (nisePrincipal.TipoServicio == "Comercial" || nisePrincipal.TipoServicio == "Industrial") { estadoClase = "Prevención"; }

    var estadoClassCss = "nise-estado";
    var estadoTexto = "Normal";
    if (tieneDeuda)
    {
        estadoClassCss = "nise-estado peligro";
        estadoTexto = "Pendiente";
    }
    else if (nisePrincipal.TipoServicio == "Comercial")
    {
        estadoClassCss = "nise-estado alerta";
        estadoTexto = "Prevención";
    }
    else if (nisePrincipal.TipoServicio == "Industrial")
    {
        estadoClassCss = "nise-estado peligro";
        estadoTexto = "Revisión";
    }

    <div class="ms-hero">
        <div class="ms-hero-top">
            <div>
                <div class="nise-label">Servicio principal</div>
                <div class="nise-numero">@nisePrincipal.NumeroNise</div>
                <div class="nise-tipo">@nisePrincipal.TipoServicio</div>
            </div>
            <span class="@estadoClassCss">
                <span class="dot"></span>
                @estadoTexto
            </span>
        </div>

        <div class="direccion">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <span>@nisePrincipal.Provincia, @nisePrincipal.Canton, @nisePrincipal.Distrito</span>
        </div>

        <div class="ms-hero-stats">
            <div class="ms-hero-stat">
                <div class="lbl">Consumo mes</div>
                <div class="val">312 <span style="font-size:10px;opacity:.8;">kWh</span></div>
                <div class="sub">-12% vs anterior</div>
            </div>
            <div class="ms-hero-stat">
                <div class="lbl">Próxima lectura</div>
                <div class="val">15 <span style="font-size:10px;opacity:.8;">set</span></div>
                <div class="sub">En 5 días</div>
            </div>
            <div class="ms-hero-stat">
                <div class="lbl">Estado</div>
                <div class="val" style="font-size:13px;">@(tieneDeuda ? "Con deuda" : "Al día")</div>
                <div class="sub">@(tieneDeuda ? "Ver factura" : "Sin pendientes")</div>
            </div>
        </div>

        @if (tieneDeuda)
        {
            <div class="ms-hero-alert">
                <svg viewBox="0 0 24 24">
                    <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                </svg>
                <div class="txt">
                    Factura <span class="monto">₡@facturaPendiente.Monto.ToString("N0")</span>
                    · vence @facturaPendiente.FechaVencimiento.ToString("dd/MM/yyyy")
                </div>
                <a href="@Url.Action("MisFacturas", "Clientes")"
                   style="background:#fff; color:#1E23E6; padding:7px 12px; border-radius:9px; font-size:11px; font-weight:800; text-decoration:none;">
                    Pagar
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="ms-empty" style="margin-bottom:16px;">
        <div class="ico">🔌</div>
        <div class="t">Sin servicios asociados</div>
        <div class="s">Cuando tengas un NISE registrado, aparecerá acá.</div>
    </div>
}

<!-- ═══════════════ ACCIONES RÁPIDAS ═══════════════ -->
<div class="ms-acciones">
    @if (facturaPendientePrincipal != null)
    {
        <a href="@Url.Action("MisFacturas", "Clientes")" class="ms-accion">
            <div class="ms-accion-icon pago">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
            <div class="ms-accion-txt">
                <div class="t">Pagar factura</div>
                <div class="s">₡@facturaPendientePrincipal.Monto.ToString("N0") pendiente</div>
            </div>
        </a>
    }
    else
    {
        <a href="@Url.Action("MisFacturas", "Clientes")" class="ms-accion">
            <div class="ms-accion-icon pago">
                <svg viewBox="0 0 24 24">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <path d="m9 11 3 3L22 4" />
                </svg>
            </div>
            <div class="ms-accion-txt">
                <div class="t">Facturas al día</div>
                <div class="s">Sin pendientes</div>
            </div>
        </a>
    }

    <a href="@Url.Action("MisFacturas", "Clientes")" class="ms-accion">
        <div class="ms-accion-icon factura">
            <svg viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6M9 13h6M9 17h4" />
            </svg>
        </div>
        <div class="ms-accion-txt">
