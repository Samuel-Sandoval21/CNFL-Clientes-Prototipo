<!-- ═══════════════ SERVICIOS ASOCIADOS (NISEs) ═══════════════ -->
@if (nises.Count > 1)
{
    <div class="ms-section">
        <div class="ms-section-head">
            <div class="ms-section-title">
                <svg viewBox="0 0 24 24">
                    <path d="M3 10l9-7 9 7v9a2 2 0 0 1-2 2h-4v-6H9v6H5a2 2 0 0 1-2-2z" />
                </svg>
                Todos mis NISEs
            </div>
            <span style="font-size:11px; color:var(--muted); font-weight:700;">@totalNises totales</span>
        </div>

        @foreach (var n in nises.Skip(1))
        {
            var facturas = facturasPorNise.ContainsKey(n.NiseId) ? facturasPorNise[n.NiseId] : new List<CNFL_Clientes_Prototipo.Models.Factura>();
            var fPendiente = facturas.FirstOrDefault(f => !f.Pagada);
            var tieneDeudaN = fPendiente != null;

            var iconColor = "var(--green)";
            var iconBg = "#e9f7ec";
            var iconPath = "<path d=\"M9 21V9l6-6v18M9 13h6\" /><path d=\"M3 21h18\" />";

            if (n.TipoServicio == "Comercial")
            {
                iconBg = "#fef3e0";
                iconColor = "var(--amber)";
                iconPath = "<path d=\"M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6\" />";
            }
            else if (n.TipoServicio == "Industrial")
            {
                iconBg = "#fdeaea";
                iconColor = "var(--red)";
                iconPath = "<path d=\"M13 2 3 14h7l-1 8 10-12h-7z\" />";
            }

            var pillClass = tieneDeudaN ? "p-red" : "p-green";
            var pillTexto = tieneDeudaN ? "Pendiente" : "Normal";

            <a href="@Url.Action("MisFacturas", "Clientes")" class="ms-card">
                <div class="ms-card-icon" style="background:@iconBg; color:@iconColor;">
                    <svg viewBox="0 0 24 24">@Html.Raw(iconPath)</svg>
                </div>
                <div class="ms-card-txt">
                    <div class="t">@n.NumeroNise · @n.TipoServicio</div>
                    <div class="s">@n.Provincia, @n.Canton, @n.Distrito</div>
                    @if (tieneDeudaN)
                    {
                        <div style="margin-top:6px; font-size:11px; color:var(--red); font-weight:800;">
                            ⚠️ ₡@fPendiente.Monto.ToString("N0") pendiente
                        </div>
                    }
                </div>
                <span class="ms-pill @pillClass">
                    <span class="dot"></span>@pillTexto
                </span>
            </a>
        }
    </div>
}

