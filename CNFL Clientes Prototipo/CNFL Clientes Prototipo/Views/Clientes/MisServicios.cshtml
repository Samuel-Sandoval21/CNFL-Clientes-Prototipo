<!-- ═══════════════ AVERÍAS EN SEGUIMIENTO ═══════════════ -->
@if (averiasActivas.Any())
{
    <div class="ms-section">
        <div class="ms-section-head">
            <div class="ms-section-title">
                <svg viewBox="0 0 24 24">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                Averías en seguimiento
            </div>
            <a href="@Url.Action("HistorialReportes", "Clientes")" class="ms-section-link">
                Ver todas
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="m9 6 6 6-6 6" />
                </svg>
            </a>
        </div>

        @foreach (var a in averiasActivas.Take(3))
        {
            var estadoClass = "estado-enproceso";
            var pillClass = "p-amber";
            var estadoTexto = string.IsNullOrWhiteSpace(a.Estado) ? "Ingresado" : a.Estado;

            if (a.Estado == "Ingresado" || a.Estado == "Reportada")
            {
                estadoClass = "estado-ingresado";
                pillClass = "p-red";
            }
            else if (a.Estado == "Finalizada" || a.Estado == "Resuelta" || a.Estado == "Resuelto")
            {
                estadoClass = "estado-finalizado";
                pillClass = "p-green";
            }

            <a href="@Url.Action("EstadoAveria", "Clientes", new { id = a.AveriaId })" class="ms-averia @estadoClass">
                <div class="ms-averia-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M13 2 3 14h7l-1 8 10-12h-7z" />
                    </svg>
                </div>
                <div class="ms-averia-txt">
                    <div class="t">#@a.AveriaId · @a.Tipo</div>
                    <div class="s">@a.FechaReporte.ToString("dd/MM/yyyy · HH:mm")</div>
                </div>
                <span class="ms-pill @pillClass">
                    <span class="dot"></span>@estadoTexto
                </span>
            </a>
        }
    </div>
}

