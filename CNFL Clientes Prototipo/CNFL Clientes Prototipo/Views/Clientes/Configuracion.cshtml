@section Scripts {
    <script>
        // ═══════════ Zoom ═══════════
        var zoomActual = 100;
        var zoomMin = 80;
        var zoomMax = 150;

        function aplicarZoom(valor) {
            zoomActual = Math.max(zoomMin, Math.min(zoomMax, valor));

            var valorEl = document.getElementById('zoomValor');
            if (valorEl) valorEl.textContent = zoomActual + '%';

            var btnActual = document.getElementById('zoomActual');
            if (btnActual) {
                btnActual.textContent = zoomActual + '%';
                btnActual.classList.toggle('actual', zoomActual === 100);
            }

            document.documentElement.style.fontSize = (zoomActual / 100) * 16 + 'px';

            try { localStorage.setItem('cnfl_zoom', zoomActual); } catch (e) { }
        }

        function cambiarZoom(delta) {
            aplicarZoom(zoomActual + delta);
        }

        function resetZoom() {
            aplicarZoom(100);
        }

        // Cargar zoom guardado
        try {
            var guardado = localStorage.getItem('cnfl_zoom');
            if (guardado) {
                aplicarZoom(parseInt(guardado, 10));
            }
        } catch (e) { }

        // ═══════════ Modo oscuro ═══════════
        function toggleModoOscuro() {
            var toggle = document.getElementById('toggleOscuro');
            if (!toggle) return;
            toggle.classList.toggle('on');

            var activo = toggle.classList.contains('on');
            document.body.classList.toggle('modo-oscuro', activo);

            try { localStorage.setItem('cnfl_modo_oscuro', activo ? '1' : '0'); } catch (e) { }
        }

        // Cargar modo oscuro guardado
        try {
            var modoGuardado = localStorage.getItem('cnfl_modo_oscuro') === '1';
            if (modoGuardado) {
                var toggle = document.getElementById('toggleOscuro');
                if (toggle) toggle.classList.add('on');
                document.body.classList.add('modo-oscuro');
            }
        } catch (e) { }

        // ═══════════ Cerrar configuración ═══════════
        function cerrarConfig() {
            window.history.back();
        }
    </script>
}