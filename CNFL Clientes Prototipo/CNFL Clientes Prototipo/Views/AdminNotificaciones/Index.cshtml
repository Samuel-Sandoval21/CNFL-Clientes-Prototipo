@{
    ViewBag.Title = "Notificar";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var usuarios = ViewBag.Usuarios as List<CNFL_Clientes_Prototipo.Models.Usuario>
                   ?? new List<CNFL_Clientes_Prototipo.Models.Usuario>();
    var notificaciones = ViewBag.Notificaciones as List<CNFL_Clientes_Prototipo.Models.Notificacion>
                        ?? new List<CNFL_Clientes_Prototipo.Models.Notificacion>();

    var totalClientes = ViewBag.TotalClientes ?? 0;
    var totalNotif = ViewBag.TotalNotificaciones ?? 0;
    var totalLeidas = ViewBag.TotalLeidas ?? 0;
    var totalNoLeidas = ViewBag.TotalNoLeidas ?? 0;
}

@section Styles {
    <style>
        /* ═══ ESTADÍSTICAS ═══ */
        .notif-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 18px;
        }

        .notif-stat {
            background: #fff;
            border-radius: 14px;
            padding: 14px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border: 1px solid #eef0f5;
        }

            .notif-stat .lbl {
                font-size: 10px;
                color: #6b7280;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .4px;
            }

            .notif-stat .num {
                font-size: 20px;
                font-weight: 900;
                margin-top: 4px;
                color: #1a2b6b;
            }

            .notif-stat.green .num {
                color: #00a651;
            }

            .notif-stat.gold .num {
                color: #c98a00;
            }

            .notif-stat.purple .num {
                color: #5b3fbf;
            }

        /* ═══ TABS ═══ */
        .notif-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .notif-tab {
            padding: 9px 16px;
            background: #fff;
            border: 1.5px solid #e3e6ee;
            border-radius: 22px;
            font-size: 12px;
            font-weight: 700;
            color: #6b7280;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
            transition: all .18s;
            font-family: inherit;
        }

            .notif-tab.active {
                background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
                color: #fff;
                border-color: transparent;
                box-shadow: 0 6px 14px -6px rgba(26, 43, 107, .5);
            }

        /* ═══ FORMULARIO ═══ */
        .notif-card {
            background: #fff;
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border: 1px solid #eef0f5;
            margin-bottom: 16px;
        }

        .notif-card-title {
            font-size: 14px;
            font-weight: 800;
            color: var(--blue);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .notif-card-title i {
                font-size: 15px;
                color: var(--purple);
            }

        .notif-field {
            margin-bottom: 12px;
        }

            .notif-field label {
                display: block;
                font-size: 11px;
                font-weight: 800;
                color: #6b7280;
                margin-bottom: 6px;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .notif-field input[type="text"],
            .notif-field select,
            .notif-field textarea {
                width: 100%;
                padding: 11px 14px;
                border: 1.5px solid #e3e6ee;
                border-radius: 10px;
                font-family: inherit;
                font-size: 13.5px;
                color: var(--text);
                outline: none;
                background: #fff;
                transition: border-color .15s, box-shadow .15s;
            }

                .notif-field input:focus,
                .notif-field select:focus,
                .notif-field textarea:focus {
                    border-color: var(--blue);
                    box-shadow: 0 0 0 3px rgba(30, 35, 230, .08);
                }

            .notif-field textarea {
                min-height: 100px;
                resize: vertical;
                line-height: 1.5;
            }

        .notif-btn-send {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
            color: #fff;
            border: 0;
            border-radius: 12px;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 0 8px 18px -6px rgba(30, 35, 230, .5);
            transition: transform .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .notif-btn-send:active {
                transform: scale(.98);
            }

            .notif-btn-send:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .notif-aviso {
            display: none;
            margin-top: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 800;
            text-align: center;
        }

            .notif-aviso.ok {
                background: #e9f7ec;
                color: #2f8f3e;
                display: block;
            }

            .notif-aviso.err {
                background: #fdeaea;
                color: #c93a3f;
                display: block;
            }

        /* ═══ LISTA NOTIFICACIONES ═══ */
        .notif-item {
            display: flex;
            gap: 12px;
            padding: 14px;
            background: #fff;
            border: 1px solid #eef0f5;
            border-radius: 14px;
            margin-bottom: 10px;
            transition: transform .15s, box-shadow .15s;
            position: relative;
        }

            .notif-item:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(20, 30, 70, .08);
            }

            .notif-item.unread {
                border-left: 4px solid #1a2b6b;
            }

            .notif-item.read {
                border-left: 4px solid #e0e0e0;
                opacity: 0.85;
            }

        .notif-item-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: #eef0ff;
            color: var(--blue);
            flex-shrink: 0;
        }

            .notif-item-icon svg {
                width: 20px;
                height: 20px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .notif-item-body {
            flex: 1;
            min-width: 0;
        }

        .notif-item-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 4px;
        }

        .notif-item-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.25;
        }

        .notif-item-time {
            font-size: 10.5px;
            color: #6b7280;
            font-weight: 700;
            white-space: nowrap;
        }

        .notif-item-msg {
            font-size: 12px;
            color: #6b7280;
            line-height: 1.45;
        }

        .notif-item-user {
            font-size: 11px;
            color: var(--blue);
            font-weight: 800;
            margin-top: 6px;
        }

        .notif-empty {
            text-align: center;
            padding: 40px 20px;
            color: #6b7280;
        }

            .notif-empty i {
                font-size: 40px;
                color: #c9ced9;
                margin-bottom: 12px;
                display: block;
            }

            .notif-empty .t {
                font-size: 14px;
                font-weight: 800;
                color: var(--text);
                margin-bottom: 4px;
            }

            .notif-empty .s {
                font-size: 12px;
                line-height: 1.4;
            }

        /* ═══ CHIPS DE DESTINATARIOS ═══ */
        .notif-chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .notif-chip {
            padding: 6px 12px;
            background: #eef0f5;
            border: 1.5px solid transparent;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
            color: #6b7280;
            cursor: pointer;
            font-family: inherit;
            transition: all .15s;
        }

            .notif-chip.active {
                background: #eef0ff;
                border-color: var(--blue);
                color: var(--blue);
            }

        .notif-checkbox-wrap {
            max-height: 220px;
            overflow-y: auto;
            border: 1.5px solid #e3e6ee;
            border-radius: 12px;
            padding: 8px;
            background: #fafbfe;
        }

        .notif-checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: background .15s;
        }

            .notif-checkbox-row:hover {
                background: #f0f2f8;
            }

            .notif-checkbox-row input[type="checkbox"] {
                width: 18px;
                height: 18px;
                accent-color: var(--blue);
                cursor: pointer;
                flex-shrink: 0;
            }

            .notif-checkbox-row .info {
                flex: 1;
                min-width: 0;
            }

            .notif-checkbox-row .name {
                font-size: 12.5px;
                font-weight: 700;
                color: var(--text);
                line-height: 1.2;
            }

            .notif-checkbox-row .email {
                font-size: 11px;
                color: #6b7280;
                margin-top: 2px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
    </style>
}

<h1 class="page-title">Notificar</h1>
<p class="page-subtitle">Enviá notificaciones a tus clientes y consultá el historial.</p>

<!-- ═══ ESTADÍSTICAS ═══ -->
<div class="notif-stats">
    <div class="notif-stat">
        <div class="lbl">Clientes</div>
        <div class="num">@totalClientes</div>
    </div>
    <div class="notif-stat purple">
        <div class="lbl">Notificaciones</div>
        <div class="num">@totalNotif</div>
    </div>
    <div class="notif-stat green">
        <div class="lbl">Leídas</div>
        <div class="num">@totalLeidas</div>
    </div>
    <div class="notif-stat gold">
        <div class="lbl">No leídas</div>
        <div class="num">@totalNoLeidas</div>
    </div>
</div>

<!-- ═══ TABS ═══ -->
<div class="notif-tabs">
    <button type="button" class="notif-tab active" data-tab="enviar" onclick="cambiarTab('enviar', this);">📤 Enviar</button>
    <button type="button" class="notif-tab" data-tab="historial" onclick="cambiarTab('historial', this);">📋 Historial</button>
</div>

<!-- ═══════════════════════════════════════════
     TAB 1: ENVIAR NOTIFICACIÓN
     ═══════════════════════════════════════════ -->
<div id="tab-enviar" class="tab-panel">
    <div class="notif-card">
        <div class="notif-card-title">
            <i class="fas fa-paper-plane"></i>
            Nueva notificación
        </div>

        <div class="notif-field">
            <label>Destinatarios</label>
            <div class="notif-chips">
                <button type="button" class="notif-chip active" data-scope="todos" onclick="cambiarScope('todos', this);">Todos los clientes</button>
                <button type="button" class="notif-chip" data-scope="seleccion" onclick="cambiarScope('seleccion', this);">Seleccionar clientes</button>
            </div>

            <div id="wrapClientes" class="notif-checkbox-wrap" style="display:none;">
                @foreach (var u in usuarios)
                {
                    <label class="notif-checkbox-row">
                        <input type="checkbox" class="chk-cliente" value="@u.UsuarioId" />
                        <div class="info">
                            <div class="name">@u.Nombre @u.Apellidos</div>
                            <div class="email">@u.Correo · @u.Cedula</div>
                        </div>
                    </label>
                }
            </div>
        </div>

        <div class="notif-field">
            <label for="notifTitulo">Título</label>
            <input type="text" id="notifTitulo" placeholder="Ej: Mantenimiento programado" maxlength="100" />
        </div>

        <div class="notif-field">
            <label for="notifMensaje">Mensaje</label>
            <textarea id="notifMensaje" placeholder="Escribí el contenido de la notificación..." maxlength="500"></textarea>
        </div>

        <div class="notif-field">
            <label for="notifTipo">Tipo de notificación</label>
            <select id="notifTipo">
                <option value="General">General</option>
                <option value="Factura">Factura</option>
                <option value="Avería">Avería</option>
                <option value="Trámite">Trámite</option>
                <option value="Alerta">Alerta</option>
                <option value="Promoción">Promoción</option>
            </select>
        </div>

        <button type="button" id="btnEnviarNotif" class="notif-btn-send" onclick="enviarNotificacion();">
            <i class="fas fa-paper-plane"></i> Enviar notificación
        </button>

        <div id="notifAviso" class="notif-aviso"></div>
    </div>
</div>

<!-- ═══════════════════════════════════════════
     TAB 2: HISTORIAL
     ═══════════════════════════════════════════ -->
<div id="tab-historial" class="tab-panel" style="display:none;">
    <div class="notif-card">
        <div class="notif-card-title">
            <i class="fas fa-history"></i>
            Historial de notificaciones
        </div>

        @if (notificaciones.Any())
        {
            foreach (var n in notificaciones)
            {
                var clase = n.Leida ? "read" : "unread";
                <div class="notif-item @clase">
                    <div class="notif-item-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                        </svg>
                    </div>
                    <div class="notif-item-body">
                        <div class="notif-item-head">
                            <div class="notif-item-title">@n.Titulo</div>
                            <div class="notif-item-time">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="notif-item-msg">@Html.Raw(n.Mensaje)</div>
                        @if (!string.IsNullOrEmpty(n.Tipo))
                        {
                            <div class="notif-item-user">
                                @n.Tipo
                                @if (n.Leida)
                                {
                                    <text>· ✓ Leída</text>
                                }
                                else
                                {
                                    <text>· ⏳ No leída</text>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="notif-empty">
                <i class="fas fa-bell-slash"></i>
                <div class="t">Sin notificaciones</div>
                <div class="s">Cuando envíes notificaciones aparecerán acá.</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ═══════════ TABS ═══════════
        function cambiarTab(tab, btn) {
            document.querySelectorAll('.notif-tab').forEach(function (t) { t.classList.remove('active'); });
            btn.classList.add('active');

            document.querySelectorAll('.tab-panel').forEach(function (p) { p.style.display = 'none'; });
            var panel = document.getElementById('tab-' + tab);
            if (panel) panel.style.display = 'block';
        }

        // ═══════════ SCOPE (todos / selección) ═══════════
        var scopeActual = 'todos';

        function cambiarScope(scope, btn) {
            scopeActual = scope;
            document.querySelectorAll('.notif-chip').forEach(function (c) { c.classList.remove('active'); });
            btn.classList.add('active');

            var wrap = document.getElementById('wrapClientes');
            wrap.style.display = (scope === 'seleccion') ? 'block' : 'none';
        }

        // ═══════════ ENVIAR ═══════════
        function enviarNotificacion() {
            var titulo = document.getElementById('notifTitulo').value.trim();
            var mensaje = document.getElementById('notifMensaje').value.trim();
            var tipo = document.getElementById('notifTipo').value;

            if (!titulo) { alert('Escribí un título para la notificación.'); return; }
            if (!mensaje) { alert('Escribí un mensaje para la notificación.'); return; }

            var usuariosIds = [];
            if (scopeActual === 'seleccion') {
                var checks = document.querySelectorAll('.chk-cliente:checked');
                checks.forEach(function (c) { usuariosIds.push(parseInt(c.value, 10)); });
                if (usuariosIds.length === 0) {
                    alert('Seleccioná al menos un cliente.');
                    return;
                }
            }

            var btn = document.getElementById('btnEnviarNotif');
            var aviso = document.getElementById('notifAviso');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Enviando...';
            aviso.className = 'notif-aviso';
            aviso.style.display = 'none';

            var formData = new FormData();
            formData.append('titulo', titulo);
            formData.append('mensaje', mensaje);
            formData.append('tipo', tipo);
            formData.append('scope', scopeActual);
            if (usuariosIds.length > 0) {
                formData.append('usuariosIds', usuariosIds.join(','));
            }

            fetch('@Url.Action("EnviarNotificacion", "AdminNotificaciones")', {
                method: 'POST',
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.ok) {
                    aviso.className = 'notif-aviso ok';
                    aviso.textContent = '✓ ' + data.mensaje;
                    document.getElementById('notifTitulo').value = '';
                    document.getElementById('notifMensaje').value = '';
                    document.querySelectorAll('.chk-cliente:checked').forEach(function (c) { c.checked = false; });

                    setTimeout(function () {
                        window.location.reload();
                    }, 1500);
                } else {
                    aviso.className = 'notif-aviso err';
                    aviso.textContent = '✗ ' + (data.mensaje || 'Error al enviar');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar notificación';
                }
            })
            .catch(function () {
                aviso.className = 'notif-aviso err';
                aviso.textContent = '✗ Error de conexión';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar notificación';
            });
        }
    </script>
}