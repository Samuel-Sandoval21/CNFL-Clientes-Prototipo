@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";

    var logueado = Session["UsuarioId"] != null;
    var nombre = Session["Nombre"] as string ?? "";
}

<!-- ═══════════════ HERO ═══════════════ -->
<div class="hero-card">
    @if (logueado && !string.IsNullOrWhiteSpace(nombre))
    {
        <p class="greet">¡Hola, @nombre!</p>
        <h1>Bienvenido a CNFL</h1>
        <p class="sub">Tu energía, en una sola app.</p>
    }
    else
    {
        <p class="greet">Buenas tardes,</p>
        <h1>Bienvenido a CNFL</h1>
        <p class="sub">Tu energía, en una sola app.</p>
    }
</div>

@if (!logueado)
{
    <!-- Botones de acceso cuando NO está logueado -->
    <a href="@Url.Action("Login", "Cuenta")" class="reg-btn" style="display:block;text-align:center;text-decoration:none;background:var(--orange);box-shadow:0 8px 18px -8px rgba(255,105,45,.5);margin-top:14px;">
        Iniciar sesión
    </a>

    <a href="@Url.Action("Registro", "Cuenta")" class="reg-btn" style="display:block;text-align:center;text-decoration:none;background:#fff;color:var(--blue);border:1.5px solid var(--blue);box-shadow:none;margin-top:10px;">
        Crear cuenta
    </a>
}

<!-- ═══════════════ CONTÁCTANOS (reutilizable) ═══════════════ -->
@Html.Partial("_Contactanos")