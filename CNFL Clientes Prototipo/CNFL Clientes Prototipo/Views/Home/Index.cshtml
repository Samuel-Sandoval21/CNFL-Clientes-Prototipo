@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           HOME PÚBLICO — REDISEÑADO
           ═══════════════════════════════════════════ */

        /* Contenedor principal con protección blanca */
        .home-wrap {
            padding-top: 8px;
            padding-bottom: 100px;
        }

        /* ═══════════════════════════════════════════
           HERO / BIENVENIDA
           ═══════════════════════════════════════════ */
        .home-hero {
            background: linear-gradient(135deg, #0033A0 0%, #1E23E6 55%, #3b6ce0 100%);
            border-radius: 24px;
            padding: 26px 22px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 18px 36px -16px rgba(16, 20, 60, 0.55);
            margin-bottom: 18px;
        }

            .home-hero::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

            .home-hero::before {
                content: "";
                position: absolute;
                left: -80px;
                bottom: -80px;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(255,255,255,.10), transparent 70%);
            }

        .home-hero-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            position: relative;
            z-index: 2;
        }

            .home-hero-logo img {
                height: 36px;
                width: auto;
                filter: brightness(0) invert(1);
            }

        .home-hero-badge {
            font-size: 9.5px;
            font-weight: 800;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 4px 10px;
            border-radius: 999px;
            letter-spacing: .08em;
            text-transform: uppercase;
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .home-hero h1 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -.02em;
            margin: 0;
            line-height: 1.15;
            position: relative;
            z-index: 2;
        }

        .home-hero p {
            font-size: 13px;
            opacity: .92;
            margin: 10px 0 0;
            line-height: 1.55;
            position: relative;
            z-index: 2;
        }

        /* ═══════════════════════════════════════════
           BOTONES DE ACCESO
           ═══════════════════════════════════════════ */
        .home-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
        }

        .home-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 20px;
            border-radius: 14px;
            font-family: inherit;
            font-weight: 800;
            font-size: 14.5px;
            cursor: pointer;
            text-decoration: none;
            border: 0;
            transition: transform .15s, box-shadow .15s, background .15s;
            letter-spacing: .01em;
        }

            .home-btn:active {
                transform: scale(0.98);
            }

            .home-btn svg {
                width: 18px;
                height: 18px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* Botón primario (naranja) */
        .home-btn-primary {
            background: linear-gradient(135deg, var(--orange), #ff8a4c);
            color: #fff;
            box-shadow: 0 10px 22px -8px rgba(255, 105, 45, 0.6);
        }

            .home-btn-primary:hover {
                box-shadow: 0 12px 26px -8px rgba(255, 105, 45, 0.75);
            }

        /* Botón secundario (blanco con borde azul) */
        .home-btn-secondary {
            background: #ffffff;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            box-shadow: 0 4px 12px -4px rgba(30, 35, 230, 0.15);
        }

            .home-btn-secondary:hover {
                background: #f5f7ff;
                box-shadow: 0 6px 16px -4px rgba(30, 35, 230, 0.25);
            }

        /* ═══════════════════════════════════════════
           SECCIÓN CONTÁCTANOS
           ═══════════════════════════════════════════ */
        .home-section-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 4px;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -.01em;
        }

        .home-section-sub {
            font-size: 12px;
            color: var(--muted);
            margin: 0 0 14px;
            line-height: 1.5;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .contact-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 18px 12px;
            background: #ffffff;
            border: 1px solid var(--line);
            border-radius: 18px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 4px 14px rgba(16, 20, 40, 0.05);
            transition: transform .15s, box-shadow .15s, border-color .15s;
            position: relative;
            overflow: hidden;
        }

            .contact-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 22px rgba(16, 20, 40, 0.1);
                border-color: #d8dde8;
            }

            .contact-card:active {
                transform: scale(0.98);
            }

        .contact-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            margin-bottom: 12px;
            background: linear-gradient(135deg, #fff4ec, #ffe2d1);
            color: var(--orange);
        }

            .contact-icon svg {
                width: 26px;
                height: 26px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .contact-card:nth-child(2) .contact-icon {
            background: linear-gradient(135deg, #eef0ff, #dde3ff);
            color: var(--blue);
        }

        .contact-card:nth-child(3) .contact-icon {
            background: linear-gradient(135deg, #e9f7ec, #d1f0d9);
            color: var(--green);
        }

        .contact-card:nth-child(4) .contact-icon {
            background: linear-gradient(135deg, #f3f0ff, #e4daff);
            color: var(--purple);
        }

        .contact-title {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 6px;
            line-height: 1.25;
        }

        .contact-value {
            font-size: 12.5px;
            font-weight: 800;
            color: var(--blue);
            margin: 0 0 4px;
            line-height: 1.3;
            word-break: break-word;
        }

        .contact-note {
            font-size: 10.5px;
            color: var(--muted);
            margin: 0;
            line-height: 1.4;
        }

        /* ═══════════════════════════════════════════
           INFO ADICIONAL
           ═══════════════════════════════════════════ */
        .info-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 18px;
            padding: 18px;
            margin-top: 20px;
            box-shadow: 0 4px 16px rgba(16, 20, 40, 0.06);
        }

            .info-card h4 {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                margin: 0 0 10px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .info-card p {
                font-size: 12px;
                color: var(--muted);
                line-height: 1.6;
                margin: 0 0 8px;
            }

                .info-card p:last-child {
                    margin-bottom: 0;
                }

            .info-card a {
                color: var(--blue);
                font-weight: 800;
                text-decoration: none;
            }

                .info-card a:hover {
                    text-decoration: underline;
                }

        /* ═══════════════════════════════════════════
           FOOTER SEGURIDAD
           ═══════════════════════════════════════════ */
        .home-footer-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 16px;
            padding: 14px 18px;
            text-align: center;
            margin-top: 14px;
            box-shadow: 0 4px 16px rgba(16, 20, 40, 0.06);
        }

            .home-footer-card .line1 {
                font-size: 11px;
                color: var(--muted);
                font-weight: 700;
                line-height: 1.5;
            }

                .home-footer-card .line1 span {
                    display: inline-block;
                    padding: 0 4px;
                }

            .home-footer-card .line2 {
                font-size: 10.5px;
                color: var(--muted);
                opacity: 0.85;
                margin-top: 4px;
            }
    </style>
}

<div class="home-wrap">

    <!-- ═══════════════════════════════════════════
         HERO / BIENVENIDA
         ═══════════════════════════════════════════ -->
    <div class="home-hero">
        <div class="home-hero-logo">
            <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
                 onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
            <span class="home-hero-badge">Agencia Virtual</span>
        </div>

        <h1>Bienvenido a<br />CNFL Clientes</h1>
        <p>Tu energía, en una sola app. Gestioná tus servicios, consultá tus facturas y reportá averías desde cualquier lugar.</p>
    </div>

    <!-- ═══════════════════════════════════════════
         BOTONES DE ACCESO
         ═══════════════════════════════════════════ -->
    <div class="home-actions">
        <a href="@Url.Action("Login", "Cuenta")" class="home-btn home-btn-primary">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
            </svg>
            Iniciar sesión
        </a>

        <a href="@Url.Action("Registro", "Cuenta")" class="home-btn home-btn-secondary">
            <svg viewBox="0 0 24 24">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="8.5" cy="7" r="4" />
                <line x1="20" y1="8" x2="20" y2="14" />
                <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
            Crear cuenta
        </a>
    </div>

    <!-- ═══════════════════════════════════════════
         CONTÁCTANOS
         ═══════════════════════════════════════════ -->
    <h3 class="home-section-title">
        📞 Contáctanos
    </h3>
    <p class="home-section-sub">
        Estamos disponibles para ayudarte cuando lo necesites.
    </p>

    <div class="contact-grid">

        <!-- WhatsApp -->
        <a href="https://wa.me/50683195273" target="_blank" rel="noopener" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
            </div>
            <div class="contact-title">WhatsApp</div>
            <div class="contact-value">+506 8319-5273</div>
            <div class="contact-note">Lun-Vie 7:00am - 9:00pm<br />Sáb-Dom 7:00am - 3:00pm</div>
        </a>

        <!-- Correo -->
        <a href="mailto:800energia@cnfl.go.cr" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-10 5L2 7" />
                </svg>
            </div>
            <div class="contact-title">Correo electrónico</div>
            <div class="contact-value" style="font-size:11px;">800energia@cnfl.go.cr</div>
            <div class="contact-note">Respuesta en 24 horas</div>
        </a>

        <!-- Web Chat -->
        <a href="#" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    <circle cx="8.5" cy="10" r="0.8" fill="currentColor" />
                    <circle cx="12" cy="10" r="0.8" fill="currentColor" />
                    <circle cx="15.5" cy="10" r="0.8" fill="currentColor" />
                </svg>
            </div>
            <div class="contact-title">Web Chat</div>
            <div class="contact-value" style="font-size:11.5px;">Disponible</div>
            <div class="contact-note">Ícono inferior derecho</div>
        </a>

        <!-- Reporte de averías -->
        <a href="tel:1026" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
            </div>
            <div class="contact-title">Reporte de averías</div>
            <div class="contact-value">Llame al 1026</div>
            <div class="contact-note">Disponible 24 horas</div>
        </a>

        <!-- 800 Energía -->
        <a href="tel:8003637442" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                </svg>
            </div>
            <div class="contact-title">800 Energía</div>
            <div class="contact-value" style="font-size:11.5px;">800 363 7442</div>
            <div class="contact-note">Central telefónica</div>
        </a>

        <!-- Formulario -->
        <a href="#" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                </svg>
            </div>
            <div class="contact-title">Formulario</div>
            <div class="contact-value" style="font-size:11.5px;">Consultas</div>
            <div class="contact-note">Disponible en línea</div>
        </a>

    </div>

    <!-- ═══════════════════════════════════════════
         INFO ADICIONAL
         ═══════════════════════════════════════════ -->
    <div class="info-card">
        <h4>💡 Información útil</h4>
        <p>Consultá horarios de atención, sucursales, tarifas vigentes y preguntas frecuentes en nuestro sitio web.</p>
        <p>
            <a href="https://www.cnfl.go.cr" target="_blank" rel="noopener">Visitar cnfl.go.cr →</a>
        </p>
    </div>

    <!-- ═══════════════════════════════════════════
         FOOTER SEGURIDAD
         ═══════════════════════════════════════════ -->
    <div class="home-footer-card">
        <div class="line1">
            <span>Conexión segura</span>
            <span>·</span>
            <span>Términos y condiciones</span>
            <span>·</span>
            <span>Política de privacidad</span>
        </div>
        <div class="line2">
            © @DateTime.Now.Year Compañía Nacional de Fuerza y Luz S.A.
        </div>
    </div>

</div>