@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           HOME PÚBLICO — GLASSMORPHISM
           ═══════════════════════════════════════════ */

        .home-wrap {
            padding-top: 8px;
            padding-bottom: 100px;
        }

        /* HERO con efecto glass azul */
        .home-hero {
            background: linear-gradient(135deg, rgba(0, 51, 160, 0.9) 0%, rgba(30, 35, 230, 0.85) 55%, rgba(59, 108, 224, 0.85) 100%);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            padding: 26px 22px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 18px 36px -16px rgba(16, 20, 60, 0.55);
            margin-bottom: 18px;
        }

            .home-hero::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.18), transparent 70%);
            }

            .home-hero::before {
                content: "";
                position: absolute;
                left: -80px;
                bottom: -80px;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(255,255,255,.10), transparent 70%);
            }

        .home-hero-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            position: relative;
            z-index: 2;
        }

            .home-hero-logo img {
                height: 36px;
                width: auto;
                filter: brightness(0) invert(1);
            }

        .home-hero h1 {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -.02em;
            margin: 0;
            line-height: 1.15;
            position: relative;
            z-index: 2;
        }

        .home-hero p {
            font-size: 13px;
            opacity: .95;
            margin: 10px 0 0;
            line-height: 1.55;
            position: relative;
            z-index: 2;
        }

        /* BOTONES */
        .home-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
        }

        .home-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 20px;
            border-radius: 14px;
            font-family: inherit;
            font-weight: 800;
            font-size: 14.5px;
            cursor: pointer;
            text-decoration: none;
            border: 0;
            transition: transform .15s, box-shadow .15s, background .15s;
            letter-spacing: .01em;
        }

            .home-btn:active {
                transform: scale(0.98);
            }

            .home-btn svg {
                width: 18px;
                height: 18px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .home-btn-primary {
            background: linear-gradient(135deg, var(--orange), #ff8a4c);
            color: #fff;
            box-shadow: 0 10px 22px -8px rgba(255, 105, 45, 0.6);
        }

            .home-btn-primary:hover {
                box-shadow: 0 12px 26px -8px rgba(255, 105, 45, 0.75);
            }

        .home-btn-secondary {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: var(--blue);
            border: 1.5px solid rgba(30, 35, 230, 0.5);
            box-shadow: 0 4px 12px -4px rgba(30, 35, 230, 0.15);
        }

            .home-btn-secondary:hover {
                background: rgba(255, 255, 255, 0.92);
                box-shadow: 0 6px 16px -4px rgba(30, 35, 230, 0.25);
            }

        /* TÍTULO SECCIÓN */
        .home-section-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            margin: 0 0 4px;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -.01em;
        }

        .home-section-sub {
            font-size: 12px;
            color: var(--muted);
            margin: 0 0 14px;
            line-height: 1.5;
        }

        /* CONTÁCTANOS con GLASS */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .contact-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 8px;
            padding: 16px 12px;
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 16px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 4px 14px rgba(16, 20, 40, 0.06);
            transition: transform .15s, box-shadow .15s, background .15s;
            position: relative;
            overflow: hidden;
        }

            .contact-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 22px rgba(16, 20, 40, 0.1);
                background: rgba(255, 255, 255, 0.92);
            }

            .contact-card:active {
                transform: scale(0.98);
            }

        .contact-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: transparent;
            color: var(--blue);
        }

            .contact-icon svg {
                width: 24px;
                height: 24px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .contact-card:nth-child(1) .contact-icon {
            color: var(--orange);
        }

        .contact-card:nth-child(2) .contact-icon {
            color: var(--blue);
        }

        .contact-card:nth-child(3) .contact-icon {
            color: var(--green);
        }

        .contact-card:nth-child(4) .contact-icon {
            color: #5b3fbf;
        }

        .contact-title {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            margin: 0;
            line-height: 1.25;
        }

        /* INFO CARD con GLASS */
        .info-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 18px;
            padding: 18px;
            margin-top: 20px;
            box-shadow: 0 8px 24px rgba(16, 20, 40, 0.08);
        }

            .info-card h4 {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                margin: 0 0 10px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .info-card p {
                font-size: 12px;
                color: var(--muted);
                line-height: 1.6;
                margin: 0 0 8px;
            }

                .info-card p:last-child {
                    margin-bottom: 0;
                }

            .info-card a {
                color: var(--blue);
                font-weight: 800;
                text-decoration: none;
            }

                .info-card a:hover {
                    text-decoration: underline;
                }

        /* FOOTER con GLASS */
        .home-footer-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 16px;
            padding: 14px 18px;
            text-align: center;
            margin-top: 14px;
            box-shadow: 0 8px 24px rgba(16, 20, 40, 0.08);
        }

            .home-footer-card .line1 {
                font-size: 11px;
                color: var(--muted);
                font-weight: 700;
                line-height: 1.5;
            }

                .home-footer-card .line1 span {
                    display: inline-block;
                    padding: 0 4px;
                }

            .home-footer-card .line2 {
                font-size: 10.5px;
                color: var(--muted);
                opacity: 0.85;
                margin-top: 4px;
            }
    </style>
}

<div class="home-wrap">

    <!-- HERO -->
    <div class="home-hero">
        <div class="home-hero-logo">
            <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
                 onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
        </div>

        <h1>Bienvenido a<br />CNFL</h1>
        <p>Tu energía, en una sola app. Gestioná tus servicios, consultá tus facturas y reportá averías desde cualquier lugar.</p>
    </div>

    <!-- BOTONES -->
    <div class="home-actions">
        <a href="@Url.Action("Login", "Cuenta")" class="home-btn home-btn-primary">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
            </svg>
            Iniciar sesión
        </a>

        <a href="@Url.Action("Registro", "Cuenta")" class="home-btn home-btn-secondary">
            <svg viewBox="0 0 24 24">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="8.5" cy="7" r="4" />
                <line x1="20" y1="8" x2="20" y2="14" />
                <line x1="23" y1="11" x2="17" y2="11" />
            </svg>
            Crear cuenta
        </a>
    </div>

    <!-- CONTÁCTANOS -->
    <h3 class="home-section-title">📞 Contáctanos</h3>
    <p class="home-section-sub">Estamos disponibles para ayudarte cuando lo necesites.</p>

    <div class="contact-grid">

        <a href="https://wa.me/50683195273" target="_blank" rel="noopener" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                </svg>
            </div>
            <div class="contact-title">WhatsApp</div>
        </a>

        <a href="mailto:800energia@cnfl.go.cr" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-10 5L2 7" />
                </svg>
            </div>
            <div class="contact-title">Correo</div>
        </a>

        <a href="tel:1026" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
            </div>
            <div class="contact-title">Reporte de averías</div>
        </a>

        <a href="tel:8003637442" class="contact-card">
            <div class="contact-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                </svg>
            </div>
            <div class="contact-title">800 Energía</div>
        </a>

    </div>

    <!-- INFO ADICIONAL -->
    <div class="info-card">
        <h4>💡 Información útil</h4>
        <p>Consultá horarios de atención, sucursales, tarifas vigentes y preguntas frecuentes en nuestro sitio web.</p>
        <p>
            <a href="https://www.cnfl.go.cr" target="_blank" rel="noopener">Visitar cnfl.go.cr →</a>
        </p>
    </div>

    <!-- FOOTER -->
    <div class="home-footer-card">
        <div class="line1">
            <span>Conexión segura</span>
            <span>·</span>
            <span>Términos y condiciones</span>
            <span>·</span>
            <span>Política de privacidad</span>
        </div>
        <div class="line2">
            © @DateTime.Now.Year Compañía Nacional de Fuerza y Luz S.A.
        </div>
    </div>

</div>