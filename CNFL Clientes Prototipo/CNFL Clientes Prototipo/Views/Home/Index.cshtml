@{
    ViewBag.Title = "App Móvil";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/home-publico.css" />

<div class="public-home">
    <div style="text-align:center;">
        <img src="~/images/logo-cnfl.png" alt="CNFL" style="height:60px; width:auto; margin-bottom:16px;" />

        <h1>Tu energía, en una sola app.</h1>
        <p>Gestiona tu servicio eléctrico desde tu celular</p>

        <div class="btn-container">
            <a href="@Url.Action("Login", "Cuenta")" class="btn-cta-home">Iniciar Sesión</a>
            <a href="@Url.Action("Registro", "Cuenta")" class="btn-ghost-home">Crear Cuenta</a>
        </div>

        <div class="feature-grid">
            <div class="feature-item">
                <div class="icon">⚡</div>
                <div class="label">Reporta Averías</div>
            </div>
            <div class="feature-item">
                <div class="icon">💳</div>
                <div class="label">Paga tus facturas</div>
            </div>
            <div class="feature-item">
                <div class="icon">📊</div>
                <div class="label">Consulta tu consumo</div>
            </div>
        </div>

        <div class="footer-publico">
            <p>Consentimiento informado · Política de privacidad</p>
            <p>© 2026 CNFL - Todos los derechos reservados</p>
        </div>
    </div>
</div>