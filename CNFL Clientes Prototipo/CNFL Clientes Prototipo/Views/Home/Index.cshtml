@{
    ViewBag.Title = "Bienvenido";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/home-publico.css")" />

<div class="public-home">
    <div style="text-align:center; padding: 20px 16px;">
        <!-- LOGO CORRECTO -->
        <div style="display:flex; justify-content:center; align-items:center; gap:8px;">
            <svg width="48" height="48" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="25" cy="25" r="22" stroke="#1E23E6" stroke-width="2.5" />
                <path d="M25 10L12 28H20L14 42L34 22H26L30 10Z" fill="#1E23E6" />
            </svg>
            <span style="font-family:'Inter',sans-serif; font-weight:900; font-size:48px; color:#FF692D; letter-spacing:-2px; text-transform:lowercase;">cnfl</span>
        </div>

        <h1 class="titulo">Tu energía, en una sola app</h1>
        <p class="subtitulo">Gestiona tu servicio eléctrico desde tu celular</p>

        <div class="btn-container">
            <a href="@Url.Action("Login", "Cuenta")" class="btn-cta-home">
                Iniciar Sesión
            </a>
            <a href="@Url.Action("Registro", "Cuenta")" class="btn-ghost-home">
                Crear Cuenta
            </a>
        </div>

        <div class="feature-grid">
            <div class="feature-item">
                <div class="icon">⚡</div>
                <div class="label">Reporta Averías</div>
            </div>
            <div class="feature-item">
                <div class="icon">💳</div>
                <div class="label">Paga tus facturas</div>
            </div>
            <div class="feature-item">
                <div class="icon">📊</div>
                <div class="label">Consulta tu consumo</div>
            </div>
        </div>

        <div class="footer-publico">
            <p>Consentimiento informado · Política de privacidad</p>
            <p>© 2026 CNFL - Todos los derechos reservados</p>
        </div>
    </div>
</div>