@{
    ViewBag.Title = "Bienvenido";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<!-- CSS externo para Home Público -->
<link rel="stylesheet" href="@Url.Content("~/Content/home-publico.css")" />

<div class="public-home">
    <div style="text-align:center; padding: 20px 16px;">
        <!-- LOGO -->
        <div style="display:flex; justify-content:center; align-items:center; gap:4px;">
            <svg width="55" height="55" viewBox="0 0 50 50" fill="none">
                <path d="M25 5L10 25H18L12 45L35 22H25L30 5Z" stroke="#1E23E6" stroke-width="4" stroke-linejoin="round" />
                <path d="M12 33C15 43 25 48 35 44C42 41 47 34 46 28" stroke="#1E23E6" stroke-width="4" stroke-linecap="round" />
                <path d="M38 5C30 1 20 3 15 10" stroke="#1E23E6" stroke-width="4" stroke-linecap="round" />
            </svg>
            <span class="logo">cnfl</span>
        </div>

        <h1 class="titulo">Tu energía, en una sola app</h1>
        <p class="subtitulo">Gestiona tu servicio eléctrico desde tu celular</p>

        <!-- BOTONES -->
        <div class="btn-container">
            <a href="@Url.Action("Login", "Cuenta")" class="btn-cta-home">
                Iniciar Sesión
            </a>
            <a href="@Url.Action("Registro", "Cuenta")" class="btn-ghost-home">
                Crear Cuenta
            </a>
        </div>

        <!-- CARACTERÍSTICAS -->
        <div class="feature-grid">
            <div class="feature-item">
                <div class="icon">⚡</div>
                <div class="label">Reporta Averías</div>
            </div>
            <div class="feature-item">
                <div class="icon">💳</div>
                <div class="label">Paga tus facturas</div>
            </div>
            <div class="feature-item">
                <div class="icon">📊</div>
                <div class="label">Consulta tu consumo</div>
            </div>
        </div>

        <!-- PIE DE PÁGINA -->
        <div class="footer-publico">
            <p>Consentimiento informado · Política de privacidad</p>
            <p>© 2026 CNFL - Todos los derechos reservados</p>
        </div>
    </div>
</div>