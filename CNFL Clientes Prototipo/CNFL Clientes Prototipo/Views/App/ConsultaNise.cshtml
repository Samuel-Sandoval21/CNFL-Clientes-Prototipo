@{
    ViewBag.Title = "Consulta NISE";
}
<h2>Consulta de un NISE</h2>
<div class="card-cliente">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="check1">
        <label class="form-check-label" for="check1">Cédula de Identidad</label>
    </div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="check2">
        <label class="form-check-label" for="check2">No. de Localización</label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="check3">
        <label class="form-check-label" for="check3">No. de Medidor</label>
    </div>
    <input type="text" class="form-control mb-2" placeholder="Digite el valor a buscar" />
    <button class="btn btn-cnfl w-100">Buscar</button>
</div>