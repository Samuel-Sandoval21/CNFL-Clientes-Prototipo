@model CNFL_Clientes_Prototipo.Models.Averia

@{
    ViewBag.Title = "Reportar Avería";
}

<div class="card-cliente">
    <h3 class="texto-grande">Reportar Avería Eléctrica</h3>
    <hr />
    @using (Html.BeginForm("Create", "Averias", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            @Html.LabelFor(m => m.Titulo, new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Ej: Poste inclinado" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Descripcion, new { @class = "form-label fw-bold" })
            @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Direccion, new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control", placeholder = "Dirección exacta del problema" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Tipo, new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.Tipo, new List<SelectListItem>
            {
                new SelectListItem { Text = "Eléctrica", Value = "Eléctrica" },
                new SelectListItem { Text = "Alumbrado público", Value = "Alumbrado público" }
            }, "Seleccione el tipo", new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">📷 Adjuntar Foto</label>
            <input type="file" class="form-control" id="btn-reportar-averia" name="foto" accept="image/*" />
            <div class="form-text">En la app real, esto abrirá la cámara automáticamente.</div>
        </div>

        <button type="submit" class="btn btn-cnfl w-100">Enviar Reporte</button>
        @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-secondary w-100 mt-2" })
    }
</div>