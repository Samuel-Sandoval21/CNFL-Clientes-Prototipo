@model List<CNFL_Clientes_Prototipo.Models.Averia>

@{
    ViewBag.Title = "Estado de Averías";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="texto-grande">Estado de mis Averías</h2>
    <a href="@Url.Action("Create", "Averias")" class="btn btn-cnfl">+ Reportar</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No tiene averías reportadas actualmente.</div>
}

@foreach (var averia in Model)
{
    // Lógica para color y progreso según estado
    string colorBadge = "bg-secondary";
    string colorProgreso = "bg-secondary";
    int progreso = 0;
    string textoProgreso = "";

    switch (averia.Estado)
    {
        case "Reportado":
            colorBadge = "bg-danger";
            colorProgreso = "bg-danger";
            progreso = 25;
            textoProgreso = "Paso 1 de 4: Entregado";
            break;
        case "En revisión":
            colorBadge = "bg-warning text-dark";
            colorProgreso = "bg-warning";
            progreso = 50;
            textoProgreso = "Paso 2 de 4: En revisión";
            break;
        case "En camino":
            colorBadge = "bg-primary";
            colorProgreso = "bg-primary";
            progreso = 75;
            textoProgreso = "Paso 3 de 4: Operador en camino";
            break;
        case "Resuelto":
            colorBadge = "bg-success";
            colorProgreso = "bg-success";
            progreso = 100;
            textoProgreso = "Paso 4 de 4: Problema resuelto";
            break;
    }

    <div class="card-cliente">
        <div class="d-flex justify-content-between">
            <h5 class="texto-grande">@averia.Titulo</h5>
            <span class="badge @colorBadge">@averia.Estado</span>
        </div>

        @if (!string.IsNullOrEmpty(averia.FotoUrl))
        {
            <img src="@averia.FotoUrl" alt="Foto de la avería" class="img-fluid rounded my-3" style="max-height: 200px; object-fit: cover; border: 1px solid #ddd;" />
        }

        <p class="text-muted mb-1">📍 @averia.Direccion</p>
        <p class="text-muted mb-1">🕐 @averia.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
        <p class="mb-2">@averia.Descripcion</p>

        <!-- Barra de progreso dinámica -->
        <div class="progress" style="height: 8px;">
            <div class="progress-bar @colorProgreso" role="progressbar" style="width: @progreso%" aria-valuenow="@progreso" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <small class="text-muted">@textoProgreso</small>
    </div>
}