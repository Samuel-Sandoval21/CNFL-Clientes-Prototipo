@model List<CNFL_Clientes_Prototipo.Models.Averia>
@{
    ViewBag.Title = "Reportes y Mapa";
}

<div class="section-pad">
    <div class="h-name" style="font-size: 22px;">Reportes y mapa</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 2px;">Reporta una avería con foto y ubicación GPS.</div>
</div>

<!-- Mapa Interactivo (Visual) -->
<div class="section-pad" style="margin-top: 12px;">
    <div class="map-container">
        <div style="position:absolute; top:25%; left:25%;">
            <div class="map-pin" style="background: var(--red);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg></div>
        </div>
        <div style="position:absolute; top:50%; left:60%;">
            <div class="map-pin" style="background: var(--amber);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg></div>
        </div>
        <div style="position:absolute; top:70%; left:40%;">
            <div class="map-pin" style="background: var(--sky);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="3" width="12" height="18" rx="2" /><path d="M10 8h4M10 12h4" /></svg></div>
        </div>
        <div style="position:absolute; top:40%; left:80%;">
            <div class="map-pin" style="background: var(--green);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg></div>
        </div>
    </div>

    <div class="map-legend">
        <span class="pill"><span style="width:9px; height:9px; border-radius:50%; background: var(--red);"></span> Averías</span>
        <span class="pill"><span style="width:9px; height:9px; border-radius:50%; background: var(--sky);"></span> Recarga eléctrica</span>
        <span class="pill"><span style="width:9px; height:9px; border-radius:50%; background: var(--green);"></span> Puntos verdes</span>
    </div>
</div>

<!-- Estado de mis averías -->
<div class="section-pad">
    <div class="eyebrow">Estado de mis averías</div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No tienes averías reportadas.</div>
    }

    @foreach (var a in Model)
    {
        var estadoColor = "";
        var estadoTexto = "";
        var progreso = 0;
        var colorTextoEstado = "";

        switch (a.Estado)
        {
            case "Reportado":
                estadoColor = "var(--red)";
                estadoTexto = "Reportado";
                progreso = 25;
                colorTextoEstado = "#fff";
                break;
            case "En revisión":
                estadoColor = "var(--amber)";
                estadoTexto = "En revisión";
                progreso = 50;
                colorTextoEstado = "#fff";
                break;
            case "En camino":
                estadoColor = "var(--blue)";
                estadoTexto = "En camino";
                progreso = 75;
                colorTextoEstado = "#fff";
                break;
            case "Resuelto":
                estadoColor = "var(--green)";
                estadoTexto = "Resuelto";
                progreso = 100;
                colorTextoEstado = "#fff";
                break;
        }

        <div class="card-cliente">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div style="font-weight: 800; font-size: 15px;">@a.Titulo</div>
                    <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">📍 @a.Direccion</div>
                    <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">🕐 @a.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                    @if (!string.IsNullOrEmpty(a.Latitud))
                    {
                        <div style="font-size: 11px; color: var(--blue); margin-top: 2px;">📍 GPS: @a.Latitud, @a.Longitud</div>
                    }
                </div>
                <span class="pill" style="background: @estadoColor; color: @colorTextoEstado;">@estadoTexto</span>
            </div>

            <div style="font-size: 13px; color: var(--ink); margin-top: 10px;">@a.Descripcion</div>

            @if (!string.IsNullOrEmpty(a.FotoUrl))
            {
                <img src="@a.FotoUrl" alt="Foto avería" style="width: 100%; border-radius: 12px; margin-top: 10px; max-height: 180px; object-fit: cover;" />
            }

            <div class="progress" style="height: 10px; margin-top: 12px; background: #e6e9f2; border-radius: 10px;">
                <div class="progress-bar" style="width: @progreso%; background: @estadoColor;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); margin-top: 5px;">
                <span>@progreso%</span>
                <span>@estadoTexto</span>
            </div>
        </div>
    }
</div>

<!-- NUEVO REPORTE (Tres opciones elegantes) -->
<div class="section-pad">
    <div class="eyebrow">Nuevo reporte</div>
    <div class="row-item" onclick="window.location='/Averias/Create?tipo=alumbrado'">
        <div class="ic" style="background: #fef3e0;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2.5"><path d="M12 3v3M12 8a4 4 0 0 0-4 4v5h8v-5a4 4 0 0 0-4-4ZM9 21h6" /></svg></div>
        <div class="tx">
            <div class="t">Avería en alumbrado público</div>
            <div class="s">Foto + número de poste</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>

    <div class="row-item" onclick="window.location='/Averias/Create?tipo=propia'">
        <div class="ic" style="background: #fdeaea;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2.5"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg></div>
        <div class="tx">
            <div class="t">Avería eléctrica propia</div>
            <div class="s">En tu NISE registrado</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>

    <div class="row-item" onclick="window.location='/Averias/Create?tipo=ajena'">
        <div class="ic" style="background: #eef6ff;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2.5"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" /><circle cx="12" cy="9" r="2.5" /></svg></div>
        <div class="tx">
            <div class="t">Avería eléctrica ajena</div>
            <div class="s">Sube fotos y ubicación GPS</div>
        </div>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
    </div>
</div>