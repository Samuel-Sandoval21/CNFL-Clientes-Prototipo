@{
    ViewBag.Title = "Chat / WhatsApp";
}

<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <div class="h-name" style="font-size: 24px;">Asistente Virtual</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">800 ENERGÍA · 1026</div>
</div>

<div class="section-pad mt-3">
    <div class="card-cliente">
        <div style="height: 300px; overflow-y: auto; background: #f7f8fc; border-radius: 14px; padding: 12px;" id="chatBox">
            <div style="background: #fff; padding: 10px; border-radius: 10px; margin-bottom: 8px; font-size: 13px;">
                ¡Hola! Soy tu asistente virtual CNFL. ¿En qué puedo ayudarte?
            </div>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 12px;">
            <input type="text" id="chatInput" class="form-control" placeholder="Escribe tu consulta..." />
            <button type="button" class="btn btn-cnfl" style="padding: 10px 20px; width: auto; background: var(--blue);" onclick="enviarMensajeChat()">Enviar</button>
        </div>
    </div>
</div>