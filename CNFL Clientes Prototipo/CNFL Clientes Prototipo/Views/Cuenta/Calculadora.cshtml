@{
    ViewBag.Title = "Calculadora Energética";
}
<div style="padding: 20px;">
    <h2 style="font-weight:800; color:#001482;">Calculadora Energética</h2>
    <p class="text-muted">Estima el costo de tus equipos</p>
    <hr />
    <div class="card-cliente">
        <div class="mb-3">
            <label class="fw-bold">¿Cuántos kWh consumiste?</label>
            <input type="number" id="kwh" class="form-control" placeholder="Ej: 200" />
        </div>
        <button class="btn btn-cnfl mt-2" onclick="calcular()">Calcular</button>
        <div id="resultado" class="mt-3 alert alert-info" style="display:none;"></div>
    </div>
</div>

<script>
    function calcular() {
        var kwh = parseFloat(document.getElementById("kwh").value) || 0;
        var costo = kwh * 95; // Tarifa aproximada por kWh
        document.getElementById("resultado").style.display = "block";
        document.getElementById("resultado").innerHTML = "El costo aproximado es: <strong>₡" + costo.toLocaleString() + "</strong>";
    }
</script>