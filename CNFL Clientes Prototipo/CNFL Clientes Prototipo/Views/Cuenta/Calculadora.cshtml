@{
    ViewBag.Title = "Calculadora Energética";
}

<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <div class="h-name" style="font-size: 24px;">Calculadora energética</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Estima el costo de tus equipos según las horas de uso.</div>
</div>

<div class="section-pad mt-3">
    <div class="card-cliente">
        <div class="form-group">
            <label class="form-label">⚡ ¿Cuántos kWh consumiste?</label>
            <input type="number" id="kwh" class="form-input" placeholder="Ej: 200" />
        </div>

        <button type="button" class="btn btn-cnfl mt-2" style="background: var(--blue);" onclick="calcularConsumo()">Calcular costo estimado</button>

        <div id="resultado" class="mt-3 alert alert-info" style="display: none;"></div>
    </div>
</div>