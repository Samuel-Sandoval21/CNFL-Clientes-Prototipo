@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .toggle-password {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: grid;
            place-items: center;
            color: #aab0be;
            flex-shrink: 0;
            transition: color .2s ease;
        }

            .toggle-password:hover {
                color: #1E23E6 !important;
            }

            .toggle-password svg {
                width: 20px;
                height: 20px;
            }
    </style>
}

<div class="login-wrap">
    <div style="text-align:center;">
        <div style="font-size:48px; margin-bottom:8px;">⚡</div>
        <div class="login-h" style="margin-top:0;">Tu energía,<br>en una sola app.</div>
        <div class="login-p">Ingresa con las credenciales de tu Agencia Virtual.</div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="background:#E8F5E9; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #A5D6A7;">
            <span style="color:#2E7D32; font-weight:700;">✅ @TempData["Mensaje"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div style="background:#FFEBEE; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #FFCDD2;">
            <span style="color:#D32F2F; font-weight:700;">❌ @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage</span>
        </div>
    }

    @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>USUARIO O CÉDULA</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="9" cy="12" r="2.5" />
                    <path d="M14 10h4M14 14h4" />
                </svg>
                <input type="text" name="UserName" placeholder="Usuario o cédula" autocomplete="off" />
            </div>
        </div>

        <div class="field">
            <label>CONTRASEÑA</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="4" y="10" width="16" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
                <input type="password" name="Contraseña" id="passLogin" placeholder="••••••••" autocomplete="off" />
                <button type="button" class="toggle-password" data-target="passLogin" title="Mostrar/ocultar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-cta btn-block" style="margin-top:20px;">Ingresar</button>
    }

    <div style="margin-top:14px; text-align:center;">
        <a href="@Url.Action("RecuperarClave", "Cuenta")" style="color:var(--blue); font-weight:700; font-size:13px;">¿Olvidó su clave?</a>
    </div>

    <div class="bio">
        <div class="face" onclick="alert('🔐 Face ID simulado')">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" />
                <path d="M9 10v1M15 10v1M12 10v3l-1 1M9 15c1.5 1 4.5 1 6 0" />
            </svg>
        </div>
        <small>Ingresar con Face ID / Huella</small>
    </div>

    <div class="login-foot">
        <span>¿Aún no tienes cuenta?</span> <a href="@Url.Action("Registro", "Cuenta")">Regístrate con tu cédula</a><br>
        <span style="opacity:.7;">Consentimiento informado · Política de privacidad</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(function () {
            // Toggle mostrar/ocultar contraseña
            $('.toggle-password').on('click', function () {
                var targetId = $(this).data('target');
                var $input = $('#' + targetId);
                var esPassword = $input.attr('type') === 'password';

                if (esPassword) {
                    $input.attr('type', 'text');
                    $(this).html('<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>');
                } else {
                    $input.attr('type', 'password');
                    $(this).html('<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>');
                }
            });
        });
    </script>
}