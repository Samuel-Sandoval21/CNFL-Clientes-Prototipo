@{
    ViewBag.Title = "Iniciar Sesión";
}

<style>
    .field {
        margin-top: 16px;
    }

        .field label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .field .inp {
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 14px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .field .inp input {
                border: none;
                outline: none;
                width: 100%;
                font-family: inherit;
                font-size: 14px;
                background: transparent;
            }
</style>

<div class="login-wrap" style="padding: 30px 20px 0;">
    <div class="brand-logo">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1E23E6" stroke-width="2.5"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg>
        <span style="font-size: 22px; font-weight: 900; color: #FF692D; margin-left: 8px;">cnfl</span>
    </div>

    <div style="font-size: 28px; font-weight: 800; letter-spacing: -0.02em; margin-top: 34px; line-height: 1.15;">Tu energía,<br>en una sola app.</div>
    <div style="color: var(--muted); font-size: 13.5px; margin-top: 8px; line-height: 1.5;">Ingresa con las credenciales de tu Agencia Virtual.</div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }

    @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post))
    {
        <div class="field">
            <label>USUARIO</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2.5" /><path d="M14 10h4M14 14h4" /></svg>
                <input type="text" name="usuario" placeholder="cliente" />
            </div>
        </div>
        <div class="field">
            <label>CONTRASEÑA</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="contrasena" placeholder="••••••••" />
            </div>
        </div>
        <button type="submit" class="btn btn-cta btn-block" style="margin-top:20px; background: var(--orange); color:#fff; padding: 13px 20px; border-radius: 14px; border:none; font-weight:800;">Ingresar</button>
    }

    <div style="margin-top:22px; display:flex; flex-direction:column; align-items:center; gap:10px;">
        <div style="width:74px; height:74px; border-radius:50%; background: linear-gradient(135deg, var(--blue), var(--navy)); display:grid; place-items:center; cursor:pointer; box-shadow:0 12px 24px -8px rgba(30,35,230,.6);" onclick="location.href='/Cuenta/Index'">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" width="38" height="38"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" /><path d="M9 10v1M15 10v1M12 10v3l-1 1M9 15c1.5 1 4.5 1 6 0" /></svg>
        </div>
        <small style="font-size:12px; color:var(--muted); font-weight:700;">Ingresar con Face ID / Huella</small>
    </div>

    <div style="margin-top:auto; text-align:center; font-size:11px; color:var(--muted); line-height:1.5; margin-bottom: 20px; margin-top: 30px;">
        <span>¿Aún no tienes cuenta?</span> <a href="/Cuenta/Registro" style="color: var(--blue); font-weight: 800; text-decoration: none;">Regístrate con tu cédula</a><br>
        <span style="opacity:.7">Consentimiento informado · Política de privacidad</span>
    </div>
</div>