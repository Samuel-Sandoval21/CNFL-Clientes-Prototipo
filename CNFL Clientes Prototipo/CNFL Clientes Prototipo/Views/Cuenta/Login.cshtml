@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";

    var bioCedula = Request.QueryString["bio"] ?? "";
}

<div class="login-wrap">

    <!-- Logo CNFL -->
    <div style="text-align:center; margin-bottom:18px;">
        <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
             onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';"
             style="height:52px; width:auto; display:inline-block;" />
    </div>

    <div style="text-align:center;">
        <div class="login-h">Tu energía,<br />en una sola app.</div>
        <div class="login-p">Ingresá con las credenciales de tu Agencia Virtual.</div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="aviso ok" style="margin-top:16px;">@TempData["Mensaje"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="aviso err" style="margin-top:16px;">@ViewBag.Error</div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div class="aviso err" style="margin-top:16px;">
            @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
        </div>
    }

    @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post, new { id = "formLogin" }))
    {
        @Html.AntiForgeryToken()

        <div class="reg-field" style="margin-top:16px;">
            <label>Cédula o usuario</label>
            <input type="text"
                   name="UserName"
                   id="userNameLogin"
                   value="@bioCedula"
                   placeholder="Ej: 2-0874-0716 o tu usuario"
                   autocomplete="username"
                   required
                   style="width:100%;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;font-family:inherit;font-size:15px;outline:none;color:var(--ink);background:#fff;" />
        </div>

        <div class="reg-field">
            <label>Contraseña</label>
            <div style="position:relative;">
                <input type="password"
                       name="Contraseña"
                       id="passLogin"
                       placeholder="Tu contraseña"
                       autocomplete="current-password"
                       required
                       style="width:100%;padding:12px 44px 12px 14px;border:1.5px solid var(--line);border-radius:12px;font-family:inherit;font-size:15px;outline:none;color:var(--ink);background:#fff;" />
                <button type="button"
                        onclick="togglePass('passLogin', this);"
                        title="Mostrar/ocultar"
                        style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer;padding:8px;color:#aab0be;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <button type="submit"
                style="margin-top:22px;background:var(--orange);color:#fff;padding:15px 20px;border-radius:14px;border:0;font-family:inherit;font-weight:800;font-size:15px;width:100%;cursor:pointer;box-shadow:0 8px 18px -6px rgba(255,105,45,.7);">
            Ingresar
        </button>
    }

    <div style="margin-top:14px; text-align:center;">
        <a href="@Url.Action("RecuperarClave", "Cuenta")"
           style="color:var(--blue); font-weight:700; font-size:13px; text-decoration:none;">
            ¿Olvidaste tu clave?
        </a>
    </div>

    <!-- ═══════════ FACE ID + HUELLA ═══════════ -->
    <div style="margin-top:28px; display:flex; flex-direction:column; align-items:center; gap:12px;">
        <div style="display:flex; gap:16px; justify-content:center;">

            <!-- Face ID -->
            <button type="button"
                    onclick="loginBiometrico('face')"
                    title="Ingresar con Face ID"
                    style="width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--navy));border:0;display:grid;place-items:center;cursor:pointer;color:#fff;box-shadow:0 12px 24px -8px rgba(30,35,230,.6);">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" />
                    <path d="M9 10v1M15 10v1M12 10v3l-1 1M9 15c1.5 1 4.5 1 6 0" />
                </svg>
            </button>

            <!-- Huella -->
            <button type="button"
                    onclick="loginBiometrico('huella')"
                    title="Ingresar con huella dactilar"
                    style="width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--navy));border:0;display:grid;place-items:center;cursor:pointer;color:#fff;box-shadow:0 12px 24px -8px rgba(30,35,230,.6);">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4" />
                    <path d="M14 13.12c0 2.38 0 6.38-1 8.88" />
                    <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02" />
                    <path d="M2 12a10 10 0 0 1 18-6" />
                    <path d="M2 16h.01" />
                    <path d="M21.8 16c.2-2 .131-5.354 0-6" />
                    <path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2" />
                    <path d="M8.65 22c.21-.66.45-1.32.57-2" />
                    <path d="M9 6.8a6 6 0 0 1 9 5.2v2" />
                </svg>
            </button>

        </div>
        <small style="font-size:12px;color:var(--muted);font-weight:700;">
            Ingresar con Face ID o huella digital
        </small>
    </div>

    <div class="login-foot">
        <span>¿Aún no tenés cuenta?</span>
        <a href="@Url.Action("Registro", "Cuenta")">Registrate con tu cédula</a><br />
        <span style="opacity:.7;">Consentimiento informado · Política de privacidad</span>
    </div>
</div>

<!-- Overlay verificación biométrica -->
<div id="bioOverlay"
     style="position:fixed;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;z-index:9999;">
    <div style="background:#fff;border-radius:24px;padding:32px 28px;width:90%;max-width:320px;text-align:center;box-shadow:0 30px 60px -20px rgba(0,0,0,.4);">
        <div style="width:64px;height:64px;border-radius:50%;border:4px solid #eef0ff;border-top-color:#1E23E6;margin:0 auto 18px;animation:spin 1s linear infinite;"></div>
        <div style="font-size:15px;font-weight:800;color:#0E1116;">Verificando identidad...</div>
        <div style="font-size:12px;color:#727A86;margin-top:4px;">Usando datos biométricos guardados</div>
        <div style="height:6px;background:#eef0ff;border-radius:999px;margin-top:18px;overflow:hidden;">
            <div id="bioProgressBar" style="height:100%;width:0;background:linear-gradient(90deg,#1E23E6,#3b6ce0);border-radius:999px;transition:width .3s ease;"></div>
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<script>
    // ═════════ Toggle mostrar/ocultar contraseña ═════════
    function togglePass(id, btn) {
        var input = document.getElementById(id);
        if (!input) return;
        var esPassword = input.getAttribute('type') === 'password';
        input.setAttribute('type', esPassword ? 'text' : 'password');
        btn.innerHTML = esPassword
            ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
            : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    }

    // ═════════ Biometría ═════════
    var usuarioBiometrico = null;
    var bioCedulaPendiente = '@Html.Raw(bioCedula)';

    try {
        var guardado = localStorage.getItem('cnfl_bio_user');
        if (guardado) usuarioBiometrico = JSON.parse(guardado);
    } catch (e) { /* silencioso */ }

    if (bioCedulaPendiente && (!usuarioBiometrico || usuarioBiometrico.cedula !== bioCedulaPendiente)) {
        fetch('@Url.Action("GetUsuarioPorCedula", "Cuenta")?cedula=' + encodeURIComponent(bioCedulaPendiente))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    usuarioBiometrico = {
                        usuarioId: data.usuarioId,
                        cedula: bioCedulaPendiente,
                        token: data.token
                    };
                    localStorage.setItem('cnfl_bio_user', JSON.stringify(usuarioBiometrico));
                }
            })
            .catch(function () { /* silencioso */ });
    }

    function loginBiometrico(tipo) {
        if (!usuarioBiometrico || !usuarioBiometrico.usuarioId) {
            if (confirm('No hay un usuario biométrico registrado en este dispositivo.\n\n¿Querés iniciar sesión con tu cédula y contraseña?')) {
                var inputUser = document.getElementById('userNameLogin');
                if (inputUser) inputUser.focus();
            }
            return;
        }

        var overlay = document.getElementById('bioOverlay');
        var barra = document.getElementById('bioProgressBar');
        if (!overlay || !barra) return;

        overlay.style.display = 'flex';
        barra.style.width = '0';

        var pasos = 0;
        var intervalo = setInterval(function () {
            pasos += 20;
            barra.style.width = pasos + '%';

            if (pasos >= 100) {
                clearInterval(intervalo);

                var formData = new URLSearchParams();
                formData.append('usuarioId', usuarioBiometrico.usuarioId);
                formData.append('token', usuarioBiometrico.token);
                formData.append('tipo', tipo);

                fetch('@Url.Action("LoginBiometrico", "Cuenta")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    overlay.style.display = 'none';
                    if (data.success && data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        alert('❌ ' + (data.message || 'No se pudo autenticar con biometría.'));
                    }
                })
                .catch(function () {
                    overlay.style.display = 'none';
                    alert('❌ Error de conexión al verificar biometría.');
                });
            }
        }, 180);
    }
</script>