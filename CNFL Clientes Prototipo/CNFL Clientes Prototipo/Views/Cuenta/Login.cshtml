@{
    ViewBag.Title = "Iniciar Sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-cliente">
            <h3 class="text-center mb-4">Iniciar Sesión</h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post))
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">Usuario</label>
                    <input type="text" name="usuario" class="form-control" placeholder="admin" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Contraseña</label>
                    <input type="password" name="contrasena" class="form-control" placeholder="123" />
                </div>
                <button type="submit" class="btn btn-cnfl w-100">Ingresar</button>
            }
        </div>
    </div>
</div>