@{
    ViewBag.Title = "Bienvenido a CNFL";
    // Si está logueado, muestra su nombre; si no, muestra un saludo genérico
    var nombreMostrar = Session["Nombre"] != null ? Session["Nombre"].ToString() : "Bienvenido";
}

<div class="section-pad">
    <div class="h-greet">Hola,</div>
    <div class="h-name">@nombreMostrar</div>
</div>

<!-- Tarjeta de Factura (Bill) -->
<div class="section-pad">
    <div class="bill">
        <div class="bill-lbl">FACTURA PENDIENTE · NISE 4021</div>
        <div class="bill-amt">₡ 18.450</div>
        <div class="bill-due">Vence el 28 de agosto</div>
        <div class="bill-actions">
            <!-- ACTUALIZADO: Redirige a la vista de Detalle específica -->
            <button class="btn btn-ghost" onclick="window.location='/Facturas/Detalle?id=1'">Ver detalle</button>
            <a href="/Pagos" class="btn btn-cta">Pagar ahora</a>
        </div>
    </div>
</div>

<!-- Servicios Asociados (NISE) -->
<div class="section-pad">
    <div class="eyebrow">Mis servicios asociados (NISE)</div>

    <div class="nise">
        <div class="ring" style="background:#e9f7ec">
            <svg viewBox="0 0 24 24" fill="none" stroke="#64B95A" stroke-width="2"><path d="M9 21V9l6-6v18M9 13h6" /><path d="M3 21h18" /></svg>
        </div>
        <div class="info">
            <div class="t">Casa · NISE 4021</div>
            <div class="s">Residencial · San José</div>
        </div>
        <span class="pill st-normal"><span style="width:7px; height:7px; border-radius:50%; background:#64B95A;"></span> Normal</span>
    </div>

    <div class="nise">
        <div class="ring" style="background:#fef3e0">
            <svg viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6" /></svg>
        </div>
        <div class="info">
            <div class="t">Local · NISE 7788</div>
            <div class="s">Mantenimiento programado 2:00pm</div>
        </div>
        <span class="pill st-prev"><span style="width:7px; height:7px; border-radius:50%; background:#F5A623;"></span> Prevención</span>
    </div>

    <div class="nise">
        <div class="ring" style="background:#fdeaea">
            <svg viewBox="0 0 24 24" fill="none" stroke="#E5484D" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" /></svg>
        </div>
        <div class="info">
            <div class="t">Finca · NISE 9950</div>
            <div class="s">Avería en la red · atendiéndose</div>
        </div>
        <span class="pill st-inc"><span style="width:7px; height:7px; border-radius:50%; background:#E5484D; animation: pulse 1.2s infinite;"></span> Incidente</span>
    </div>
</div>

<!-- Gráfico de Consumo -->
<div class="section-pad">
    <div class="eyebrow">Consumo kWh · NISE 4021</div>
    <div class="chart-card">
        <canvas id="consumoChart" width="320" height="160" style="width: 100%; height: 160px;"></canvas>
        <div class="chart-tabs" id="chartTabs">
            <button class="chip active" data-periodo="6m" onclick="cambiarPeriodo('6m')">Últimos 6 meses</button>
            <button class="chip" data-periodo="31d" onclick="cambiarPeriodo('31d')">31 días</button>
            <button class="chip" data-periodo="lecturas" onclick="cambiarPeriodo('lecturas')">Lecturas</button>
        </div>
    </div>
</div>

<!-- Consulta al Medidor -->
<div class="section-pad">
    <div class="eyebrow">Consulta al medidor (AMI)</div>
    <div class="chart-card">
        <div class="mgrid">
            <div class="mcell"><div class="k">Última lectura</div><div class="v">742 <small>kWh</small></div></div>
            <div class="mcell"><div class="k">Acumulado del mes</div><div class="v">198 <small>kWh</small></div></div>
            <div class="mcell"><div class="k">Costo estimado</div><div class="v" style="color: var(--orange)">₡ 21.300</div></div>
            <div class="mcell"><div class="k">Promedio mensual</div><div class="v">205 <small>kWh</small></div></div>
        </div>
        <div class="social">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5" /></svg>
            <span>12% menos que el mes anterior · ¡buen ahorro!</span>
        </div>
    </div>
</div>