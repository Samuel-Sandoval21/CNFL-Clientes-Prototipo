@{
    ViewBag.Title = "Bienvenido a CNFL";
}

<div class="p-5 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #C45A00, #F47920);">
    <h1 class="display-5 fw-bold">⚡ CNFL Clientes</h1>
    <p class="lead">Celebremos la calidad y continuidad de nuestro servicio.</p>
    <hr class="my-4">
    <p>Consulte su factura, pague en línea, reporte averías con fotos y reciba notificaciones en tiempo real.</p>
    <a class="btn btn-warning btn-lg text-dark fw-bold" href="/Cuenta/Login">Iniciar Sesión</a>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card-cliente">
            <h3>🔔 Notificaciones</h3>
            <p>Entérese antes de que ocurra un corte o avería en su zona.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-cliente">
            <h3>📄 Pago en línea</h3>
            <p>Pague su factura de forma segura con SINPE, Tarjeta o IBAN.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-cliente">
            <h3>📷 Reporte con foto</h3>
            <p>Reporte averías tomando una foto directamente desde la app.</p>
        </div>
    </div>
</div>