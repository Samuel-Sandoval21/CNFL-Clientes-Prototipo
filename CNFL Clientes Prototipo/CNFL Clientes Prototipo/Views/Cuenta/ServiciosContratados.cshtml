@{
    ViewBag.Title = "Servicios Contratados";
}

<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <div class="h-name" style="font-size: 24px;">Servicios contratados</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Todos los servicios que tienes asociados a tu cuenta.</div>
</div>

<div class="section-pad">
    <div class="eyebrow">Servicios activos</div>

    <div class="row-item" style="cursor: default;">
        <div class="ic" style="background: #eef6ff;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" /><circle cx="12" cy="9" r="2.5" /></svg></div>
        <div class="tx">
            <div class="t">Servicio Eléctrico Residencial</div>
            <div class="s">NISE 4021 · Casa</div>
        </div>
        <span class="pill st-normal">Activo</span>
    </div>

    <div class="row-item" style="cursor: default;">
        <div class="ic" style="background: #eefbf0;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
        <div class="tx">
            <div class="t">Internet 5G</div>
            <div class="s">Plan Hogar 300MB</div>
        </div>
        <span class="pill st-normal">Activo</span>
    </div>

    <div class="row-item" style="cursor: default;">
        <div class="ic" style="background: #fff3ec;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2"><path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6" /></svg></div>
        <div class="tx">
            <div class="t">Servicio Comercial</div>
            <div class="s">NISE 7788 · Local</div>
        </div>
        <span class="pill st-normal">Activo</span>
    </div>
</div>