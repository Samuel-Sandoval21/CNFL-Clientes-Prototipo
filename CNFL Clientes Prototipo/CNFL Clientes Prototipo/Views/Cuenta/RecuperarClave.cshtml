@{
    ViewBag.Title = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<div class="login-wrap" style="padding:24px 20px;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
        <a href="@Url.Action("Login", "Cuenta")" style="font-size:28px; color:var(--ink); text-decoration:none;">←</a>
        <div class="login-h" style="font-size:24px; margin:0;">Recuperar Contraseña</div>
    </div>
    <div class="login-p" style="font-size:13px; margin-bottom:16px;">Ingresa tu correo y crea una nueva contraseña.</div>

    @if (ViewBag.Error != null)
    {
        <div style="background:#FFEBEE; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #FFCDD2;">
            <span style="color:#D32F2F; font-weight:700;">❌ @ViewBag.Error</span>
        </div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div style="background:#E8F5E9; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #A5D6A7;">
            <span style="color:#2E7D32; font-weight:700;">✅ @TempData["Mensaje"]</span>
        </div>
    }

    @using (Html.BeginForm("RecuperarClave", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>CORREO ELECTRÓNICO</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                <input type="email" name="correo" placeholder="usuario@correo.com" required />
            </div>
            <div style="font-size:11px; color:var(--muted); margin-top:4px;">Recibirás un enlace de verificación.</div>
        </div>

        <div class="field">
            <label>NUEVA CONTRASEÑA</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="nuevaClave" placeholder="••••••••" required />
            </div>
            <div style="font-size:11px; color:var(--muted); margin-top:4px;">Mínimo 6 caracteres.</div>
        </div>

        <div class="field">
            <label>CONFIRMAR CONTRASEÑA</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="confirmarClave" placeholder="••••••••" required />
            </div>
            <div style="font-size:11px; color:var(--muted); margin-top:4px;">Confirma tu nueva contraseña.</div>
        </div>

        <button type="submit" class="btn btn-cta btn-block" style="margin-top:8px;">Restablecer Contraseña</button>
    }

    <div style="text-align:center; margin-top:16px;">
        <a href="@Url.Action("Login", "Cuenta")" style="color:var(--blue); font-weight:700; font-size:13px;">Inicia sesión aquí</a>
    </div>

    <div class="login-foot" style="margin-top:16px;">
        <span style="opacity:.7;">Consentimiento informado · Política de privacidad</span>
    </div>
</div>