@{
    ViewBag.Title = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<!-- CSS específico para Recuperar Clave -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/recuperar-clave.css")" />
<!-- CSS compartido -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/cuenta.css")" />

<div class="recuperar-wrap">
    <!-- ===== HEADER ===== -->
    <div class="recuperar-header">
        <a href="@Url.Action("Login", "Cuenta")" class="back-link" title="Volver al inicio de sesión">←</a>
        <h1 class="recuperar-title">Recuperar Contraseña</h1>
    </div>

    <p class="recuperar-subtitle">Ingresa tu correo y crea una nueva contraseña para acceder a tu cuenta.</p>

    <!-- ===== ALERTAS ===== -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3" style="font-size: 14px; font-weight: 700; padding:12px 16px; border-radius:12px;">
            ❌ @ViewBag.Error
        </div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success mt-3" style="font-size: 14px; font-weight: 700; padding:12px 16px; border-radius:12px;">
            ✅ @TempData["Mensaje"]
        </div>
    }

    <!-- ===== FORMULARIO ===== -->
    <div class="recuperar-card">
        @using (Html.BeginForm("RecuperarClave", "Cuenta", FormMethod.Post, new { id = "recuperarForm" }))
        {
            @Html.AntiForgeryToken()

            <!-- ========================================================== -->
            <!-- CORREO -->
            <!-- ========================================================== -->
            <div class="field" id="correoRecuperarGroup">
                <label>CORREO ELECTRÓNICO</label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 5L2 7" />
                    </svg>
                    <input type="email" name="correo" id="correoRecuperar" required placeholder="usuario@correo.com" />
                    <span class="validation-icon" id="correoIcon"></span>
                </div>
                <div class="recuperar-hint" id="correoHint">Recibirás un enlace de verificación.</div>
            </div>

            <!-- ========================================================== -->
            <!-- NUEVA CONTRASEÑA -->
            <!-- ========================================================== -->
            <div class="field" id="nuevaClaveGroup">
                <label>NUEVA CONTRASEÑA</label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="10" width="16" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <input type="password" name="nuevaClave" id="nuevaClave" required placeholder="••••••••" />
                    <button type="button" class="toggle-password" onclick="togglePasswordRecuperar('nuevaClave')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <div class="recuperar-hint" id="passwordHint">Mínimo 6 caracteres.</div>
                <div class="password-strength" id="passwordStrength">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- CONFIRMAR CONTRASEÑA -->
            <!-- ========================================================== -->
            <div class="field" id="confirmarClaveGroup">
                <label>CONFIRMAR CONTRASEÑA</label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="10" width="16" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <input type="password" name="confirmarClave" id="confirmarClave" required placeholder="••••••••" />
                    <button type="button" class="toggle-password" onclick="togglePasswordRecuperar('confirmarClave')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <div class="recuperar-hint" id="confirmHint">Confirma tu nueva contraseña.</div>
            </div>

            <button type="submit" class="btn-register" style="background: var(--orange); box-shadow: 0 8px 18px -6px rgba(255,105,45,.7); margin-top: 8px;">
                Restablecer Contraseña
            </button>
        }

        <!-- ===== DIVISOR ===== -->
        <div class="recuperar-divider">
            <span>¿Recordaste tu contraseña?</span>
        </div>

        <div style="text-align: center;">
            <a href="@Url.Action("Login", "Cuenta")" style="color: var(--blue); font-weight: 700; font-size: 14px; text-decoration: none;">
                Inicia sesión aquí
            </a>
        </div>
    </div>

    <!-- ===== FOOTER ===== -->
    <div class="footer-text" style="margin-top: 16px;">
        <span style="opacity: .8;">Consentimiento informado · Política de privacidad</span>
    </div>
</div>

@section scripts {
    <!-- JS específico para Recuperar Clave -->
    <script src="@Url.Content("~/Scripts/cliente/recuperar-clave.js")"></script>
}