@{
    ViewBag.Title = "Recuperar clave";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           RECUPERAR CLAVE — GLASSMORPHISM
           ═══════════════════════════════════════════ */

        .recuperar-wrap {
            padding-top: 4px;
            padding-bottom: 100px;
        }

        .rec-logo-wrap {
            text-align: center;
            margin-bottom: 20px;
        }

            .rec-logo-wrap img {
                height: 44px;
                width: auto;
                display: inline-block;
            }

        .rec-hero {
            text-align: center;
            margin-bottom: 24px;
        }

            .rec-hero .rec-h {
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
                line-height: 1.2;
                color: var(--ink);
                margin: 0;
            }

            .rec-hero .rec-p {
                font-size: 12.5px;
                color: var(--muted);
                margin: 8px 0 0;
                line-height: 1.5;
                padding: 0 8px;
            }

        /* Formulario GLASS */
        .rec-form {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 24px rgba(16, 20, 40, 0.08);
            margin-bottom: 14px;
        }

        .rec-field {
            margin-bottom: 14px;
        }

            .rec-field:last-of-type {
                margin-bottom: 0;
            }

            .rec-field label {
                display: block;
                font-size: 10.5px;
                font-weight: 800;
                color: var(--muted);
                letter-spacing: .05em;
                text-transform: uppercase;
                margin-bottom: 6px;
            }

            .rec-field input {
                width: 100%;
                padding: 13px 14px;
                border: 1.5px solid rgba(237, 239, 243, 0.9);
                border-radius: 12px;
                font-family: inherit;
                font-size: 14.5px;
                outline: none;
                color: var(--ink);
                background: rgba(255, 255, 255, 0.85);
                transition: border-color .15s, background .15s, box-shadow .15s;
            }

                .rec-field input:focus {
                    border-color: var(--blue);
                    background: #ffffff;
                    box-shadow: 0 0 0 3px rgba(30, 35, 230, 0.1);
                }

                .rec-field input::placeholder {
                    color: #b5bcc9;
                }

        .rec-input-icon {
            position: relative;
        }

            .rec-input-icon input {
                padding-right: 46px;
            }

        .rec-toggle-pass {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: 0;
            cursor: pointer;
            padding: 8px;
            color: #aab0be;
            border-radius: 8px;
            display: grid;
            place-items: center;
            transition: color .15s;
        }

            .rec-toggle-pass:hover {
                color: var(--blue);
            }

            .rec-toggle-pass svg {
                width: 18px;
                height: 18px;
            }

        /* Aviso seguridad GLASS */
        .rec-aviso {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            background: rgba(238, 240, 255, 0.75);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(221, 227, 255, 0.8);
            border-radius: 12px;
            padding: 12px 14px;
            margin-top: 14px;
        }

        .rec-aviso-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: var(--blue);
            color: #fff;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }

            .rec-aviso-icon svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .rec-aviso-txt {
            flex: 1;
            font-size: 11.5px;
            color: #2a3a8a;
            line-height: 1.5;
        }

            .rec-aviso-txt strong {
                display: block;
                font-weight: 800;
                color: var(--blue);
                margin-bottom: 2px;
                font-size: 12px;
            }

        /* Botón principal */
        .rec-btn {
            width: 100%;
            padding: 15px;
            margin-top: 18px;
            border: 0;
            border-radius: 13px;
            background: linear-gradient(135deg, var(--orange), #ff8a4c);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 14.5px;
            letter-spacing: .01em;
            cursor: pointer;
            box-shadow: 0 8px 18px -6px rgba(255, 105, 45, 0.6);
            transition: transform .15s, box-shadow .15s;
        }

            .rec-btn:hover {
                box-shadow: 0 10px 22px -6px rgba(255, 105, 45, 0.7);
            }

            .rec-btn:active {
                transform: scale(0.98);
            }

        /* Divisor */
        .rec-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0 16px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

            .rec-divider::before,
            .rec-divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: linear-gradient(90deg, transparent, var(--line), transparent);
            }

        /* Botón volver GLASS */
        .rec-volver {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 16px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1.5px solid rgba(255, 255, 255, 0.7);
            border-radius: 13px;
            color: var(--blue);
            font-family: inherit;
            font-size: 13.5px;
            font-weight: 800;
            text-decoration: none;
            box-shadow: 0 4px 14px rgba(16, 20, 40, 0.06);
            transition: background .15s, transform .15s, border-color .15s;
            margin-bottom: 20px;
        }

            .rec-volver:hover {
                background: rgba(255, 255, 255, 0.95);
                border-color: rgba(195, 202, 255, 0.9);
                transform: translateX(-2px);
            }

            .rec-volver:active {
                transform: scale(0.98);
            }

            .rec-volver svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.4;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* Footer GLASS */
        .rec-footer {
            text-align: center;
            font-size: 10.5px;
            color: var(--muted);
            line-height: 1.6;
            padding: 16px 20px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 14px;
            margin-top: 8px;
            margin-bottom: 20px;
        }

            .rec-footer span {
                display: inline-block;
                padding: 0 4px;
            }
    </style>
}

<div class="recuperar-wrap">

    <!-- LOGO -->
    <div class="rec-logo-wrap">
        <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
             onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
    </div>

    <!-- TÍTULO -->
    <div class="rec-hero">
        <h1 class="rec-h">Recuperá tu clave</h1>
        <p class="rec-p">Ingresá tus datos y elegí una nueva contraseña.</p>
    </div>

    <!-- AVISOS -->
    @if (ViewBag.Mensaje != null)
    {
        <div class="aviso ok" style="margin-bottom:14px;">@ViewBag.Mensaje</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="aviso err" style="margin-bottom:14px;">@ViewBag.Error</div>
    }

    <!-- FORMULARIO -->
    @using (Html.BeginForm("RecuperarClave", "Cuenta", FormMethod.Post, new { id = "formRecuperar" }))
    {
        @Html.AntiForgeryToken()

        <div class="rec-form">

            <div class="rec-field">
                <label for="cedulaRecuperar">Cédula o correo</label>
                <input type="text"
                       name="cedula"
                       id="cedulaRecuperar"
                       placeholder="Ej: 2-0874-0716 o tu correo"
                       autocomplete="username"
                       required />
            </div>

            <div class="rec-field">
                <label for="nuevaContrasena">Nueva contraseña</label>
                <div class="rec-input-icon">
                    <input type="password"
                           name="nuevaContrasena"
                           id="nuevaContrasena"
                           placeholder="Mínimo 6 caracteres"
                           autocomplete="new-password"
                           minlength="6"
                           required />
                    <button type="button"
                            class="rec-toggle-pass"
                            onclick="togglePass('nuevaContrasena', this);"
                            title="Mostrar/ocultar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="rec-field">
                <label for="confirmarContrasena">Confirmar contraseña</label>
                <div class="rec-input-icon">
                    <input type="password"
                           name="confirmarContrasena"
                           id="confirmarContrasena"
                           placeholder="Repetí la contraseña"
                           autocomplete="new-password"
                           minlength="6"
                           required />
                    <button type="button"
                            class="rec-toggle-pass"
                            onclick="togglePass('confirmarContrasena', this);"
                            title="Mostrar/ocultar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="rec-aviso">
                <div class="rec-aviso-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </div>
                <div class="rec-aviso-txt">
                    <strong>Tu seguridad es primero</strong>
                    Usá una contraseña única que no uses en otros sitios.
                </div>
            </div>

            <button type="submit" class="rec-btn">
                Cambiar contraseña
            </button>

        </div>
    }

    <!-- DIVISOR -->
    <div class="rec-divider">
        <span>¿recordaste tu clave?</span>
    </div>

    <!-- BOTÓN VOLVER -->
    <a href="@Url.Action("Login", "Cuenta")" class="rec-volver">
        <svg viewBox="0 0 24 24">
            <path d="m15 18-6-6 6-6" />
        </svg>
        Volver al inicio de sesión
    </a>

    <!-- FOOTER -->
    <div class="rec-footer">
        <span>Consentimiento informado</span>
        <span>·</span>
        <span>Política de privacidad</span>
    </div>

</div>

@section Scripts {
    <script>
        function togglePass(id, btn) {
            var input = document.getElementById(id);
            if (!input) return;
            var esPassword = input.getAttribute('type') === 'password';
            input.setAttribute('type', esPassword ? 'text' : 'password');
            btn.innerHTML = esPassword
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        }

        document.getElementById('formRecuperar').addEventListener('submit', function (e) {
            var pass = document.getElementById('nuevaContrasena').value;
            var conf = document.getElementById('confirmarContrasena').value;
            if (pass.length < 6) {
                e.preventDefault();
                alert('La contraseña debe tener al menos 6 caracteres.');
                return;
            }
            if (pass !== conf) {
                e.preventDefault();
                alert('Las contraseñas no coinciden.');
                return;
            }
        });
    </script>
}