@{
    ViewBag.Title = "Recuperar contraseña";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";
}

<div class="rec-hero">
    <div class="rec-icon">🔑</div>
    <h1>Recuperar contraseña</h1>
    <p>Ingresá tu correo electrónico y elegí una contraseña nueva.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="aviso err">@ViewBag.Error</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="aviso ok">@TempData["Mensaje"]</div>
}

@using (Html.BeginForm("RecuperarClave", "Cuenta", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="rec-card">
        <div class="reg-field">
            <label for="correo">Correo electrónico</label>
            <input type="email"
                   id="correo"
                   name="correo"
                   placeholder="tu@correo.com"
                   autocomplete="email"
                   required />
        </div>

        <div class="reg-field">
            <label for="nuevaClave">Contraseña nueva</label>
            <input type="password"
                   id="nuevaClave"
                   name="nuevaClave"
                   placeholder="Mínimo 6 caracteres"
                   autocomplete="new-password"
                   minlength="6"
                   required />
        </div>

        <div class="reg-field">
            <label for="confirmarClave">Confirmar contraseña</label>
            <input type="password"
                   id="confirmarClave"
                   name="confirmarClave"
                   placeholder="Repetí la contraseña"
                   autocomplete="new-password"
                   minlength="6"
                   required />
        </div>

        <button type="submit" class="rec-btn">Actualizar contraseña</button>
    </div>
}

<div class="rec-back">
    <a href="@Url.Action("Login", "Cuenta")">← Volver a iniciar sesión</a>
</div>