@model CNFL_Clientes_Prototipo.Controllers.Usuario
@{
    ViewBag.Title = "Editar Datos";
}
<div style="padding: 20px;">
    <h2 style="font-weight:800; color:#001482;">Editar Mis Datos</h2>
    <hr />
    @using (Html.BeginForm("EditarDatos", "Cuenta", FormMethod.Post))
    {
        <div class="mb-3">
            <label class="fw-bold">Nombre</label>
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            <label class="fw-bold">Apellidos</label>
            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            <label class="fw-bold">Teléfono</label>
            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
        </div>
        <div class="mb-3">
            <label class="fw-bold">Correo</label>
            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email" })
        </div>
        <button type="submit" class="btn btn-cnfl">Guardar Cambios</button>
    }
</div>