            $('#actividadEconomica').select2({
                placeholder: 'Seleccione o busque una actividad...',
                allowClear: true,
                width: '100%',
                minimumInputLength: 0,
                ajax: {
                    url: '@Url.Action("SearchActividades", "Cuenta")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { q: params.term || 'a' }; },
                    processResults: function (data) { return { results: data }; },
                    cache: true
                },
                language: {
                    inputTooShort: function () { return 'Escriba para filtrar...'; },
                    noResults: function () { return 'Sin resultados'; },
                    searching: function () { return 'Buscando...'; }
                }
            });

            // === Provincia / Cantón / Distrito ===
            const dataCR = {
