            window.abrirDocumento = function (tipo) {
                var titulo = '', contenido = '';
                if (tipo === 'politica') {
                    titulo = 'Política de Privacidad y Seguridad';
                    contenido = '<p>La CNFL se compromete a proteger la privacidad y los datos personales de sus clientes, en cumplimiento con la Ley N.° 8968.</p><h4>1. Datos recopilados</h4><p>Cédula, nombre, apellidos, correo, teléfono, dirección y NISE.</p><h4>2. Uso</h4><p>Gestión del servicio eléctrico, facturación, comunicación y obligaciones legales.</p><h4>3. Derechos</h4><p>Acceso, rectificación, cancelación y oposición escribiendo a info@cnfl.go.cr.</p>';
                } else {
                    titulo = 'Consentimiento Informado (F-085)';
                    contenido = '<p>El usuario manifiesta su consentimiento libre, previo, expreso e informado para que la CNFL trate sus datos personales conforme al formulario F-085.</p><h4>1. Finalidad</h4><p>Gestión del servicio eléctrico, facturación y obligaciones legales.</p><h4>2. Alcance</h4><p>Recopilación, almacenamiento, uso, circulación y supresión de datos, según la Ley N.° 8968.</p><h4>3. Revocatoria</h4><p>Puede revocar su consentimiento escribiendo a info@cnfl.go.cr.</p>';
                }
                document.getElementById('cnflModalTitle').innerText = titulo;
                document.getElementById('cnflModalBody').innerHTML = contenido;
                document.getElementById('cnflModal').style.display = 'flex';
            };
            window.cerrarDocumento = function () { document.getElementById('cnflModal').style.display = 'none'; };
            document.getElementById('cnflModal').addEventListener('click', function (e) { if (e.target === this) cerrarDocumento(); });
        });
