@model CNFL_Clientes_Prototipo.Models.Usuario
@{
    ViewBag.Title = "Crear cuenta";
    Layout = "~/Views/Shared/_LayoutPublico.cshtml";

    var actividades = ViewBag.ActividadesEconomicas as List<CNFL_Clientes_Prototipo.Models.ActividadEconomicaDto>
                      ?? new List<CNFL_Clientes_Prototipo.Models.ActividadEconomicaDto>();

    var nombreCompletoPrevio = ViewBag.NombreCompleto as string ?? "";
    var aceptoPoliticaPrevio = ViewBag.AceptoPolitica as bool? ?? false;
    var aceptoConsentimientoPrevio = ViewBag.AceptoConsentimiento as bool? ?? false;
    var facturaElectronicaPrevia = ViewBag.FacturaElectronica as bool? ?? false;
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           AUTORIZACIONES — CHECKBOX MEJORADO
           ═══════════════════════════════════════════ */
        .auth-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
        }

            .auth-card h3 {
                margin: 0 0 14px;
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                display: flex;
                align-items: center;
                gap: 8px;
            }

        .auth-item {
            display: block;
            background: #fafbfe;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 14px;
            cursor: pointer;
            transition: border-color .15s, background .15s;
            margin-bottom: 10px;
            position: relative;
        }

            .auth-item:last-child {
                margin-bottom: 0;
            }

            .auth-item:hover {
                border-color: #d8dde8;
            }

            .auth-item.marcado {
                border-color: var(--blue);
                background: #f5f7ff;
            }

        .auth-item-header {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        /* Checkbox customizado */
        .auth-check {
            width: 24px;
            height: 24px;
            border-radius: 7px;
            border: 2px solid var(--line);
            background: #fff;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            margin-top: 1px;
            transition: all .15s;
            position: relative;
        }

            .auth-check svg {
                width: 14px;
                height: 14px;
                stroke: #fff;
                stroke-width: 3;
                stroke-linecap: round;
                stroke-linejoin: round;
                fill: none;
                opacity: 0;
                transform: scale(0.5);
                transition: opacity .15s, transform .15s;
            }

        .auth-item.marcado .auth-check {
            background: var(--blue);
            border-color: var(--blue);
        }

            .auth-item.marcado .auth-check svg {
                opacity: 1;
                transform: scale(1);
            }

        /* Icono diferenciador */
        .auth-icono {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: #eef0ff;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            color: var(--blue);
        }

            .auth-icono svg {
                width: 19px;
                height: 19px;
                stroke: currentColor;
                stroke-width: 1.8;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .auth-item.marcado .auth-icono {
            background: var(--blue);
            color: #fff;
        }

        /* Texto */
        .auth-txt {
            flex: 1;
            min-width: 0;
        }

        .auth-titulo {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.3;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .auth-req {
            color: var(--red);
            font-weight: 800;
        }

        .auth-desc {
            font-size: 11.5px;
            color: var(--muted);
            margin-top: 4px;
            line-height: 1.4;
        }

        /* Link como botón */
        .auth-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 10px;
            padding: 8px 12px;
            background: #fff;
            border: 1.5px solid var(--blue);
            border-radius: 10px;
            color: var(--blue);
            font-size: 11.5px;
            font-weight: 800;
            text-decoration: none;
            transition: background .15s, color .15s;
            cursor: pointer;
        }

            .auth-link:hover {
                background: var(--blue);
                color: #fff;
            }

            .auth-link svg {
                width: 13px;
                height: 13px;
                stroke: currentColor;
                fill: none;
                stroke-width: 2.2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* ═══════════════════════════════════════════
           MODAL LEGAL — REDISEÑADO (v2)
           ═══════════════════════════════════════════ */
        .modal-legal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(14, 17, 22, 0.6);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 300;
            display: none;
            align-items: flex-end;
            justify-content: center;
            padding: 0 0 90px 0; /* espacio abajo para el tabbar */
        }

            .modal-legal-overlay.show {
                display: flex;
            }

        .modal-legal-box {
            width: 100%;
            max-width: 430px;
            max-height: 68vh;
            background: #ffffff;
            border-radius: 24px 24px 0 0;
            display: flex;
            flex-direction: column;
            box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.35);
            animation: modalLegalUp .3s ease;
        }

        @@keyframes modalLegalUp {
            from {
                transform: translateY(100%);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .modal-legal-handle {
            width: 44px;
            height: 4px;
            background: #d8dde8;
            border-radius: 2px;
            margin: 12px auto 0;
            flex-shrink: 0;
        }

        /* Header fijo */
        .modal-legal-header {
            padding: 16px 22px 14px;
            flex-shrink: 0;
            border-bottom: 1px solid var(--line);
            background: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

            .modal-legal-header h3 {
                font-size: 16px;
                font-weight: 800;
                margin: 0;
                color: var(--blue);
                line-height: 1.25;
            }

            .modal-legal-header p {
                font-size: 11.5px;
                color: var(--muted);
                margin: 4px 0 0;
                line-height: 1.4;
            }

        .modal-legal-close {
            background: #eef0ff;
            border: 0;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            color: var(--blue);
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            transition: background .15s, transform .15s;
        }

            .modal-legal-close:hover {
                background: #dde3ff;
            }

            .modal-legal-close:active {
                transform: scale(0.92);
            }

        /* Contenido scrolleable */
        .modal-legal-content {
            flex: 1;
            overflow-y: auto;
            padding: 20px 22px 24px;
            -webkit-overflow-scrolling: touch;
        }

            .modal-legal-content::-webkit-scrollbar {
                width: 0;
            }

            /* Estilos internos del contenido legal */
            .modal-legal-content h2 {
                font-size: 15px;
                color: var(--blue);
                margin: 0 0 14px;
                font-weight: 800;
                line-height: 1.3;
            }

            .modal-legal-content h3 {
                font-size: 13px;
                color: var(--ink);
                margin: 18px 0 8px;
                font-weight: 800;
                line-height: 1.3;
            }

            .modal-legal-content p {
                margin: 0 0 12px;
                font-size: 13px;
                line-height: 1.7;
                color: #2a2f38;
                text-align: justify;
            }

            .modal-legal-content strong {
                color: var(--ink);
                font-weight: 800;
            }

            .modal-legal-content ul,
            .modal-legal-content ol {
                margin: 0 0 12px;
                padding-left: 20px;
            }

            .modal-legal-content li {
                font-size: 13px;
                line-height: 1.6;
                color: #2a2f38;
                margin-bottom: 6px;
            }

        /* Footer fijo con botón — REDISEÑADO */
        .modal-legal-footer {
            padding: 16px 22px 24px;
            background: #ffffff;
            border-top: 1px solid var(--line);
            flex-shrink: 0;
            box-shadow: 0 -4px 12px -4px rgba(0, 0, 0, 0.05);
        }

        .modal-legal-btn {
            width: 100%;
            padding: 15px 16px;
            border: 0;
            border-radius: 14px;
            background: var(--blue);
            color: #fff;
            font-family: inherit;
            font-weight: 800;
            font-size: 14.5px;
            cursor: pointer;
            box-shadow: 0 8px 18px -8px rgba(30, 35, 230, 0.5);
            transition: transform .15s, background .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .modal-legal-btn:hover {
                background: #0d1b9e;
            }

            .modal-legal-btn:active {
                transform: scale(0.98);
            }

        /* Loading state */
        .modal-legal-loading {
            text-align: center;
            padding: 40px 20px;
            color: var(--muted);
            font-size: 13px;
        }

            .modal-legal-loading::before {
                content: "";
                display: block;
                width: 32px;
                height: 32px;
                margin: 0 auto 12px;
                border: 3px solid #eef0ff;
                border-top-color: var(--blue);
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
}

<!-- ═══════════ LOGO Y TÍTULO ═══════════ -->
<div class="reg-hero" style="padding-top:20px;">
    <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
         onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';"
         style="height:42px; width:auto; display:inline-block; margin-bottom:10px;" />
    <h1>Crear cuenta</h1>
    <p>Registrate con tu cédula para gestionar tus servicios CNFL.</p>
</div>

<!-- ═══════════ ERRORES DE VALIDACIÓN ═══════════ -->
@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div class="aviso err">
        <ul style="padding-left:18px; margin:0;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post, new { id = "formRegistro" }))
{
    @Html.AntiForgeryToken()

    <!-- DATOS PERSONALES -->
    <div class="reg-card">
        <h3>👤 Datos personales</h3>

        <div class="reg-field">
            <label for="Cedula">Cédula *</label>
            <input type="text" id="Cedula" name="Cedula" placeholder="Ej: 1 2345 6789" required maxlength="20"
                   value="@(Model != null ? Model.Cedula : "")" />
            <small class="hint">Sin guiones. Solo números y espacios.</small>
        </div>

        <div class="reg-field">
            <label for="NombreCompleto">Nombre completo *</label>
            <input type="text" id="NombreCompleto" name="NombreCompleto"
                   value="@nombreCompletoPrevio" placeholder="Ej: Juan Pérez Mora"
                   autocomplete="name" required />
            <small class="hint">Escribí nombre y dos apellidos.</small>
        </div>

        <div class="reg-field">
            <label for="NombreUsuario">Nombre de usuario *</label>
            <input type="text" id="NombreUsuario" name="NombreUsuario" placeholder="Ej: juanperez"
                   required maxlength="50" autocomplete="username"
                   value="@(Model != null ? Model.NombreUsuario : "")" />
            <small class="hint">Con este nombre vas a poder iniciar sesión (además de la cédula).</small>
        </div>
    </div>

    <!-- CONTACTO -->
    <div class="reg-card">
        <h3>📞 Contacto</h3>

        <div class="reg-field">
            <label for="Correo">Correo principal *</label>
            <input type="email" id="Correo" name="Correo" placeholder="Ej: tucorreo@dominio.com"
                   autocomplete="email" required
                   value="@(Model != null ? Model.Correo : "")" />
            <small class="hint">Ahí te enviaremos facturas y notificaciones.</small>
        </div>

        <div class="reg-field">
            <label for="Telefono">Teléfono principal *</label>
            <input type="tel" id="Telefono" name="Telefono" placeholder="Ej: 8888-8888"
                   autocomplete="tel" maxlength="15" required
                   value="@(Model != null ? Model.Telefono : "")" />
            <small class="hint">Formato: 8 dígitos con guion.</small>
        </div>
    </div>

    <!-- CONTRASEÑA -->
    <div class="reg-card">
        <h3>🔒 Contraseña</h3>

        <div class="reg-field">
            <label for="Contraseña">Contraseña *</label>
            <div style="position:relative;">
                <input type="password" id="Contraseña" name="Contraseña" placeholder="Mínimo 6 caracteres"
                       autocomplete="new-password" minlength="6" required
                       style="padding-right:44px;" />
                <button type="button" onclick="togglePass('Contraseña', this);" title="Mostrar/ocultar"
                        style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer;padding:8px;color:#aab0be;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
            <small class="hint">Mínimo 6 caracteres. Te recomendamos mezclar letras y números.</small>
        </div>

        <div class="reg-field">
            <label for="confirmarContraseña">Confirmar contraseña *</label>
            <div style="position:relative;">
                <input type="password" id="confirmarContraseña" name="confirmarContraseña"
                       placeholder="Repetí la contraseña" autocomplete="new-password"
                       minlength="6" required style="padding-right:44px;" />
                <button type="button" onclick="togglePass('confirmarContraseña', this);" title="Mostrar/ocultar"
                        style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer;padding:8px;color:#aab0be;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- FACTURA ELECTRÓNICA -->
    <div class="reg-card">
        <h3>🧾 Facturación electrónica</h3>

        <label class="reg-check" for="chkFactura">
            <input type="checkbox" id="chkFactura" name="FacturaElectronica" value="true"
                   @(facturaElectronicaPrevia ? "checked" : "")
                   onchange="toggleFactura(this);" />
            <span class="txt">
                <span class="t">Quiero recibir factura electrónica</span>
                <span class="s">Si marcás esta casilla, elegí tu actividad económica debajo.</span>
            </span>
        </label>

        <div class="reg-actividad" id="actividadWrap" style="display:@(facturaElectronicaPrevia ? "block" : "none");">
            <div class="reg-field">
                <label for="buscadorActividad">Actividad económica</label>
                <input type="text" id="buscadorActividad"
                       placeholder="Buscá por código o nombre (ej: 4711, comercio)"
                       autocomplete="off"
                       onfocus="mostrarActividades();"
                       oninput="filtrarActividades();" />
                <small class="hint">Escribí al menos 3 letras o el código para filtrar.</small>

                <div id="listaActividades" style="margin-top:8px;max-height:220px;overflow-y:auto;border:1px solid var(--line);border-radius:12px;background:#fff;display:none;">
                    @foreach (var item in actividades)
                    {
                        var idStr = item.Id.ToString();
                        var textStr = item.Codigo + " - " + item.Nombre;
                        <div class="actividad-item"
                             data-value="@idStr"
                             data-text="@textStr.ToLower()"
                             style="padding:10px 14px;border-bottom:1px solid var(--line);cursor:pointer;font-size:13px;"
                             onclick="seleccionarActividad(this);">
                            @textStr
                        </div>
                    }
                </div>

                <div id="actividadSeleccionada" style="display:none;margin-top:8px;padding:10px 14px;background:#eef0ff;border-radius:12px;font-size:12.5px;font-weight:800;color:var(--blue);">
                    ✓ <span id="actividadTexto"></span>
                </div>

                <input type="hidden" id="ActividadEconomicaId" name="ActividadEconomicaId" value="" />
            </div>
        </div>
    </div>

    <!-- AUTORIZACIONES -->
    <div class="auth-card">
        <h3>⚖️ Autorizaciones</h3>

        <label class="auth-item @(aceptoPoliticaPrevio ? "marcado" : "")" for="chkPolitica" id="authPoliticaItem">
            <div class="auth-item-header">
                <div class="auth-check">
                    <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                </div>
                <div class="auth-icono">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                </div>
                <div class="auth-txt">
                    <div class="auth-titulo">
                        Acepto la Política de Privacidad
                        <span class="auth-req">*</span>
                    </div>
                    <div class="auth-desc">
                        Autorizo el tratamiento de mis datos personales según la ley 8968.
                    </div>
                    <a href="javascript:void(0);"
                       onclick="event.preventDefault(); event.stopPropagation(); abrirLegal('politica');"
                       class="auth-link">
                        <svg viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                        </svg>
                        Ver documento
                    </a>
                </div>
            </div>
            <input type="checkbox" id="chkPolitica" name="AceptoPolitica" value="true"
                   @(aceptoPoliticaPrevio ? "checked" : "")
                   onchange="toggleAuth(this, 'authPoliticaItem');"
                   style="position:absolute;opacity:0;pointer-events:none;" />
        </label>

        <label class="auth-item @(aceptoConsentimientoPrevio ? "marcado" : "")" for="chkConsentimiento" id="authConsentItem">
            <div class="auth-item-header">
                <div class="auth-check">
                    <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                </div>
                <div class="auth-icono">
                    <svg viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                    </svg>
                </div>
                <div class="auth-txt">
                    <div class="auth-titulo">
                        Acepto el Consentimiento Informado
                        <span class="auth-req">*</span>
                    </div>
                    <div class="auth-desc">
                        Autorizo el uso de mi información para los servicios CNFL.
                    </div>
                    <a href="javascript:void(0);"
                       onclick="event.preventDefault(); event.stopPropagation(); abrirLegal('consentimiento');"
                       class="auth-link">
                        <svg viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
                        </svg>
                        Ver documento
                    </a>
                </div>
            </div>
            <input type="checkbox" id="chkConsentimiento" name="AceptoConsentimiento" value="true"
                   @(aceptoConsentimientoPrevio ? "checked" : "")
                   onchange="toggleAuth(this, 'authConsentItem');"
                   style="position:absolute;opacity:0;pointer-events:none;" />
        </label>
    </div>

    <button type="submit" class="reg-btn">Crear cuenta</button>
}

<div class="reg-login-link">
    ¿Ya tenés cuenta? <a href="@Url.Action("Login", "Cuenta")">Iniciar sesión</a>
</div>

<!-- ═══════════════════════════════════════════
     MODAL LEGAL
     ═══════════════════════════════════════════ -->
<div id="modalLegal" class="modal-legal-overlay">
    <div class="modal-legal-box">

        <div class="modal-legal-handle"></div>

        <div class="modal-legal-header">
            <div style="flex:1; min-width:0;">
                <h3 id="modalLegalTitulo">Documento legal</h3>
                <p>Leé el contenido completo antes de aceptar.</p>
            </div>
            <button type="button" class="modal-legal-close" onclick="cerrarLegal();" title="Cerrar">
                ✕
            </button>
        </div>

        <div id="modalLegalContenido" class="modal-legal-content">
            <!-- Se carga dinámicamente -->
        </div>

        <div class="modal-legal-footer">
            <button type="button" class="modal-legal-btn" onclick="cerrarLegal();">
                Entendido ✓
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <text>
        <script>
            // ═══════════ Toggle contraseña ═══════════
            function togglePass(id, btn) {
                var input = document.getElementById(id);
                if (!input) return;
                var esPassword = input.getAttribute('type') === 'password';
                input.setAttribute('type', esPassword ? 'text' : 'password');
                btn.innerHTML = esPassword
                    ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                    : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
            }

            // ═══════════ Factura electrónica ═══════════
            function toggleFactura(chk) {
                var wrap = document.getElementById('actividadWrap');
                var hidden = document.getElementById('ActividadEconomicaId');
                var buscador = document.getElementById('buscadorActividad');
                var lista = document.getElementById('listaActividades');
                var seleccionada = document.getElementById('actividadSeleccionada');
                if (!wrap || !hidden || !buscador || !lista || !seleccionada) return;

                wrap.style.display = chk.checked ? 'block' : 'none';
                if (!chk.checked) {
                    hidden.value = '';
                    seleccionada.style.display = 'none';
                    buscador.value = '';
                    lista.style.display = 'none';
                }
            }

            function mostrarActividades() {
                var lista = document.getElementById('listaActividades');
                if (lista) lista.style.display = 'block';
                filtrarActividades();
            }

            function filtrarActividades() {
                var buscador = document.getElementById('buscadorActividad');
                var lista = document.getElementById('listaActividades');
                if (!buscador || !lista) return;

                var q = buscador.value.toLowerCase().trim();
                var visibles = 0;
                var items = document.querySelectorAll('.actividad-item');
                for (var i = 0; i < items.length; i++) {
                    var it = items[i];
                    var txt = it.getAttribute('data-text') || '';
                    if (!q || txt.indexOf(q) >= 0) {
                        it.style.display = 'block';
                        visibles++;
                    } else {
                        it.style.display = 'none';
                    }
                }
                lista.style.display = visibles > 0 ? 'block' : 'none';
            }

            function seleccionarActividad(el) {
                var hidden = document.getElementById('ActividadEconomicaId');
                var textoEl = document.getElementById('actividadTexto');
                var seleccionada = document.getElementById('actividadSeleccionada');
                var lista = document.getElementById('listaActividades');
                var buscador = document.getElementById('buscadorActividad');
                if (!hidden || !textoEl || !seleccionada || !lista || !buscador || !el) return;

                var id = el.getAttribute('data-value');
                var texto = el.textContent.trim();

                hidden.value = id;
                textoEl.textContent = texto;
                seleccionada.style.display = 'block';
                lista.style.display = 'none';
                buscador.value = texto;
            }

            document.addEventListener('click', function (e) {
                var buscador = document.getElementById('buscadorActividad');
                var lista = document.getElementById('listaActividades');
                if (!buscador || !lista) return;
                var target = e.target;
                if (!target) return;
                if (!buscador.contains(target) && !lista.contains(target)) {
                    lista.style.display = 'none';
                }
            });

            // ═══════════ Toggle de checkboxes de autorización ═══════════
            function toggleAuth(chk, itemId) {
                var item = document.getElementById(itemId);
                if (!item) return;
                if (chk.checked) {
                    item.classList.add('marcado');
                } else {
                    item.classList.remove('marcado');
                }
            }

            // ═══════════ Modal legal ═══════════
            var legalCache = {};

            function abrirLegal(tipo) {
                var modal = document.getElementById('modalLegal');
                var cont = document.getElementById('modalLegalContenido');
                var titulo = document.getElementById('modalLegalTitulo');
                if (!modal || !cont) return;

                var urls = {
                    politica: '@Html.Raw(Url.Action("PoliticaPrivacidad", "Cuenta"))',
                    consentimiento: '@Html.Raw(Url.Action("ConsentimientoInformado", "Cuenta"))'
                };

                var titulos = {
                    politica: 'Política de Privacidad y Seguridad',
                    consentimiento: 'Consentimiento Informado'
                };

                var url = urls[tipo];
                if (!url) return;

                titulo.textContent = titulos[tipo] || 'Documento legal';
                modal.classList.add('show');
                document.body.style.overflow = 'hidden';

                if (legalCache[tipo]) {
                    cont.innerHTML = legalCache[tipo];
                    cont.scrollTop = 0;
                    return;
                }

                cont.innerHTML = '<div class="modal-legal-loading">Cargando documento...</div>';

                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) {
                        if (!r.ok) throw new Error('No se pudo cargar');
                        return r.text();
                    })
                    .then(function (html) {
                        legalCache[tipo] = html;
                        cont.innerHTML = html;
                        cont.scrollTop = 0;
                    })
                    .catch(function () {
                        cont.innerHTML = '<p style="color:#b00;text-align:center;padding:30px;">No se pudo cargar el documento. Intentá de nuevo.</p>';
                    });
            }

            function cerrarLegal() {
                var modal = document.getElementById('modalLegal');
                if (!modal) return;
                modal.classList.remove('show');
                document.body.style.overflow = '';
            }

            document.getElementById('modalLegal').addEventListener('click', function (e) {
                if (e.target === this) cerrarLegal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') cerrarLegal();
            });

            // ═══════════ Validación del formulario ═══════════
            var formRegistro = document.getElementById('formRegistro');
            if (formRegistro) {
                formRegistro.addEventListener('submit', function (e) {
                    var politica = document.getElementById('chkPolitica');
                    var consent = document.getElementById('chkConsentimiento');
                    var chkFactura = document.getElementById('chkFactura');
                    var actId = document.getElementById('ActividadEconomicaId');
                    var buscador = document.getElementById('buscadorActividad');
                    var passEl = document.getElementById('Contraseña');
                    var confEl = document.getElementById('confirmarContraseña');

                    if (!politica || !consent || !chkFactura || !actId ||
                        !buscador || !passEl || !confEl) return;

                    if (!politica.checked) {
                        e.preventDefault();
                        alert('Debés aceptar la Política de Privacidad.');
                        return;
                    }
                    if (!consent.checked) {
                        e.preventDefault();
                        alert('Debés aceptar el Consentimiento Informado.');
                        return;
                    }
                    if (chkFactura.checked && !actId.value) {
                        e.preventDefault();
                        alert('Elegí la actividad económica para activar la factura electrónica.');
                        buscador.focus();
                        return;
                    }
                    var pass = passEl.value;
                    var conf = confEl.value;
                    if (pass.length < 6) {
                        e.preventDefault();
                        alert('La contraseña debe tener al menos 6 caracteres.');
                        return;
                    }
                    if (pass !== conf) {
                        e.preventDefault();
                        alert('Las contraseñas no coinciden.');
                        return;
                    }
                });
            }
        </script>
    </text>
}