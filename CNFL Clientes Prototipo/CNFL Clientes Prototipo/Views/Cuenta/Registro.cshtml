@{
    ViewBag.Title = "Registro";
}

<div class="section-pad">
    <div style="padding-top: 20px;">
        <div style="font-size: 28px; font-weight: 800;">Crear cuenta</div>
        <div style="font-size: 13px; color: var(--muted); margin-top: 6px;">Regístrate para conectar con la Agencia Virtual.</div>
    </div>
</div>

<div class="section-pad mt-3">
    <div class="card-cliente">
        @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
        {
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CÉDULA</label>
                <input type="text" name="cedula" class="form-control" required placeholder="1-2345-6789" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">NOMBRE</label>
                <input type="text" name="nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">APELLIDOS</label>
                <input type="text" name="apellidos" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">FECHA DE NACIMIENTO</label>
                <input type="date" name="fecha" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CORREO</label>
                <input type="email" name="correo" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">TELÉFONO</label>
                <input type="text" name="telefono" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CONTRASEÑA</label>
                <input type="password" name="contrasena" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CONFIRMAR CONTRASEÑA</label>
                <input type="password" name="confirm" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-cnfl">Registrarme</button>
        }
    </div>
</div>