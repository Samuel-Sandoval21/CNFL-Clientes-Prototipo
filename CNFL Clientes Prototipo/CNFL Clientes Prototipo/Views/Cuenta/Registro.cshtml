@model CNFL_Clientes_Prototipo.Models.Usuario

@{
    ViewBag.Title = "Crear Cuenta";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        /* Fix Select2 */
        .select2-container {
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single {
            height: auto !important;
            border: none !important;
            background: transparent !important;
            padding: 0 !important;
        }

            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #0E1116 !important;
                font-size: 14px !important;
                line-height: normal !important;
                padding-left: 0 !important;
                padding-right: 20px !important;
            }

            .select2-container--default .select2-selection--single .select2-selection__placeholder {
                color: #aab0be !important;
                font-size: 14px !important;
            }

            .select2-container--default .select2-selection--single .select2-selection__arrow {
                height: 100% !important;
                right: 0 !important;
            }

        .select2-container--open {
            z-index: 99999 !important;
        }

        .select2-dropdown {
            z-index: 99999 !important;
            border-radius: 12px !important;
            box-shadow: 0 10px 30px rgba(16,20,40,.15) !important;
            border: 1px solid #EDEFF3 !important;
        }

        .select2-results__option {
            font-size: 13px !important;
            padding: 8px 12px !important;
        }

        .select2-search--dropdown .select2-search__field {
            border-radius: 8px !important;
            border: 1px solid #EDEFF3 !important;
            padding: 6px 10px !important;
            font-family: inherit !important;
            font-size: 13px !important;
        }

        /* Selects de ubicación */
        .field select.native-select {
            width: 100%;
            border: none;
            background: transparent;
            font-family: inherit;
            font-size: 14px;
            color: #0E1116;
            padding: 12px 0;
            outline: none;
            cursor: pointer;
        }

            .field select.native-select option {
                color: #0E1116;
                background: #fff;
            }

        /* Botón mostrar/ocultar contraseña */
        .toggle-password {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: grid;
            place-items: center;
            color: #aab0be;
            flex-shrink: 0;
            transition: color .2s ease;
        }

            .toggle-password:hover {
                color: #1E23E6 !important;
            }

            .toggle-password svg {
                width: 20px;
                height: 20px;
            }
    </style>
}

<div class="login-wrap">
    <div style="text-align:center; margin-bottom:16px;">
        <div style="font-size:48px;">📋</div>
        <div class="login-h" style="font-size:24px; margin-top:8px;">Crear cuenta</div>
        <div class="login-p" style="font-size:13px;">Regístrate para conectar con la Agencia Virtual.</div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="background:#E8F5E9; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #A5D6A7;">
            <span style="color:#2E7D32; font-weight:700;">✅ @TempData["Mensaje"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div style="background:#FFEBEE; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #FFCDD2;">
            <span style="color:#D32F2F; font-weight:700;">❌ @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage</span>
        </div>
    }

    @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <!-- 1. CÉDULA -->
        <div class="field">
            <label>CÉDULA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2.5" /><path d="M14 10h4M14 14h4" /></svg>
                <input type="text" name="Cedula" placeholder="2-0874-0716" autocomplete="off" required />
            </div>
        </div>

        <!-- 2. NOMBRE -->
        <div class="field">
            <label>NOMBRE *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                <input type="text" name="Nombre" placeholder="Su nombre" autocomplete="off" required />
            </div>
        </div>

        <!-- 3. APELLIDOS -->
        <div class="field">
            <label>APELLIDOS *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                <input type="text" name="Apellidos" placeholder="Sus apellidos" autocomplete="off" required />
            </div>
        </div>

        <!-- 4. SEXO -->
        <div class="field">
            <label>SEXO *</label>
            <div style="display:flex; gap:18px; align-items:center; padding-left:8px;">
                <label style="font-weight:600;"><input type="radio" name="Sexo" value="Masculino" required /> Masculino</label>
                <label style="font-weight:600;"><input type="radio" name="Sexo" value="Femenino" /> Femenino</label>
            </div>
        </div>

        <!-- 5. CORREO 1 -->
        <div class="field">
            <label>CORREO 1 *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                <input type="email" name="Correo" placeholder="usuario@correo.com" autocomplete="off" required />
            </div>
        </div>

        <!-- 6. CORREO 2 -->
        <div class="field">
            <label>CORREO 2 (OPCIONAL)</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                <input type="email" name="CorreoSecundario" placeholder="otro@correo.com" autocomplete="off" />
            </div>
        </div>

        <!-- 7. TELÉFONO 1 -->
        <div class="field">
            <label>TELÉFONO 1 *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <input type="text" name="Telefono" placeholder="8888-8888" autocomplete="off" required />
            </div>
        </div>

        <!-- 8. TELÉFONO 2 -->
        <div class="field">
            <label>TELÉFONO 2 (OPCIONAL)</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <input type="text" name="TelefonoSecundario" placeholder="8888-0000" autocomplete="off" />
            </div>
        </div>

        <!-- 9. NOMBRE DE USUARIO -->
        <div class="field">
            <label>NOMBRE DE USUARIO *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                <input type="text" name="NombreUsuario" placeholder="Nombre de usuario (máx 30)" maxlength="30" autocomplete="off" required />
            </div>
        </div>

        <!-- 10. ACTIVIDAD ECONÓMICA -->
        <div class="field">
            <label>ACTIVIDAD ECONÓMICA *</label>
            <div class="inp" style="padding:6px 14px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v4H3z" /><path d="M3 11h18v10H3z" /></svg>
                <select id="actividadEconomica" name="ActividadEconomicaId" style="width:100%;" required></select>
            </div>
        </div>

        <!-- 11. UBICACIÓN -->
        <div class="field" style="display:flex; gap:8px;">
            <div style="flex:1;">
                <label>PROVINCIA *</label>
                <div class="inp">
                    <select name="Provincia" id="provincia" class="native-select" required>
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
            <div style="flex:1;">
                <label>CANTÓN *</label>
                <div class="inp">
                    <select name="Canton" id="canton" class="native-select" required>
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
            <div style="flex:1;">
                <label>DISTRITO *</label>
                <div class="inp">
                    <select name="Distrito" id="distrito" class="native-select" required>
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 12. CONTRASEÑA -->
        <div class="field">
            <label>CONTRASEÑA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="Contraseña" id="pass1" placeholder="••••••••" autocomplete="new-password" required />
                <button type="button" class="toggle-password" data-target="pass1" title="Mostrar/ocultar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- 13. CONFIRMAR CONTRASEÑA -->
        <div class="field">
            <label>CONFIRMAR CONTRASEÑA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="confirmarContraseña" id="pass2" placeholder="••••••••" autocomplete="new-password" required />
                <button type="button" class="toggle-password" data-target="pass2" title="Mostrar/ocultar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- 14. TÉRMINOS -->
        <div style="background:#f8f9fe; border-radius:12px; border:1px solid #EDEFF3; padding:14px; margin-top:14px; display:flex; flex-direction:column; gap:12px;">
            <label style="display:flex; align-items:flex-start; gap:10px; font-size:13px; font-weight:600; cursor:pointer; line-height:1.5; color:#0E1116;">
                <input type="checkbox" name="AceptaPolitica" value="true" required style="width:18px; height:18px; margin-top:2px; flex-shrink:0; cursor:pointer; accent-color:#1E23E6;" />
                <span>Acepto la <a href="javascript:void(0)" onclick="abrirDocumento('politica')" style="color:#1E23E6; font-weight:700; text-decoration:underline;">Política de Privacidad y Seguridad</a></span>
            </label>
            <label style="display:flex; align-items:flex-start; gap:10px; font-size:13px; font-weight:600; cursor:pointer; line-height:1.5; color:#0E1116;">
                <input type="checkbox" name="AceptaConsentimiento" value="true" required style="width:18px; height:18px; margin-top:2px; flex-shrink:0; cursor:pointer; accent-color:#1E23E6;" />
                <span>Acepto el <a href="javascript:void(0)" onclick="abrirDocumento('consentimiento')" style="color:#1E23E6; font-weight:700; text-decoration:underline;">Consentimiento Informado (F-085)</a></span>
            </label>
        </div>

        <button type="submit" class="btn btn-cta btn-block" style="margin-top:16px;">Registrar cuenta</button>
    }

    <div class="login-foot">
        ¿Ya tienes cuenta? <a href="@Url.Action("Login", "Cuenta")">Inicia sesión aquí</a>
    </div>
</div>

<div id="cnflModal" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.55); display:none; align-items:center; justify-content:center; z-index:99999; padding:20px;">
    <div style="background:#fff; border-radius:16px; max-width:500px; width:100%; max-height:80vh; overflow:hidden; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.35);">
        <div style="padding:16px 20px; border-bottom:1px solid #EDEFF3; display:flex; justify-content:space-between; align-items:center;">
            <h3 id="cnflModalTitle" style="font-size:16px; margin:0; font-weight:800;">Documento</h3>
            <button type="button" onclick="cerrarDocumento()" style="background:none; border:none; cursor:pointer; font-size:22px; line-height:1; color:#727A86;">×</button>
        </div>
        <div id="cnflModalBody" style="padding:18px 20px; overflow-y:auto; font-size:13px; line-height:1.6; color:#0E1116;"></div>
    </div>
</div>

