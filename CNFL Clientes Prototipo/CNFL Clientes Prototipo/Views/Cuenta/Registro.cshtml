@model CNFL_Clientes_Prototipo.Models.Usuario

@{
    ViewBag.Title = "Crear Cuenta";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .login-wrap .field .inp input:-webkit-autofill,
        .login-wrap .field .inp input:-webkit-autofill:hover,
        .login-wrap .field .inp input:-webkit-autofill:focus {
            -webkit-text-fill-color: var(--ink) !important;
            -webkit-box-shadow: 0 0 0 1000px #fff inset !important;
            transition: background-color 9999s ease-in-out 0s;
        }

        .select2-container .select2-selection--single {
            height: auto !important;
            border: none !important;
            background: transparent !important;
            padding: 0 !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            padding: 0 !important;
            font-family: inherit;
            font-size: 14px;
            color: var(--ink);
            line-height: normal;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100% !important;
            right: 0 !important;
        }

        .select2-container--open .select2-dropdown {
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(16,20,40,.15);
            border: 1px solid var(--line);
            z-index: 9999;
        }

        .select2-results__option {
            font-size: 13px;
            padding: 8px 12px;
        }

        .select2-search--dropdown .select2-search__field {
            border-radius: 8px;
            border: 1px solid var(--line);
            padding: 6px 10px;
            font-family: inherit;
            font-size: 13px;
        }
    </style>
}

<div class="login-wrap" style="padding:24px 20px;">
    <div style="text-align:center; margin-bottom:16px;">
        <div style="font-size:48px;">📋</div>
        <div class="login-h" style="font-size:24px; margin-top:8px;">Crear cuenta</div>
        <div class="login-p" style="font-size:13px;">Regístrate para conectar con la Agencia Virtual.</div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div style="background:#E8F5E9; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #A5D6A7;">
            <span style="color:#2E7D32; font-weight:700;">✅ @TempData["Mensaje"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
    {
        <div style="background:#FFEBEE; padding:12px 16px; border-radius:12px; margin-bottom:12px; border:1px solid #FFCDD2;">
            <span style="color:#D32F2F; font-weight:700;">❌ @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage</span>
        </div>
    }

    @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>CÉDULA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="12" r="2.5" /><path d="M14 10h4M14 14h4" /></svg>
                <input type="text" name="Cedula" placeholder="2-0874-0716" autocomplete="off" required />
            </div>
        </div>

        <div class="field">
            <label>SEXO *</label>
            <div style="display:flex; gap:18px; align-items:center; padding-left:8px;">
                <label style="font-weight:600;"><input type="radio" name="Sexo" value="Masculino" required /> Masculino</label>
                <label style="font-weight:600;"><input type="radio" name="Sexo" value="Femenino" /> Femenino</label>
                <label style="font-weight:600;"><input type="radio" name="Sexo" value="Otro" /> Otro</label>
            </div>
        </div>

        <div class="field">
            <label>CORREO 1 *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                <input type="email" name="Correo" placeholder="usuario@correo.com" autocomplete="off" required />
            </div>
        </div>

        <div class="field">
            <label>CORREO 2 (OPCIONAL)</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 5L2 7" /></svg>
                <input type="email" name="CorreoSecundario" placeholder="otro@correo.com" autocomplete="off" />
            </div>
        </div>

        <div class="field">
            <label>TELÉFONO 1 *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <input type="text" name="Telefono" placeholder="8888-8888" autocomplete="off" required />
            </div>
        </div>

        <div class="field">
            <label>TELÉFONO 2 (OPCIONAL)</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <input type="text" name="TelefonoSecundario" placeholder="8888-0000" autocomplete="off" />
            </div>
        </div>

        <div class="field">
            <label>ACTIVIDAD ECONÓMICA *</label>
            <div class="inp" style="padding:6px 14px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v4H3z" /><path d="M3 11h18v10H3z" /></svg>
                <select id="actividadEconomica" name="ActividadEconomicaId" style="width:100%;" required></select>
            </div>
        </div>

        <div class="field" style="display:flex; gap:8px;">
            <div style="flex:1;">
                <label>PROVINCIA *</label>
                <div class="inp">
                    <select name="Provincia" id="provincia" required style="width:100%;border:none;background:transparent;font-family:inherit;font-size:14px;color:var(--ink);">
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
            <div style="flex:1;">
                <label>CANTÓN *</label>
                <div class="inp">
                    <select name="Canton" id="canton" required style="width:100%;border:none;background:transparent;font-family:inherit;font-size:14px;color:var(--ink);">
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
            <div style="flex:1;">
                <label>DISTRITO *</label>
                <div class="inp">
                    <select name="Distrito" id="distrito" required style="width:100%;border:none;background:transparent;font-family:inherit;font-size:14px;color:var(--ink);">
                        <option value="">Seleccione</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="field">
            <label>CONTRASEÑA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="Contraseña" placeholder="••••••••" autocomplete="new-password" required />
            </div>
        </div>

        <div class="field">
            <label>CONFIRMAR CONTRASEÑA *</label>
            <div class="inp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input type="password" name="confirmarContraseña" placeholder="••••••••" autocomplete="new-password" required />
            </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px; background:#f8f9fe; padding:12px; border-radius:12px; border:1px solid var(--line); margin-top:12px;">
            <label style="display:flex; align-items:flex-start; gap:8px; font-size:12px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="AceptaPolitica" value="true" required /> Acepto la Política de Privacidad
            </label>
            <label style="display:flex; align-items:flex-start; gap:8px; font-size:12px; font-weight:600; cursor:pointer;">
                <input type="checkbox" name="AceptaConsentimiento" value="true" required /> Acepto el Consentimiento Informado
            </label>
        </div>

        <button type="submit" class="btn btn-cta btn-block" style="margin-top:16px;">Registrar cuenta</button>
    }

    <div class="login-foot" style="margin-top:16px;">
        ¿Ya tienes cuenta? <a href="@Url.Action("Login", "Cuenta")">Inicia sesión aquí</a>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
