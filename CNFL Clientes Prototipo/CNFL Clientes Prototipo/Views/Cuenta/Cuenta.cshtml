@model CNFL_Clientes_Prototipo.Controllers.Usuario
@{
    ViewBag.Title = "Mi Cuenta";
}

<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <!-- Recuadro azul con datos ACTUALES de la sesión -->
    <div style="background: linear-gradient(135deg, var(--navy), var(--blue)); border-radius: 24px; padding: 20px; color: #fff; display: flex; align-items: center; gap: 14px; box-shadow: 0 16px 30px -14px rgba(0,20,130,.6);">
        <div style="width: 56px; height: 56px; border-radius: 18px; background: rgba(255,255,255,.18); display: grid; place-items: center; font-size: 22px; font-weight: 800;">
            @(Session["Nombre"]?.ToString().Substring(0,1) ?? "U")
        </div>
        <div>
            <div style="font-size: 18px; font-weight: 800;">
                @(Session["Nombre"]?.ToString() ?? "Usuario") @(Session["Apellidos"]?.ToString() ?? "")
            </div>
            <div style="font-size: 12px; opacity: .85; margin-top: 2px;">
                @(Session["Correo"]?.ToString() ?? "Sin correo")
            </div>
        </div>
    </div>

    <div style="background: #e9f7ec; border: 1px solid #cdeed4; border-radius: 16px; padding: 13px; margin-top: 14px; display: flex; gap: 11px; align-items: center;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2f8f3e" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5z" /><path d="m9 12 2 2 4-4" /></svg>
        <div>
            <div style="font-size: 12.5px; font-weight: 800; color: #2f8f3e;">Datos protegidos</div>
            <div style="font-size: 11px; color: #4a9a57;">Cifrado extremo a extremo · biometría</div>
        </div>
    </div>
</div>

<div class="section-pad">
    <div class="eyebrow">Mi actividad (CRM)</div>
    <div class="rows">
        <div class="row-item" onclick="window.location='/Tienda'">
            <div class="ic" style="background:#fff3ec"><svg viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2"><path d="M3 3h18v6H3zM3 13h18v8H3z" /></svg></div>
            <div class="tx"><div class="t">Historial de compras</div><div class="s">Marketplace</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
        <div class="row-item" onclick="window.location='/Cuenta/Suscripciones'">
            <div class="ic" style="background:#eefbf0"><svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
            <div class="tx"><div class="t">Suscripciones</div><div class="s">2 activas · 1 inactiva</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
        <div class="row-item" onclick="window.location='/Cuenta/ServiciosContratados'">
            <div class="ic" style="background:#eef6ff"><svg viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M9 11l3 3 8-8" /><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" /></svg></div>
            <div class="tx"><div class="t">Servicios contratados</div><div class="s">Solicitados · abiertos</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
        <div class="row-item" onclick="window.location='/Cuenta/EditarDatos'">
            <div class="ic" style="background:#f3f0ff"><svg viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2"><path d="M4 4h16v16H4z" /><path d="M8 8h8M8 12h8M8 16h5" /></svg></div>
            <div class="tx"><div class="t">Editar mis datos</div><div class="s">Actualizar información personal</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
    </div>
</div>

<div class="section-pad">
    <div class="eyebrow">Herramientas y contacto</div>
    <div class="rows">
        <div class="row-item" onclick="window.location='/Cuenta/Calculadora'">
            <div class="ic" style="background:#f3f0ff"><svg viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M8 6h8M8 10h3M13 10h3M8 14h3M13 14h3M8 18h8" /></svg></div>
            <div class="tx"><div class="t">Calculadora energética</div><div class="s">Estima el costo de tus equipos</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
        <div class="row-item" onclick="window.location='/Cuenta/Chat'">
            <div class="ic" style="background:#e9f7ec"><svg viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></div>
            <div class="tx"><div class="t">Chat / WhatsApp · Chatbot</div><div class="s">800 ENERGÍA · 1026</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
        <div class="row-item" onclick="window.location='/Cuenta/Logout'" style="cursor:pointer; background:#fdeaea; border-color:#ffcdd2;">
            <div class="ic" style="background:#fdeaea"><svg viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg></div>
            <div class="tx"><div class="t" style="color:var(--red);">Cerrar sesión</div></div>
        </div>
    </div>
</div>