@{
    ViewBag.Title = "Mis Pagos";
    var monto = ViewBag.Monto as string ?? "28450";
    var producto = ViewBag.Producto as string ?? "Factura Agosto 2026";
}

<div class="pagos-container">
    <div class="pago-header">
        <div class="eyebrow">Mis pagos</div>
        <div class="h-name">Historial de Pagos</div>
        <div class="subtitulo">Consulta y paga tus facturas en segundos.</div>
    </div>

    <!-- Tarjeta de Factura Pendiente -->
    <div class="pago-card">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="periodo">@producto</div>
                <div class="monto">₡ @monto</div>
            </div>
            <span class="pago-estado pendiente">⏳ Pendiente</span>
        </div>

        <div class="pago-metodos">
            <a href="/Pagos/Sinpe?monto=@monto&producto=@producto" class="btn-pago sinpe">
                <span class="icono-pago">📱</span>
                SINPE Móvil
            </a>
            <a href="/Pagos/Iban?monto=@monto&producto=@producto" class="btn-pago iban">
                <span class="icono-pago">🏦</span>
                IBAN
            </a>
            <a href="/Pagos/Tarjeta?monto=@monto&producto=@producto" class="btn-pago tarjeta">
                <span class="icono-pago">💳</span>
                Tarjeta
            </a>
        </div>
    </div>

    <!-- Tarjeta de Factura Pagada -->
    <div class="pago-card" style="border-left: 4px solid var(--green);">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <div class="periodo">Julio 2026</div>
                <div class="monto" style="color: var(--muted);">₡ 26.980</div>
            </div>
            <span class="pago-estado pagada">✓ Pagada</span>
        </div>

        <div style="margin-top: 15px; border-top: 1px solid var(--line); padding-top: 12px; text-align: center;">
            <span style="font-size: 12px; color: var(--green); font-weight: 700;">✓ Pago realizado con éxito</span>
        </div>
    </div>
</div>

<!-- Espaciado inferior para que no choque con la barra del menú -->
<div style="height: 20px;"></div>