@model CNFL_Clientes_Prototipo.Models.OrdenCompra
@{
    ViewBag.Title = "Pago exitoso";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .cf-success {
            background: linear-gradient(135deg, #2f8f3e, #4ac265);
            border-radius: 22px;
            padding: 30px 20px;
            color: #fff;
            text-align: center;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(47,143,62,.5);
            position: relative;
            overflow: hidden;
        }

            .cf-success::after {
                content: "";
                position: absolute;
                right: -60px;
                top: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
            }

            .cf-success .check {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: rgba(255,255,255,.2);
                display: grid;
                place-items: center;
                margin: 0 auto 16px;
                font-size: 40px;
                border: 3px solid rgba(255,255,255,.5);
            }

            .cf-success h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .cf-success .sub {
                font-size: 13px;
                opacity: .9;
                margin-top: 6px;
                line-height: 1.4;
            }

        .cf-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .cf-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid var(--line);
            font-size: 13px;
        }

            .cf-row:last-child {
                border-bottom: 0;
            }

            .cf-row .l {
                color: var(--muted);
                font-weight: 700;
            }

            .cf-row .r {
                color: var(--ink);
                font-weight: 800;
                text-align: right;
            }

                .cf-row .r.blue {
                    color: var(--blue);
                    font-size: 15px;
                }

        .cf-actions {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 20px;
            margin-bottom: 24px;
        }

        .cf-btn-primary {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            box-shadow: 0 8px 18px -8px rgba(30,35,230,.6);
        }

            .cf-btn-primary:hover {
                color: #fff;
                text-decoration: none;
            }

        .cf-btn-secondary {
            background: #fff;
            color: var(--ink);
            border: 1.5px solid var(--line);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
        }

            .cf-btn-secondary:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--ink);
            }
    </style>
}

<div class="cf-success">
    <div class="check">✅</div>
    <h1>¡Pago exitoso!</h1>
    <div class="sub">Tu orden fue procesada correctamente</div>
</div>

<div class="cf-card">
    <div class="cf-row"><div class="l">Número de orden</div><div class="r">@Model.NumeroOrden</div></div>
    <div class="cf-row"><div class="l">Método de pago</div><div class="r">@Model.Metodo</div></div>
    <div class="cf-row"><div class="l">Referencia</div><div class="r">@Model.ReferenciaPago</div></div>
    <div class="cf-row"><div class="l">Fecha</div><div class="r">@(Model.FechaConfirmacion.HasValue ? Model.FechaConfirmacion.Value.ToString("dd/MM/yyyy HH:mm") : Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</div></div>
    <div class="cf-row"><div class="l">Subtotal</div><div class="r">₡@Model.Subtotal.ToString("N0")</div></div>
    <div class="cf-row"><div class="l">IVA (13%)</div><div class="r">₡@Model.Impuesto.ToString("N0")</div></div>
    <div class="cf-row"><div class="l" style="font-size:14px;color:var(--ink);">Total pagado</div><div class="r blue">₡@Model.Total.ToString("N0")</div></div>
</div>

<div class="cf-actions">
    <a href="@Url.Action("MisCompras", "Pagos")" class="cf-btn-primary">🧾 Ver mis compras</a>
    <a href="@Url.Action("Dashboard", "Clientes")" class="cf-btn-secondary">🏠 Volver al inicio</a>
</div>