@{
    ViewBag.Title = "Transferencia IBAN";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var total = (decimal)ViewBag.Total;
    var iban = ViewBag.CuentaIBAN as string ?? "CR05015200100512345678";
    var banco = ViewBag.Banco as string ?? "Banco Nacional de Costa Rica";
    var titular = ViewBag.Titular as string ?? "Compañía Nacional de Fuerza y Luz S.A.";
}

@section Styles {
    <style>
        .ib-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .ib-back:hover {
                text-decoration: underline;
            }

        .ib-hero {
            background: linear-gradient(135deg, #64B9CD, #2c8aa3);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(100,185,205,.5);
        }

            .ib-hero h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 800;
            }

            .ib-hero .total {
                font-size: 26px;
                font-weight: 800;
                margin-top: 8px;
            }

        .ib-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 20px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .ib-row {
            margin-bottom: 16px;
        }

            .ib-row:last-child {
                margin-bottom: 0;
            }

        .ib-lbl {
            font-size: 10.5px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .05em;
        }

        .ib-val {
            font-size: 14px;
            font-weight: 800;
            color: var(--ink);
            margin-top: 4px;
            word-break: break-all;
        }

        .ib-copy {
            background: #eaf6fa;
            color: #2c8aa3;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 11px;
            padding: 6px 12px;
            border-radius: 8px;
            margin-left: 8px;
            cursor: pointer;
            vertical-align: middle;
        }

            .ib-copy:active {
                transform: scale(.95);
            }

        .ib-btn {
            width: 100%;
            background: linear-gradient(135deg, #64B9CD, #2c8aa3);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            margin-top: 16px;
            margin-bottom: 24px;
            cursor: pointer;
            box-shadow: 0 8px 18px -8px rgba(100,185,205,.6);
            transition: transform .12s;
        }

            .ib-btn:active {
                transform: scale(.97);
            }
    </style>
}

<a href="@Url.Action("Index", "Carrito")" class="ib-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver al carrito
</a>

<div class="ib-hero">
    <h1>🏦 Transferencia IBAN</h1>
    <div class="total">₡@total.ToString("N0")</div>
</div>

<div class="ib-card">
    <div class="ib-row">
        <div class="ib-lbl">BANCO</div>
        <div class="ib-val">@banco</div>
    </div>
    <div class="ib-row">
        <div class="ib-lbl">TITULAR</div>
        <div class="ib-val">@titular</div>
    </div>
    <div class="ib-row">
        <div class="ib-lbl">CUENTA IBAN</div>
        <div class="ib-val">
            @iban
            <button type="button" class="ib-copy" onclick="copiar('@iban')">📋 Copiar</button>
        </div>
    </div>
    <div class="ib-row">
        <div class="ib-lbl">MONTO</div>
        <div class="ib-val" style="color:#2c8aa3;">₡@total.ToString("N0")</div>
    </div>
</div>

<button type="button" class="ib-btn" id="btnPagar" onclick="confirmarIban()">✅ Ya realicé la transferencia</button>

@section Scripts {
    <script>
        function copiar(texto) {
            navigator.clipboard.writeText(texto).then(function () {
                alert('✅ IBAN copiado: ' + texto);
            });
        }

        function confirmarIban() {
            if (!confirm('¿Confirmás que realizaste la transferencia por ₡@total.ToString("N0")?')) return;

            var btn = document.getElementById('btnPagar');
            btn.disabled = true;
            btn.textContent = 'Verificando transferencia...';

            setTimeout(function () {
                fetch('@Url.Action("Procesar", "Pagos")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'metodo=Transferencia IBAN&referencia=@iban'
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = '@Url.Action("Confirmacion", "Pagos")/' + data.ordenId;
                    } else {
                        alert('❌ ' + data.message);
                        btn.disabled = false;
                        btn.textContent = '✅ Ya realicé la transferencia';
                    }
                })
                .catch(function () {
                    alert('Error al procesar el pago.');
                    btn.disabled = false;
                    btn.textContent = '✅ Ya realicé la transferencia';
                });
            }, 1400);
        }
    </script>
}