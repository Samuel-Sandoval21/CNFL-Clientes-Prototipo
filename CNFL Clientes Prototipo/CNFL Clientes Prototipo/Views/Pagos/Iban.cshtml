@{
    ViewBag.Title = "Pago IBAN";
    var monto = ViewBag.Monto ?? "0";
    var producto = ViewBag.Producto ?? "Factura";
}
<div class="section-pad">
    <div class="h-name" style="font-size: 22px; margin-top:20px;">Pago por Transferencia IBAN</div>
    <p class="text-muted">Producto/Factura: @producto</p>
</div>
<div class="card-cliente m-3">
    <div class="mb-3">
        <label class="form-label fw-bold">Nombre del titular</label>
        <input type="text" class="form-control" value="Katherine Villalobos" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label fw-bold">Cuenta destino</label>
        <input type="text" class="form-control" value="CR1234567890" disabled />
    </div>
    <div class="mb-3">
        <label class="form-label fw-bold">Monto a transferir</label>
        <input type="text" class="form-control" value="₡@monto" disabled />
    </div>
    <hr />
    <button class="btn btn-cnfl" onclick="alert('Transferencia IBAN procesada exitosamente!')">Confirmar transferencia</button>
</div>