@model List<CNFL_Clientes_Prototipo.Models.OrdenCompra>
@{
    ViewBag.Title = "Mis compras";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

@section Styles {
    <style>
        .mc-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .mc-back:hover {
                text-decoration: underline;
            }

        .mc-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(16,20,60,.45);
        }

            .mc-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
            }

            .mc-hero .sub {
                font-size: 12.5px;
                opacity: .85;
                margin-top: 4px;
            }

        .mc-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 18px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .mc-empty .e {
                font-size: 48px;
                margin-bottom: 10px;
            }

            .mc-empty .t {
                font-size: 15px;
                font-weight: 800;
                color: var(--ink);
            }

            .mc-empty .s {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 5px;
            }

        .mc-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .mc-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .mc-item:hover {
                text-decoration: none;
                color: inherit;
            }

            .mc-item .ico {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                font-size: 20px;
                background: #e9f7ec;
                flex-shrink: 0;
            }

            .mc-item .body {
                flex: 1;
                min-width: 0;
            }

            .mc-item .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .mc-item .s {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 2px;
            }

            .mc-item .badge {
                font-size: 10px;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: 999px;
                background: #e9f7ec;
                color: #2f8f3e;
                white-space: nowrap;
            }

            .mc-item .total {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--blue);
                text-align: right;
            }
    </style>
}

<a href="@Url.Action("Dashboard", "Clientes")" class="mc-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver al inicio
</a>

<div class="mc-hero">
    <h1>🧾 Mis compras</h1>
    <div class="sub">Historial de todas tus órdenes en CNFL</div>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="mc-empty">
        <div class="e">📦</div>
        <div class="t">Aún no tenés compras</div>
        <div class="s">Cuando realices tu primera compra aparecerá acá.</div>
    </div>
}
else
{
    <div class="mc-list">
        @foreach (var o in Model)
        {
            <a href="@Url.Action("Confirmacion", "Pagos", new { id = o.OrdenId })" class="mc-item">
                <div class="ico">✅</div>
                <div class="body">
                    <div class="t">@o.NumeroOrden</div>
                    <div class="s">@o.Metodo · @o.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div>
                    <div class="badge">@o.Estado</div>
                    <div class="total" style="margin-top:4px;">₡@o.Total.ToString("N0")</div>
                </div>
            </a>
        }
    </div>
}