@{
    ViewBag.Title = "Tokens CNFL";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var total = (decimal)ViewBag.Total;
    var tokensDisponibles = (int)ViewBag.TokensDisponibles;
}

@section Styles {
    <style>
        .to-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .to-back:hover {
                text-decoration: underline;
            }

        .to-hero {
            background: linear-gradient(135deg, #f5a623, #ff8a4c);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(245,166,35,.5);
        }

            .to-hero h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 800;
            }

            .to-hero .total {
                font-size: 26px;
                font-weight: 800;
                margin-top: 8px;
            }

        .to-tokens-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 20px;
            margin-top: 16px;
            text-align: center;
            box-shadow: var(--shadow-sm);
        }

            .to-tokens-card .lbl {
                font-size: 11px;
                font-weight: 800;
                color: var(--muted);
                letter-spacing: .05em;
            }

            .to-tokens-card .num {
                font-size: 42px;
                font-weight: 800;
                color: #f5a623;
                margin-top: 8px;
            }

            .to-tokens-card .sub {
                font-size: 12px;
                color: var(--muted);
                margin-top: 4px;
            }

        .to-eq {
            background: #fef3e0;
            border-radius: 12px;
            padding: 12px 14px;
            margin-top: 12px;
            font-size: 12px;
            color: #b9791a;
            font-weight: 700;
            line-height: 1.4;
        }

        .to-form {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .to-field {
            margin-bottom: 14px;
        }

        .to-label {
            font-size: 11.5px;
            font-weight: 800;
            color: var(--muted);
            letter-spacing: .04em;
            display: block;
            margin-bottom: 6px;
        }

        .to-input {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: 13px 15px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            background: #fafbff;
            outline: none;
        }

            .to-input:focus {
                border-color: var(--blue);
                background: #fff;
            }

        .to-btn {
            width: 100%;
            background: linear-gradient(135deg, #f5a623, #ff8a4c);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            margin-top: 12px;
            cursor: pointer;
            box-shadow: 0 8px 18px -8px rgba(245,166,35,.6);
            transition: transform .12s;
        }

            .to-btn:active {
                transform: scale(.97);
            }

            .to-btn:disabled {
                background: #d0d0d0;
                cursor: not-allowed;
                box-shadow: none;
            }
    </style>
}

<a href="@Url.Action("Index", "Carrito")" class="to-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver al carrito
</a>

<div class="to-hero">
    <h1>🎟️ Pago con Tokens CNFL</h1>
    <div class="total">₡@total.ToString("N0")</div>
</div>

<div class="to-tokens-card">
    <div class="lbl">TOKENS DISPONIBLES</div>
    <div class="num">@tokensDisponibles</div>
    <div class="sub">1 token = ₡100</div>
    <div class="to-eq">
        💡 Con @tokensDisponibles tokens podés cubrir hasta ₡@((tokensDisponibles * 100).ToString("N0"))
    </div>
</div>

<div class="to-form">
    <div class="to-field">
        <label class="to-label">TOKENS A USAR</label>
        <input type="number" id="tokensUsar" class="to-input" placeholder="Ej: 50" min="1" max="@tokensDisponibles" />
    </div>

    <button type="button" class="to-btn" id="btnPagar" onclick="procesarTokens()">
        🎟️ Pagar con tokens
    </button>
</div>

@section Scripts {
    <script>
        function procesarTokens() {
            var tokens = parseInt(document.getElementById('tokensUsar').value) || 0;

            if (tokens <= 0) {
                alert('Ingresá una cantidad de tokens mayor a 0.');
                return;
            }
            if (tokens > @tokensDisponibles) {
                alert('No tenés suficientes tokens.');
                return;
            }

            var montoCubierto = tokens * 100;
            if (!confirm('¿Usar ' + tokens + ' tokens para cubrir ₡' + montoCubierto.toLocaleString('es-CR') + '?')) return;

            var btn = document.getElementById('btnPagar');
            btn.disabled = true;
            btn.textContent = 'Procesando...';

            setTimeout(function () {
                fetch('@Url.Action("Procesar", "Pagos")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'metodo=Tokens CNFL&referencia=' + tokens + ' tokens'
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = '@Url.Action("Confirmacion", "Pagos")/' + data.ordenId;
                    } else {
                        alert('❌ ' + data.message);
                        btn.disabled = false;
                        btn.textContent = '🎟️ Pagar con tokens';
                    }
                })
                .catch(function () {
                    alert('Error al procesar el pago.');
                    btn.disabled = false;
                    btn.textContent = '🎟️ Pagar con tokens';
                });
            }, 1200);
        }
    </script>
}