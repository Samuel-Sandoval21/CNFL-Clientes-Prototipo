@{
    ViewBag.Title = "SINPE Móvil";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var total = (decimal)ViewBag.Total;
    var telefono = ViewBag.TelefonoSinpe as string ?? "8888-1234";
}

@section Styles {
    <style>
        .sp-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .sp-back:hover {
                text-decoration: underline;
            }

        .sp-hero {
            background: linear-gradient(135deg, #2f8f3e, #4ac265);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(47,143,62,.5);
        }

            .sp-hero h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 800;
            }

            .sp-hero .total {
                font-size: 26px;
                font-weight: 800;
                margin-top: 8px;
            }

        .sp-steps {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 20px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .sp-step {
            display: flex;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid var(--line);
        }

            .sp-step:last-child {
                border-bottom: 0;
            }

            .sp-step .num {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: #e9f7ec;
                color: #2f8f3e;
                display: grid;
                place-items: center;
                font-weight: 800;
                font-size: 13px;
                flex-shrink: 0;
            }

            .sp-step .body {
                flex: 1;
            }

            .sp-step .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
            }

            .sp-step .s {
                font-size: 12px;
                color: var(--muted);
                margin-top: 3px;
                line-height: 1.45;
            }

        .sp-phone {
            background: #f7f8fc;
            border-radius: 14px;
            padding: 16px;
            margin-top: 14px;
            text-align: center;
        }

            .sp-phone .lbl {
                font-size: 10.5px;
                font-weight: 800;
                color: var(--muted);
                letter-spacing: .05em;
            }

            .sp-phone .num {
                font-size: 24px;
                font-weight: 800;
                color: var(--ink);
                margin-top: 4px;
                letter-spacing: 1px;
            }

            .sp-phone .copy {
                background: var(--blue);
                color: #fff;
                border: 0;
                font-family: inherit;
                font-weight: 800;
                font-size: 11.5px;
                padding: 8px 14px;
                border-radius: 10px;
                margin-top: 10px;
                cursor: pointer;
            }

        .sp-monto {
            background: #f7f8fc;
            border-radius: 14px;
            padding: 16px;
            margin-top: 10px;
            text-align: center;
        }

            .sp-monto .lbl {
                font-size: 10.5px;
                font-weight: 800;
                color: var(--muted);
                letter-spacing: .05em;
            }

            .sp-monto .num {
                font-size: 24px;
                font-weight: 800;
                color: #2f8f3e;
                margin-top: 4px;
            }

        .sp-btn {
            width: 100%;
            background: linear-gradient(135deg, #2f8f3e, #4ac265);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            margin-top: 16px;
            margin-bottom: 24px;
            cursor: pointer;
            box-shadow: 0 8px 18px -8px rgba(47,143,62,.6);
            transition: transform .12s;
        }

            .sp-btn:active {
                transform: scale(.97);
            }
    </style>
}

<a href="@Url.Action("Index", "Carrito")" class="sp-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver al carrito
</a>

<div class="sp-hero">
    <h1>📱 Pago con SINPE Móvil</h1>
    <div class="total">₡@total.ToString("N0")</div>
</div>

<div class="sp-steps">
    <div class="sp-step">
        <div class="num">1</div>
        <div class="body">
            <div class="t">Abrí tu app bancaria</div>
            <div class="s">Cualquier banco que soporte SINPE Móvil</div>
        </div>
    </div>
    <div class="sp-step">
        <div class="num">2</div>
        <div class="body">
            <div class="t">Transferí al número</div>
            <div class="s">Enviá el monto exacto al siguiente número:</div>
            <div class="sp-phone">
                <div class="lbl">NÚMERO SINPE CNFL</div>
                <div class="num">@telefono</div>
                <button type="button" class="copy" onclick="copiar('@telefono')">📋 Copiar número</button>
            </div>
        </div>
    </div>
    <div class="sp-step">
        <div class="num">3</div>
        <div class="body">
            <div class="t">Transferí el monto exacto</div>
            <div class="s">Enviá este monto:</div>
            <div class="sp-monto">
                <div class="lbl">MONTO A TRANSFERIR</div>
                <div class="num">₡@total.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="sp-step">
        <div class="num">4</div>
        <div class="body">
            <div class="t">Confirmá en la app</div>
            <div class="s">Una vez realizado el SINPE, presioná "Ya pagué" para confirmar tu orden.</div>
        </div>
    </div>
</div>

<button type="button" class="sp-btn" id="btnPagar" onclick="confirmarSinpe()">✅ Ya realicé el SINPE</button>

@section Scripts {
    <script>
        function copiar(texto) {
            navigator.clipboard.writeText(texto).then(function () {
                alert('✅ Número copiado: ' + texto);
            });
        }

        function confirmarSinpe() {
            if (!confirm('¿Confirmás que realizaste el SINPE por ₡@total.ToString("N0")?')) return;

            var btn = document.getElementById('btnPagar');
            btn.disabled = true;
            btn.textContent = 'Verificando pago...';

            setTimeout(function () {
                fetch('@Url.Action("Procesar", "Pagos")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'metodo=SINPE Móvil&referencia=@telefono'
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = '@Url.Action("Confirmacion", "Pagos")/' + data.ordenId;
                    } else {
                        alert('❌ ' + data.message);
                        btn.disabled = false;
                        btn.textContent = '✅ Ya realicé el SINPE';
                    }
                })
                .catch(function () {
                    alert('Error al procesar el pago.');
                    btn.disabled = false;
                    btn.textContent = '✅ Ya realicé el SINPE';
                });
            }, 1400);
        }
    </script>
}