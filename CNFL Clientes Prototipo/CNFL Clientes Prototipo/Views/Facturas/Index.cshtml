@model List<CNFL_Clientes_Prototipo.Models.Factura>
@{
    ViewBag.Title = "Mis Facturas";
}

<div class="section-pad">
    <div class="eyebrow">Mis facturas</div>
    <div class="h-name" style="font-size: 24px;">Historial de Pagos</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Consulta y paga tus facturas en segundos.</div>
</div>

<div class="facturas-container">
    @foreach (var f in Model)
    {
        <div class="factura-card">
            <!-- Cabecera de la factura -->
            <div class="factura-header">
                <div>
                    <div class="factura-periodo">@f.Periodo</div>
                    <div class="factura-monto">₡@f.Monto.ToString("N0")</div>
                </div>

                @if (f.Estado == "Pagada")
                {
                    <span class="factura-estado estado-pagada">✓ Pagada</span>
                }
                else
                {
                    <span class="factura-estado estado-pendiente">⏳ Pendiente</span>
                }
            </div>

            <!-- Botones de acción si está pendiente -->
            @if (f.Estado != "Pagada")
            {
                <div class="factura-acciones">
                    <a href="/Pagos/Sinpe?monto=@f.Monto&producto=@f.Periodo" class="btn-metodo-pago sinpe">
                        📱 SINPE
                    </a>
                    <a href="/Pagos/Iban?monto=@f.Monto&producto=@f.Periodo" class="btn-metodo-pago">
                        🏦 IBAN
                    </a>
                    <a href="/Pagos/Tarjeta?monto=@f.Monto&producto=@f.Periodo" class="btn-metodo-pago tarjeta">
                        💳 Tarjeta
                    </a>
                </div>
            }
            else
            {
                <div style="text-align: center; margin-top: 15px; border-top: 1px solid var(--line); padding-top: 15px;">
                    <span style="font-size: 12px; color: var(--green); font-weight: 700;">✓ Pago realizado con éxito</span>
                </div>
            }
        </div>
    }
</div>

<!-- Espaciado inferior para que no choque con la barra del menú -->
<div style="height: 20px;"></div>