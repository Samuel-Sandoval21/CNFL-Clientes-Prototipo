@model List<CNFL_Clientes_Prototipo.Models.Factura>
@{
    ViewBag.Title = "Mis Facturas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 style="color: var(--cnfl-navy); font-weight: 800;">Mis Pagos</h3>
</div>

@foreach (var f in Model)
{
    <div class="card-cliente" style="border-left: 5px solid var(--cnfl-orange);">
        <div class="d-flex justify-content-between">
            <div>
                <div style="font-weight: bold;">@f.Periodo</div>
                <div style="font-size: 24px; font-weight: 800; color: var(--cnfl-navy);">₡@f.Monto.ToString("N0")</div>
            </div>
            @if (f.Estado == "Pagada")
            {
                <span class="badge badge-success align-self-start">Pagada</span>
            }
            else
            {
                <span class="badge badge-warning align-self-start">Pendiente</span>
            }
        </div>
        <hr />
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="alert('Pago vía SINPE Móvil simulado')">SINPE</button>
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="alert('Pago vía IBAN simulado')">IBAN</button>
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="alert('Pago vía Tarjeta simulado')">Tarjeta</button>
        </div>
    </div>
}