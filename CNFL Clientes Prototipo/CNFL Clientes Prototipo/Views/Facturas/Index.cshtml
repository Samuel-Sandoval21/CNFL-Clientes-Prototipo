@model List<CNFL_Clientes_Prototipo.Models.Factura>
@{
    ViewBag.Title = "Mis Facturas";
}

<div class="section-pad">
    <div class="eyebrow">Mis facturas</div>
    <div class="h-name" style="font-size: 22px;">Mis Pagos</div>
</div>

@foreach (var f in Model)
{
    <div class="card-cliente" style="border-left: 5px solid var(--blue);">
        <div class="d-flex justify-content-between">
            <div>
                <div style="font-weight: bold;">@f.Periodo</div>
                <div style="font-size: 24px; font-weight: 800; color: var(--blue);">₡@f.Monto.ToString("N0")</div>
            </div>
            @if (f.Estado == "Pagada")
            {
                <span class="badge badge-success align-self-start">Pagada</span>
            }
            else
            {
                <span class="badge badge-warning align-self-start">Pendiente</span>
            }
        </div>
        <hr />
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="window.location='/Pagos/Sinpe?monto=@f.Monto&periodo=@f.Periodo'">SINPE</button>
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="window.location='/Pagos/Iban?monto=@f.Monto&periodo=@f.Periodo'">IBAN</button>
            <button class="btn btn-sm btn-outline-primary flex-fill" onclick="window.location='/Pagos/Tarjeta?monto=@f.Monto&periodo=@f.Periodo'">Tarjeta</button>
        </div>
    </div>
}