@model CNFL_Clientes_Prototipo.Models.Factura
@{
    ViewBag.Title = "Detalle de Factura";
}

<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <div class="h-name" style="font-size: 24px;">Detalle de Factura</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Revisa la información completa de tu factura.</div>
</div>

<div class="section-pad">
    <div class="card-cliente" style="border-left: 5px solid var(--blue);">
        <div class="d-flex justify-content-between">
            <div>
                <div style="font-weight: 700; font-size: 14px;">@Model.Periodo</div>
                <div style="font-size: 32px; font-weight: 800; color: var(--blue); margin-top: 4px;">₡ @Model.Monto.ToString("N0")</div>
            </div>
            @if (Model.Estado == "Pagada")
            {
                <span class="pill st-normal">Pagada</span>
            }
            else
            {
                <span class="pill st-prev">Pendiente</span>
            }
        </div>

        <hr style="border-color: var(--line); margin: 15px 0;" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
                <div style="font-size: 11px; color: var(--muted); font-weight: 700;">NISE</div>
                <div style="font-size: 14px; font-weight: 700; margin-top: 4px;">4021</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--muted); font-weight: 700;">Tarifa</div>
                <div style="font-size: 14px; font-weight: 700; margin-top: 4px;">Residencial</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--muted); font-weight: 700;">Consumo</div>
                <div style="font-size: 14px; font-weight: 700; margin-top: 4px;">387 kWh</div>
            </div>
            <div>
                <div style="font-size: 11px; color: var(--muted); font-weight: 700;">Vencimiento</div>
                <div style="font-size: 14px; font-weight: 700; margin-top: 4px;">28 de agosto</div>
            </div>
        </div>
    </div>

    @if (Model.Estado == "Pendiente")
    {
        <div class="card-cliente mt-3" style="text-align: center;">
            <p style="font-size: 13px; color: var(--muted);">¿Deseas pagar esta factura ahora?</p>
            <a href="/Pagos/Sinpe?monto=@Model.Monto&producto=@Model.Periodo" class="btn btn-cnfl mt-2">Pagar con SINPE</a>
            <a href="/Pagos/Iban?monto=@Model.Monto&producto=@Model.Periodo" class="btn btn-outline-primary mt-2 w-100">Pagar con IBAN</a>
            <a href="/Pagos/Tarjeta?monto=@Model.Monto&producto=@Model.Periodo" class="btn btn-outline-primary mt-2 w-100">Pagar con Tarjeta</a>
        </div>
    }
</div>

<div style="height: 20px;"></div>