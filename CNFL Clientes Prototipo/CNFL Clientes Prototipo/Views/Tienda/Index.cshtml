@{
    ViewBag.Title = "Tienda CNFL";
}

<div class="section-pad">
    <div class="eyebrow">Productos y servicios</div>
</div>

<div style="background: linear-gradient(120deg, var(--orange), #ff8a5c); color: white; border-radius: 22px; padding: 20px; position: relative; overflow: hidden; box-shadow: 0 16px 30px -12px rgba(255,105,45,.6);">
    <div style="font-size: 12px; font-weight: 800; letter-spacing: .05em; opacity: .9;">HOGAR 360°</div>
    <div style="font-size: 20px; font-weight: 800; margin: 6px 0 4px; line-height: 1.15;">Cargador para tu auto eléctrico</div>
    <div style="font-size: 12.5px; opacity: .92; line-height: 1.4; max-width: 74%;">Instalación certificada. Págalo cómodo en tu factura eléctrica.</div>
</div>

<div class="card-cliente mt-3">
    <h5>Marketplace</h5>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 13px;">
        <div class="card-cliente" style="text-align: center; margin: 0;">
            <div style="font-size: 32px; margin-bottom: 10px;">❄️</div>
            <div style="font-weight: 700; font-size: 13px;">Aire acondicionado Inverter</div>
            <div style="font-weight: 800; font-size: 16px; margin-top: 5px;">₡ 289.000</div>
            <button class="btn btn-cnfl mt-2" style="padding: 8px;">Cargar a factura</button>
        </div>
        <div class="card-cliente" style="text-align: center; margin: 0;">
            <div style="font-size: 32px; margin-bottom: 10px;">💡</div>
            <div style="font-weight: 700; font-size: 13px;">Kit iluminación LED</div>
            <div style="font-weight: 800; font-size: 16px; margin-top: 5px;">₡ 42.900</div>
            <button class="btn btn-cnfl mt-2" style="padding: 8px;">Cargar a factura</button>
        </div>
    </div>
</div>