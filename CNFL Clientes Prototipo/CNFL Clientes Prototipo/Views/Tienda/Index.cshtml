                <button style="width: 100%; margin-top: 9px; background: var(--orange); color: #fff; border: 0; font-weight: 800; font-size: 11.5px; padding: 9px; border-radius: 11px; cursor: pointer;" onclick="window.location='/Pagos?monto=185000&producto=Panel+Solar'">Cargar a factura</button>
            </div>
        </div>

        <!-- Producto 6 -->
        <div style="background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow);">
