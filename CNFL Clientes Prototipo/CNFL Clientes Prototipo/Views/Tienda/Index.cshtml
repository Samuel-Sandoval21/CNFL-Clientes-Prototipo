@{
    ViewBag.Title = "Tienda CNFL";
}

<div class="section-pad">
    <div class="h-name" style="font-size: 22px;">Productos y servicios</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 4px;">Compra fácil, paga con tu factura.</div>
</div>

<!-- Banner Promocional -->
<div class="section-pad" style="margin-top: 12px;">
    <div class="promo-banner">
        <div class="promo-kicker">HOGAR 360°</div>
        <div class="promo-title">Cargador para tu auto eléctrico</div>
        <div class="promo-desc">Instalación certificada. Págalo cómodo en tu factura eléctrica.</div>
        <button class="btn-cotizar" onclick="window.location='/Pagos?monto=615000&producto=Cargador+EV'">Solicitar cotización →</button>
    </div>
</div>

<!-- Categorías (CNFL te asiste) -->
<div class="section-pad">
    <div class="eyebrow">CNFL te asiste</div>
    <div class="cat-scroll">
        <div class="cat-card" onclick="window.location='/Pagos?monto=0&producto=Seguro'">
            <div class="cat-icon">🛡️</div>
            <span>Seguros</span>
        </div>
        <div class="cat-card" onclick="window.location='/Pagos?monto=0&producto=5G'">
            <div class="cat-icon">📶</div>
            <span>5G</span>
        </div>
        <div class="cat-card" onclick="window.location='/Pagos?monto=0&producto=Vigilancia'">
            <div class="cat-icon">📷</div>
            <span>Vigilancia</span>
        </div>
        <div class="cat-card" onclick="window.location='/Pagos?monto=0&producto=Consumo+Verde'">
            <div class="cat-icon">💚</div>
            <span>Consumo Verde</span>
        </div>
        <div class="cat-card" onclick="window.location='/Pagos?monto=0&producto=Domotica'">
            <div class="cat-icon">🏠</div>
            <span>Domótica</span>
        </div>
    </div>
</div>

<!-- Marketplace -->
<div class="section-pad">
    <div class="eyebrow">Marketplace</div>
    <div class="pgrid">
        <div class="prod">
            <div class="img" style="background: #eef6ff;">❄️</div>
            <div class="b">
                <div class="n">Aire acondicionado Inverter 12.000 BTU</div>
                <div class="pr">₡ 289.000</div>
                <button class="add" onclick="window.location='/Pagos?monto=289000&producto=Aire'">Cargar a factura</button>
            </div>
        </div>

        <div class="prod">
            <div class="img" style="background: #fff3ec;">💡</div>
            <div class="b">
                <div class="n">Kit iluminación LED inteligente</div>
                <div class="pr">₡ 42.900</div>
                <button class="add" onclick="window.location='/Pagos?monto=42900&producto=LED'">Cargar a factura</button>
            </div>
        </div>

        <div class="prod">
            <div class="img" style="background: #f3f0ff;">🔋</div>
            <div class="b">
                <div class="n">Cargador EV residencial 7kW</div>
                <div class="pr">₡ 615.000</div>
                <button class="add" onclick="window.location='/Pagos?monto=615000&producto=Cargador+EV'">Cargar a factura</button>
            </div>
        </div>

        <div class="prod">
            <div class="img" style="background: #eefbf0;">🔌</div>
            <div class="b">
                <div class="n">Supresor de picos + base</div>
                <div class="pr">₡ 74.500</div>
                <button class="add" onclick="window.location='/Pagos?monto=74500&producto=Supresor'">Cargar a factura</button>
            </div>
        </div>

        <div class="prod">
            <div class="img" style="background: #fff9e6;">🔆</div>
            <div class="b">
                <div class="n">Panel Solar 400W</div>
                <div class="pr">₡ 185.000</div>
                <button class="add" onclick="window.location='/Pagos?monto=185000&producto=Panel+Solar'">Cargar a factura</button>
            </div>
        </div>

        <div class="prod">
            <div class="img" style="background: #fff0f5;">🌡️</div>
            <div class="b">
                <div class="n">Termostato Smart</div>
                <div class="pr">₡ 89.000</div>
                <button class="add" onclick="window.location='/Pagos?monto=89000&producto=Termostato'">Cargar a factura</button>
            </div>
        </div>
    </div>
</div>