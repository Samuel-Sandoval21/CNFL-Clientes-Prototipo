@{
    ViewBag.Title = "Tienda CNFL";
}

<div class="section-pad">
    <div class="h-name" style="font-size: 22px;">Productos y servicios</div>
</div>

<!-- Banner Promocional -->
<div class="section-pad" style="margin-top: 12px;">
    <div style="background: linear-gradient(120deg, var(--orange), #ff8a5c); color: #fff; border-radius: 22px; padding: 20px; position: relative; overflow: hidden; box-shadow: 0 16px 30px -12px rgba(255,105,45,.6);">
        <div style="font-size: 12px; font-weight: 800; letter-spacing: .05em; opacity: .9;">HOGAR 360°</div>
        <div style="font-size: 20px; font-weight: 800; margin: 6px 0 4px;">Cargador para tu auto eléctrico</div>
        <div style="font-size: 12.5px; opacity: .92;">Instalación certificada. Págalo cómodo en tu factura eléctrica.</div>
        <button class="btn btn-line" style="margin-top: 14px; padding: 11px 18px;" onclick="window.location='/Pagos?monto=615000&producto=Cargador+EV'">Solicitar cotización →</button>
    </div>
</div>

<!-- Categorías -->
<div class="section-pad">
    <div class="eyebrow">CNFL te asiste</div>
    <div style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 5px;">
        <div style="min-width: 80px; background: #fff; border-radius: 18px; padding: 12px; text-align: center; cursor: pointer; box-shadow: var(--shadow);">
            <div style="font-size: 26px; margin-bottom: 5px;">🛡️</div>
            <div style="font-size: 11px; font-weight: 800;">Seguros</div>
        </div>
        <div style="min-width: 80px; background: #fff; border-radius: 18px; padding: 12px; text-align: center; cursor: pointer; box-shadow: var(--shadow);">
            <div style="font-size: 26px; margin-bottom: 5px;">📶</div>
            <div style="font-size: 11px; font-weight: 800;">5G</div>
        </div>
        <div style="min-width: 80px; background: #fff; border-radius: 18px; padding: 12px; text-align: center; cursor: pointer; box-shadow: var(--shadow);">
            <div style="font-size: 26px; margin-bottom: 5px;">📷</div>
            <div style="font-size: 11px; font-weight: 800;">Videovigilancia</div>
        </div>
        <div style="min-width: 80px; background: #fff; border-radius: 18px; padding: 12px; text-align: center; cursor: pointer; box-shadow: var(--shadow);">
            <div style="font-size: 26px; margin-bottom: 5px;">💚</div>
            <div style="font-size: 11px; font-weight: 800;">Consumo verde</div>
        </div>
    </div>
</div>

<!-- Marketplace -->
<div class="section-pad">
    <div class="eyebrow">Marketplace</div>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 13px;">
        <!-- Producto 1 -->
        <div style="background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow);">
            <div style="height: 96px; display: grid; place-items: center; font-size: 34px; background: #eef6ff;">❄️</div>
            <div style="padding: 11px 12px 13px;">
                <div style="font-size: 12.5px; font-weight: 700;">Aire acondicionado Inverter 12.000 BTU</div>
                <div style="font-weight: 800; font-size: 15px; margin-top: 6px;">₡ 289.000</div>
                <button style="width: 100%; margin-top: 9px; background: var(--orange); color: #fff; border: 0; font-weight: 800; font-size: 11.5px; padding: 9px; border-radius: 11px; cursor: pointer;" onclick="window.location='/Pagos?monto=289000&producto=Aire'">Cargar a factura</button>
            </div>
        </div>

        <!-- Producto 2 -->
        <div style="background: #fff; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow);">
