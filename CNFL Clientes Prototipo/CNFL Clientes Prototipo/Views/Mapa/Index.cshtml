@{
    ViewBag.Title = "Mapa de Averías";
}
<h2>Mapa de Averías en la Red Eléctrica</h2>
<div class="alert alert-warning">
    <strong>Prototipo:</strong> En la app final, aquí se cargará la capa de ArcGIS (ArcMap) solicitada por el equipo.
</div>

<!-- Mapa simulado con estilos CSS -->
<div style="background: #2A1500; height: 400px; border-radius: 16px; position: relative; overflow: hidden;">
    <div style="position:absolute; left: 20%; top: 30%; width: 20px; height: 20px; background: red; border-radius: 50%; border: 3px solid white;"></div>
    <div style="position:absolute; left: 20%; top: 30%; color: white; font-size: 12px; margin-top: 25px;">Barrio Los Ángeles</div>

    <div style="position:absolute; left: 70%; top: 60%; width: 20px; height: 20px; background: green; border-radius: 50%; border: 3px solid white;"></div>
    <div style="position:absolute; left: 70%; top: 60%; color: white; font-size: 12px; margin-top: 25px;">Centro de Cartago</div>
</div>