@model CNFL_Clientes_Prototipo.Models.ViewModels.ReporteVentasViewModel
@{
    ViewBag.Title = "Reportes de Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section Styles {
    <style>
        .kpi-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 16px;
        }

        .kpi {
            background: #fff;
            border-radius: 14px;
            padding: 14px;
            box-shadow: 0 4px 20px rgba(20,30,70,.06);
        }

            .kpi .lbl {
                font-size: 10px;
                color: #6b7280;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .4px;
            }

            .kpi .num {
                font-size: 22px;
                font-weight: 900;
                margin-top: 4px;
                color: #1a2b6b;
                letter-spacing: -.5px;
                word-break: break-all;
            }

            .kpi.green .num {
                color: #00a651;
            }

            .kpi.gold .num {
                color: #c98a00;
            }

            .kpi.purple .num {
                color: #5b3fbf;
            }

        .bar-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
        }

            .bar-row .name {
                flex: 1;
                font-size: 12px;
                font-weight: 700;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .bar-row .bar {
                flex: 2;
                height: 8px;
                background: #eef0f5;
                border-radius: 4px;
                overflow: hidden;
            }

                .bar-row .bar span {
                    display: block;
                    height: 100%;
                    background: linear-gradient(90deg, #1a2b6b, #5b3fbf);
                }

            .bar-row .val {
                font-size: 11.5px;
                font-weight: 800;
                color: #1a2b6b;
                white-space: nowrap;
                min-width: 65px;
                text-align: right;
            }

        .btn-export {
            display: flex;
            gap: 8px;
            margin-top: 14px;
            margin-bottom: 20px;
        }

            .btn-export button {
                flex: 1;
                padding: 14px;
                border: 0;
                border-radius: 12px;
                font-family: inherit;
                font-weight: 800;
                font-size: 12.5px;
                cursor: pointer;
                transition: transform .15s;
            }

                .btn-export button:active {
                    transform: scale(.97);
                }

            .btn-export .xls {
                background: #e0f7e9;
                color: #00a651;
            }

            .btn-export .pdf {
                background: #ffe6e6;
                color: #e53935;
            }

            .btn-export .print {
                background: #eef0ff;
                color: #1a2b6b;
            }

        .tabla-compras {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
        }

            .tabla-compras thead th {
                text-align: left;
                padding: 8px 6px;
                font-weight: 800;
                color: #6b7280;
                text-transform: uppercase;
                font-size: 9.5px;
                letter-spacing: .4px;
                border-bottom: 2px solid #e3e6ee;
            }

            .tabla-compras tbody tr {
                border-bottom: 1px solid #eef0f5;
            }

                .tabla-compras tbody tr:last-child {
                    border-bottom: 0;
                }

            .tabla-compras td {
                padding: 9px 6px;
                vertical-align: top;
            }

        .metodo-tag {
            display: inline-block;
            font-size: 9.5px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 8px;
            background: #eef0ff;
            color: #1a2b6b;
            white-space: nowrap;
        }

        .card-empty {
            text-align: center;
            padding: 30px 20px;
            color: #6b7280;
            font-size: 12.5px;
        }

            .card-empty i {
                font-size: 38px;
                color: #c9ced9;
                margin-bottom: 10px;
                display: block;
            }
    </style>
}

<h2 class="page-title">📊 Reportes de Ventas</h2>
<p class="page-subtitle">Visualizá todo lo que los clientes han comprado y pagado en CNFL.</p>

<!-- ═══════════ FILTROS ═══════════ -->
<div class="filtros">
    <a href="?rango=7d&metodo=@Model.MetodoPago" class="filtro @(Model.FiltroRapido == "7d" ? "active" : "")">7 días</a>
    <a href="?rango=30d&metodo=@Model.MetodoPago" class="filtro @(Model.FiltroRapido == "30d" ? "active" : "")">30 días</a>
    <a href="?rango=90d&metodo=@Model.MetodoPago" class="filtro @(Model.FiltroRapido == "90d" ? "active" : "")">90 días</a>
    <a href="?rango=anio&metodo=@Model.MetodoPago" class="filtro @(Model.FiltroRapido == "anio" ? "active" : "")">Este año</a>
</div>

<!-- ═══════════ KPIs ═══════════ -->
<div class="kpi-grid">
    <div class="kpi green">
        <div class="lbl">Ingresos totales</div>
        <div class="num">₡@Model.IngresosTotales.ToString("N0")</div>
    </div>
    <div class="kpi">
        <div class="lbl">Compras</div>
        <div class="num">@Model.TotalCompras</div>
    </div>
    <div class="kpi purple">
        <div class="lbl">Clientes únicos</div>
        <div class="num">@Model.ClientesUnicos</div>
    </div>
    <div class="kpi gold">
        <div class="lbl">Ticket promedio</div>
        <div class="num">₡@Model.TicketPromedio.ToString("N0")</div>
    </div>
</div>

<!-- ═══════════ TOP CLIENTES ═══════════ -->
<div class="card">
    <h3 style="font-size:15px; font-weight:900; margin:0 0 12px;">🏆 Top clientes</h3>
    @if (Model.TopClientes.Any())
    {
        var maxCli = Model.TopClientes.Max(c => c.TotalGastado);
        foreach (var c in Model.TopClientes)
        {
            var pct = maxCli > 0 ? (c.TotalGastado / maxCli) * 100 : 0;
            <div class="bar-row">
                <div class="name">@c.Nombre</div>
                <div class="bar"><span style="width:@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                <div class="val">₡@c.TotalGastado.ToString("N0")</div>
            </div>
        }
    }
    else
    {
        <div class="card-empty">
            <i class="fas fa-users"></i>
            Sin datos en este período
        </div>
    }
</div>

<!-- ═══════════ MÉTODOS DE PAGO ═══════════ -->
<div class="card">
    <h3 style="font-size:15px; font-weight:900; margin:0 0 12px;">💳 Métodos de pago</h3>
    @if (Model.VentasPorMetodo.Any())
    {
        foreach (var m in Model.VentasPorMetodo)
        {
            <div class="bar-row">
                <div class="name">@m.Etiqueta</div>
                <div class="bar"><span style="width:@m.Porcentaje.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                <div class="val">₡@m.TotalIngresos.ToString("N0")</div>
            </div>
        }
    }
    else
    {
        <div class="card-empty">
            <i class="fas fa-credit-card"></i>
            Sin datos en este período
        </div>
    }
</div>

<!-- ═══════════ VENTAS POR MES ═══════════ -->
<div class="card">
    <h3 style="font-size:15px; font-weight:900; margin:0 0 12px;">📈 Ventas por mes</h3>
    <canvas id="chartMes" style="max-height:200px;"></canvas>
</div>

<!-- ═══════════ LISTA DE COMPRAS ═══════════ -->
<div class="card">
    <h3 style="font-size:15px; font-weight:900; margin:0 0 12px;">🧾 Últimas compras</h3>
    @if (Model.Compras.Any())
    {
        <div style="overflow-x:auto;">
            <table class="tabla-compras">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th style="text-align:right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Compras.Take(20))
                    {
                        <tr>
                            <td>
                                <div style="font-weight:800;">@c.ClienteNombre</div>
                                <div style="font-size:10px; color:#6b7280;">@c.ClienteCorreo</div>
                            </td>
                            <td>
                                <div>@c.Fecha.ToString("dd/MM/yyyy")</div>
                                <div style="font-size:10px; color:#6b7280;">@c.Fecha.ToString("HH:mm")</div>
                            </td>
                            <td><span class="metodo-tag">@c.MetodoPago</span></td>
                            <td style="text-align:right; font-weight:900; color:#1a2b6b;">
                                ₡@c.Total.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-empty">
            <i class="fas fa-shopping-cart"></i>
            Sin compras en este período
        </div>
    }
</div>

<!-- ═══════════ EXPORTAR ═══════════ -->
<div class="btn-export">
    <button class="xls" onclick="exportarExcel()">📥 Excel</button>
    <button class="pdf" onclick="exportarPDF()">📄 PDF</button>
    <button class="print" onclick="window.print()">🖨️ Imprimir</button>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        var datosCompras = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.Compras.Select(c => new {
                Cliente = c.ClienteNombre,
                Correo = c.ClienteCorreo,
                Fecha = c.Fecha.ToString("dd/MM/yyyy HH:mm"),
                Metodo = c.MetodoPago,
                Items = c.TotalItems,
                Total = c.Total
            })
        ));

        var datosMes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            Model.VentasPorMes.Select(v => new {
                Etiqueta = v.Etiqueta,
                Total = v.TotalIngresos
            })
        ));

        // Gráfico
        var ctx = document.getElementById('chartMes');
        if (ctx && datosMes.length) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: datosMes.map(function (d) { return d.Etiqueta; }),
                    datasets: [{
                        label: 'Ingresos',
                        data: datosMes.map(function (d) { return d.Total; }),
                        backgroundColor: '#1a2b6b',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return '₡' + context.parsed.y.toLocaleString('es-CR');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return '₡' + (value / 1000) + 'k';
                                }
                            }
                        }
                    }
                }
            });
        }

        function exportarExcel() {
            if (!datosCompras.length) {
                alert('No hay datos para exportar en este período.');
                return;
            }

            var ws = XLSX.utils.json_to_sheet(datosCompras);
            var wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Compras');

            var fecha = new Date().toISOString().slice(0, 10);
            XLSX.writeFile(wb, 'Reporte_Ventas_CNFL_' + fecha + '.xlsx');
        }

        function exportarPDF() {
            if (!datosCompras.length) {
                alert('No hay datos para exportar en este período.');
                return;
            }

            var jsPDF = window.jspdf.jsPDF;
            var doc = new jsPDF();

            doc.setFontSize(18);
            doc.setTextColor(26, 43, 107);
            doc.text('Reporte de Ventas · CNFL', 14, 20);

            doc.setFontSize(10);
            doc.setTextColor(107, 114, 128);
            doc.text('Generado: ' + new Date().toLocaleString('es-CR'), 14, 28);

            doc.setFontSize(11);
            doc.setTextColor(28, 31, 43);
            var kpis = [
                'Ingresos totales: ₡@Model.IngresosTotales.ToString("N0")',
                'Compras: @Model.TotalCompras',
                'Clientes únicos: @Model.ClientesUnicos',
                'Ticket promedio: ₡@Model.TicketPromedio.ToString("N0")'
            ];
            kpis.forEach(function (k, i) {
                doc.text(k, 14, 40 + (i * 6));
            });

            doc.autoTable({
                startY: 70,
                head: [['Cliente', 'Correo', 'Fecha', 'Método', 'Items', 'Total']],
                body: datosCompras.map(function (d) {
                    return [
                        d.Cliente,
                        d.Correo,
                        d.Fecha,
                        d.Metodo,
                        d.Items,
                        '₡' + d.Total.toLocaleString('es-CR')
                    ];
                }),
                styles: { fontSize: 8, cellPadding: 3 },
                headStyles: { fillColor: [26, 43, 107], textColor: 255, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: [244, 246, 251] }
            });

            var fecha = new Date().toISOString().slice(0, 10);
            doc.save('Reporte_Ventas_CNFL_' + fecha + '.pdf');
        }
    </script>
}