@model List<CNFL_Clientes_Prototipo.Models.Usuario>

@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/admin/clientes.css" />

<div class="admin-clientes">
    <div class="page-header">
        <h1>Gestión de Clientes</h1>
        <p>Lista completa de clientes registrados en la plataforma.</p>
    </div>

    <div class="filtros-container">
        <div class="filtros">
            <input type="text" id="buscadorClientes" class="form-control-sm" placeholder="🔍 Buscar por nombre, cédula o correo..." />
            <button class="btn-limpiar" id="btnLimpiarBusqueda">Limpiar</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="admin-table" id="tablaClientes">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Cédula</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Fecha Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.UsuarioId</td>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Apellidos</td>
                            <td>@usuario.Cedula</td>
                            <td>@usuario.Correo</td>
                            <td>@usuario.Telefono</td>
                            <td>@usuario.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="@Url.Action("DetalleCliente", "Admin", new { id = usuario.UsuarioId })" class="btn-ver btn-ver-cliente" data-id="@usuario.UsuarioId">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="empty-message">No hay clientes registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin/clientes.js"></script>
}