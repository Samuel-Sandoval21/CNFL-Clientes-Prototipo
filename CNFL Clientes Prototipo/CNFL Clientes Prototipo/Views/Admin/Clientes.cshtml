@model List<CNFL_Clientes_Prototipo.Models.ClienteAdminDto>
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section Styles {
    <style>
        .search-box {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--line);
            border-radius: 14px;
            font-size: 14px;
            font-family: inherit;
            margin-bottom: 14px;
            background: #fff;
        }

        .cliente-card {
            background: #fff;
            border-radius: 16px;
            padding: 14px;
            margin-bottom: 10px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--blue-soft);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0;
        }

        .info {
            flex: 1;
            min-width: 0;
        }

            .info .name {
                font-weight: 800;
                font-size: 14px;
                color: var(--text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .info .meta {
                font-size: 12px;
                color: var(--muted);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
    </style>
}

<h1 class="page-title">Clientes</h1>

@using (Html.BeginForm("Clientes", "Admin", FormMethod.Get))
{
    <input type="text" name="q" class="search-box"
           placeholder="Buscar por nombre, cédula o correo..."
           value="@ViewBag.Busqueda" />
}

@if (Model == null || !Model.Any())
{
    <div class="empty">
        <i class="fas fa-users" style="font-size:38px;color:#c9ced9;"></i>
        <p>No se encontraron clientes.</p>
    </div>
}
else
{
    foreach (var c in Model)
    {
        var inicial = string.IsNullOrEmpty(c.Nombre) ? "?" : c.Nombre.Substring(0, 1).ToUpper();
        <a href="@Url.Action("DetalleCliente", "Admin", new { id = c.UsuarioId })" class="cliente-card">
            <div class="avatar">@inicial</div>
            <div class="info">
                <div class="name">@c.Nombre @c.Apellidos</div>
                <div class="meta">@c.Cedula · @c.Correo</div>
                <div class="meta" style="margin-top:3px;">
                    @c.TotalNISEs NISEs · ₡@c.MontoPendiente.ToString("N0") pendiente
                </div>
            </div>
            <span class="badge @(c.Activo ? "ok" : "warn")">
                @(c.Activo ? "Activo" : "Inactivo")
            </span>
        </a>
    }
}