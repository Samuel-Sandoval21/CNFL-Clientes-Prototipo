@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var consumos = ViewBag.Consumos as List<CNFL_Clientes_Prototipo.Models.ConsumoMensualDto>
                   ?? new List<CNFL_Clientes_Prototipo.Models.ConsumoMensualDto>();
    var totalFacturado = (decimal)(ViewBag.TotalFacturado ?? 0m);
    var totalCobrado = (decimal)(ViewBag.TotalCobrado ?? 0m);
    var totalPendiente = (decimal)(ViewBag.TotalPendiente ?? 0m);

    var maxMonto = consumos.Any() ? consumos.Max(c => c.monto) : 1m;
    if (maxMonto <= 0) { maxMonto = 1m; }
}

@section Styles {
    <style>
        .summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            margin-bottom: 20px;
        }

        .summary-card {
            background: #fff;
            border-radius: 14px;
            padding: 12px 8px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            text-align: center;
        }

            .summary-card .label {
                font-size: 9.5px;
                color: var(--muted);
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .4px;
                margin-bottom: 6px;
            }

            .summary-card .value {
                font-size: 12.5px;
                font-weight: 900;
                color: var(--text);
                word-break: break-all;
            }

            .summary-card.gold .value {
                color: var(--gold);
            }

            .summary-card.green .value {
                color: var(--green);
            }

            .summary-card.red .value {
                color: var(--red);
            }

        .chart-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            margin-bottom: 14px;
        }

        .section-title {
            font-size: 14.5px;
            font-weight: 800;
            color: var(--blue);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-title i {
                font-size: 15px;
                color: var(--purple);
            }

        .chart {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 6px;
            height: 160px;
            padding: 10px 0;
        }

            .chart .bar-wrap {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-end;
                height: 100%;
            }

            .chart .bar {
                width: 100%;
                background: linear-gradient(180deg, #1a2b6b, #5b3fbf);
                border-radius: 8px 8px 0 0;
                min-height: 6px;
                transition: height .3s;
                box-shadow: 0 4px 10px -4px rgba(26, 43, 107, .4);
            }

            .chart .label {
                font-size: 11px;
                color: var(--muted);
                font-weight: 700;
                margin-top: 8px;
                text-transform: uppercase;
            }

            .chart .value {
                font-size: 9px;
                color: var(--blue);
                font-weight: 800;
                margin-bottom: 4px;
            }

        .export-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .export-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 16px 12px;
            border-radius: 14px;
            font-size: 13.5px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            border: none;
            transition: transform .15s, box-shadow .15s;
        }

            .export-btn:active {
                transform: scale(.97);
            }

            .export-btn.excel {
                background: var(--green-soft);
                color: #046a38;
                box-shadow: 0 6px 14px -6px rgba(4, 106, 56, .3);
            }

            .export-btn.pdf {
                background: var(--red-soft);
                color: #b71c1c;
                box-shadow: 0 6px 14px -6px rgba(183, 28, 28, .3);
            }

            .export-btn i {
                font-size: 18px;
            }
    </style>
}

<h1 class="page-title">Reportes</h1>
<p class="page-subtitle">Resumen financiero y descarga de informes.</p>

<div class="summary-grid">
    <div class="summary-card gold">
        <div class="label">Facturado</div>
        <div class="value">₡@totalFacturado.ToString("N0")</div>
    </div>
    <div class="summary-card green">
        <div class="label">Cobrado</div>
        <div class="value">₡@totalCobrado.ToString("N0")</div>
    </div>
    <div class="summary-card red">
        <div class="label">Pendiente</div>
        <div class="value">₡@totalPendiente.ToString("N0")</div>
    </div>
</div>

<div class="chart-card">
    <div class="section-title">
        <i class="fas fa-chart-bar"></i>
        Facturación últimos 6 meses
    </div>
    @if (!consumos.Any())
    {
        <div class="empty" style="padding:20px;">Sin datos</div>
    }
    else
    {
        <div class="chart">
            @foreach (var c in consumos)
            {
                var pct = (double)(c.monto / maxMonto) * 100;
                if (pct < 3) { pct = 3; }
                <div class="bar-wrap">
                    <div class="value">@((c.monto / 1000).ToString("N0"))k</div>
                    <div class="bar" style="height:@(pct.ToString("0.0"))%;"></div>
                    <div class="label">@c.mes</div>
                </div>
            }
        </div>
    }
</div>

<div class="chart-card">
    <div class="section-title">
        <i class="fas fa-download"></i>
        Descargar reportes
    </div>
    <div class="export-grid">
        <a href="@Url.Action("ExportarExcel", "Admin")" class="export-btn excel">
            <i class="fas fa-file-excel"></i>
            Excel
        </a>
        <a href="@Url.Action("ExportarPDF", "Admin")" class="export-btn pdf">
            <i class="fas fa-file-pdf"></i>
            PDF
        </a>
    </div>
    <p style="font-size:11.5px;color:var(--muted);margin:12px 0 0;text-align:center;">
        Los archivos se descargan a tu dispositivo.
    </p>
</div>