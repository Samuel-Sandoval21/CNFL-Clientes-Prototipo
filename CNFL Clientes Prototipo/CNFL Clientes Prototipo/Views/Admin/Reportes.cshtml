@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/admin/reportes.css" />

<div class="admin-reportes">
    <div class="page-header">
        <h1>Reportes</h1>
        <p>Genera reportes y estadísticas del sistema.</p>
    </div>

    <div class="reportes-grid">
        <div class="reporte-card">
            <div class="reporte-icon">📊</div>
            <h3>Reporte de Averías</h3>
            <p>Genera un reporte detallado de todas las averías registradas.</p>
            <a href="@Url.Action("ReportesPDF", "Admin", new { tipo = "averias" })" class="btn-generar" target="_blank">Generar PDF</a>
        </div>

        <div class="reporte-card">
            <div class="reporte-icon">👥</div>
            <h3>Reporte de Clientes</h3>
            <p>Genera un reporte de todos los clientes registrados.</p>
            <a href="@Url.Action("ReportesPDF", "Admin", new { tipo = "clientes" })" class="btn-generar" target="_blank">Generar PDF</a>
        </div>

        <div class="reporte-card">
            <div class="reporte-icon">📈</div>
            <h3>Estadísticas Generales</h3>
            <p>Genera un reporte con estadísticas de uso y rendimiento.</p>
            <a href="@Url.Action("ReportesPDF", "Admin", new { tipo = "estadisticas" })" class="btn-generar" target="_blank">Generar PDF</a>
        </div>

        <div class="reporte-card">
            <div class="reporte-icon">⚡</div>
            <h3>Reporte de Consumo</h3>
            <p>Genera un reporte de consumo eléctrico por cliente.</p>
            <a href="@Url.Action("ReportesPDF", "Admin", new { tipo = "consumo" })" class="btn-generar" target="_blank">Generar PDF</a>
        </div>
    </div>

    <div class="admin-note-box">
        <p>💡 Los reportes se generan en formato PDF con los datos más recientes del sistema.</p>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin/reportes.js"></script>
}