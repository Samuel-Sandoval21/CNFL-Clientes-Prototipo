@using CNFL_Clientes_Prototipo.Models.ViewModels
@model CNFL_Clientes_Prototipo.Models.ViewModels.ReporteClienteViewModel
@{
    ViewBag.Title = "Reportes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var vm = Model;
}

@section Styles {
    <style>
        /* ═══ HERO ═══ */
        .rep-hero {
            background: linear-gradient(135deg, #1a2b6b 0%, #5b3fbf 100%);
            border-radius: 18px;
            padding: 20px;
            color: #fff;
            margin-bottom: 18px;
            position: relative;
            overflow: hidden;
        }

            .rep-hero::after {
                content: '';
                position: absolute;
                right: -40px;
                top: -40px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(255,255,255,.15), transparent 70%);
            }

            .rep-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 900;
                letter-spacing: -.3px;
                position: relative;
                z-index: 2;
            }

            .rep-hero p {
                margin: 6px 0 0;
                font-size: 12.5px;
                opacity: .9;
                position: relative;
                z-index: 2;
            }

        .rep-badge-periodo {
            display: inline-block;
            margin-top: 10px;
            padding: 4px 12px;
            background: rgba(255,255,255,.18);
            border-radius: 20px;
            font-size: 11px;
            font-weight: 800;
            position: relative;
            z-index: 2;
        }

        /* ═══ FILTROS ═══ */
        .rep-filtros {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .rep-filtro-label {
            font-size: 10px;
            font-weight: 800;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 4px;
        }

        .rep-select {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e3e6ee;
            border-radius: 12px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            background: #fff;
            cursor: pointer;
            outline: none;
        }

        .rep-chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .rep-chip {
            padding: 8px 14px;
            background: #fff;
            border: 1.5px solid #e3e6ee;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 700;
            color: #6b7280;
            text-decoration: none;
            cursor: pointer;
            transition: all .15s;
            white-space: nowrap;
            display: inline-block;
        }

            .rep-chip:hover {
                border-color: #c9ced9;
            }

            .rep-chip.active {
                background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
                color: #fff;
                border-color: transparent;
            }

        /* ═══ EXPORTS ═══ */
        .rep-exports {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 18px;
        }

        .rep-btn-export {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 14px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
        }

            .rep-btn-export.excel {
                background: #d4f0e0;
                color: #046a38;
            }

            .rep-btn-export.pdf {
                background: #ffe0e0;
                color: #b71c1c;
            }

            .rep-btn-export i {
                font-size: 16px;
            }

        /* ═══ SECCIONES ═══ */
        .rep-section {
            background: #fff;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 14px;
            border: 1px solid #eef0f5;
            box-shadow: 0 2px 10px rgba(20, 30, 70, .04);
        }

        .rep-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 800;
            color: var(--blue);
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eef0f5;
        }

            .rep-section-title i {
                font-size: 14px;
                color: var(--purple);
            }

        .rep-section-count {
            margin-left: auto;
            font-size: 10.5px;
            color: #6b7280;
            font-weight: 700;
            text-transform: none;
            letter-spacing: 0;
        }

        /* ═══ GRIDS ═══ */
        .rep-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        @@media (min-width: 600px) {
            .rep-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (min-width: 900px) {
            .rep-grid-4 {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        /* ═══ KPI CARDS ═══ */
        .kpi-card {
            background: linear-gradient(180deg, #f9fafc, #f4f6fb);
            border: 1px solid #e8ecf5;
            border-radius: 12px;
            padding: 12px 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .kpi-lbl {
            font-size: 10px;
            font-weight: 800;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .04em;
            line-height: 1.3;
            word-wrap: break-word;
        }

        .kpi-val {
            font-size: 16px;
            font-weight: 900;
            color: #1a2b6b;
            letter-spacing: -.3px;
            line-height: 1.15;
            word-wrap: break-word;
        }

        .kpi-card.gold .kpi-val {
            color: #c98a00;
        }

        .kpi-card.green .kpi-val {
            color: #046a38;
        }

        .kpi-card.red .kpi-val {
            color: #b71c1c;
        }

        .kpi-card.purple .kpi-val {
            color: #5b3fbf;
        }

        /* ═══ BARRA ═══ */
        .rep-bar {
            height: 8px;
            background: #eef0f5;
            border-radius: 4px;
            overflow: hidden;
            margin: 10px 0 6px;
        }

            .rep-bar > span {
                display: block;
                height: 100%;
                background: linear-gradient(90deg, #1a2b6b, #5b3fbf);
                border-radius: 4px;
            }

        .rep-subtitle {
            font-size: 11.5px;
            color: #6b7280;
            font-weight: 700;
            margin: 8px 0 4px;
        }

        /* ═══ CHART ═══ */
        .rep-chart-box {
            background: #fafbfe;
            border: 1px solid #eef0f5;
            border-radius: 12px;
            padding: 12px;
            margin-top: 10px;
        }

            .rep-chart-box canvas {
                max-height: 220px;
            }

        /* ═══ TABLAS ═══ */
        .rep-table-wrap {
            overflow-x: auto;
            border-radius: 10px;
            border: 1px solid #eef0f5;
            margin-top: 6px;
        }

        .rep-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11.5px;
            min-width: 420px;
        }

            .rep-table thead th {
                background: #f4f6fb;
                text-align: left;
                padding: 10px 12px;
                font-size: 9.5px;
                font-weight: 800;
                color: #1a2b6b;
                text-transform: uppercase;
                border-bottom: 1.5px solid #e3e6ee;
                white-space: nowrap;
            }

            .rep-table tbody td {
                padding: 10px 12px;
                border-bottom: 1px solid #f0f2f8;
                vertical-align: middle;
            }

            .rep-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .rep-table tbody tr:hover {
                background: #fafbfe;
            }

            .rep-table .col-num {
                font-weight: 800;
                text-align: right;
                white-space: nowrap;
            }

            .rep-table .col-badge {
                text-align: center;
            }

        /* ═══ BADGES ═══ */
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
            line-height: 1;
        }

        .badge-green {
            background: #d4f0e0;
            color: #046a38;
        }

        .badge-amber {
            background: #fff4d9;
            color: #c98a00;
        }

        .badge-red {
            background: #ffe0e0;
            color: #b71c1c;
        }

        .badge-blue {
            background: #e0e8ff;
            color: #1a2b6b;
        }

        .badge-gray {
            background: #eef0f5;
            color: #6b7280;
        }

        /* ═══ EMPTY ═══ */
        .rep-empty {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            background: #f9fafc;
            border: 1px dashed #e3e6ee;
            border-radius: 10px;
            color: #6b7280;
            font-size: 12px;
        }

            .rep-empty i {
                font-size: 22px;
                color: #c9ced9;
            }

        /* ═══ ESTADO CUENTA ═══ */
        .rep-estado-cuenta {
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 12.5px;
            font-weight: 800;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .rep-estado-cuenta.green {
                background: #d4f0e0;
                color: #046a38;
            }

            .rep-estado-cuenta.amber {
                background: #fff4d9;
                color: #c98a00;
            }

            .rep-estado-cuenta.red {
                background: #ffe0e0;
                color: #b71c1c;
            }
    </style>
}

<!-- ═══ HERO ═══ -->
<div class="rep-hero">
    <h1>📊 Reporte General</h1>
    <p>Resumen ejecutivo del sistema y detalle por cliente.</p>
    <span class="rep-badge-periodo">Período: @vm.RangoTexto</span>
</div>

<!-- ═══ FILTROS ═══ -->
<div class="rep-section">
    <div class="rep-section-title">
        <i class="fas fa-filter"></i> Filtros
    </div>

    <div class="rep-filtros">
        <div>
            <div class="rep-filtro-label">Cliente</div>
            <select class="rep-select" onchange="cambiarCliente(this.value);">
                @foreach (var c in vm.ClientesLista)
                {
                    var sel = (vm.ClienteId.HasValue && vm.ClienteId.Value == c.Key) ? "selected" : "";
                    <option value="@c.Key" @sel>@c.Value</option>
                }
            </select>
        </div>

        <div>
            <div class="rep-filtro-label">Período</div>
            <div class="rep-chips">
                <a href="?rango=todo&amp;clienteId=@vm.ClienteId" class="rep-chip @(vm.Rango == "todo" ? "active" : "")">Todo</a>
                <a href="?rango=7d&amp;clienteId=@vm.ClienteId" class="rep-chip @(vm.Rango == "7d" ? "active" : "")">7 días</a>
                <a href="?rango=30d&amp;clienteId=@vm.ClienteId" class="rep-chip @(vm.Rango == "30d" ? "active" : "")">30 días</a>
                <a href="?rango=90d&amp;clienteId=@vm.ClienteId" class="rep-chip @(vm.Rango == "90d" ? "active" : "")">90 días</a>
                <a href="?rango=anio&amp;clienteId=@vm.ClienteId" class="rep-chip @(vm.Rango == "anio" ? "active" : "")">Este año</a>
            </div>
        </div>
    </div>
</div>

<!-- ═══ EXPORTS ═══ -->
<div class="rep-exports">
    <a href="@Url.Action("ExportarReporteExcel", "Admin", new { clienteId = vm.ClienteId, rango = vm.Rango })"
       class="rep-btn-export excel">
        <i class="fas fa-file-excel"></i> Excel
    </a>
    <a href="@Url.Action("ExportarReportePDF", "Admin", new { clienteId = vm.ClienteId, rango = vm.Rango })"
       class="rep-btn-export pdf">
        <i class="fas fa-file-pdf"></i> PDF
    </a>
</div>

<!-- ═══════════════════════════════════════════
     SECCIÓN 1: RESUMEN DEL SISTEMA
     ═══════════════════════════════════════════ -->
<div class="rep-section">
    <div class="rep-section-title">
        <i class="fas fa-chart-pie"></i> Resumen general del sistema
    </div>

    <div class="rep-grid rep-grid-4">
        <div class="kpi-card">
            <div class="kpi-lbl">Clientes activos</div>
            <div class="kpi-val">@vm.SisClientesActivos.ToString("N0")</div>
        </div>
        <div class="kpi-card purple">
            <div class="kpi-lbl">Clientes totales</div>
            <div class="kpi-val">@vm.SisClientesTotal.ToString("N0")</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-lbl">NISEs</div>
            <div class="kpi-val">@vm.SisNISEs.ToString("N0")</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-lbl">Servicios al día</div>
            <div class="kpi-val">@vm.SisServiciosAlDia.ToString("N0")</div>
        </div>
        <div class="kpi-card red">
            <div class="kpi-lbl">Servicios con deuda</div>
            <div class="kpi-val">@vm.SisServiciosConDeuda.ToString("N0")</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-lbl">Facturas emitidas</div>
            <div class="kpi-val">@vm.SisFacturas.ToString("N0")</div>
        </div>
        <div class="kpi-card red">
            <div class="kpi-lbl">Facturas vencidas</div>
            <div class="kpi-val">@vm.SisFacturasVencidas.ToString("N0")</div>
        </div>
        <div class="kpi-card red">
            <div class="kpi-lbl">Averías abiertas</div>
            <div class="kpi-val">@vm.SisAveriasAbiertas.ToString("N0")</div>
        </div>
        <div class="kpi-card purple">
            <div class="kpi-lbl">Trámites abiertos</div>
            <div class="kpi-val">@vm.SisTramitesAbiertos.ToString("N0")</div>
        </div>
    </div>

    <div class="rep-grid rep-grid-4">
        <div class="kpi-card gold">
            <div class="kpi-lbl">Total facturado</div>
            <div class="kpi-val">@RepFmt.Mon(vm.SisFacturado)</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-lbl">Total cobrado</div>
            <div class="kpi-val">@RepFmt.Mon(vm.SisCobrado)</div>
        </div>
        <div class="kpi-card red">
            <div class="kpi-lbl">Saldo pendiente</div>
            <div class="kpi-val">@RepFmt.Mon(vm.SisPendiente)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-lbl">Porcentaje cobrado</div>
            <div class="kpi-val">@RepFmt.Pct(vm.SisPorcentajeCobro)</div>
        </div>
    </div>

    <div class="rep-subtitle">Cobro de lo facturado: @RepFmt.Pct(vm.SisPorcentajeCobro)</div>
    <div class="rep-bar"><span style="width:@RepFmt.Css(vm.SisPorcentajeCobro)%"></span></div>

    @if (vm.SisIngresosVentas > 0 || vm.SisCompras > 0)
    {
        <div class="rep-grid rep-grid-4">
            <div class="kpi-card green">
                <div class="kpi-lbl">Ingresos por ventas</div>
                <div class="kpi-val">@RepFmt.Mon(vm.SisIngresosVentas)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Compras pagadas</div>
                <div class="kpi-val">@vm.SisCompras.ToString("N0")</div>
            </div>
            <div class="kpi-card purple">
                <div class="kpi-lbl">Compradores únicos</div>
                <div class="kpi-val">@vm.SisCompradores.ToString("N0")</div>
            </div>
            <div class="kpi-card gold">
                <div class="kpi-lbl">Ticket promedio</div>
                <div class="kpi-val">@RepFmt.Mon(vm.SisTicketPromedio)</div>
            </div>
        </div>
    }

    @if (vm.SisMensual != null && vm.SisMensual.Count > 0)
    {
        <div class="rep-subtitle">Facturado y cobrado en los últimos 6 meses</div>
        <div class="rep-chart-box">
            <canvas id="chartSistema"></canvas>
        </div>
    }

    @if (vm.TopDeudores != null && vm.TopDeudores.Count > 0)
    {
        <div class="rep-subtitle">Clientes con mayor saldo pendiente</div>
        <div class="rep-table-wrap">
            <table class="rep-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Cédula</th>
                        <th class="col-num">Facturas</th>
                        <th class="col-num">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in vm.TopDeudores)
                    {
                        <tr>
                            <td>@d.Nombre</td>
                            <td>@d.Cedula</td>
                            <td class="col-num">@d.Facturas</td>
                            <td class="col-num" style="color:#b71c1c;">@RepFmt.Mon(d.Monto)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (vm.HayCliente)
{
    <!-- ═══════════════════════════════════════════
         SECCIÓN 2: DETALLE DEL CLIENTE
         ═══════════════════════════════════════════ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-user"></i> Detalle del cliente
        </div>

        <div class="rep-estado-cuenta @vm.EstadoCuentaClase">
            <i class="fas fa-info-circle"></i> @vm.EstadoCuenta
        </div>

        <div class="rep-grid">
            <div class="kpi-card">
                <div class="kpi-lbl">Cliente</div>
                <div class="kpi-val" style="font-size:13px;">@vm.Cliente.NombreCompleto</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Cédula</div>
                <div class="kpi-val" style="font-size:13px;">@vm.Cliente.Cedula</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Correo</div>
                <div class="kpi-val" style="font-size:12px;">@vm.Cliente.Correo</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Teléfono</div>
                <div class="kpi-val" style="font-size:13px;">@(string.IsNullOrEmpty(vm.Cliente.Telefono) ? "—" : vm.Cliente.Telefono)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Registro</div>
                <div class="kpi-val" style="font-size:13px;">@RepFmt.Fecha(vm.Cliente.FechaRegistro)</div>
            </div>
            <div class="kpi-card @(vm.Cliente.Activo ? "green" : "red")">
                <div class="kpi-lbl">Estado</div>
                <div class="kpi-val" style="font-size:13px;">@(vm.Cliente.Activo ? "Activo" : "Inactivo")</div>
            </div>
        </div>

        <div class="rep-grid">
            <div class="kpi-card gold">
                <div class="kpi-lbl">Facturado (período)</div>
                <div class="kpi-val">@RepFmt.Mon(vm.Facturado)</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-lbl">Pagado (período)</div>
                <div class="kpi-val">@RepFmt.Mon(vm.Pagado)</div>
            </div>
            <div class="kpi-card red">
                <div class="kpi-lbl">Pendiente (período)</div>
                <div class="kpi-val">@RepFmt.Mon(vm.Pendiente)</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-lbl">Porcentaje pagado</div>
                <div class="kpi-val">@RepFmt.Pct(vm.PorcentajePagado)</div>
            </div>
            <div class="kpi-card red">
                <div class="kpi-lbl">Saldo total</div>
                <div class="kpi-val">@RepFmt.Mon(vm.SaldoPendienteTotal)</div>
            </div>
            <div class="kpi-card red">
                <div class="kpi-lbl">Monto vencido</div>
                <div class="kpi-val">@RepFmt.Mon(vm.MontoVencido)</div>
            </div>
        </div>

        <div class="rep-subtitle">Pago del período: @RepFmt.Pct(vm.PorcentajePagado)</div>
        <div class="rep-bar"><span style="width:@RepFmt.Css(vm.PorcentajePagado)%"></span></div>
    </div>

    <!-- ═══ SERVICIOS (NISE) ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-bolt"></i> Servicios (NISE)
            <span class="rep-section-count">@vm.Servicios.Count</span>
        </div>

        @if (vm.Servicios != null && vm.Servicios.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>NISE</th>
                            <th>Tipo</th>
                            <th>Provincia</th>
                            <th class="col-num">Facturas</th>
                            <th class="col-num">Saldo</th>
                            <th class="col-badge">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in vm.Servicios)
                        {
                            <tr>
                                <td><strong>@s.Nise</strong></td>
                                <td>@s.Tipo</td>
                                <td>@s.Provincia</td>
                                <td class="col-num">@s.Facturas</td>
                                <td class="col-num">@RepFmt.Mon(s.Pendiente)</td>
                                <td class="col-badge">
                                    <span class="badge badge-@RepFmt.Clase(s.Estado)">@s.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-bolt"></i> Sin servicios registrados.
            </div>
        }
    </div>

    <!-- ═══ FACTURACIÓN MENSUAL ═══ -->
    if (vm.FacturacionMensual != null && vm.FacturacionMensual.Count > 0)
    {
        <div class="rep-section">
            <div class="rep-section-title">
                <i class="fas fa-chart-line"></i> Facturación del cliente · últimos 12 meses
            </div>
            <div class="rep-chart-box">
                <canvas id="chartCliente"></canvas>
            </div>
        </div>
    }

    <!-- ═══ FACTURAS ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-file-invoice-dollar"></i> Facturas
            <span class="rep-section-count">@vm.FacturasTotal</span>
        </div>

        <div class="rep-grid">
            <div class="kpi-card">
                <div class="kpi-lbl">Total</div>
                <div class="kpi-val">@vm.FacturasTotal.ToString("N0")</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-lbl">Pagadas</div>
                <div class="kpi-val">@vm.FacturasPagadas.ToString("N0")</div>
            </div>
            <div class="kpi-card gold">
                <div class="kpi-lbl">Pendientes</div>
                <div class="kpi-val">@vm.FacturasPendientes.ToString("N0")</div>
            </div>
            <div class="kpi-card red">
                <div class="kpi-lbl">Vencidas</div>
                <div class="kpi-val">@vm.FacturasVencidas.ToString("N0")</div>
            </div>
        </div>

        @if (vm.Facturas != null && vm.Facturas.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>NISE</th>
                            <th>Emisión</th>
                            <th>Vencimiento</th>
                            <th class="col-num">Monto</th>
                            <th class="col-badge">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in vm.Facturas.Take(40))
                        {
                            <tr>
                                <td><strong>@f.Numero</strong></td>
                                <td>@f.Nise</td>
                                <td>@RepFmt.Fecha(f.Emision)</td>
                                <td>@RepFmt.Fecha(f.Vencimiento)</td>
                                <td class="col-num">@RepFmt.Mon(f.Monto)</td>
                                <td class="col-badge">
                                    <span class="badge badge-@RepFmt.Clase(f.Estado)">@f.Estado</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-file-invoice"></i> Sin facturas en este período.
            </div>
        }
    </div>

    <!-- ═══ AVERÍAS ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-tools"></i> Averías
            <span class="rep-section-count">@vm.AveriasTotal</span>
        </div>

        <div class="rep-grid rep-grid-4">
            <div class="kpi-card">
                <div class="kpi-lbl">Total</div>
                <div class="kpi-val">@vm.AveriasTotal.ToString("N0")</div>
            </div>
            <div class="kpi-card red">
                <div class="kpi-lbl">Abiertas</div>
                <div class="kpi-val">@vm.AveriasAbiertas.ToString("N0")</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-lbl">Resueltas</div>
                <div class="kpi-val">@vm.AveriasResueltas.ToString("N0")</div>
            </div>
            <div class="kpi-card purple">
                <div class="kpi-lbl">Promedio resolución</div>
                <div class="kpi-val" style="font-size:13px;">@RepFmt.Numero((decimal)vm.AveriasDiasPromedio, 1) días</div>
            </div>
        </div>

        @if (vm.Averias != null && vm.Averias.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Reportada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in vm.Averias.Take(25))
                        {
                            <tr>
                                <td>@a.Id</td>
                                <td>@a.Tipo</td>
                                <td><span class="badge badge-@RepFmt.Clase(a.Estado)">@a.Estado</span></td>
                                <td>@RepFmt.Fecha(a.Reportada)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-tools"></i> Sin averías en este período.
            </div>
        }
    </div>

    <!-- ═══ TRÁMITES ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-file-signature"></i> Trámites
            <span class="rep-section-count">@vm.TramitesTotal</span>
        </div>

        <div class="rep-grid">
            <div class="kpi-card">
                <div class="kpi-lbl">Total</div>
                <div class="kpi-val">@vm.TramitesTotal.ToString("N0")</div>
            </div>
            <div class="kpi-card gold">
                <div class="kpi-lbl">Abiertos</div>
                <div class="kpi-val">@vm.TramitesAbiertos.ToString("N0")</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-lbl">Completados</div>
                <div class="kpi-val">@vm.TramitesCompletados.ToString("N0")</div>
            </div>
        </div>

        @if (vm.Tramites != null && vm.Tramites.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Solicitado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in vm.Tramites.Take(25))
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@t.Tipo</td>
                                <td><span class="badge badge-@RepFmt.Clase(t.Estado)">@t.Estado</span></td>
                                <td>@RepFmt.Fecha(t.Solicitud)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-file-signature"></i> Sin trámites en este período.
            </div>
        }
    </div>

    <!-- ═══ COMPRAS ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-shopping-cart"></i> Compras
            <span class="rep-section-count">@vm.Compras.Count</span>
        </div>

        <div class="rep-grid rep-grid-4">
            <div class="kpi-card green">
                <div class="kpi-lbl">Compras pagadas</div>
                <div class="kpi-val">@vm.ComprasPagadas.ToString("N0")</div>
            </div>
            <div class="kpi-card gold">
                <div class="kpi-lbl">Monto total</div>
                <div class="kpi-val">@RepFmt.Mon(vm.ComprasMonto)</div>
            </div>
            <div class="kpi-card purple">
                <div class="kpi-lbl">Ticket promedio</div>
                <div class="kpi-val">@RepFmt.Mon(vm.ComprasTicket)</div>
            </div>
        </div>

        @if (vm.Compras != null && vm.Compras.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Fecha</th>
                            <th>Método</th>
                            <th>Estado</th>
                            <th class="col-num">Artículos</th>
                            <th class="col-num">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in vm.Compras.Take(25))
                        {
                            <tr>
                                <td><strong>#@c.Id</strong></td>
                                <td>@RepFmt.Fecha(c.Fecha)</td>
                                <td>@c.Metodo</td>
                                <td><span class="badge badge-@RepFmt.Clase(c.Estado)">@c.Estado</span></td>
                                <td class="col-num">@c.Articulos</td>
                                <td class="col-num">@RepFmt.Mon(c.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-shopping-cart"></i> Sin compras registradas.
            </div>
        }
    </div>

    <!-- ═══ ACTIVIDAD ═══ -->
    <div class="rep-section">
        <div class="rep-section-title">
            <i class="fas fa-mobile-alt"></i> Actividad en la app
        </div>

        <div class="rep-grid rep-grid-4">
            <div class="kpi-card">
                <div class="kpi-lbl">Sesiones</div>
                <div class="kpi-val">@vm.ActSesiones.ToString("N0")</div>
            </div>
            <div class="kpi-card purple">
                <div class="kpi-lbl">Minutos totales</div>
                <div class="kpi-val">@RepFmt.Numero(vm.ActMinutos, 1)</div>
            </div>
            <div class="kpi-card green">
                <div class="kpi-lbl">Promedio por sesión</div>
                <div class="kpi-val" style="font-size:13px;">@RepFmt.Numero(vm.ActPromedioMin, 1) min</div>
            </div>
            <div class="kpi-card gold">
                <div class="kpi-lbl">Última actividad</div>
                <div class="kpi-val" style="font-size:12px;">@RepFmt.FechaHora(vm.ActUltima)</div>
            </div>
        </div>

        @if (vm.Actividad != null && vm.Actividad.Count > 0)
        {
            <div class="rep-table-wrap">
                <table class="rep-table">
                    <thead>
                        <tr>
                            <th>Sección</th>
                            <th class="col-num">Minutos</th>
                            <th class="col-num">Sesiones</th>
                            <th class="col-num">% del tiempo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in vm.Actividad)
                        {
                            <tr>
                                <td>@a.Seccion</td>
                                <td class="col-num">@RepFmt.Numero(a.Minutos, 1)</td>
                                <td class="col-num">@a.Sesiones</td>
                                <td class="col-num">@RepFmt.Pct(a.Porcentaje)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="rep-empty">
                <i class="fas fa-mobile-alt"></i> Sin actividad registrada.
            </div>
        }
    </div>
}
else
{
    <div class="rep-section">
        <div class="rep-empty">
            <i class="fas fa-info-circle"></i> No hay clientes registrados.
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function cambiarCliente(id) {
            var rango = '@vm.Rango';
            window.location.href = '@Url.Action("Reportes", "Admin")?rango=' + rango + '&clienteId=' + id;
        }

        var datosSistema = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            vm.SisMensual.Select(x => new { etiqueta = x.Etiqueta, facturado = x.Valor, cobrado = x.Valor2 })
        ));

        if (document.getElementById('chartSistema') && datosSistema.length) {
            new Chart(document.getElementById('chartSistema'), {
                type: 'bar',
                data: {
                    labels: datosSistema.map(function (d) { return d.etiqueta; }),
                    datasets: [
                        { label: 'Facturado', data: datosSistema.map(function (d) { return d.facturado; }), backgroundColor: '#1a2b6b', borderRadius: 6, maxBarThickness: 32 },
                        { label: 'Cobrado', data: datosSistema.map(function (d) { return d.cobrado; }), backgroundColor: '#046a38', borderRadius: 6, maxBarThickness: 32 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10, weight: '700' }, usePointStyle: true, boxWidth: 10 } } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#eef0f5' }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        var datosCliente = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            vm.FacturacionMensual.Select(x => new { etiqueta = x.Etiqueta, facturado = x.Valor, pagado = x.Valor2 })
        ));

        if (document.getElementById('chartCliente') && datosCliente.length) {
            new Chart(document.getElementById('chartCliente'), {
                type: 'bar',
                data: {
                    labels: datosCliente.map(function (d) { return d.etiqueta; }),
                    datasets: [
                        { label: 'Facturado', data: datosCliente.map(function (d) { return d.facturado; }), backgroundColor: '#5b3fbf', borderRadius: 6, maxBarThickness: 22 },
                        { label: 'Pagado', data: datosCliente.map(function (d) { return d.pagado; }), backgroundColor: '#046a38', borderRadius: 6, maxBarThickness: 22 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10, weight: '700' }, usePointStyle: true, boxWidth: 10 } } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: '#eef0f5' }, ticks: { font: { size: 10 } } },
                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }
                    }
                }
            });
        }
    </script>
}