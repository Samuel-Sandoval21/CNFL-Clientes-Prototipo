@{
    ViewBag.Title = "Actividad";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var actividad = ViewBag.Actividad as List<CNFL_Clientes_Prototipo.Models.ActividadSemanalDto>
                    ?? new List<CNFL_Clientes_Prototipo.Models.ActividadSemanalDto>();
    var tiempoUso = ViewBag.TiempoUso as List<CNFL_Clientes_Prototipo.Models.TiempoUsoClienteDto>
                    ?? new List<CNFL_Clientes_Prototipo.Models.TiempoUsoClienteDto>();
}

@section Styles {
    <style>
        .chart-week {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 6px;
            height: 140px;
        }

            .chart-week .col {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: flex-end;
                height: 100%;
            }

            .chart-week .bar {
                width: 100%;
                background: var(--blue);
                border-radius: 6px 6px 0 0;
                min-height: 4px;
            }

            .chart-week .label {
                font-size: 10px;
                color: var(--muted);
                font-weight: 700;
                margin-top: 6px;
            }

            .chart-week .value {
                font-size: 10px;
                color: var(--blue);
                font-weight: 800;
                margin-bottom: 3px;
            }

        .uso-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--line);
        }

            .uso-card:last-child {
                border-bottom: none;
            }

            .uso-card .nombre {
                font-weight: 800;
                font-size: 13px;
            }

            .uso-card .correo {
                font-size: 11.5px;
                color: var(--muted);
            }

            .uso-card .tiempo {
                font-weight: 800;
                color: var(--blue);
                font-size: 13px;
            }
    </style>
}

<h1 class="page-title">Actividad</h1>

<div class="card">
    <div style="font-size:14px;font-weight:800;color:var(--blue);margin-bottom:10px;">
        Últimos 7 días
    </div>
    @{
        var maxAct = actividad.Any() ? actividad.Max(a => a.facturas + a.reportes + a.tramites) : 1;
        if (maxAct <= 0) { maxAct = 1; }
    }
    <div class="chart-week">
        @foreach (var a in actividad)
        {
            var total = a.facturas + a.reportes + a.tramites;
            var pct = ((double)total / maxAct) * 100;
            <div class="col">
                <div class="value">@total</div>
                <div class="bar" style="height:@(pct.ToString("0.0"))%;"></div>
                <div class="label">@a.dia</div>
            </div>
        }
    </div>
</div>

<div class="card">
    <div style="font-size:14px;font-weight:800;color:var(--blue);margin-bottom:8px;">
        Top 10 uso de la app
    </div>
    @if (!tiempoUso.Any())
    {
        <div class="empty" style="padding:16px;">Sin datos</div>
    }
    else
    {
        foreach (var u in tiempoUso)
        {
            <div class="uso-card">
                <div>
                    <div class="nombre">@u.Nombre</div>
                    <div class="correo">@u.Correo</div>
                </div>
                <div class="tiempo">@u.MinutosTotales min</div>
            </div>
        }
    }
</div>