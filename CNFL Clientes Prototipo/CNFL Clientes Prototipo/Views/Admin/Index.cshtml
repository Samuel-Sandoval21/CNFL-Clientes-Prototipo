@model List<CNFL_Clientes_Prototipo.Models.Averia>

@{
    ViewBag.Title = "Panel Administrativo - CNFL";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/admin-index.css")" />

<!-- Toast -->
<div class="toast-notification" id="toastNotif"></div>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap;">
    <div>
        <h2 style="font-weight:800; font-size:22px; margin:0;">🧑‍💼 Panel Administrativo</h2>
        <p style="color:var(--muted); font-size:13px; margin:2px 0 0 0;">Gestión de averías y operaciones</p>
    </div>
    <span class="estado-badge estado-camino" style="font-size:12px; padding:4px 14px; border-radius:999px;">🔑 Operador</span>
</div>

<div class="admin-stats">
    <div class="stat-box">
        <span class="icon">📋</span>
        <div class="number">@ViewBag.TotalAverias</div>
        <div class="label">Total Averías</div>
    </div>
    <div class="stat-box orange">
        <span class="icon">⏳</span>
        <div class="number">@ViewBag.AveriasPendientes</div>
        <div class="label">Pendientes</div>
    </div>
    <div class="stat-box purple">
        <span class="icon">🔍</span>
        <div class="number">@ViewBag.AveriasEnRevision</div>
        <div class="label">En Revisión</div>
    </div>
    <div class="stat-box green">
        <span class="icon">🚗</span>
        <div class="number">@ViewBag.AveriasEnCamino</div>
        <div class="label">En Camino</div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <span class="icono-grande">✅</span>
        <h3>No hay averías reportadas</h3>
        <p style="color: var(--muted); font-size: 14px; margin-top: 6px;">Todo en orden. Los clientes no han reportado incidencias recientemente.</p>
    </div>
}
else
{
    foreach (var averia in Model)
    {
        string estadoClass = "estado-reportado";
        if (averia.Estado == "En revisión") { estadoClass = "estado-revision"; }
        else if (averia.Estado == "En camino") { estadoClass = "estado-camino"; }
        else if (averia.Estado == "Resuelto") { estadoClass = "estado-resuelto"; }

        <div class="card-cliente" id="averia-@averia.Id">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap;">
                <div style="flex:1;">
                    <h4><span>⚡</span> @averia.TipoAveria</h4>
                    <div class="meta">
                        <span>📍 @averia.Direccion</span>
                        <span>🕐 @averia.FechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
                        <span>🆔 #@averia.Id</span>
                    </div>
                    <p class="descripcion">@averia.Descripcion</p>
                </div>
                <div style="min-width:100px; text-align:right;">
                    <span class="estado-badge @estadoClass">@averia.Estado</span>
                </div>
            </div>
            <div class="admin-actions">
                <form method="post" action="@Url.Action("CambiarEstado", "Admin")" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; width:100%;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@averia.Id" />
                    <select name="estado">
                        <option value="Reportado" @(averia.Estado == "Reportado" ? "selected" : "")>📋 Reportado</option>
                        <option value="En revisión" @(averia.Estado == "En revisión" ? "selected" : "")>🔍 En revisión</option>
                        <option value="En camino" @(averia.Estado == "En camino" ? "selected" : "")>🚗 En camino</option>
                        <option value="Resuelto" @(averia.Estado == "Resuelto" ? "selected" : "")>✅ Resuelto</option>
                    </select>
                    <button type="submit" class="btn-actualizar">🔄 Actualizar</button>
                </form>
            </div>
        </div>
    }
}

<div class="admin-nota">
    ⚠️ <strong>Nota:</strong> Para ver el listado completo de clientes registrados, diríjase a la pestaña <a href="@Url.Action("Clientes", "Admin")">Clientes</a> del menú superior.
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/admin-index.js")"></script>
}