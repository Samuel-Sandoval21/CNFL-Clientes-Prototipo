@{
    ViewBag.Title = "Alertas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section Styles {
    <style>
        .alert-card {
            background: #fff;
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 10px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

            .alert-card.warn {
                border-left-color: #ff692d;
            }

            .alert-card.danger {
                border-left-color: #e53935;
            }

            .alert-card.ok {
                border-left-color: #00a651;
            }

        .alert-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            background: #eef0ff;
            color: #1a2b6b;
        }

        .alert-card.warn .alert-icon {
            background: #fff4d9;
            color: #c98a00;
        }

        .alert-card.danger .alert-icon {
            background: #ffe6e6;
            color: #e53935;
        }

        .alert-card.ok .alert-icon {
            background: #e0f7e9;
            color: #00a651;
        }

        .alert-body {
            flex: 1;
            min-width: 0;
        }

        .alert-title {
            font-size: 13.5px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 3px;
        }

        .alert-text {
            font-size: 12.5px;
            color: var(--muted);
            line-height: 1.4;
        }

        .alert-time {
            font-size: 11px;
            color: #aab0be;
            font-weight: 700;
            margin-top: 6px;
        }
    </style>
}

<h1 class="page-title">Alertas</h1>

<div class="alert-card danger">
    <div class="alert-icon"><i class="fas fa-exclamation-triangle"></i></div>
    <div class="alert-body">
        <div class="alert-title">7 averías abiertas</div>
        <div class="alert-text">Hay averías sin resolver que requieren atención.</div>
        <div class="alert-time">Hace 5 minutos</div>
    </div>
</div>

<div class="alert-card warn">
    <div class="alert-icon"><i class="fas fa-money-bill-wave"></i></div>
    <div class="alert-body">
        <div class="alert-title">₡57.000 en facturas pendientes</div>
        <div class="alert-text">Clientes con pagos por vencer esta semana.</div>
        <div class="alert-time">Hace 1 hora</div>
    </div>
</div>

<div class="alert-card ok">
    <div class="alert-icon"><i class="fas fa-user-plus"></i></div>
    <div class="alert-body">
        <div class="alert-title">Nuevo cliente registrado</div>
        <div class="alert-text">Se ha registrado un nuevo usuario en la app.</div>
        <div class="alert-time">Hace 3 horas</div>
    </div>
</div>