@{
    ViewBag.Title = "Cuenta";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var nombreAdmin = ViewBag.NombreAdmin as string ?? "Administrador";
    var correoAdmin = ViewBag.CorreoAdmin as string ?? "admin@cnfl.go.cr";
    var fotoAdmin = ViewBag.FotoAdmin as string;   // ← ruta de la foto si existe
    var inicial = !string.IsNullOrEmpty(nombreAdmin) ? nombreAdmin.Substring(0, 1).ToUpper() : "A";
    var tieneFoto = !string.IsNullOrWhiteSpace(fotoAdmin);
}

@section Styles {
    <style>
        /* ═══ CARD DE PERFIL ═══ */
        .perfil-card {
            background: #fff;
            border-radius: 20px;
            padding: 26px 20px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            text-align: center;
            margin-bottom: 18px;
            border: 1px solid #eef0f5;
        }

        /* ═══ AVATAR CON BOTÓN DE CÁMARA ═══ */
        .avatar-wrap {
            position: relative;
            width: 108px;
            height: 108px;
            margin: 0 auto 16px;
        }

        .avatar-grande {
            width: 108px;
            height: 108px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a2b6b, #2b3f8f);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 40px;
            box-shadow: 0 10px 24px -8px rgba(30, 35, 230, .5);
            overflow: hidden;
            background-size: cover;
            background-position: center;
            transition: transform .2s ease;
        }

            .avatar-grande:hover {
                transform: scale(1.02);
            }

        /* Botón de cámara flotante */
        .avatar-cam-btn {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
            color: #fff;
            display: grid;
            place-items: center;
            cursor: pointer;
            box-shadow: 0 6px 16px -4px rgba(91, 63, 191, .55);
            border: 3px solid #fff;
            transition: transform .15s ease;
        }

            .avatar-cam-btn:hover {
                transform: scale(1.08);
            }

            .avatar-cam-btn:active {
                transform: scale(.95);
            }

            .avatar-cam-btn i {
                font-size: 15px;
            }

        /* Estado de subida */
        #fotoEstado {
            display: none;
            margin-top: 10px;
            font-size: 12px;
            font-weight: 800;
            text-align: center;
        }

            #fotoEstado.loading {
                display: block;
                color: #6b7280;
            }

            #fotoEstado.ok {
                display: block;
                color: #046a38;
            }

            #fotoEstado.err {
                display: block;
                color: #b71c1c;
            }

        /* ═══ DATOS DEL PERFIL ═══ */
        .perfil-nombre {
            font-size: 18px;
            font-weight: 800;
            color: var(--text);
            margin-bottom: 5px;
        }

        .perfil-correo {
            font-size: 12.5px;
            color: var(--muted);
        }

        .rol-badge {
            display: inline-block;
            margin-top: 12px;
            padding: 5px 14px;
            background: #eef0ff;
            color: #1a2b6b;
            border-radius: 12px;
            font-size: 10.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
        }

        /* ═══ BOTÓN LOGOUT ═══ */
        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 15px;
            background: #fff;
            color: #e53935;
            border: 2px solid #e53935;
            border-radius: 14px;
            font-size: 13.5px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            margin-top: 20px;
            transition: background .18s, color .18s, transform .15s;
        }

            .logout-btn:hover {
                background: #fef0f0;
            }

            .logout-btn:active {
                background: #e53935;
                color: #fff;
                transform: scale(.98);
            }

        /* ═══ INFO CARD ═══ */
        .info-card {
            background: #fff;
            border: 1px solid #eef0f5;
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 2px 10px rgba(20, 30, 70, .04);
        }

        .info-card-title {
            font-size: 11px;
            font-weight: 800;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 12px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f0f2f8;
            font-size: 13px;
        }

            .info-row:last-child {
                border-bottom: 0;
                padding-bottom: 0;
            }

            .info-row .label {
                color: #6b7280;
                font-weight: 700;
                font-size: 12px;
            }

            .info-row .value {
                color: var(--text);
                font-weight: 800;
                font-size: 13px;
            }
    </style>
}

<h1 class="page-title">Mi cuenta</h1>
<p class="page-subtitle">Información del administrador.</p>

<!-- ═══ CARD DE PERFIL CON AVATAR ═══ -->
<div class="perfil-card">
    <div class="avatar-wrap">
        <div id="avatarPreview" class="avatar-grande"
             style="@(tieneFoto ? "background-image:url('" + Url.Content(fotoAdmin) + "'); background-size:cover; background-position:center; color:transparent;" : "")">
            @if (!tieneFoto)
            {
                @inicial
            }
        </div>

        <label for="fotoInput" class="avatar-cam-btn" title="Cambiar foto">
            <i class="fas fa-camera"></i>
        </label>

        <input type="file" id="fotoInput" accept="image/*" style="display:none;" />
    </div>

    <div class="perfil-nombre">@nombreAdmin</div>
    <div class="perfil-correo">@correoAdmin</div>
    <div class="rol-badge">Administrador</div>

    <div id="fotoEstado"></div>
</div>

<!-- ═══ INFO ADICIONAL ═══ -->
<div class="info-card">
    <div class="info-card-title">Información de la cuenta</div>

    <div class="info-row">
        <div class="label">Rol</div>
        <div class="value">Administrador</div>
    </div>

    <div class="info-row">
        <div class="label">Estado</div>
        <div class="value" style="color:#046a38;">● Activo</div>
    </div>

    <div class="info-row">
        <div class="label">Correo</div>
        <div class="value">@correoAdmin</div>
    </div>
</div>

<!-- ═══ BOTÓN LOGOUT ═══ -->
@using (Html.BeginForm("Logout", "Admin", FormMethod.Get))
{
    <button type="submit" class="logout-btn">
        <i class="fas fa-sign-out-alt"></i> Cerrar sesión
    </button>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('fotoInput');
            var preview = document.getElementById('avatarPreview');
            var estado = document.getElementById('fotoEstado');

            if (!input || !preview) return;

            input.addEventListener('change', function (e) {
                var file = e.target.files && e.target.files[0];
                if (!file) return;

                // Validaciones
                if (!file.type.match(/^image\//)) {
                    mostrarEstado('err', '✗ Solo se permiten imágenes');
                    return;
                }

                if (file.size > 4 * 1024 * 1024) {
                    mostrarEstado('err', '✗ La imagen no puede pesar más de 4 MB');
                    return;
                }

                // Preview instantáneo
                var reader = new FileReader();
                reader.onload = function (ev) {
                    preview.innerHTML = '';
                    preview.style.backgroundImage = 'url(' + ev.target.result + ')';
                    preview.style.backgroundSize = 'cover';
                    preview.style.backgroundPosition = 'center';
                    preview.style.color = 'transparent';
                };
                reader.readAsDataURL(file);

                // Subir al servidor
                mostrarEstado('loading', '⏳ Subiendo...');

                var formData = new FormData();
                formData.append('fotoAdmin', file);

                fetch('@Url.Action("SubirFotoAdmin", "Admin")', {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin'
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.ok) {
                        mostrarEstado('ok', '✓ ' + (data.mensaje || 'Foto actualizada'));
                        setTimeout(function () {
                            estado.style.display = 'none';
                        }, 2500);
                    } else {
                        mostrarEstado('err', '✗ ' + (data.mensaje || 'Error al subir'));
                    }
                })
                .catch(function () {
                    mostrarEstado('err', '✗ Error de conexión');
                });
            });

            function mostrarEstado(tipo, texto) {
                if (!estado) return;
                estado.className = tipo;
                estado.textContent = texto;
                estado.style.display = 'block';
            }
        })();
    </script>
}