@model CNFL_Clientes_Prototipo.Models.ReportesViewModel

@{
    ViewBag.Title = "Dashboard Admin";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/admin/dashboard.css" />

<div class="admin-dashboard">
    <div class="page-header">
        <h1>Panel de Administración</h1>
        <p>Bienvenido, @Session["Nombre"]</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">@Model.TotalAverias</div>
            <div class="stat-label">Total Averías</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.TasaResolucion%</div>
            <div class="stat-label">Tasa de Resolución</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@Model.TiempoPromedioResolucion</div>
            <div class="stat-label">Tiempo Promedio</div>
        </div>
    </div>

    <div class="admin-section">
        <div class="section-header">
            <h3>Averías Recientes</h3>
            <a href="@Url.Action("Averias", "Admin")" class="btn-ver-todas">Ver todas →</a>
        </div>

        @if (Model.AveriasRecientes != null && Model.AveriasRecientes.Any())
        {
            <div class="averias-lista">
                @foreach (var averia in Model.AveriasRecientes.Take(5))
                {
                    <div class="averia-item">
                        <div class="averia-info">
                            <strong>#@averia.AveriaId</strong>
                            <span>@averia.Tipo</span>
                            <span class="averia-fecha">@averia.FechaReporte.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <span class="estado-badge @averia.Estado.Replace(" ", "-").ToLower()">@averia.Estado</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">No hay averías recientes.</p>
        }
    </div>

    <div class="admin-section">
        <div class="section-header">
            <h3>Clientes Registrados</h3>
            <a href="@Url.Action("Clientes", "Admin")" class="btn-ver-todas">Ver todos →</a>
        </div>

        @if (ViewBag.ClientesRecientes != null && ((List<CNFL_Clientes_Prototipo.Models.Usuario>)ViewBag.ClientesRecientes).Any())
        {
            <div class="clientes-lista">
                @foreach (var cliente in (List<CNFL_Clientes_Prototipo.Models.Usuario>)ViewBag.ClientesRecientes)
                {
                    <div class="cliente-item">
                        <div class="cliente-info">
                            <strong>@cliente.Nombre @cliente.Apellidos</strong>
                            <span>@cliente.Cedula</span>
                            <span class="cliente-correo">@cliente.Correo</span>
                        </div>
                        <a href="@Url.Action("DetalleCliente", "Admin", new { id = cliente.UsuarioId })" class="btn-ver">Ver</a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">No hay clientes registrados.</p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin/dashboard.js"></script>
}