@{
    ViewBag.Title = "Dashboard Admin";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var nombreAdmin = Session["AdminNombre"] as string ?? "Administrador";
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días," : (hora < 19 ? "Buenas tardes," : "Buenas noches,");
    var primerNombre = !string.IsNullOrEmpty(nombreAdmin) ? nombreAdmin.Split(' ')[0] : "Admin";

    var totalClientes = (int)(ViewBag.TotalClientes ?? 0);
    var clientesActivos = (int)(ViewBag.ClientesActivos ?? 0);
    var nisesActivos = (int)(ViewBag.NISEsActivos ?? 0);
    var montoPendiente = (decimal)(ViewBag.MontoPendiente ?? 0m);
    var ingresosMes = (decimal)(ViewBag.IngresosMes ?? 0m);
    var averiasAbiertas = (int)(ViewBag.AveriasAbiertas ?? 0);
    var averiasResueltas = (int)(ViewBag.AveriasResueltas ?? 0);
    var tramitesAbiertos = (int)(ViewBag.TramitesAbiertos ?? 0);
    var tiempoPromedio = (double)(ViewBag.TiempoPromedio ?? 0.0);
}

@section Styles {
    <style>
        .greeting {
            margin-bottom: 16px;
        }

            .greeting .hi {
                font-size: 13px;
                color: var(--muted);
                font-weight: 600;
            }

            .greeting .name {
                font-size: 24px;
                font-weight: 900;
                color: var(--text);
                margin-top: 2px;
                line-height: 1.1;
            }

        .welcome-banner {
            background: linear-gradient(135deg, #1a2b6b 0%, #5b3fbf 100%);
            border-radius: 20px;
            padding: 20px;
            color: #fff;
            margin-bottom: 16px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 14px 30px -14px rgba(26, 43, 107, .7);
        }

            .welcome-banner::before {
                content: '';
                position: absolute;
                top: -30px;
                right: -30px;
                width: 120px;
                height: 120px;
                background: rgba(255, 255, 255, .08);
                border-radius: 50%;
            }

            .welcome-banner::after {
                content: '';
                position: absolute;
                bottom: -40px;
                right: 30px;
                width: 80px;
                height: 80px;
                background: rgba(255, 255, 255, .06);
                border-radius: 50%;
            }

            .welcome-banner .tag {
                font-size: 10.5px;
                font-weight: 800;
                opacity: .75;
                text-transform: uppercase;
                letter-spacing: .8px;
                margin-bottom: 8px;
                position: relative;
                z-index: 1;
            }

            .welcome-banner .title {
                font-size: 20px;
                font-weight: 900;
                line-height: 1.2;
                margin-bottom: 6px;
                position: relative;
                z-index: 1;
            }

            .welcome-banner .sub {
                font-size: 12px;
                opacity: .85;
                line-height: 1.5;
                position: relative;
                z-index: 1;
            }

        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 16px;
        }

        .metric-card {
            background: #fff;
            border-radius: 16px;
            padding: 14px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            position: relative;
            transition: transform .15s, box-shadow .15s;
        }

            .metric-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(20, 30, 70, .1);
            }

        .metric-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            margin-bottom: 10px;
        }

            .metric-icon.blue {
                background: var(--blue-soft);
                color: var(--blue);
            }

            .metric-icon.green {
                background: var(--green-soft);
                color: var(--green);
            }

            .metric-icon.red {
                background: var(--red-soft);
                color: var(--red);
            }

            .metric-icon.gold {
                background: var(--gold-soft);
                color: var(--gold);
            }

            .metric-icon.purple {
                background: var(--purple-soft);
                color: var(--purple);
            }

        .metric-label {
            font-size: 10px;
            color: #6b7280;
            font-weight: 700;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

        .metric-value {
            font-size: 19px;
            font-weight: 900;
            color: #1c1f2b;
            line-height: 1.1;
        }

            .metric-value small {
                font-size: 11.5px;
                font-weight: 600;
                color: #6b7280;
                margin-left: 3px;
            }

        .metric-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: var(--red-soft);
            color: var(--red);
            font-size: 10px;
            font-weight: 800;
            padding: 3px 8px;
            border-radius: 10px;
        }

            .metric-badge.gray {
                background: #eef0f5;
                color: #6b7280;
            }

        .chart-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            margin-bottom: 14px;
        }

        .chart-title {
            font-size: 14px;
            font-weight: 800;
            color: var(--blue);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .chart-title i {
                font-size: 14px;
                color: var(--purple);
            }

        .chart-box {
            position: relative;
            height: 180px;
        }

        .export-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .export-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 10px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 800;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            border: none;
            transition: transform .15s;
        }

            .export-btn:active {
                transform: scale(.97);
            }

            .export-btn.excel {
                background: var(--green-soft);
                color: #046a38;
                box-shadow: 0 6px 14px -6px rgba(4, 106, 56, .3);
            }

            .export-btn.pdf {
                background: var(--red-soft);
                color: #b71c1c;
                box-shadow: 0 6px 14px -6px rgba(183, 28, 28, .3);
            }

            .export-btn i {
                font-size: 17px;
            }
    </style>
}

<div class="greeting">
    <div class="hi">@saludo,</div>
    <div class="name">@primerNombre 👋</div>
</div>

<div class="welcome-banner">
    <div class="tag">Panel Administrativo CNFL</div>
    <div class="title">Todo bajo control,<br />desde un solo lugar.</div>
    <div class="sub">Gestioná clientes, averías, trámites y reportes de la app móvil.</div>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-icon blue"><i class="fas fa-users"></i></div>
        <div class="metric-label">Clientes</div>
        <div class="metric-value">@clientesActivos<small>de @totalClientes</small></div>
    </div>

    <div class="metric-card">
        <div class="metric-icon blue"><i class="fas fa-bolt"></i></div>
        <div class="metric-label">NISEs activos</div>
        <div class="metric-value">@nisesActivos</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon gold"><i class="fas fa-money-bill-wave"></i></div>
        @if (montoPendiente > 0)
        {
            <span class="metric-badge">$</span>
        }
        <div class="metric-label">Monto pendiente</div>
        <div class="metric-value">₡@montoPendiente.ToString("N0")</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon purple"><i class="fas fa-chart-line"></i></div>
        <span class="metric-badge gray">mes</span>
        <div class="metric-label">Ingresos del mes</div>
        <div class="metric-value">₡@ingresosMes.ToString("N0")</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon red"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="metric-label">Averías abiertas</div>
        <div class="metric-value">@averiasAbiertas</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon green"><i class="fas fa-check"></i></div>
        <div class="metric-label">Averías resueltas</div>
        <div class="metric-value">@averiasResueltas</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon gold"><i class="fas fa-clipboard-list"></i></div>
        <div class="metric-label">Trámites abiertos</div>
        <div class="metric-value">@tramitesAbiertos</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon purple"><i class="fas fa-stopwatch"></i></div>
        <div class="metric-label">Tiempo prom.</div>
        <div class="metric-value">@tiempoPromedio.ToString("0.0")<small>días</small></div>
    </div>
</div>

<div class="chart-card">
    <div class="chart-title"><i class="fas fa-chart-pie"></i> Averías por estado</div>
    <div class="chart-box"><canvas id="chartAverias"></canvas></div>
</div>

<div class="chart-card">
    <div class="chart-title"><i class="fas fa-chart-line"></i> Averías últimos 7 días</div>
    <div class="chart-box"><canvas id="chartSemana"></canvas></div>
</div>

<div class="chart-card">
    <div class="chart-title"><i class="fas fa-download"></i> Descargar reportes</div>
    <div class="export-grid">
        <a href="@Url.Action("ExportarExcel", "Admin")" class="export-btn excel">
            <i class="fas fa-file-excel"></i> Excel
        </a>
        <a href="@Url.Action("ExportarPDF", "Admin")" class="export-btn pdf">
            <i class="fas fa-file-pdf"></i> PDF
        </a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var ctx = document.getElementById('chartAverias');
            if (!ctx) return;
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Abiertas', 'Resueltas'],
                    datasets: [{
                        data: [@averiasAbiertas, @averiasResueltas],
                        backgroundColor: ['#e53935', '#00a651'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Inter', size: 11, weight: '700' },
                                color: '#6b7280',
                                padding: 12,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        }
                    }
                }
            });
        })();

        (function () {
            var ctx = document.getElementById('chartSemana');
            if (!ctx) return;
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
                    datasets: [{
                        label: 'Averías',
                        data: [2, 4, 3, 5, 4, 1, 2],
                        borderColor: '#1a2b6b',
                        backgroundColor: 'rgba(26, 43, 107, .08)',
                        fill: true,
                        tension: .35,
                        pointBackgroundColor: '#1a2b6b',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#eef0f5', drawBorder: false },
                            ticks: { color: '#6b7280', font: { family: 'Inter', size: 10 }, stepSize: 1 }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#6b7280', font: { family: 'Inter', size: 10, weight: '700' } }
                        }
                    }
                }
            });
        })();
    </script>
}