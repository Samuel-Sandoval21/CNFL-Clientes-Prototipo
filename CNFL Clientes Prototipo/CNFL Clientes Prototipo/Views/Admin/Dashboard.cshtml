@model List<CNFL_Clientes_Prototipo.Models.Averia>

@{
    ViewBag.Title = "Dashboard - CNFL";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/admin-dashboard.css")" />

<h2 style="font-weight: 800; font-size: 22px; margin: 0;">📊 Resumen General</h2>
<p style="color: var(--muted); font-size: 13px; margin: 2px 0 18px;">Vista rápida de las operaciones del sistema</p>

<div class="dash-stats">
    <div class="dash-stat blue">
        <span class="emoji">📋</span>
        <div class="num">@ViewBag.TotalAverias</div>
        <div class="lbl">Total Averías</div>
    </div>
    <div class="dash-stat orange">
        <span class="emoji">⏳</span>
        <div class="num">@ViewBag.AveriasPendientes</div>
        <div class="lbl">Pendientes</div>
    </div>
    <div class="dash-stat red">
        <span class="emoji">🔍</span>
        <div class="num">@ViewBag.AveriasEnRevision</div>
        <div class="lbl">En Revisión</div>
    </div>
    <div class="dash-stat green">
        <span class="emoji">✅</span>
        <div class="num">@ViewBag.AveriasResueltas</div>
        <div class="lbl">Resueltas</div>
    </div>
</div>

<div class="dash-section-title">
    <span>🕐</span> Últimas averías reportadas
</div>

@if (Model != null && Model.Any())
{
    var ultimas = Model.OrderByDescending(a => a.FechaReporte).Take(3);
    foreach (var averia in ultimas)
    {
        string colorBorder = averia.Estado == "Resuelto" ? "var(--green)" : "var(--orange)";
        string estadoClase = averia.Estado == "Resuelto" ? "estado-resuelto" : "estado-revision";
        <div class="recent-item" style="border-left-color: @colorBorder;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                    <div class="titulo">⚡ @averia.TipoAveria</div>
                    <div class="detalle">📍 @averia.Direccion</div>
                    <div class="detalle">🕐 @averia.FechaReporte.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <span class="estado @estadoClase">
                    @averia.Estado
                </span>
            </div>
        </div>
    }
}
else
{
    <div style="text-align: center; padding: 30px; color: var(--muted);">
        No hay averías reportadas
    </div>
}

<div class="tip-card">
    <span class="tip-icon">💡</span>
    <div>
        <div class="tip-title">Consejo del día</div>
        <div class="tip-text">Mantén actualizados los estados de las averías para un mejor seguimiento y atención al cliente.</div>
    </div>
</div>

@section scriptsVista {
    <script src="@Url.Content("~/Scripts/admin-dashboard.js")"></script>
}