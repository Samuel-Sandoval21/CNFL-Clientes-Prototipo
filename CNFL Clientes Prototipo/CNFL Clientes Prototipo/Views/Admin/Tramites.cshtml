@model List<CNFL_Clientes_Prototipo.Models.Tramite>
@{
    ViewBag.Title = "Trámites";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estadoActual = ViewBag.Estado as string ?? "";
}

@section Styles {
    <style>
        .tramite-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
            transition: transform .15s, box-shadow .15s;
        }

            .tramite-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(20, 30, 70, .1);
            }

            .tramite-card.estado-completado {
                border-left-color: var(--green);
            }

            .tramite-card.estado-proceso {
                border-left-color: var(--gold);
            }

        .tramite-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
            gap: 8px;
        }

        .tramite-tipo {
            font-weight: 800;
            font-size: 14px;
            color: var(--text);
            line-height: 1.3;
            flex: 1;
        }

        .tramite-info {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .tramite-info i {
                font-size: 12px;
                color: #aab0be;
                width: 14px;
                text-align: center;
            }
    </style>
}

<h1 class="page-title">Trámites</h1>
<p class="page-subtitle">Seguimiento de todas las solicitudes de los clientes.</p>

<div class="stats-row">
    <div class="stat-mini blue">
        <div class="num">@Model.Count(t => t.Estado == "Solicitado" || t.Estado == "Iniciado")</div>
        <div class="lbl">Solicitados</div>
    </div>
    <div class="stat-mini gold">
        <div class="num">@Model.Count(t => t.Estado == "En proceso")</div>
        <div class="lbl">En proceso</div>
    </div>
    <div class="stat-mini green">
        <div class="num">@Model.Count(t => t.Estado == "Completado" || t.Estado == "Cerrado")</div>
        <div class="lbl">Completados</div>
    </div>
</div>

<div class="filtros">
    <a href="@Url.Action("Tramites", "Admin")" class="filtro @(string.IsNullOrEmpty(estadoActual) ? "active" : "")">Todos</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Solicitado" })" class="filtro @(estadoActual == "Solicitado" ? "active" : "")">Solicitados</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "En proceso" })" class="filtro @(estadoActual == "En proceso" ? "active" : "")">En proceso</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Completado" })" class="filtro @(estadoActual == "Completado" ? "active" : "")">Completados</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty">
        <i class="fas fa-file-alt"></i>
        <p>No hay trámites para mostrar.</p>
    </div>
}
else
{
    foreach (var t in Model)
    {
        var cssEstado = t.Estado == "Completado" || t.Estado == "Cerrado" ? "estado-completado" :
                        (t.Estado == "En proceso" ? "estado-proceso" : "");
        var badge = t.Estado == "Completado" || t.Estado == "Cerrado" ? "ok" :
                    (t.Estado == "En proceso" ? "gold" : "warn");

        <div class="tramite-card @cssEstado">
            <div class="tramite-top">
                <span class="tramite-tipo">@t.Tipo</span>
                <span class="badge @badge">@t.Estado</span>
            </div>

            @if (!string.IsNullOrEmpty(t.Categoria))
            {
                <div class="tramite-info">
                    <i class="fas fa-tag"></i>
                    @t.Categoria
                </div>
            }

            <div class="tramite-info">
                <i class="fas fa-calendar"></i>
                @t.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrEmpty(t.NumeroReferencia))
            {
                <div class="tramite-info">
                    <i class="fas fa-hashtag"></i>
                    @t.NumeroReferencia
                </div>
            }

            @if (!string.IsNullOrEmpty(t.Descripcion))
            {
                <div style="margin-top:8px;padding:10px 12px;background:#f9fafc;border-radius:10px;font-size:12.5px;line-height:1.5;border-left:2px solid #e3e6ee;">
                    @t.Descripcion
                </div>
            }
        </div>
    }
}