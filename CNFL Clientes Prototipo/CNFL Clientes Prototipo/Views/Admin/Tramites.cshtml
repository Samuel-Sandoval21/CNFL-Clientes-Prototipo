@model List<CNFL_Clientes_Prototipo.Models.Tramite>
@{
    ViewBag.Title = "Trámites";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estadoActual = ViewBag.Estado as string ?? "";
}

@section Styles {
    <style>
        .tramite-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
            transition: transform .15s, box-shadow .15s;
            text-decoration: none;
            color: inherit;
            display: block;
        }

            .tramite-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(20, 30, 70, .1);
                color: inherit;
                text-decoration: none;
            }

            .tramite-card.estado-completado {
                border-left-color: var(--green);
            }

            .tramite-card.estado-proceso {
                border-left-color: var(--amber);
            }

            .tramite-card.estado-correccion {
                border-left-color: var(--red);
            }

        .tramite-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
            gap: 8px;
        }

        .tramite-tipo {
            font-weight: 800;
            font-size: 14px;
            color: var(--ink);
            line-height: 1.3;
            flex: 1;
        }

        .tramite-info {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .tramite-info i {
                font-size: 12px;
                color: #aab0be;
                width: 14px;
                text-align: center;
            }
    </style>
}

<h1 class="page-title">📋 Trámites</h1>
<p class="page-subtitle">Revisá, aprobá o solicitá correcciones a los trámites de los clientes.</p>

<!-- Stats -->
<div class="stats-row" style="display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin:18px 0;">
    <div style="background:#eef0ff; border-radius:14px; padding:14px; text-align:center;">
        <div style="font-size:20px; font-weight:800; color:var(--blue);">@ViewBag.TotalSolicitados</div>
        <div style="font-size:11px; color:var(--muted); margin-top:2px;">Solicitados</div>
    </div>
    <div style="background:#fef3e0; border-radius:14px; padding:14px; text-align:center;">
        <div style="font-size:20px; font-weight:800; color:var(--amber);">@ViewBag.TotalProceso</div>
        <div style="font-size:11px; color:var(--muted); margin-top:2px;">En proceso</div>
    </div>
    <div style="background:#e9f7ec; border-radius:14px; padding:14px; text-align:center;">
        <div style="font-size:20px; font-weight:800; color:var(--green);">@ViewBag.TotalCompletados</div>
        <div style="font-size:11px; color:var(--muted); margin-top:2px;">Completados</div>
    </div>
    <div style="background:#fdeaea; border-radius:14px; padding:14px; text-align:center;">
        <div style="font-size:20px; font-weight:800; color:var(--red);">@ViewBag.TotalCorreccion</div>
        <div style="font-size:11px; color:var(--muted); margin-top:2px;">Corrección</div>
    </div>
</div>

<!-- Filtros -->
<div style="display:flex; gap:8px; margin:18px 0; overflow-x:auto; padding-bottom:6px;">
    <a href="@Url.Action("Tramites", "Admin")"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(string.IsNullOrEmpty(estadoActual) ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        Todos
    </a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Iniciado" })"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(estadoActual == "Iniciado" ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        Iniciados
    </a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "En revisión" })"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(estadoActual == "En revisión" ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        En revisión
    </a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Aprobado" })"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(estadoActual == "Aprobado" ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        Aprobados
    </a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Requiere corrección" })"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(estadoActual == "Requiere corrección" ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        Corrección
    </a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Resuelto" })"
       style="flex:none; padding:8px 16px; border-radius:999px; font-size:12px; font-weight:800; text-decoration:none; @(estadoActual == "Resuelto" ? "background:var(--blue); color:#fff;" : "background:#eef0f7; color:var(--muted);")">
        Resueltos
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card" style="text-align:center; padding:40px 20px;">
        <div style="font-size:44px;">📭</div>
        <p style="font-weight:800; font-size:15px; margin-top:12px;">Sin trámites en este estado</p>
        <p style="font-size:12.5px; color:var(--muted); margin-top:6px;">
            Cuando un cliente envíe un trámite aparecerá aquí.
        </p>
    </div>
}
else
{
    foreach (var t in Model)
    {
        var cssEstado = (t.Estado == "Completado" || t.Estado == "Cerrado" || t.Estado == "Aprobado" || t.Estado == "Resuelto") ? "estado-completado"
                    : (t.Estado == "Requiere corrección" ? "estado-correccion"
                    : (t.Estado == "En proceso" || t.Estado == "En revisión" ? "estado-proceso" : ""));

        var badgeBg = cssEstado == "estado-completado" ? "#e9f7ec"
                    : (cssEstado == "estado-correccion" ? "#fdeaea" : "#fef3e0");
        var badgeColor = cssEstado == "estado-completado" ? "#2f8f3e"
                    : (cssEstado == "estado-correccion" ? "#c93a3f" : "#b9791a");

        <a href="@Url.Action("DetalleTramite", "Admin", new { id = t.TramiteId })" class="tramite-card @cssEstado">
            <div class="tramite-top">
                <span class="tramite-tipo">@t.Tipo</span>
                <span style="font-size:10.5px; font-weight:800; padding:5px 10px; border-radius:999px; background:@badgeBg; color:@badgeColor; white-space:nowrap;">
                    @t.Estado
                </span>
            </div>

            @if (t.Usuario != null)
            {
                <div class="tramite-info">
                    <i>👤</i>
                    @(t.Usuario.Nombre + " " + t.Usuario.Apellidos)
                </div>
            }

            @if (!string.IsNullOrEmpty(t.NumeroReferencia))
            {
                <div class="tramite-info">
                    <i>#</i>
                    @t.NumeroReferencia
                </div>
            }

            <div class="tramite-info">
                <i>📅</i>
                @t.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrEmpty(t.Descripcion))
            {
                <div style="margin-top:8px; padding:10px 12px; background:#f9fafc; border-radius:10px; font-size:12.5px; line-height:1.5; border-left:2px solid #e3e6ee; color:var(--ink);">
                    @t.Descripcion
                </div>
            }
        </a>
    }
}