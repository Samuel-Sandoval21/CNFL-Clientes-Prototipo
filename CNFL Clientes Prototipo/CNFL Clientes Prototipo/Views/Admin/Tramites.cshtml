@model List<CNFL_Clientes_Prototipo.Models.Tramite>
@{
    ViewBag.Title = "Trámites";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estadoActual = ViewBag.Estado as string ?? "";
}

@section Styles {
    <style>
        .filtros {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            margin-bottom: 16px;
            padding-bottom: 6px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .filtros::-webkit-scrollbar {
                display: none;
            }

        .filtro {
            padding: 9px 16px;
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 22px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            white-space: nowrap;
            cursor: pointer;
            flex-shrink: 0;
            transition: all .18s;
        }

            .filtro.active {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
                box-shadow: 0 6px 14px -6px rgba(26, 43, 107, .5);
            }

        .tramite-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
        }

            .tramite-card.estado-completado {
                border-left-color: #00a651;
            }

            .tramite-card.estado-proceso {
                border-left-color: #c98a00;
            }

        .tramite-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
            gap: 8px;
        }

        .tramite-tipo {
            font-weight: 800;
            font-size: 14px;
            color: var(--text);
            line-height: 1.3;
            flex: 1;
        }

        .tramite-info {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .tramite-info i {
                font-size: 12px;
                color: #aab0be;
                width: 14px;
            }
    </style>
}

<h1 class="page-title">Trámites</h1>

<div class="filtros">
    <a href="@Url.Action("Tramites", "Admin")" class="filtro @(string.IsNullOrEmpty(estadoActual) ? "active" : "")">Todos</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Solicitado" })" class="filtro @(estadoActual == "Solicitado" ? "active" : "")">Solicitados</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "En proceso" })" class="filtro @(estadoActual == "En proceso" ? "active" : "")">En proceso</a>
    <a href="@Url.Action("Tramites", "Admin", new { estado = "Completado" })" class="filtro @(estadoActual == "Completado" ? "active" : "")">Completados</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty">
        <i class="fas fa-file-alt" style="font-size:42px;color:#c9ced9;margin-bottom:12px;display:block;"></i>
        <p>No hay trámites para mostrar.</p>
    </div>
}
else
{
    foreach (var t in Model)
    {
        var cssEstado = t.Estado == "Completado" || t.Estado == "Cerrado" ? "estado-completado" :
                        (t.Estado == "En proceso" ? "estado-proceso" : "");
        var badge = t.Estado == "Completado" || t.Estado == "Cerrado" ? "ok" :
                    (t.Estado == "En proceso" ? "info" : "warn");

        <div class="tramite-card @cssEstado">
            <div class="tramite-top">
                <span class="tramite-tipo">@t.Tipo</span>
                <span class="badge @badge">@t.Estado</span>
            </div>

            @if (!string.IsNullOrEmpty(t.Categoria))
            {
                <div class="tramite-info">
                    <i class="fas fa-tag"></i>
                    @t.Categoria
                </div>
            }

            <div class="tramite-info">
                <i class="fas fa-calendar"></i>
                @t.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrEmpty(t.NumeroReferencia))
            {
                <div class="tramite-info">
                    <i class="fas fa-hashtag"></i>
                    @t.NumeroReferencia
                </div>
            }

            @if (!string.IsNullOrEmpty(t.Descripcion))
            {
                <div style="margin-top:8px;font-size:13px;color:var(--text);">
                    @t.Descripcion
                </div>
            }
        </div>
    }
}