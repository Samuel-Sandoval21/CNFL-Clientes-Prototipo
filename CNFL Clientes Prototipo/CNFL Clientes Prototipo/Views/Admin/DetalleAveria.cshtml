@model CNFL_Clientes_Prototipo.Models.Averia

@{
    ViewBag.Title = "Detalle de Avería";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}

<link rel="stylesheet" href="~/Content/admin/detalle-averia.css" />

<div class="detalle-averia">
    <div class="page-header">
        <h1>Detalle de Avería #@Model.AveriaId</h1>
        <a href="@Url.Action("Averias", "Admin")" class="btn-volver">← Volver</a>
    </div>

    <div class="detalle-grid">
        <div class="detalle-card">
            <h3>Información General</h3>
            <p><strong>ID:</strong> #@Model.AveriaId</p>
            <p><strong>Tipo:</strong> @Model.Tipo</p>
            <p><strong>Estado:</strong> <span class="estado-badge @Model.Estado.Replace(" ", "-").ToLower()">@Model.Estado</span></p>
            <p><strong>Fecha Reporte:</strong> @Model.FechaReporte.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Última Actualización:</strong> @(Model.FechaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Sin actualizar")</p>
        </div>

        <div class="detalle-card">
            <h3>Descripción</h3>
            <p>@Model.Descripcion</p>
        </div>

        <div class="detalle-card">
            <h3>Información del Usuario</h3>
            <p><strong>Usuario ID:</strong> @Model.UsuarioId</p>
            <p><strong>NISE:</strong> @Model.NiseId</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.FotoUrl))
        {
            <div class="detalle-card">
                <h3>Foto Adjunta</h3>
                <img src="@Model.FotoUrl" alt="Foto de la avería" class="detalle-foto" />
            </div>
        }
    </div>

    <div class="detalle-actions">
        <button class="btn-cambiar-estado" id="btnCambiarEstado" data-id="@Model.AveriaId">Cambiar Estado</button>
        <button class="btn-imprimir" id="btnImprimir">Imprimir</button>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin/detalle-averia.js"></script>
}