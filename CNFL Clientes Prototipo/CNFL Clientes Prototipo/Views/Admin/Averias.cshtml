@model List<CNFL_Clientes_Prototipo.Models.Averia>
@{
    ViewBag.Title = "Averías";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var averias = Model ?? new List<CNFL_Clientes_Prototipo.Models.Averia>();
    var estadoFiltro = ViewBag.EstadoFiltro as string ?? "Todos";
    var tipoFiltro = ViewBag.TipoFiltro as string ?? "Todos";
    var busqueda = ViewBag.Busqueda as string ?? "";
    var estados = ViewBag.Estados as string[] ?? new string[0];
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();

    string ClaseEstado(string e)
    {
        var s = (e ?? "").ToLower();
        if (s.Contains("resuelto")) return "ok";
        if (s.Contains("revisión") || s.Contains("camino")) return "warn";
        if (s.Contains("ingresado")) return "info";
        return "err";
    }
}

<div class="appbar">
    <a href="@Url.Action("Dashboard", "Admin")" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.2">
            <path d="m15 18-6-6 6-6" />
        </svg>
    </a>
    <div class="brand" style="font-weight:800; font-size:16px;">Averías</div>
    <div style="width:40px;"></div>
</div>

<h1 class="h-name" style="font-size:24px;">Gestión de averías</h1>
<p class="h-greet" style="margin-top:6px; line-height:1.5;">
    @averias.Count avería(s) · actualizado en tiempo real
</p>

<form method="get" action="@Url.Action("Averias", "Admin")" class="admin-search" style="margin-top:14px;">
    <input type="text" name="q" value="@busqueda" placeholder="Buscar..." style="width:100%;" />
    <select name="estado">
        @foreach (var e in estados)
        {
            <option value="@e" @(estadoFiltro == e ? "selected" : "")>@e</option>
        }
    </select>
    <select name="tipo">
        <option value="Todos" @(tipoFiltro == "Todos" ? "selected" : "")>Tipos</option>
        @foreach (var t in tipos)
        {
            <option value="@t" @(tipoFiltro == t ? "selected" : "")>@t</option>
        }
    </select>
    <button type="submit" class="admin-btn primary">Filtrar</button>
</form>

<div class="admin-list" style="margin-top:8px;">
    @if (averias.Count == 0)
    {
        <div class="admin-card" style="text-align:center; padding:34px 18px;">
            <div style="font-size:40px;">⚡</div>
            <p style="font-weight:800; font-size:14px; margin-top:10px;">Sin averías</p>
        </div>
    }
    else
    {
        foreach (var a in averias)
        {
            <a href="@Url.Action("DetalleAveria", "Admin", new { id = a.AveriaId })" class="admin-list-item">
                <div class="ic" style="background:#fff3ec; color:var(--orange);">⚡</div>
                <div class="tx">
                    <div style="display:flex; justify-content:space-between; gap:8px; align-items:flex-start;">
                        <div class="t">#@a.AveriaId · @a.Tipo</div>
                        <span class="chip @ClaseEstado(a.Estado)" style="font-size:10px;">
                            <span class="d"></span>@a.Estado
                        </span>
                    </div>
                    <div class="s" style="margin-top:4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        @a.Descripcion
                    </div>
                    <div class="s" style="margin-top:4px; font-weight:700; color:var(--blue); font-size:10.5px;">
                        @a.FechaReporte.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
            </a>
        }
    }
</div>