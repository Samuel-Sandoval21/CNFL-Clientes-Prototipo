@model List<CNFL_Clientes_Prototipo.Models.Averia>
@{
    ViewBag.Title = "Averías";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estadoActual = ViewBag.Estado as string ?? "";
}

@section Styles {
    <style>
        .filtros {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            margin-bottom: 16px;
            padding-bottom: 6px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .filtros::-webkit-scrollbar {
                display: none;
            }

        .filtro {
            padding: 9px 16px;
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 22px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            white-space: nowrap;
            cursor: pointer;
            flex-shrink: 0;
            transition: all .18s;
        }

            .filtro.active {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
                box-shadow: 0 6px 14px -6px rgba(26, 43, 107, .5);
            }

        .averia-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
        }

            .averia-card.estado-resuelta {
                border-left-color: #00a651;
            }

            .averia-card.estado-proceso {
                border-left-color: #c98a00;
            }

        .averia-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            gap: 8px;
        }

        .averia-tipo {
            font-weight: 800;
            font-size: 14.5px;
            color: var(--text);
        }

        .averia-info {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .averia-info i {
                font-size: 12px;
                color: #aab0be;
                width: 14px;
            }
    </style>
}

<h1 class="page-title">Averías</h1>

<div class="filtros">
    <a href="@Url.Action("Averias", "Admin")" class="filtro @(string.IsNullOrEmpty(estadoActual) ? "active" : "")">Todas</a>
    <a href="@Url.Action("Averias", "Admin", new { estado = "Ingresado" })" class="filtro @(estadoActual == "Ingresado" ? "active" : "")">Ingresadas</a>
    <a href="@Url.Action("Averias", "Admin", new { estado = "En revisión" })" class="filtro @(estadoActual == "En revisión" ? "active" : "")">En revisión</a>
    <a href="@Url.Action("Averias", "Admin", new { estado = "Resuelta" })" class="filtro @(estadoActual == "Resuelta" ? "active" : "")">Resueltas</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty">
        <i class="fas fa-bolt" style="font-size:42px;color:#c9ced9;margin-bottom:12px;display:block;"></i>
        <p>No hay averías para mostrar.</p>
    </div>
}
else
{
    foreach (var a in Model)
    {
        var cssEstado = a.Estado == "Resuelta" || a.Estado == "Cerrada" ? "estado-resuelta" :
                        (a.Estado == "En revisión" || a.Estado == "En proceso" ? "estado-proceso" : "");
        var badge = a.Estado == "Resuelta" || a.Estado == "Cerrada" ? "ok" :
                    (a.Estado == "En revisión" || a.Estado == "En proceso" ? "info" : "warn");

        <div class="averia-card @cssEstado">
            <div class="averia-top">
                <span class="averia-tipo">@a.Tipo</span>
                <span class="badge @badge">@a.Estado</span>
            </div>

            @if (a.NISE != null)
            {
                <div class="averia-info">
                    <i class="fas fa-bolt"></i>
                    NISE: @a.NISE.NumeroNise
                </div>
            }

            <div class="averia-info">
                <i class="fas fa-calendar"></i>
                @a.FechaReporte.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrEmpty(a.Descripcion))
            {
                <div class="averia-info" style="margin-top:8px;color:var(--text);font-size:13px;">
                    @a.Descripcion
                </div>
            }
        </div>
    }
}