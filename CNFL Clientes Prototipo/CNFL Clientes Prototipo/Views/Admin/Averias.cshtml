@model List<CNFL_Clientes_Prototipo.Models.Averia>
@{
    ViewBag.Title = "Averías";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estadoActual = ViewBag.Estado as string ?? "";
}

@section Styles {
    <style>
        .averia-card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            border-left: 4px solid var(--blue);
            transition: transform .15s, box-shadow .15s;
        }

            .averia-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(20, 30, 70, .1);
            }

            .averia-card.estado-resuelta {
                border-left-color: var(--green);
            }

            .averia-card.estado-proceso {
                border-left-color: var(--gold);
            }

            .averia-card.estado-reportada {
                border-left-color: var(--red);
            }

        .averia-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            gap: 8px;
        }

        .averia-tipo {
            font-weight: 800;
            font-size: 14.5px;
            color: var(--text);
            line-height: 1.2;
        }

        .averia-info {
            font-size: 12.5px;
            color: var(--muted);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .averia-info i {
                font-size: 12px;
                color: #aab0be;
                width: 14px;
                text-align: center;
            }

        .averia-desc {
            margin-top: 10px;
            padding: 10px 12px;
            background: #f9fafc;
            border-radius: 10px;
            font-size: 12.5px;
            color: var(--text);
            line-height: 1.5;
            border-left: 2px solid #e3e6ee;
        }

        /* ═══════════ FILTROS CON SCROLL ═══════════ */
        .filtros-scroll {
            display: flex;
            gap: 8px;
            margin: 16px 0;
            overflow-x: auto;
            padding: 0 4px 8px 0;
            scrollbar-width: thin;
            -webkit-overflow-scrolling: touch;
        }

            .filtros-scroll::-webkit-scrollbar {
                height: 4px;
            }

            .filtros-scroll::-webkit-scrollbar-thumb {
                background: #d8dde8;
                border-radius: 4px;
            }

            .filtros-scroll::-webkit-scrollbar-track {
                background: transparent;
            }

        .filtro-btn {
            flex: none;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            background: #eef0f7;
            color: var(--muted);
            white-space: nowrap;
            transition: background .15s;
        }

            .filtro-btn:hover {
                background: #dde3ff;
                color: var(--blue);
            }

            .filtro-btn.active {
                background: var(--blue);
                color: #fff;
            }
    </style>
}

<h1 class="page-title">Averías</h1>
<p class="page-subtitle">Supervisá y gestioná todos los reportes de averías.</p>

<div class="stats-row">
    <div class="stat-mini red">
        <div class="num">@Model.Count(a => a.Estado != "Resuelta" && a.Estado != "Cerrada")</div>
        <div class="lbl">Abiertas</div>
    </div>
    <div class="stat-mini gold">
        <div class="num">@Model.Count(a => a.Estado == "En revisión" || a.Estado == "En proceso")</div>
        <div class="lbl">En proceso</div>
    </div>
    <div class="stat-mini green">
        <div class="num">@Model.Count(a => a.Estado == "Resuelta" || a.Estado == "Cerrada")</div>
        <div class="lbl">Resueltas</div>
    </div>
</div>

<!-- Filtros con scroll horizontal -->
<div class="filtros-scroll">
    <a href="@Url.Action("Averias", "Admin")"
       class="filtro-btn @(string.IsNullOrEmpty(estadoActual) ? "active" : "")">Todas</a>

    <a href="@Url.Action("Averias", "Admin", new { estado = "Ingresado" })"
       class="filtro-btn @(estadoActual == "Ingresado" ? "active" : "")">Ingresadas</a>

    <a href="@Url.Action("Averias", "Admin", new { estado = "En revisión" })"
       class="filtro-btn @(estadoActual == "En revisión" ? "active" : "")">En revisión</a>

    <a href="@Url.Action("Averias", "Admin", new { estado = "Resuelta" })"
       class="filtro-btn @(estadoActual == "Resuelta" ? "active" : "")">Resueltas</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty">
        <i class="fas fa-bolt"></i>
        <p>No hay averías para mostrar.</p>
    </div>
}
else
{
    foreach (var a in Model)
    {
        var cssEstado = a.Estado == "Resuelta" || a.Estado == "Cerrada" ? "estado-resuelta" :
                        (a.Estado == "En revisión" || a.Estado == "En proceso" ? "estado-proceso" : "estado-reportada");
        var badge = a.Estado == "Resuelta" || a.Estado == "Cerrada" ? "ok" :
                    (a.Estado == "En revisión" || a.Estado == "En proceso" ? "gold" : "warn");

        <div class="averia-card @cssEstado">
            <div class="averia-top">
                <span class="averia-tipo">@a.Tipo</span>
                <span class="badge @badge">@a.Estado</span>
            </div>

            @if (a.NISE != null)
            {
                <div class="averia-info">
                    <i class="fas fa-bolt"></i>
                    NISE: @a.NISE.NumeroNise
                </div>
            }

            <div class="averia-info">
                <i class="fas fa-calendar"></i>
                @a.FechaReporte.ToString("dd/MM/yyyy HH:mm")
            </div>

            @if (!string.IsNullOrEmpty(a.Descripcion))
            {
                <div class="averia-desc">
                    @a.Descripcion
                </div>
            }
        </div>
    }
}