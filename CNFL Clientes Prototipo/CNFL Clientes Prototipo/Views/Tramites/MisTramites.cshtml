@model List<CNFL_Clientes_Prototipo.Models.Tramite>

@{
    ViewBag.Title = "Mis Trámites";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var tramites = Model ?? new List<CNFL_Clientes_Prototipo.Models.Tramite>();
    var pendientes = tramites.Count(t => t.Estado != "Resuelto");
}

@section Styles {
    <style>
        .mt-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .mt-back:hover {
                text-decoration: underline;
            }

        .mt-header h1 {
            font-size: 22px;
            font-weight: 800;
            color: var(--blue);
            margin: 0;
        }

        .mt-header .sub {
            font-size: 12.5px;
            color: var(--muted);
            margin-top: 4px;
        }

        .mt-kpis {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 14px;
        }

        .mt-kpi {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 12px 14px;
            box-shadow: var(--shadow-sm);
        }

            .mt-kpi .lbl {
                font-size: 10.5px;
                font-weight: 800;
                color: var(--muted);
            }

            .mt-kpi .val {
                font-size: 20px;
                font-weight: 800;
                color: var(--ink);
                margin-top: 3px;
            }

                .mt-kpi .val.warn {
                    color: #b9791a;
                }

        .mt-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            margin-top: 10px;
            box-shadow: var(--shadow-sm);
        }

            .mt-card .top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
            }

            .mt-card .tipo {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .mt-card .ref {
                font-size: 11px;
                color: var(--muted);
                margin-top: 3px;
            }

            .mt-card .badge {
                font-size: 10.5px;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: 999px;
            }

                .mt-card .badge.pend {
                    background: #fef3e0;
                    color: #b9791a;
                }

                .mt-card .badge.ok {
                    background: #e9f7ec;
                    color: #2f8f3e;
                }

                .mt-card .badge.ing {
                    background: #eef0ff;
                    color: var(--blue);
                }

            .mt-card .meta {
                font-size: 11.5px;
                color: var(--muted);
                margin-top: 8px;
                line-height: 1.5;
            }

        .mt-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 30px 20px;
            text-align: center;
            margin-top: 20px;
        }

            .mt-empty .e {
                font-size: 40px;
                margin-bottom: 8px;
            }

            .mt-empty .t {
                font-size: 14px;
                font-weight: 800;
                color: var(--ink);
            }

            .mt-empty .s {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 5px;
                line-height: 1.4;
            }

            .mt-empty .btn {
                display: inline-block;
                margin-top: 14px;
                background: var(--blue);
                color: #fff;
                text-decoration: none;
                font-weight: 800;
                font-size: 13px;
                padding: 10px 20px;
                border-radius: 12px;
            }
    </style>
}

<a href="@Url.Action("Index", "Tramites")" class="mt-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver a trámites
</a>

<div class="mt-header">
    <h1>Mis Trámites</h1>
    <div class="sub">Historial completo de solicitudes</div>
</div>

<div class="mt-kpis">
    <div class="mt-kpi">
        <div class="lbl">TOTAL</div>
        <div class="val">@tramites.Count</div>
    </div>
    <div class="mt-kpi">
        <div class="lbl">EN PROCESO</div>
        <div class="val warn">@pendientes</div>
    </div>
</div>

@if (tramites.Any())
{
    foreach (var t in tramites)
    {
        var clase = t.Estado == "Resuelto" ? "ok"
                  : t.Estado == "En proceso" ? "ing"
                  : "pend";
        <div class="mt-card">
            <div class="top">
                <div>
                    <div class="tipo">@t.Tipo</div>
                    <div class="ref">@t.NumeroReferencia · @t.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="badge @clase">@t.Estado</div>
            </div>
            @if (!string.IsNullOrEmpty(t.Descripcion))
            {
                <div class="meta">📝 @t.Descripcion</div>
            }
        </div>
    }
}
else
{
    <div class="mt-empty">
        <div class="e">📭</div>
        <div class="t">Sin trámites registrados</div>
        <div class="s">Realizá tu primer trámite en línea.</div>
        <a href="@Url.Action("Index", "Tramites")" class="btn">Ver catálogo</a>
    </div>
}