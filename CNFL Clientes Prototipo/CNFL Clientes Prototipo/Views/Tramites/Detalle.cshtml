@model CNFL_Clientes_Prototipo.Controllers.TramiteCatalogo

@{
    ViewBag.Title = Model.Nombre;
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var nises = ViewBag.NISEs as SelectList;
    var tramiteId = ViewBag.TramiteId as string ?? Model.Id;
}

@section Styles {
    <style>
        .td-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .td-back:hover {
                text-decoration: underline;
            }

        .td-hero {
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(16,20,60,.45);
            margin-top: 8px;
        }

            .td-hero .ico {
                font-size: 34px;
                margin-bottom: 8px;
            }

            .td-hero h1 {
                margin: 0;
                font-size: 19px;
                font-weight: 800;
                letter-spacing: -.02em;
                line-height: 1.2;
            }

            .td-hero p {
                margin: 6px 0 0;
                font-size: 12.5px;
                opacity: .9;
                line-height: 1.4;
            }

        .td-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 20px;
            margin-top: 16px;
            box-shadow: var(--shadow-sm);
        }

        .td-field {
            margin-bottom: 14px;
        }

        .td-label {
            font-size: 12px;
            font-weight: 800;
            color: var(--muted);
            display: block;
            margin-bottom: 7px;
        }

        .td-input, .td-select, .td-textarea {
            width: 100%;
            border: 1.5px solid var(--line);
            border-radius: 14px;
            padding: 13px 15px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            outline: none;
            background: #fff;
            transition: border-color .15s;
        }

            .td-input:focus, .td-select:focus, .td-textarea:focus {
                border-color: var(--blue);
            }

        .td-textarea {
            resize: vertical;
            min-height: 90px;
        }

        .td-btn {
            width: 100%;
            background: var(--blue);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 15px;
            border-radius: 14px;
            margin-top: 8px;
            cursor: pointer;
            transition: transform .12s;
        }

            .td-btn:active {
                transform: scale(.97);
            }

            .td-btn:disabled {
                background: #b8c2e0;
                cursor: not-allowed;
            }

        .td-btn-sec {
            width: 100%;
            background: #fff;
            color: var(--blue);
            border: 1.5px solid var(--blue);
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 14px;
            border-radius: 14px;
            margin-top: 10px;
            cursor: pointer;
            text-decoration: none;
            display: block;
            text-align: center;
        }

            .td-btn-sec:hover {
                background: #f5f7ff;
                text-decoration: none;
                color: var(--blue);
            }

        .td-alert {
            background: #eef0ff;
            color: var(--blue);
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 12.5px;
            font-weight: 700;
            margin-bottom: 14px;
            line-height: 1.5;
        }

            .td-alert.ok {
                background: #e9f7ec;
                color: #2f8f3e;
            }
    </style>
}

<a href="@Url.Action("Index", "Tramites")" class="td-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span data-i18n="detalle.back">Volver a trámites</span>
</a>

<div class="td-hero">
    <div class="ico">@Model.Icono</div>
    <h1>@Model.Nombre</h1>
    <p>@Model.Descripcion</p>
</div>

<div class="td-card" id="formCard">
    <div class="td-alert">
        Completá los datos requeridos. Te vamos a asignar un <b>número de referencia</b> al enviar el trámite.
    </div>

    @using (Html.BeginForm("Solicitar", "Tramites", FormMethod.Post, new { id = "formTramite" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="tramiteId" value="@tramiteId" />
        <input type="hidden" name="datosFormulario" id="datosFormulario" value="" />

        <div class="td-field">
            <label class="td-label" data-i18n="detalle.nise">NISE ASOCIADO</label>
            @if (nises != null && nises.Any())
            {
                @Html.DropDownList("niseId", nises, "Seleccioná un NISE", new { @class = "td-select", required = "required" })
            }
            else
            {
                <input type="text" name="niseId" class="td-input" placeholder="Ingresá el número de NISE" required />
            }
        </div>

        <div class="td-field">
            <label class="td-label" data-i18n="detalle.desc">DESCRIPCIÓN DEL TRÁMITE</label>
            <textarea name="descripcion" class="td-textarea"
                      data-i18n-placeholder="detalle.desc.placeholder"
                      placeholder="Describí brevemente el motivo de tu trámite..." required></textarea>
        </div>

        if (Model.Id == "cambio-conexion-voltaje")
        {
            <div class="td-field">
                <label class="td-label">VOLTAJE ACTUAL</label>
                <select class="td-select" data-campo="voltajeActual">
                    <option value="">Seleccioná</option>
                    <option value="120V">120V</option>
                    <option value="240V">240V</option>
                    <option value="480V">480V</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">VOLTAJE SOLICITADO</label>
                <select class="td-select" data-campo="voltajeNuevo">
                    <option value="">Seleccioná</option>
                    <option value="120V">120V</option>
                    <option value="240V">240V</option>
                    <option value="480V">480V</option>
                </select>
            </div>
        }

        if (Model.Id == "cambio-nombre-abonado")
        {
            <div class="td-field">
                <label class="td-label">NOMBRE DEL NUEVO TITULAR</label>
                <input type="text" class="td-input" data-campo="nuevoTitular" placeholder="Nombre completo" />
            </div>
            <div class="td-field">
                <label class="td-label">CÉDULA DEL NUEVO TITULAR</label>
                <input type="text" class="td-input" data-campo="cedulaTitular" placeholder="Ej: 1-1234-5678" />
            </div>
            <div class="td-field">
                <label class="td-label">MOTIVO DEL CAMBIO</label>
                <select class="td-select" data-campo="motivo">
                    <option value="">Seleccioná</option>
                    <option value="Venta del inmueble">Venta del inmueble</option>
                    <option value="Herencia">Herencia</option>
                    <option value="Traspaso familiar">Traspaso familiar</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
        }

        if (Model.Id == "cambio-servicio-provisional")
        {
            <div class="td-field">
                <label class="td-label">NÚMERO DE CONTRATO PROVISIONAL</label>
                <input type="text" class="td-input" data-campo="contratoProvisional" placeholder="Ej: PROV-2026-001" />
            </div>
            <div class="td-field">
                <label class="td-label">FECHA DE SOLICITUD ORIGINAL</label>
                <input type="date" class="td-input" data-campo="fechaOriginal" />
            </div>
        }

        if (Model.Id == "desconexion-reconexion")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE SOLICITUD</label>
                <select class="td-select" data-campo="tipoSolicitud">
                    <option value="">Seleccioná</option>
                    <option value="Desconexión temporal">Desconexión temporal</option>
                    <option value="Desconexión definitiva">Desconexión definitiva</option>
                    <option value="Reconexión">Reconexión</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">FECHA DESEADA</label>
                <input type="date" class="td-input" data-campo="fechaDeseada" />
            </div>
        }

        if (Model.Id == "diseno-red-electrica")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE PROYECTO</label>
                <select class="td-select" data-campo="tipoProyecto">
                    <option value="">Seleccioná</option>
                    <option value="Residencial">Residencial</option>
                    <option value="Comercial">Comercial</option>
                    <option value="Industrial">Industrial</option>
                    <option value="DER">Recursos Energéticos Distribuidos</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">POTENCIA ESTIMADA (kW)</label>
                <input type="number" class="td-input" data-campo="potencia" placeholder="Ej: 50" />
            </div>
            <div class="td-field">
                <label class="td-label">UBICACIÓN DEL PROYECTO</label>
                <input type="text" class="td-input" data-campo="ubicacion" placeholder="Dirección exacta" />
            </div>
        }

        if (Model.Id == "transformador-temporal")
        {
            <div class="td-field">
                <label class="td-label">CAPACIDAD REQUERIDA (kVA)</label>
                <input type="number" class="td-input" data-campo="capacidad" placeholder="Ej: 75" />
            </div>
            <div class="td-field">
                <label class="td-label">DURACIÓN ESTIMADA</label>
                <select class="td-select" data-campo="duracion">
                    <option value="">Seleccioná</option>
                    <option value="1 mes">1 mes</option>
                    <option value="3 meses">3 meses</option>
                    <option value="6 meses">6 meses</option>
                    <option value="1 año">1 año</option>
                </select>
            </div>
        }

        if (Model.Id == "traslado-medidor")
        {
            <div class="td-field">
                <label class="td-label">DIRECCIÓN ACTUAL DEL MEDIDOR</label>
                <input type="text" class="td-input" data-campo="direccionActual" placeholder="Dirección actual" />
            </div>
            <div class="td-field">
                <label class="td-label">NUEVA DIRECCIÓN</label>
                <input type="text" class="td-input" data-campo="direccionNueva" placeholder="Nueva dirección" />
            </div>
            <div class="td-field">
                <label class="td-label">MOTIVO DEL TRASLADO</label>
                <textarea class="td-textarea" data-campo="motivo" placeholder="Describí el motivo..."></textarea>
            </div>
        }

        if (Model.Id == "tarifa-residencial-horaria")
        {
            <div class="td-field">
                <label class="td-label">CONSUMO PROMEDIO MENSUAL (kWh)</label>
                <input type="number" class="td-input" data-campo="consumoPromedio" placeholder="Ej: 250" />
            </div>
            <div class="td-field">
                <label class="td-label">¿TIENE MEDIDOR INTELIGENTE?</label>
                <select class="td-select" data-campo="medidorInteligente">
                    <option value="">Seleccioná</option>
                    <option value="Sí">Sí</option>
                    <option value="No">No</option>
                </select>
            </div>
        }

        if (Model.Id == "reclamo-responsabilidad-civil")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE DAÑO</label>
                <select class="td-select" data-campo="tipoDano">
                    <option value="">Seleccioná</option>
                    <option value="Electrodoméstico">Electrodoméstico</option>
                    <option value="Equipo electrónico">Equipo electrónico</option>
                    <option value="Instalación eléctrica">Instalación eléctrica</option>
                    <option value="Otro">Otro</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">DESCRIPCIÓN DEL EQUIPO DAÑADO</label>
                <input type="text" class="td-input" data-campo="equipo" placeholder="Marca, modelo, año" />
            </div>
            <div class="td-field">
                <label class="td-label">MONTO ESTIMADO DEL DAÑO (₡)</label>
                <input type="number" class="td-input" data-campo="montoDano" placeholder="Ej: 250000" />
            </div>
            <div class="td-field">
                <label class="td-label">FECHA DEL INCIDENTE</label>
                <input type="date" class="td-input" data-campo="fechaIncidente" />
            </div>
        }

        if (Model.Id == "servicio-nuevo-mono-tri")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE SERVICIO</label>
                <select class="td-select" data-campo="tipoServicio">
                    <option value="">Seleccioná</option>
                    <option value="Monofásico">Monofásico</option>
                    <option value="Trifásico">Trifásico</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">CARGA INSTALADA ESTIMADA (kW)</label>
                <input type="number" class="td-input" data-campo="cargaInstalada" placeholder="Ej: 10" />
            </div>
            <div class="td-field">
                <label class="td-label">DIRECCIÓN DEL SERVICIO</label>
                <input type="text" class="td-input" data-campo="direccion" placeholder="Dirección exacta" />
            </div>
        }

        if (Model.Id == "suministro-inmuebles")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE INMUEBLE</label>
                <select class="td-select" data-campo="tipoInmueble">
                    <option value="">Seleccioná</option>
                    <option value="Casa">Casa</option>
                    <option value="Apartamento">Apartamento</option>
                    <option value="Local comercial">Local comercial</option>
                    <option value="Bodega">Bodega</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">ÁREA DE CONSTRUCCIÓN (m²)</label>
                <input type="number" class="td-input" data-campo="area" placeholder="Ej: 120" />
            </div>
        }

        if (Model.Id == "suministro-especial")
        {
            <div class="td-field">
                <label class="td-label">DESCRIPCIÓN DEL SUMINISTRO ESPECIAL</label>
                <textarea class="td-textarea" data-campo="descripcionEspecial" placeholder="Describí las características especiales..."></textarea>
            </div>
            <div class="td-field">
                <label class="td-label">CARGA REQUERIDA (kW)</label>
                <input type="number" class="td-input" data-campo="carga" placeholder="Ej: 100" />
            </div>
        }

        if (Model.Id == "alumbrado-publico")
        {
            <div class="td-field">
                <label class="td-label">TIPO DE SOLICITUD</label>
                <select class="td-select" data-campo="tipoAlumbrado">
                    <option value="">Seleccioná</option>
                    <option value="Nuevo punto de alumbrado">Nuevo punto de alumbrado</option>
                    <option value="Reparación de lámpara">Reparación de lámpara</option>
                    <option value="Ampliación de cobertura">Ampliación de cobertura</option>
                </select>
            </div>
            <div class="td-field">
                <label class="td-label">CANTIDAD DE PUNTOS SOLICITADOS</label>
                <input type="number" class="td-input" data-campo="cantidad" placeholder="Ej: 3" />
            </div>
            <div class="td-field">
                <label class="td-label">UBICACIÓN EXACTA</label>
                <input type="text" class="td-input" data-campo="ubicacion" placeholder="Dirección o referencia" />
            </div>
        }

        if (Model.Id == "traspaso-servicio")
        {
            <div class="td-field">
                <label class="td-label">NOMBRE DEL NUEVO TITULAR</label>
                <input type="text" class="td-input" data-campo="nuevoTitular" placeholder="Nombre completo" />
            </div>
            <div class="td-field">
                <label class="td-label">CÉDULA DEL NUEVO TITULAR</label>
                <input type="text" class="td-input" data-campo="cedulaTitular" placeholder="Ej: 1-1234-5678" />
            </div>
            <div class="td-field">
                <label class="td-label">CORREO DEL NUEVO TITULAR</label>
                <input type="email" class="td-input" data-campo="correo" placeholder="correo@ejemplo.com" />
            </div>
        }

        if (Model.Id == "carga-fija")
        {
            <div class="td-field">
                <label class="td-label">DESCRIPCIÓN DE LA CARGA</label>
                <textarea class="td-textarea" data-campo="descripcionCarga" placeholder="Describí el equipo o maquinaria..."></textarea>
            </div>
            <div class="td-field">
                <label class="td-label">POTENCIA DE LA CARGA (kW)</label>
                <input type="number" class="td-input" data-campo="potencia" placeholder="Ej: 50" />
            </div>
            <div class="td-field">
                <label class="td-label">HORARIO DE OPERACIÓN</label>
                <input type="text" class="td-input" data-campo="horario" placeholder="Ej: 8am - 5pm" />
            </div>
        }

        if (Model.Id == "eventos-temporal")
        {
            <div class="td-field">
                <label class="td-label">NOMBRE DEL EVENTO</label>
                <input type="text" class="td-input" data-campo="nombreEvento" placeholder="Ej: Concierto, feria, etc." />
            </div>
            <div class="td-field">
                <label class="td-label">FECHA DEL EVENTO</label>
                <input type="date" class="td-input" data-campo="fechaEvento" />
            </div>
            <div class="td-field">
                <label class="td-label">CARGA REQUERIDA (kW)</label>
                <input type="number" class="td-input" data-campo="carga" placeholder="Ej: 30" />
            </div>
            <div class="td-field">
                <label class="td-label">UBICACIÓN DEL EVENTO</label>
                <input type="text" class="td-input" data-campo="ubicacion" placeholder="Dirección exacta" />
            </div>
        }

        <button type="submit" class="td-btn" id="btnEnviar" data-i18n="detalle.submit">
            Enviar solicitud
        </button>
        <a href="@Url.Action("Index", "Tramites")" class="td-btn-sec" data-i18n="detalle.cancel">Cancelar</a>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('formTramite').addEventListener('submit', function (e) {
            e.preventDefault();

            var datos = {};
            document.querySelectorAll('[data-campo]').forEach(function (el) {
                datos[el.getAttribute('data-campo')] = el.value;
            });

            document.getElementById('datosFormulario').value = JSON.stringify(datos);

            var form = e.target;
            var formData = new FormData(form);

            var btn = document.getElementById('btnEnviar');
            btn.disabled = true;
            btn.innerText = window.CNFL_T ? window.CNFL_T('detalle.sending') : 'Enviando...';

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.success) {
                    var t = window.CNFL_T || function (k) { return k; };
                    document.getElementById('formCard').innerHTML =
                        '<div class="td-alert ok" style="font-size:14px; padding:20px; text-align:center;">' +
                        '✅ <b>' + t('detalle.success.title') + '</b><br><br>' +
                        t('detalle.success.ref') + ' <b>' + res.referencia + '</b><br><br>' +
                        '<small>' + t('detalle.success.msg') + '</small>' +
                        '</div>' +
                        '<a href="@Url.Action("Index", "Tramites")" class="td-btn" style="display:block; text-align:center; text-decoration:none; color:#fff;">' + t('detalle.back.to.list') + '</a>';
                } else {
                    alert('❌ ' + (res.message || 'Error al procesar.'));
                    btn.disabled = false;
                    btn.innerText = window.CNFL_T ? window.CNFL_T('detalle.submit') : 'Enviar solicitud';
                }
            })
            .catch(function () {
                alert('❌ Error al enviar. Intentá de nuevo.');
                btn.disabled = false;
                btn.innerText = window.CNFL_T ? window.CNFL_T('detalle.submit') : 'Enviar solicitud';
            });
        });
    </script>
}