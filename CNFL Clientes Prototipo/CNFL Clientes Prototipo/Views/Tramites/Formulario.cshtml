@model CNFL_Clientes_Prototipo.Models.FormularioTramite
@{
    ViewBag.Title = "Formulario de Trámite";
    var tipo = ViewBag.Tipo as string ?? "Trámite General";
}

<div class="section-pad">
    <div class="h-name" style="font-size: 22px; margin-top: 20px;">@tipo</div>
    <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">Complete el formulario, los datos ya vienen precargados.</div>
</div>

<div style="padding: 0 20px;">
    @using (Html.BeginForm("Formulario", "Tramites", FormMethod.Post))
    {
        @Html.Hidden("tipo", tipo)

        <div class="card-cliente">
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">NISE ASOCIADO</label>
                <input type="text" name="NISE" class="form-control" value="@Session["NISE"]" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">NOMBRE DEL CLIENTE</label>
                <input type="text" name="NombreCliente" class="form-control" value="@Session["Usuario"]" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CÉDULA</label>
                <input type="text" name="Cedula" class="form-control" value="1-2345-6789" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">TELÉFONO</label>
                <input type="text" name="Telefono" class="form-control" value="8888-7777" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">CORREO</label>
                <input type="text" name="Correo" class="form-control" value="@Session["Correo"]" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold" style="font-size: 12px;">DETALLE / OBSERVACIONES</label>
                <textarea name="Detalle" class="form-control" rows="4" placeholder="Escriba aquí el detalle de su solicitud..."></textarea>
            </div>

            <button type="submit" class="btn btn-cnfl">Enviar Solicitud</button>
        </div>
    }
</div>