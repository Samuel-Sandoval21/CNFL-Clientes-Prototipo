@{
    ViewBag.Title = "Trámites";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";

    var catalogo = ViewBag.Catalogo as List<CNFL_Clientes_Prototipo.Controllers.TramiteCatalogo> ?? new List<CNFL_Clientes_Prototipo.Controllers.TramiteCatalogo>();
    var historial = ViewBag.Historial as List<CNFL_Clientes_Prototipo.Controllers.TramiteResumen> ?? new List<CNFL_Clientes_Prototipo.Controllers.TramiteResumen>();

    var categorias = catalogo.Select(c => c.Categoria).Distinct().ToList();
}

@section Styles {
    <style>
        .tr-hero {
            background: linear-gradient(135deg, #2a4fd6, #4a7cff);
            border-radius: 22px;
            padding: 22px 20px;
            color: #fff;
            box-shadow: 0 12px 30px -12px rgba(42,79,214,.45);
            margin-top: 8px;
        }

            .tr-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .tr-hero p {
                margin: 6px 0 0;
                font-size: 12.5px;
                opacity: .9;
                line-height: 1.4;
            }

            .tr-hero .kpis {
                display: flex;
                gap: 20px;
                margin-top: 14px;
                padding-top: 14px;
                border-top: 1px solid rgba(255,255,255,.2);
            }

            .tr-hero .kpi-l {
                font-size: 11px;
                opacity: .8;
                font-weight: 800;
            }

            .tr-hero .kpi-v {
                font-size: 22px;
                font-weight: 800;
                margin-top: 2px;
            }

        .tr-cat {
            font-size: 14px;
            font-weight: 800;
            color: var(--ink);
            margin: 22px 0 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -.01em;
        }

            .tr-cat .cnt {
                background: #eef0ff;
                color: var(--blue);
                font-size: 11px;
                font-weight: 800;
                padding: 2px 8px;
                border-radius: 999px;
            }

        .tr-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .tr-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px 16px;
            box-shadow: var(--shadow-sm);
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: transform .15s, box-shadow .2s;
        }

            .tr-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 22px -10px rgba(16,20,60,.25);
                text-decoration: none;
                color: inherit;
            }

            .tr-card .ico {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 22px;
                background: #eef0ff;
                flex-shrink: 0;
            }

            .tr-card .body {
                flex: 1;
                min-width: 0;
            }

            .tr-card .t {
                font-size: 13px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .tr-card .s {
                font-size: 11.5px;
                color: var(--muted);
                line-height: 1.35;
                margin-top: 3px;
            }

            .tr-card .arrow {
                color: #c7cdd9;
                font-size: 18px;
            }

        .tr-hist {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 4px 0;
            box-shadow: var(--shadow-sm);
            margin-top: 10px;
        }

        .tr-hist-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            border-bottom: 1px solid var(--line);
        }

            .tr-hist-item:last-child {
                border-bottom: 0;
            }

            .tr-hist-item .l {
                font-size: 12.5px;
                font-weight: 700;
                color: var(--ink);
                flex: 1;
                min-width: 0;
            }

                .tr-hist-item .l small {
                    display: block;
                    font-size: 11px;
                    color: var(--muted);
                    font-weight: 500;
                    margin-top: 2px;
                }

            .tr-hist-item .r {
                font-size: 10.5px;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: 999px;
                flex-shrink: 0;
            }

                .tr-hist-item .r.pend {
                    background: #fef3e0;
                    color: #b9791a;
                }

                .tr-hist-item .r.ok {
                    background: #e9f7ec;
                    color: #2f8f3e;
                }

                .tr-hist-item .r.ing {
                    background: #eef0ff;
                    color: var(--blue);
                }

        .tr-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 16px;
            padding: 24px 20px;
            text-align: center;
            margin-top: 12px;
        }

            .tr-empty .e {
                font-size: 36px;
                margin-bottom: 8px;
            }

            .tr-empty .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
            }

            .tr-empty .s {
                font-size: 12px;
                color: var(--muted);
                margin-top: 4px;
            }

        .tr-ver-todos {
            display: block;
            text-align: center;
            margin-top: 12px;
            color: var(--blue);
            font-weight: 800;
            font-size: 13px;
            text-decoration: none;
        }

            .tr-ver-todos:hover {
                text-decoration: underline;
            }
    </style>
}

<div class="tr-hero">
    <h1 data-i18n="tramites.hero.title">📋 Trámites CNFL</h1>
    <p data-i18n="tramites.hero.subtitle">Realizá tus solicitudes en línea de forma rápida y segura.</p>
    <div class="kpis">
        <div>
            <div class="kpi-l" data-i18n="tramites.kpi.total">MIS TRÁMITES</div>
            <div class="kpi-v">@ViewBag.TotalTramites</div>
        </div>
        <div>
            <div class="kpi-l" data-i18n="tramites.kpi.pending">EN PROCESO</div>
            <div class="kpi-v">@ViewBag.TramitesPendientes</div>
        </div>
    </div>
</div>

@foreach (var cat in categorias)
{
    var items = catalogo.Where(c => c.Categoria == cat).ToList();
    <div class="tr-cat" data-cat-original="@cat">@cat <span class="cnt">@items.Count</span></div>
    <div class="tr-grid">
        @foreach (var t in items)
        {
            <a href="@Url.Action("Detalle", "Tramites", new { id = t.Id })" class="tr-card">
                <div class="ico">@t.Icono</div>
                <div class="body">
                    <div class="t">@t.Nombre</div>
                    <div class="s">@t.Descripcion</div>
                </div>
                <div class="arrow">›</div>
            </a>
        }
    </div>
}

@if (historial.Any())
{
    <div class="tr-cat" data-i18n="tramites.recent">🕒 Mis trámites recientes</div>
    <div class="tr-hist">
        @foreach (var t in historial)
        {
            var clase = t.Estado == "Resuelto" ? "ok"
                      : t.Estado == "En proceso" ? "ing"
                      : "pend";
            <div class="tr-hist-item">
                <div class="l">
                    @t.Tipo
                    <small>@t.NumeroReferencia · @t.FechaSolicitud.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="r @clase">@t.Estado</div>
            </div>
        }
    </div>
    <a href="@Url.Action("MisTramites", "Tramites")" class="tr-ver-todos" data-i18n="tramites.seeAll">
        Ver todos mis trámites →
    </a>
}
else
{
    <div class="tr-empty">
        <div class="e">📭</div>
        <div class="t" data-i18n="tramites.empty.title">Sin trámites registrados</div>
        <div class="s" data-i18n="tramites.empty.sub">Cuando solicites un trámite, aparecerá acá con su número de referencia.</div>
    </div>
}