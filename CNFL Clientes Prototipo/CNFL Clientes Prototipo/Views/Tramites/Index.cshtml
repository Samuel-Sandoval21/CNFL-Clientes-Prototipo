@model List<CNFL_Clientes_Prototipo.Models.Tramite>
@{
    ViewBag.Title = "Trámites";
}

<div class="section-pad">
    <div class="h-name" style="font-size: 22px;">Trámites</div>
    <div style="font-size: 13px; color: var(--muted); margin-top: 2px;">16 solicitudes en línea, sin filas.</div>
</div>

<div class="section-pad">
    <div class="eyebrow">Mis trámites activos</div>

    @foreach (var t in Model)
    {
        string claseEstado = "bg-secondary";
        string tituloEstado = "En proceso";
        string progreso = "50%";

        if (t.Estado == "Iniciado") { claseEstado = "bg-primary"; tituloEstado = "Iniciado"; progreso = "25%"; }
        if (t.Estado == "En proceso") { claseEstado = "bg-warning text-dark"; tituloEstado = "En proceso"; progreso = "50%"; }
        if (t.Estado == "Resuelto") { claseEstado = "bg-success"; tituloEstado = "Resuelto"; progreso = "100%"; }

        <div class="card" style="background:#fff; border-radius:20px; box-shadow: var(--shadow); padding:18px; margin-bottom: 15px;">
            <div style="font-weight:700; font-size:13.5px;">@t.Nombre</div>
            <div style="font-size:11.5px; color:var(--muted); margin-top:3px;">@t.Descripcion</div>

            <!-- Barra de progreso -->
            <div class="progress" style="height: 8px; margin-top: 15px;">
                <div class="progress-bar @claseEstado" style="width: @progreso"></div>
            </div>
            <small style="font-size: 11px; color: var(--muted); display:block; margin-top: 5px;">Estado: @tituloEstado</small>
        </div>
    }
</div>

<div class="section-pad">
    <div class="eyebrow">Catálogo de trámites</div>
    <div class="rows">
        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Cambio de nombre de abonado'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Cambio de nombre de abonado</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>

        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Desconexión y reconexión'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Desconexión y reconexión</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>

        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Solicitud de servicio nuevo'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Solicitud de servicio nuevo</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>

        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Traslado de medidor'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Traslado de medidor</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>

        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Traspaso de servicio eléctrico'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Traspaso de servicio eléctrico</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>

        <div class="row-item" onclick="window.location='/Tramites/Formulario?tipo=Reclamo por daños (Resp. Civil)'">
            <div class="ic" style="width:40px; height:40px; border-radius:12px; background:#eef6ff; display:grid; place-items:center; flex:none;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg></div>
            <div style="flex:1;"><div style="font-weight:700; font-size:13.5px;">Reclamo por daños (Resp. Civil)</div></div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
        </div>
    </div>
</div>

<style>
    .row-item {
        display: flex;
        align-items: center;
        gap: 13px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 14px;
        cursor: pointer;
        transition: .15s;
        margin-bottom: 10px;
    }

    .chev {
        color: #c3c8d4;
        flex: none;
    }
</style>