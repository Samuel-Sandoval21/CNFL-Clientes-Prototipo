@{
    ViewBag.Title = "Notificaciones";
}

<!-- Botón Volver -->
<div style="display: flex; align-items: center; gap: 10px; padding: 10px 20px; cursor: pointer;" onclick="history.back()">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    <span style="font-weight: 800; font-size: 16px;">Volver</span>
</div>

<div class="section-pad">
    <div class="h-name" style="font-size: 22px;">Alertas</div>
</div>

<div class="section-pad">
    <div class="card" style="border-left: 4px solid var(--red); padding: 15px; margin-bottom: 10px; background: #fff; border-radius: 16px;">
        <div style="display: flex; gap: 11px; align-items: flex-start;">
            <div class="ic" style="width: 38px; height: 38px; border-radius: 11px; background: #fdeaea; display: grid; place-items: center;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg>
            </div>
            <div>
                <div style="font-weight: 800; font-size: 13.5px;">Avería · NISE 9950</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">En atención · estimado 4:30pm</div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid var(--amber); padding: 15px; margin-bottom: 10px; background: #fff; border-radius: 16px;">
        <div style="display: flex; gap: 11px; align-items: flex-start;">
            <div class="ic" style="width: 38px; height: 38px; border-radius: 11px; background: #fef3e0; display: grid; place-items: center;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 2v4M16 2v4M3 10h18" /></svg>
            </div>
            <div>
                <div style="font-weight: 800; font-size: 13.5px;">Suspensión programada</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">NISE 7788 · mañana 8:00–10:00am</div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid var(--orange); padding: 15px; margin-bottom: 10px; background: #fff; border-radius: 16px;">
        <div style="display: flex; gap: 11px; align-items: flex-start;">
            <div class="ic" style="width: 38px; height: 38px; border-radius: 11px; background: #fff3ec; display: grid; place-items: center;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
            </div>
            <div>
                <div style="font-weight: 800; font-size: 13.5px;">Factura por vencer</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">₡18.450 · vence en 5 días</div>
            </div>
        </div>
    </div>

    <div class="card" style="border-left: 4px solid var(--sky); padding: 15px; margin-bottom: 10px; background: #fff; border-radius: 16px;">
        <div style="display: flex; gap: 11px; align-items: flex-start;">
            <div class="ic" style="width: 38px; height: 38px; border-radius: 11px; background: #eef6ff; display: grid; place-items: center;">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--sky)" stroke-width="2"><path d="M13 2 3 14h7l-1 8 10-12h-7z" /></svg>
            </div>
            <div>
                <div style="font-weight: 800; font-size: 13.5px;">Evento de voltaje</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">Voltaje fuera de rango · NISE 4021</div>
            </div>
        </div>
    </div>
</div>