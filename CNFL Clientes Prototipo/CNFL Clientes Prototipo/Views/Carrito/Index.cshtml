@model List<CNFL_Clientes_Prototipo.Models.CarritoItem>
@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
    var subtotal = (decimal)ViewBag.Subtotal;
    var impuesto = (decimal)ViewBag.Impuesto;
    var total = (decimal)ViewBag.Total;
}

@section Styles {
    <style>
        .ct-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 700;
            color: var(--blue);
            text-decoration: none;
            margin-bottom: 14px;
        }

            .ct-back:hover {
                text-decoration: underline;
            }

        .ct-hero {
            background: linear-gradient(135deg, var(--orange), #ff8a5c);
            border-radius: 22px;
            padding: 20px;
            color: #fff;
            margin-top: 8px;
            box-shadow: 0 12px 30px -12px rgba(255,105,45,.5);
            position: relative;
            overflow: hidden;
        }

            .ct-hero::after {
                content: "";
                position: absolute;
                right: -50px;
                top: -50px;
                width: 160px;
                height: 160px;
                background: radial-gradient(circle, rgba(255,255,255,.2), transparent 70%);
            }

            .ct-hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.02em;
            }

            .ct-hero .sub {
                font-size: 12.5px;
                opacity: .9;
                margin-top: 4px;
            }

        .ct-empty {
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: 18px;
            padding: 40px 20px;
            text-align: center;
            margin-top: 16px;
        }

            .ct-empty .e {
                font-size: 48px;
                margin-bottom: 10px;
            }

            .ct-empty .t {
                font-size: 15px;
                font-weight: 800;
                color: var(--ink);
            }

            .ct-empty .s {
                font-size: 12.5px;
                color: var(--muted);
                margin-top: 5px;
                line-height: 1.5;
            }

            .ct-empty .btn {
                display: inline-block;
                margin-top: 16px;
                background: var(--blue);
                color: #fff;
                text-decoration: none;
                font-weight: 800;
                font-size: 13px;
                padding: 12px 22px;
                border-radius: 12px;
            }

        .ct-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .ct-item {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 14px;
            display: flex;
            gap: 12px;
            box-shadow: var(--shadow-sm);
            position: relative;
        }

            .ct-item .img {
                width: 60px;
                height: 60px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                font-size: 26px;
                background: #eef0ff;
                flex-shrink: 0;
            }

            .ct-item .body {
                flex: 1;
                min-width: 0;
            }

            .ct-item .t {
                font-size: 13.5px;
                font-weight: 800;
                color: var(--ink);
                line-height: 1.25;
            }

            .ct-item .s {
                font-size: 11px;
                color: var(--muted);
                margin-top: 2px;
            }

            .ct-item .price {
                font-size: 14px;
                font-weight: 800;
                color: var(--blue);
                margin-top: 6px;
            }

            .ct-item .qty {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 8px;
            }

                .ct-item .qty button {
                    width: 26px;
                    height: 26px;
                    border-radius: 8px;
                    background: #f4f6fb;
                    border: 0;
                    font-family: inherit;
                    font-weight: 800;
                    font-size: 14px;
                    cursor: pointer;
                    color: var(--ink);
                }

                    .ct-item .qty button:active {
                        transform: scale(.9);
                    }

                .ct-item .qty span {
                    font-size: 13px;
                    font-weight: 800;
                    min-width: 20px;
                    text-align: center;
                }

            .ct-item .delete {
                position: absolute;
                top: 12px;
                right: 12px;
                background: none;
                border: 0;
                cursor: pointer;
                color: #d33;
                font-size: 18px;
                padding: 4px;
            }

        .ct-summary {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 18px;
            margin-top: 18px;
            box-shadow: var(--shadow-sm);
        }

            .ct-summary .row {
                display: flex;
                justify-content: space-between;
                font-size: 13px;
                color: var(--muted);
                padding: 6px 0;
            }

                .ct-summary .row b {
                    color: var(--ink);
                }

            .ct-summary .total {
                display: flex;
                justify-content: space-between;
                font-size: 17px;
                font-weight: 800;
                color: var(--ink);
                padding-top: 12px;
                margin-top: 6px;
                border-top: 1px solid var(--line);
            }

                .ct-summary .total .v {
                    color: var(--blue);
                }

        .ct-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background: linear-gradient(135deg, var(--blue), #2a4fd6);
            color: #fff;
            border: 0;
            font-family: inherit;
            font-weight: 800;
            font-size: 14px;
            padding: 16px;
            border-radius: 14px;
            margin-top: 16px;
            margin-bottom: 24px;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 8px 18px -8px rgba(30,35,230,.6);
            transition: transform .12s;
        }

            .ct-cta:hover {
                color: #fff;
                text-decoration: none;
                transform: scale(.98);
            }
    </style>
}

<a href="@Url.Action("MiPerfil", "Clientes")" class="ct-back">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
    Volver al perfil
</a>

<div class="ct-hero">
    <h1>🛒 Mi carrito</h1>
    <div class="sub">Revisá tus productos antes de pagar</div>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="ct-empty">
        <div class="e">🛒</div>
        <div class="t">Tu carrito está vacío</div>
        <div class="s">Agregá productos desde la Tienda CNFL y aparecerán acá.</div>
        <a href="@Url.Action("Tienda", "Clientes")" class="btn">Ir a la tienda</a>
    </div>
}
else
{
    <div class="ct-list">
        @foreach (var item in Model)
        {
            <div class="ct-item">
                <div class="img">@(string.IsNullOrEmpty(item.Imagen) ? "🛍️" : item.Imagen)</div>
                <div class="body">
                    <div class="t">@item.Nombre</div>
                    <div class="s">@item.Descripcion</div>
                    <div class="price">₡@item.Precio.ToString("N0")</div>
                    <div class="qty">
                        <button type="button" onclick="cambiarCantidad(@item.CarritoItemId, @(item.Cantidad - 1))">−</button>
                        <span id="qty-@item.CarritoItemId">@item.Cantidad</span>
                        <button type="button" onclick="cambiarCantidad(@item.CarritoItemId, @(item.Cantidad + 1))">+</button>
                    </div>
                </div>
                <button type="button" class="delete" onclick="eliminarItem(@item.CarritoItemId)" title="Eliminar">🗑️</button>
            </div>
        }
    </div>

    <div class="ct-summary">
        <div class="row"><span>Subtotal</span><b id="subtotal">₡@subtotal.ToString("N0")</b></div>
        <div class="row"><span>IVA (13%)</span><b id="impuesto">₡@impuesto.ToString("N0")</b></div>
        <div class="total"><span>Total</span><span class="v" id="total">₡@total.ToString("N0")</span></div>
    </div>

    <a href="@Url.Action("Checkout", "Pagos")" class="ct-cta">💳 Proceder al pago</a>
}

@section Scripts {
    <script>
        function cambiarCantidad(itemId, cantidad) {
            fetch('@Url.Action("ActualizarCantidad", "Carrito")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'itemId=' + itemId + '&cantidad=' + cantidad
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    if (cantidad <= 0) { location.reload(); return; }
                    var qtyEl = document.getElementById('qty-' + itemId);
                    if (qtyEl) qtyEl.textContent = cantidad;
                    document.getElementById('subtotal').textContent = '₡' + data.subtotal.toLocaleString('es-CR');
                    document.getElementById('impuesto').textContent = '₡' + data.impuesto.toLocaleString('es-CR');
                    document.getElementById('total').textContent = '₡' + data.total.toLocaleString('es-CR');
                }
            });
        }
        function eliminarItem(itemId) {
            if (!confirm('¿Quitar este producto del carrito?')) return;
            fetch('@Url.Action("Eliminar", "Carrito")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'itemId=' + itemId
            })
            .then(function (r) { return r.json(); })
            .then(function (data) { if (data.success) location.reload(); });
        }
    </script>
}