@* ============================================================
    Logo de CNFL incrustado en base64.
    Se usa con @Html.Partial("_LogoCNFL", "clase-css-opcional")
    para no depender de una ruta de archivo estatico que a veces
    no resuelve bien en el prototipo (wwwroot / Content / etc.).
    ============================================================ *@
@model string
<img src="data:image/png;base64," alt="CNFL" class="@Model" />
