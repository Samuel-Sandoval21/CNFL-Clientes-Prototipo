<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CNFL - @ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
</head>
<body>

    <header class="header-publico">
        <div class="header-container">
            <img src="~/images/logo-cnfl.png" alt="CNFL" class="logo" />
            <div class="header-links">
                <a href="@Url.Action("Login", "Cuenta")" class="btn-login">Iniciar Sesión</a>
                <a href="@Url.Action("Registro", "Cuenta")" class="btn-register">Registrarse</a>
            </div>
        </div>
    </header>

    <main class="main-content" role="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer">
        <div class="container footer-container">
            <p class="footer-text">CNFL · @DateTime.Now.Year · www.cnfl.go.cr</p>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

</body>
</html>