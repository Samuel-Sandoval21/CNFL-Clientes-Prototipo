<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>CNFL - App Móvil</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="@Url.Content("~/Content/cliente/layout.css")" />
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

    <div class="phone-frame">
        <div class="phone-notch"></div>

        <header class="status-bar">
            <span class="time" id="statusTime">10:44</span>
            <div class="status-icons">
                <svg width="17" height="12" viewBox="0 0 17 12" fill="none">
                    <rect x="0" y="7" width="3" height="5" rx="1" fill="#0E1116" />
                    <rect x="4.5" y="4" width="3" height="8" rx="1" fill="#0E1116" />
                    <rect x="9" y="2" width="3" height="10" rx="1" fill="#0E1116" />
                    <rect x="13.5" y="0" width="3" height="12" rx="1" fill="#0E1116" opacity=".3" />
                </svg>
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
                    <path d="M8 2.5C10.5 2.5 12.7 3.5 14.3 5.1L15.7 3.6C13.7 1.6 11 .5 8 .5S2.3 1.6.3 3.6l1.4 1.5C3.3 3.5 5.5 2.5 8 2.5Z" fill="#0E1116" />
                    <path d="M8 6.5c1.1 0 2.1.4 2.8 1.2l1.4-1.5C11.1 5.1 9.6 4.5 8 4.5s-3.1.6-4.2 1.7l1.4 1.5C5.9 6.9 6.9 6.5 8 6.5Z" fill="#0E1116" />
                    <circle cx="8" cy="10" r="1.6" fill="#0E1116" />
                </svg>
                <svg width="26" height="12" viewBox="0 0 26 12" fill="none">
                    <rect x="1" y="1" width="21" height="10" rx="2.5" stroke="#0E1116" opacity=".4" />
                    <rect x="2.5" y="2.5" width="16" height="7" rx="1.2" fill="#0E1116" />
                    <rect x="23" y="4" width="2" height="4" rx="1" fill="#0E1116" opacity=".4" />
                </svg>
            </div>
        </header>

        <div class="phone-content" id="phoneContent">

            <div class="app-header">
                <div class="brand">
                    <svg width="44" height="44" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="25" cy="25" r="22" stroke="#1E23E6" stroke-width="2.5" />
                        <path d="M25 10L12 28H20L14 42L34 22H26L30 10Z" fill="#1E23E6" />
                    </svg>
                    <span class="brand-text">cnfl</span>
                </div>

                <div class="langbar" id="langbar">
                    <button data-lang="es" class="active" onclick="cambiarIdioma('es')">ES</button>
                    <button data-lang="en" onclick="cambiarIdioma('en')">EN</button>
                </div>

                <div style="display:flex; gap:8px;">
                    <div class="icon-btn" onclick="window.location.href='/Clientes/Notificaciones'">
                        <i class="fas fa-bell" style="font-size:18px; color:var(--ink);"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="icon-btn" onclick="window.location.href='/Clientes/Perfil'">
                        <i class="fas fa-user" style="font-size:18px; color:var(--ink);"></i>
                    </div>
                </div>
            </div>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>

        <!-- ===== MENÚ INFERIOR - CLIENTE (SIN SALIR COMO TAB) ===== -->
        <nav class="bottom-nav" id="bottomNav">
            @if (Session["Rol"] != null)
            {
                <!-- Usuario logueado - Menú completo -->
                <a href="@Url.Action("Index", "Home")" class="tab" data-seccion="inicio">
                    <i class="fas fa-home"></i>
                    <span data-i18n="menu_inicio">Inicio</span>
                </a>

                <a href="@Url.Action("Tramites", "Clientes")" class="tab" data-seccion="tramites">
                    <i class="fas fa-file-alt"></i>
                    <span data-i18n="menu_tramites">Trámites</span>
                </a>

                <a href="@Url.Action("Pagos", "Clientes")" class="tab" data-seccion="pagos">
                    <i class="fas fa-credit-card"></i>
                    <span data-i18n="menu_pagos">Pagos</span>
                </a>

                <a href="@Url.Action("Tienda", "Clientes")" class="tab center" data-seccion="tienda">
                    <div class="fab">
                        <i class="fas fa-store"></i>
                    </div>
                    <span data-i18n="menu_tienda">Tienda</span>
                </a>

                <a href="@Url.Action("Reportes", "Clientes")" class="tab" data-seccion="reportes">
                    <i class="fas fa-map-marked-alt"></i>
                    <span data-i18n="menu_reportes">Reportes</span>
                </a>

                <!-- ========================================================== -->
                <!-- CUENTA (donde está Cerrar Sesión dentro del perfil) -->
                <!-- ========================================================== -->
                <a href="@Url.Action("Perfil", "Clientes")" class="tab" data-seccion="perfil">
                    <i class="fas fa-user-circle"></i>
                    <span data-i18n="menu_cuenta">Cuenta</span>
                </a>
            }
            else
            {
                <!-- Visitante - Menú público -->
                <a href="@Url.Action("Index", "Home")" class="tab" data-seccion="inicio">
                    <i class="fas fa-home"></i>
                    <span data-i18n="menu_inicio">Inicio</span>
                </a>

                <a href="@Url.Action("Login", "Cuenta")" class="tab center" data-seccion="perfil">
                    <div class="fab">
                        <i class="fas fa-user"></i>
                    </div>
                    <span data-i18n="menu_cuenta">Cuenta</span>
                </a>
            }
        </nav>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script src="@Url.Content("~/Scripts/cliente/idiomas.js")"></script>
    <script src="@Url.Content("~/Scripts/cliente/layout.js")"></script>

    @RenderSection("scriptsVista", required: false)

</body>
</html>