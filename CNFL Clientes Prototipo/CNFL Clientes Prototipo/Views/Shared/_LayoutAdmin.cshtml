<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title - CNFL Admin</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        /* ═══════════ TIPOGRAFÍA OFICIAL CNFL ═══════════ */
        @@font-face {
            font-family: 'AvenirNextLPro';
            src: url('/Content/fonts/AvenirNextLTPro-Regular.otf') format('opentype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'AvenirNextLPro';
            src: url('/Content/fonts/AvenirNextLTPro-Medium.otf') format('opentype');
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'AvenirNextLPro';
            src: url('/Content/fonts/AvenirNextLTPro-Bold.otf') format('opentype');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'AvenirNextLPro';
            src: url('/Content/fonts/AvenirNextLTPro-Bold.otf') format('opentype');
            font-weight: 800;
            font-style: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'AvenirNextLPro';
            src: url('/Content/fonts/AvenirNextLTPro-Bold.otf') format('opentype');
            font-weight: 900;
            font-style: normal;
            font-display: swap;
        }

        :root {
            --blue: #1a2b6b;
            --blue-light: #2b3f8f;
            --blue-soft: #eef0ff;
            --purple: #5b3fbf;
            --purple-soft: #efe6ff;
            --gold: #c98a00;
            --gold-soft: #fff4d9;
            --green: #00a651;
            --green-soft: #e0f7e9;
            --red: #e53935;
            --red-soft: #ffe6e6;
            --orange: #ff692d;
            --line: #e3e6ee;
            --text: #1c1f2b;
            --muted: #6b7280;
            --bg: #f4f6fb;
            --white: #ffffff;
            --radius: 18px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'AvenirNextLPro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #e8ecf5;
            color: var(--text);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .phone-frame {
            width: 390px;
            height: 844px;
            max-height: 96vh;
            background: #0a0a0a;
            border-radius: 54px;
            padding: 14px;
            box-shadow: 0 0 0 3px #2a2a2a, 0 0 0 4px #3a3a3a, 0 30px 80px -20px rgba(0, 0, 0, .55), 0 0 100px -30px rgba(26, 43, 107, .3);
            position: relative;
            flex-shrink: 0;
        }

        .phone-notch {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            width: 110px;
            height: 30px;
            background: #0a0a0a;
            border-radius: 20px;
            z-index: 10;
        }

        .phone-screen {
            width: 100%;
            height: 100%;
            background: #f4f6fb;
            border-radius: 42px;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .status-bar {
            height: 48px;
            padding: 0 30px 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 700;
            color: #1c1f2b;
            flex-shrink: 0;
            background: #f4f6fb;
        }

            .status-bar .right {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 12px;
            }

        .app-header {
            padding: 4px 22px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-shrink: 0;
            background: #f4f6fb;
        }

            .app-header .logo-wrap {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .app-header .logo-wrap img {
                    height: 30px;
                    width: auto;
                }

        .admin-tag {
            font-size: 9px;
            font-weight: 800;
            background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
            color: #fff;
            padding: 3px 9px;
            border-radius: 8px;
            text-transform: uppercase;
            letter-spacing: .6px;
            box-shadow: 0 4px 10px -4px rgba(91, 63, 191, .5);
        }

        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 6px 20px 24px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .app-content::-webkit-scrollbar {
                display: none;
            }

        .bottom-nav {
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 8px 4px 12px;
            background: #fff;
            border-top: 1px solid var(--line);
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            flex: 1;
            padding: 6px 2px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 600;
            transition: color .18s ease, transform .18s ease;
            cursor: pointer;
            text-align: center;
            line-height: 1.1;
            position: relative;
        }

            .nav-item i {
                font-size: 19px;
                margin-bottom: 1px;
                transition: transform .2s ease;
            }

            .nav-item.active {
                color: var(--blue);
                font-weight: 800;
            }

                .nav-item.active i {
                    transform: scale(1.1);
                }

                .nav-item.active::before {
                    content: '';
                    position: absolute;
                    top: 2px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 24px;
                    height: 3px;
                    background: linear-gradient(90deg, #1a2b6b, #5b3fbf);
                    border-radius: 3px;
                }

        .page-title {
            font-size: 22px;
            font-weight: 900;
            color: var(--blue);
            margin: 4px 0 6px;
            letter-spacing: -.3px;
        }

        .page-subtitle {
            font-size: 12.5px;
            color: var(--muted);
            margin: 0 0 16px;
            line-height: 1.4;
        }

        .card {
            background: #fff;
            border-radius: 18px;
            padding: 16px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            margin-bottom: 14px;
        }

        .empty {
            text-align: center;
            padding: 48px 20px;
            color: var(--muted);
            font-size: 13px;
        }

            .empty i {
                font-size: 42px;
                color: #c9ced9;
                margin-bottom: 14px;
                display: block;
            }

        .badge {
            font-size: 10.5px;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 10px;
            white-space: nowrap;
            display: inline-block;
        }

            .badge.ok {
                background: var(--green-soft);
                color: var(--green);
            }

            .badge.warn {
                background: var(--red-soft);
                color: var(--red);
            }

            .badge.info {
                background: var(--blue-soft);
                color: var(--blue);
            }

            .badge.gold {
                background: var(--gold-soft);
                color: var(--gold);
            }

            .badge.gray {
                background: #eef0f5;
                color: var(--muted);
            }

        .filtros {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            margin-bottom: 16px;
            padding-bottom: 6px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .filtros::-webkit-scrollbar {
                display: none;
            }

        .filtro {
            padding: 9px 16px;
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: 22px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            white-space: nowrap;
            cursor: pointer;
            flex-shrink: 0;
            transition: all .18s;
            text-decoration: none;
        }

            .filtro:hover {
                border-color: #c9ced9;
            }

            .filtro.active {
                background: linear-gradient(135deg, #1a2b6b, #5b3fbf);
                color: #fff;
                border-color: transparent;
                box-shadow: 0 6px 14px -6px rgba(26, 43, 107, .5);
            }

        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }

            .stats-row.two {
                grid-template-columns: 1fr 1fr;
            }

        .stat-mini {
            background: #fff;
            border-radius: 14px;
            padding: 12px 10px;
            box-shadow: 0 4px 20px rgba(20, 30, 70, .06);
            text-align: center;
        }

            .stat-mini .num {
                font-size: 20px;
                font-weight: 900;
                line-height: 1;
                color: var(--text);
            }

            .stat-mini .lbl {
                font-size: 9.5px;
                color: var(--muted);
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .4px;
                margin-top: 5px;
            }

            .stat-mini.blue .num {
                color: var(--blue);
            }

            .stat-mini.purple .num {
                color: var(--purple);
            }

            .stat-mini.gold .num {
                color: var(--gold);
            }

            .stat-mini.green .num {
                color: var(--green);
            }

            .stat-mini.red .num {
                color: var(--red);
            }

        @@media (max-width: 520px) {
            html, body {
                display: block;
            }

            .phone-frame {
                width: 100%;
                height: 100vh;
                max-height: none;
                border-radius: 0;
                padding: 0;
                box-shadow: none;
            }

            .phone-notch {
                display: none;
            }

            .phone-screen {
                border-radius: 0;
            }

            .status-bar {
                display: none;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="phone-frame">
        <div class="phone-notch"></div>

        <div class="phone-screen">

            <div class="status-bar">
                <span id="statusHora">9:41</span>
                <div class="right">
                    <i class="fas fa-signal"></i>
                    <i class="fas fa-wifi"></i>
                    <i class="fas fa-battery-three-quarters"></i>
                </div>
            </div>

            <div class="app-header">
                <div class="logo-wrap">
                    <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
                         onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
                    <span class="admin-tag">Admin</span>
                </div>
                <!-- ═══ Header sin botones (Configuración y Alertas eliminados) ═══ -->
            </div>

            <main class="app-content">
                @RenderBody()
            </main>

            @{
                var accionActual = (ViewContext.RouteData.Values["action"] ?? "").ToString();
                var controladorActual = (ViewContext.RouteData.Values["controller"] ?? "").ToString();

                Func<string, string, string> activo = (ctrl, acc) =>
                    (controladorActual.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
                     && accionActual.Equals(acc, StringComparison.OrdinalIgnoreCase))
                        ? "nav-item active" : "nav-item";
            }

            <nav class="bottom-nav">
                <a href="@Url.Action("Dashboard", "Admin")" class="@activo("Admin", "Dashboard")">
                    <i class="fas fa-th-large"></i>
                    <span>Inicio</span>
                </a>
                <a href="@Url.Action("Clientes", "Admin")" class="@activo("Admin", "Clientes")">
                    <i class="fas fa-users"></i>
                    <span>Clientes</span>
                </a>
                <a href="@Url.Action("Index", "AdminNotificaciones")" class="@activo("AdminNotificaciones", "Index")">
                    <i class="fas fa-bullhorn"></i>
                    <span>Notificar</span>
                </a>
                <a href="@Url.Action("Reportes", "Admin")" class="@activo("Admin", "Reportes")">
                    <i class="fas fa-chart-line"></i>
                    <span>Reportes</span>
                </a>
                <a href="@Url.Action("Cuenta", "Admin")" class="@activo("Admin", "Cuenta")">
                    <i class="fas fa-user"></i>
                    <span>Cuenta</span>
                </a>
            </nav>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var el = document.getElementById('statusHora');
            if (el) {
                var d = new Date();
                var h = d.getHours();
                var m = d.getMinutes().toString().padStart(2, '0');
                el.textContent = h + ':' + m;
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>