<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title - CNFL Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --blue: #1a2b6b;
            --blue-light: #2b3f8f;
            --blue-soft: #eef0ff;
            --green: #00a651;
            --red: #e53935;
            --orange: #ff692d;
            --line: #e3e6ee;
            --text: #1c1f2b;
            --muted: #6b7280;
            --bg: #e8ecf5;
            --white: #ffffff;
            --radius: 18px;
            --shadow: 0 4px 20px rgba(20, 30, 70, .06);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ═══════════ MARCO DE CELULAR ═══════════ */
        .phone-frame {
            width: 390px;
            height: 844px;
            max-height: 96vh;
            background: #0a0a0a;
            border-radius: 54px;
            padding: 14px;
            box-shadow: 0 0 0 3px #2a2a2a, 0 0 0 4px #3a3a3a, 0 30px 80px -20px rgba(0, 0, 0, .55), 0 0 100px -30px rgba(26, 43, 107, .3);
            position: relative;
            flex-shrink: 0;
        }

        .phone-notch {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            width: 110px;
            height: 30px;
            background: #0a0a0a;
            border-radius: 20px;
            z-index: 10;
        }

        .phone-screen {
            width: 100%;
            height: 100%;
            background: #f4f6fb;
            border-radius: 42px;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        /* ── Barra de estado iOS ─────────────────── */
        .status-bar {
            height: 48px;
            padding: 0 30px 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 700;
            color: #1c1f2b;
            flex-shrink: 0;
            background: #f4f6fb;
        }

            .status-bar .right {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 12px;
            }

        /* ── Header con íconos ────────────────────── */
        .app-header {
            padding: 4px 22px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-shrink: 0;
            background: #f4f6fb;
        }

            .app-header .logo-wrap {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .app-header .logo-wrap img {
                    height: 30px;
                    width: auto;
                }

        .admin-tag {
            font-size: 9px;
            font-weight: 800;
            background: #1a2b6b;
            color: #fff;
            padding: 3px 8px;
            border-radius: 8px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .header-icons {
            display: flex;
            gap: 8px;
        }

        .header-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: #fff;
            border: 1px solid #e3e6ee;
            color: #1c1f2b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            cursor: pointer;
            position: relative;
            transition: transform .15s, background .15s;
            text-decoration: none;
        }

            .header-icon-btn:active {
                transform: scale(.92);
            }

            .header-icon-btn:hover {
                background: #eef0ff;
            }

            .header-icon-btn .dot {
                position: absolute;
                top: 7px;
                right: 7px;
                width: 8px;
                height: 8px;
                background: #ff692d;
                border-radius: 50%;
                border: 2px solid #fff;
            }

        /* ── Contenido scrollable ─────────────────── */
        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 6px 20px 24px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .app-content::-webkit-scrollbar {
                display: none;
            }

        /* ── Bottom nav ───────────────────────────── */
        .bottom-nav {
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 8px 4px 12px;
            background: #fff;
            border-top: 1px solid var(--line);
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            flex: 1;
            padding: 6px 2px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 600;
            transition: color .18s ease;
            cursor: pointer;
            text-align: center;
            line-height: 1.1;
        }

            .nav-item i {
                font-size: 19px;
                margin-bottom: 1px;
            }

            .nav-item.active {
                color: var(--blue);
                font-weight: 800;
            }

        /* ── Componentes comunes ─────────────────── */
        .card {
            background: #fff;
            border-radius: var(--radius);
            padding: 16px;
            box-shadow: var(--shadow);
            margin-bottom: 14px;
        }

        .page-title {
            font-size: 22px;
            font-weight: 800;
            color: var(--blue);
            margin: 4px 0 16px;
        }

        .empty {
            text-align: center;
            padding: 40px 20px;
            color: var(--muted);
            font-size: 13px;
        }

        .badge {
            font-size: 10.5px;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 10px;
            white-space: nowrap;
            display: inline-block;
        }

            .badge.ok {
                background: #e0f7e9;
                color: #00a651;
            }

            .badge.warn {
                background: #ffe6e6;
                color: #e53935;
            }

            .badge.info {
                background: #e6ecff;
                color: #1a2b6b;
            }

            .badge.gray {
                background: #eef0f5;
                color: #6b7280;
            }

        /* ── Responsive: en celular real, sin marco ─ */
        @@media (max-width: 520px) {
            html, body {
                display: block;
            }

            .phone-frame {
                width: 100%;
                height: 100vh;
                max-height: none;
                border-radius: 0;
                padding: 0;
                box-shadow: none;
            }

            .phone-notch {
                display: none;
            }

            .phone-screen {
                border-radius: 0;
            }

            .status-bar {
                display: none;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <div class="phone-frame">
        <div class="phone-notch"></div>
        <div class="phone-screen">

            <!-- Barra de estado iOS -->
            <div class="status-bar">
                <span id="statusHora">9:41</span>
                <div class="right">
                    <i class="fas fa-signal"></i>
                    <i class="fas fa-wifi"></i>
                    <i class="fas fa-battery-three-quarters"></i>
                </div>
            </div>

            <!-- Header -->
            <div class="app-header">
                <div class="logo-wrap">
                    <img src="~/Content/img/logo-cnfl.png" alt="CNFL"
                         onerror="this.onerror=null; this.src='/Content/img/logo-cnfl.jpg';" />
                    <span class="admin-tag">Admin</span>
                </div>
                <div class="header-icons">
                    <a href="@Url.Action("Configuracion", "Admin")" class="header-icon-btn" title="Configuración">
                        <i class="fas fa-cog"></i>
                    </a>
                    <a href="@Url.Action("Alertas", "Admin")" class="header-icon-btn" title="Alertas">
                        <i class="fas fa-bell"></i>
                        <span class="dot"></span>
                    </a>
                </div>
            </div>

            <!-- Contenido -->
            <main class="app-content">
                @RenderBody()
            </main>

            <!-- Menú inferior (6 items: Inicio, Clientes, Averías, Trámites, Reportes, Cuenta) -->
            @{
                var accionActual = (ViewContext.RouteData.Values["action"] ?? "").ToString();
                Func<string, string> activo = (acc) =>
                    accionActual.Equals(acc, StringComparison.OrdinalIgnoreCase)
                        ? "nav-item active" : "nav-item";
            }

            <nav class="bottom-nav">
                <a href="@Url.Action("Dashboard", "Admin")" class="@activo("Dashboard")">
                    <i class="fas fa-th-large"></i>
                    <span>Inicio</span>
                </a>
                <a href="@Url.Action("Clientes", "Admin")" class="@activo("Clientes")">
                    <i class="fas fa-users"></i>
                    <span>Clientes</span>
                </a>
                <a href="@Url.Action("Averias", "Admin")" class="@activo("Averias")">
                    <i class="fas fa-bolt"></i>
                    <span>Averías</span>
                </a>
                <a href="@Url.Action("Tramites", "Admin")" class="@activo("Tramites")">
                    <i class="fas fa-file-alt"></i>
                    <span>Trámites</span>
                </a>
                <a href="@Url.Action("Reportes", "Admin")" class="@activo("Reportes")">
                    <i class="fas fa-chart-line"></i>
                    <span>Reportes</span>
                </a>
                <a href="@Url.Action("Cuenta", "Admin")" class="@activo("Cuenta")">
                    <i class="fas fa-user"></i>
                    <span>Cuenta</span>
                </a>
            </nav>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var el = document.getElementById('statusHora');
            if (el) {
                var d = new Date();
                var h = d.getHours();
                var m = d.getMinutes().toString().padStart(2, '0');
                el.textContent = h + ':' + m;
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>