<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title - CNFL Admin</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="@Url.Content("~/Content/admin-layout.css")" />
    @Scripts.Render("~/bundles/modernizr")
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 50 50'><text y='32' font-size='32'>⚡</text></svg>">
</head>
<body>
    <div class="app-container">

        <!-- ========================================================== -->
        <!-- ===== BARRA DE ESTADO CON IDIOMA ===== -->
        <!-- ========================================================== -->
        <header class="status-bar">
            <span class="time" id="statusTime">10:44</span>
            <div class="status-icons">
                <svg width="17" height="12" viewBox="0 0 17 12" fill="none">
                    <rect x="0" y="7" width="3" height="5" rx="1" fill="#0E1116" />
                    <rect x="4.5" y="4" width="3" height="8" rx="1" fill="#0E1116" />
                    <rect x="9" y="2" width="3" height="10" rx="1" fill="#0E1116" />
                    <rect x="13.5" y="0" width="3" height="12" rx="1" fill="#0E1116" opacity=".3" />
                </svg>
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
                    <path d="M8 2.5C10.5 2.5 12.7 3.5 14.3 5.1L15.7 3.6C13.7 1.6 11 .5 8 .5S2.3 1.6.3 3.6l1.4 1.5C3.3 3.5 5.5 2.5 8 2.5Z" fill="#0E1116" />
                    <path d="M8 6.5c1.1 0 2.1.4 2.8 1.2l1.4-1.5C11.1 5.1 9.6 4.5 8 4.5s-3.1.6-4.2 1.7l1.4 1.5C5.9 6.9 6.9 6.5 8 6.5Z" fill="#0E1116" />
                    <circle cx="8" cy="10" r="1.6" fill="#0E1116" />
                </svg>
                <svg width="26" height="12" viewBox="0 0 26 12" fill="none">
                    <rect x="1" y="1" width="21" height="10" rx="2.5" stroke="#0E1116" opacity=".4" />
                    <rect x="2.5" y="2.5" width="16" height="7" rx="1.2" fill="#0E1116" />
                    <rect x="23" y="4" width="2" height="4" rx="1" fill="#0E1116" opacity=".4" />
                </svg>
                <button class="lang-toggle-top" onclick="cambiarIdiomaAdmin('es')" title="Cambiar idioma">
                    ES ▼
                </button>
            </div>
        </header>

        <!-- ========================================================== -->
        <!-- ===== ENCABEZADO ADMIN - CORREGIDO ===== -->
        <!-- ========================================================== -->
        <section class="admin-header">

            <!-- ===== FILA 1: BOTÓN VOLVER ===== -->
            <div class="admin-row-top">
                <button class="back-btn" onclick="history.back();">
                    <i class="fas fa-arrow-left"></i> Volver
                </button>
            </div>

            <!-- ===== FILA 2: LOGO + cnfl + USUARIO (TODO EN UNA LÍNEA) ===== -->
            <div class="admin-row-bottom">
                <div style="display:flex; align-items:center; gap:12px; width:100%; flex-wrap:wrap;">

                    <!-- LOGO + cnfl -->
                    <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                        <svg width="32" height="32" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="25" cy="25" r="22" stroke="#1E23E6" stroke-width="2.5" />
                            <path d="M25 10L12 28H20L14 42L34 22H26L30 10Z" fill="#1E23E6" />
                        </svg>
                        <span style="font-family:'Inter',sans-serif; font-weight:900; font-size:20px; color:#FF692D; letter-spacing:-1px; text-transform:lowercase;">cnfl</span>
                    </div>

                    <!-- USUARIO (junto al logo) -->
                    <div style="display:flex; align-items:center; gap:8px; background:white; padding:3px 14px 3px 3px; border-radius:40px; box-shadow:0 4px 14px rgba(16,20,40,0.06); flex-shrink:0;">
                        <span style="width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg, #FF692D, #ff8a4c); color:white; font-weight:700; font-size:13px; display:flex; align-items:center; justify-content:center; text-transform:uppercase; flex-shrink:0;">@(Session["Nombre"]?.ToString()?.Substring(0, 1) ?? "A")</span>
                        <div style="line-height:1.2;">
                            <span style="font-weight:700; font-size:12px; color:#0E1116;">@(Session["Nombre"] ?? "Admin Sistema")</span>
                            <span style="font-size:10px; color:#727A86; display:block;">@(Session["Correo"] ?? "admin@cnfl.go.cr")</span>
                        </div>
                    </div>

                </div>
            </div>

        </section>

        <!-- ===== CONTENIDO DINÁMICO ===== -->
        <main class="main-content">
            @RenderBody()
        </main>

        <!-- ===== MENÚ INFERIOR ===== -->
        <nav class="bottom-nav">
            <a href="@Url.Action("Dashboard", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Dashboard" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-chart-pie"></i></span>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Index", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-bolt"></i></span>
                <span>Averías</span>
            </a>
            <a href="@Url.Action("Clientes", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Clientes" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-users"></i></span>
                <span>Clientes</span>
            </a>
            <a href="@Url.Action("Reportes", "Admin")" class="nav-item @(ViewContext.RouteData.Values["action"].ToString() == "Reportes" ? "active" : "")">
                <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                <span>Reportes</span>
            </a>
            <a href="#" class="nav-item" onclick="mostrarModalCierre()">
                <span class="nav-icon"><i class="fas fa-sign-out-alt"></i></span>
                <span>Salir</span>
            </a>
        </nav>

        <!-- ===== MODAL DE CONFIRMACIÓN ===== -->
        <div class="modal-overlay" id="modalCierre">
            <div class="modal-box">
                <span class="modal-icon">🤔</span>
                <h3>¿Cerrar sesión?</h3>
                <p>¿Estás seguro de que deseas salir del panel administrativo? Podrás volver a iniciar sesión cuando lo necesites.</p>
                <div class="modal-actions">
                    <button class="btn-cancel" onclick="cerrarModalCierre()">Cancelar</button>
                    <button class="btn-confirm" onclick="confirmarCierre()">Sí, salir</button>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <script>
        window.logoutUrl = '@Url.Action("Logout", "Cuenta", new { area = "" })';
    </script>

    <script src="@Url.Content("~/Scripts/admin-layout.js")"></script>
</body>
</html>