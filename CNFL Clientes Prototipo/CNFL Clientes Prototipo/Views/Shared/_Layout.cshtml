<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewBag.Title - CNFL App</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/prototipo.css")" rel="stylesheet" type="text/css" />

    <script>
        const Idiomas = {
            es: { title: "CNFL · App Móvil — Prototipo Interactivo", home: "Inicio", tramites: "Trámites", tienda: "Tienda", pagos: "Pagos", reportes: "Reportes", cuenta: "Cuenta", hola: "Hola,", factura: "FACTURA PENDIENTE · NISE 4021", vence: "Vence el 28 de agosto", ver: "Ver detalle", pagar: "Pagar ahora", servicios: "MIS SERVICIOS ASOCIADOS (NISE)", normal: "Normal", prev: "Prevención", inc: "Incidente" },
            en: { title: "CNFL · Mobile App — Interactive Prototype", home: "Home", tramites: "Requests", tienda: "Store", pagos: "Payments", reportes: "Reports", cuenta: "Account", hola: "Hello,", factura: "PENDING BILL · NISE 4021", vence: "Due August 28", ver: "View details", pagar: "Pay now", servicios: "MY LINKED SERVICES (NISE)", normal: "Normal", prev: "Prevention", inc: "Incident" },
            pt: { title: "CNFL · App Móvel — Protótipo Interativo", home: "Início", tramites: "Solicitações", tienda: "Loja", pagos: "Pagamentos", reportes: "Relatórios", cuenta: "Conta", hola: "Olá,", factura: "FATURA PENDENTE · NISE 4021", vence: "Vence em 28 de agosto", ver: "Ver detalhes", pagar: "Pagar agora", servicios: "MEUS SERVIÇOS VINCULADOS (NISE)", normal: "Normal", prev: "Prevenção", inc: "Incidente" },
            fr: { title: "CNFL · App Mobile — Prototype Interactif", home: "Accueil", tramites: "Démarches", tienda: "Boutique", pagos: "Paiements", reportes: "Signalements", cuenta: "Compte", hola: "Bonjour,", factura: "FACTURE EN ATTENTE · NISE 4021", vence: "Échéance le 28 août", ver: "Voir détails", pagar: "Payer maintenant", servicios: "MES SERVICES LIÉS (NISE)", normal: "Normal", prev: "Prévention", inc: "Incident" }
        };

        let idiomaActual = localStorage.getItem('idioma') || 'es';
        function t(clave) { return Idiomas[idiomaActual][clave] || Idiomas.es[clave]; }
        function aplicarIdioma() {
            document.querySelectorAll('[data-i18n]').forEach(el => { el.innerHTML = t(el.getAttribute('data-i18n')); });
            document.querySelectorAll('#langbar button').forEach(btn => {
                btn.style.background = btn.dataset.lang === idiomaActual ? '#1E23E6' : 'transparent';
                btn.style.color = btn.dataset.lang === idiomaActual ? '#fff' : '#727A86';
            });
        }
        function cambiarIdioma(lang) { idiomaActual = lang; localStorage.setItem('idioma', lang); aplicarIdioma(); }

        window.onload = function () {
            var tamano = localStorage.getItem('tamanoFuente');
            var contraste = localStorage.getItem('altoContraste');
            if (tamano) document.body.style.fontSize = tamano + 'px';
            if (contraste === 'true') document.body.classList.add('alto-contraste');
            aplicarIdioma();
            actualizarHora();
            if (document.getElementById('consumoChart')) { dibujarGraficoConsumo('6m'); }
        };

        function cambiarTamano(delta) {
            let actual = parseFloat(document.body.style.fontSize) || 16;
            let nuevo = actual + delta;
            if (nuevo >= 12 && nuevo <= 24) { document.body.style.fontSize = nuevo + 'px'; localStorage.setItem('tamanoFuente', nuevo); }
        }
        function toggleContraste() { document.body.classList.toggle('alto-contraste'); localStorage.setItem('altoContraste', document.body.classList.contains('alto-contraste')); }
        function actualizarHora() { var ahora = new Date(); document.getElementById('clock').textContent = ahora.getHours().toString().padStart(2, '0') + ":" + ahora.getMinutes().toString().padStart(2, '0'); }
        setInterval(actualizarHora, 10000);
    </script>
</head>
<body>

    <div class="stage-title" data-i18n="title">CNFL · App Móvil — Prototipo Interactivo</div>

    <div class="phone-frame" style="margin-top: 80px;">
        <div class="phone-notch"></div>
        <div class="statusbar">
            <span id="clock">9:41</span>
            <span style="display:flex; gap:6px;">
                <svg width="17" height="12" viewBox="0 0 17 12" fill="none"><rect x="0" y="7" width="3" height="5" rx="1" fill="#0E1116" /><rect x="4.5" y="4" width="3" height="8" rx="1" fill="#0E1116" /><rect x="9" y="2" width="3" height="10" rx="1" fill="#0E1116" /><rect x="13.5" y="0" width="3" height="12" rx="1" fill="#0E1116" opacity=".3" /></svg>
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none"><path d="M8 2.5C10.5 2.5 12.7 3.5 14.3 5.1L15.7 3.6C13.7 1.6 11 .5 8 .5S2.3 1.6.3 3.6l1.4 1.5C3.3 3.5 5.5 2.5 8 2.5Z" fill="#0E1116" /><path d="M8 6.5c1.1 0 2.1.4 2.8 1.2l1.4-1.5C11.1 5.1 9.6 4.5 8 4.5s-3.1.6-4.2 1.7l1.4 1.5C5.9 6.9 6.9 6.5 8 6.5Z" fill="#0E1116" /><circle cx="8" cy="10" r="1.6" fill="#0E1116" /></svg>
                <svg width="26" height="12" viewBox="0 0 26 12" fill="none"><rect x="1" y="1" width="21" height="10" rx="2.5" stroke="#0E1116" opacity=".4" /><rect x="2.5" y="2.5" width="16" height="7" rx="1.2" fill="#0E1116" /><rect x="23" y="4" width="2" height="4" rx="1" fill="#0E1116" opacity=".4" /></svg>
            </span>
        </div>

        <div class="phone-content">
            <div style="display:flex; justify-content:space-between; align-items:center; padding: 5px 20px 10px;">
                <div class="brand-logo">
                    <svg width="55" height="55" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M25 5L10 25H18L12 45L35 22H25L30 5Z" stroke="#1E23E6" stroke-width="4" stroke-linejoin="round" />
                        <path d="M12 33C15 43 25 48 35 44C42 41 47 34 46 28" stroke="#1E23E6" stroke-width="4" stroke-linecap="round" />
                        <path d="M38 5C30 1 20 3 15 10" stroke="#1E23E6" stroke-width="4" stroke-linecap="round" />
                    </svg>
                    <span style="font-family:'Montserrat'; font-weight:900; font-size:32px; color:#FF692D; letter-spacing: -2px;">cnfl</span>
                </div>

                <div id="langbar" style="display:flex; background:#fff; padding:4px; border-radius:20px; border:1px solid var(--line);">
                    <button onclick="cambiarIdioma('es')" data-lang="es" class="btn btn-sm" style="border-radius:15px; font-size:10px; font-weight:800;">ES</button>
                    <button onclick="cambiarIdioma('en')" data-lang="en" class="btn btn-sm" style="border-radius:15px; font-size:10px; font-weight:800;">EN</button>
                    <button onclick="cambiarIdioma('pt')" data-lang="pt" class="btn btn-sm" style="border-radius:15px; font-size:10px; font-weight:800;">PT</button>
                    <button onclick="cambiarIdioma('fr')" data-lang="fr" class="btn btn-sm" style="border-radius:15px; font-size:10px; font-weight:800;">FR</button>
                </div>

                <div style="display:flex; gap:8px;">
                    <div class="icon-btn" style="cursor:pointer;" onclick="window.location='/Notificaciones'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2" width="18" height="18"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" /></svg>
                        <span class="badge">3</span>
                    </div>
                    <div class="icon-btn" style="cursor:pointer;" onclick="window.location='/Cuenta/Cuenta'">
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ink)" stroke-width="2" width="18" height="18"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                    </div>
                </div>
            </div>

            @RenderBody()
        </div>

        <!-- BARRA INFERIOR -->
        <div class="tabbar">
            <!-- Inicio: SIEMPRE visible y con contenido informativo -->
            <a href="/Cuenta" class="tab @(Request.Url.AbsolutePath == "/Cuenta" || Request.Url.AbsolutePath == "/" ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10l9-7 9 7v9a2 2 0 0 1-2 2h-4v-6H9v6H5a2 2 0 0 1-2-2z" /></svg>
                <span data-i18n="home">Inicio</span>
            </a>

            @if (Session["Rol"] != null)
            {
                <a href="/Tramites" class="tab @(Request.Url.AbsolutePath == "/Tramites" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                    <span data-i18n="tramites">Trámites</span>
                </a>
                <a href="/Pagos" class="tab @(Request.Url.AbsolutePath == "/Pagos" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9h10M7 13h6" /></svg>
                    <span data-i18n="pagos">Pagos</span>
                </a>
                <a href="/Tienda" class="tab center @(Request.Url.AbsolutePath == "/Tienda" ? "active" : "")">
                    <div class="fab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h3l2.5 12.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 2-1.5L22 7H6" /></svg></div>
                    <span style="@(Request.Url.AbsolutePath == "/Tienda" ? "color: var(--orange); font-weight: 800;" : "")" data-i18n="tienda">Tienda</span>
                </a>
                <a href="/Averias" class="tab @(Request.Url.AbsolutePath == "/Averias" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" /><circle cx="12" cy="9" r="2.5" /></svg>
                    <span data-i18n="reportes">Reportes</span>
                </a>
                <a href="/Cuenta/Cuenta" class="tab @(Request.Url.AbsolutePath == "/Cuenta/Cuenta" || Request.Url.AbsolutePath == "/Cuenta/Login" || Request.Url.AbsolutePath == "/Cuenta/Registro" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                    <span data-i18n="cuenta">Cuenta</span>
                </a>
            }
            else
            {
                <a href="/Cuenta/Login" class="tab @(Request.Url.AbsolutePath == "/Cuenta/Login" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 4-6 8-6s8 2 8 6" /></svg>
                    <span>Ingresar</span>
                </a>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/prototipo.js")"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>