<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CNFL Clientes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/prototipo.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Menú superior -->
    <nav class="navbar navbar-expand-lg navbar-cnfl">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Cuenta">
                <span style="font-size: 1.5rem;">⚡ CNFL</span> Clientes
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Apuntamos al Home Público -->
                    <li class="nav-item"><a class="nav-link" href="/Cuenta">Inicio</a></li>

                    <!-- Zona protegida (Clientes) -->
                    <li class="nav-item"><a class="nav-link" href="/Clientes">Clientes</a></li>

                    <!-- Zona protegida (Averías) -->
                    <li class="nav-item"><a class="nav-link" href="/Averias">Averías</a></li>

                    <!-- Botón de Login -->
                    <li class="nav-item"><a class="nav-link btn btn-light text-dark ms-2" href="/Cuenta/Login">Iniciar Sesión</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4" style="padding-bottom: 40px;">
        @RenderBody()
        <hr />
        <footer class="text-center text-muted">
            <p>&copy; @DateTime.Now.Year - Prototipo TCU Samuel Sandoval Ramírez</p>
            <p class="small">"Celebremos la calidad y continuidad de nuestro servicio"</p>
        </footer>
    </div>

    <!-- Toast de notificación (aparece una sola vez) -->
    <div id="toast-notificacion" class="toast align-items-center text-white bg-primary border-0 position-fixed top-0 end-0 m-3" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <strong>🔔 Aviso:</strong> Su factura vence en 3 días. Puede pagarla desde la app.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Scripts/prototipo.js")"></script>
</body>
</html>