        // --- Factura Electrónica ---
        function toggleActividadEconomica() {
            var radios = document.querySelectorAll('input[name="FacturaElectronica"]');
            var actividadGroup = document.getElementById('actividadEconomicaGroup');
            var select = document.getElementById('actividadSelect');

            if (radios[0].checked) {
                actividadGroup.style.display = 'block';
                select.required = true;
                cargarActividadesEconomicas();
            } else {
                actividadGroup.style.display = 'none';
                select.required = false;
                select.value = '';
            }
        }

        // --- Actividades Económicas ---
        var actividadesData = [];

        function cargarActividadesEconomicas() {
            var select = document.getElementById('actividadSelect');
            if (select.options.length <= 1) {
                $.ajax({
                    url: '/Cuenta/ObtenerActividadesEconomicas',
                    type: 'GET',
                    success: function (data) {
                        actividadesData = data;
                        select.innerHTML = '<option value="">-- Seleccione una actividad --</option>';
                        data.forEach(function (item) {
                            var option = document.createElement('option');
                            option.value = item.Codigo;
                            option.textContent = item.Codigo + ' - ' + item.Nombre;
                            select.appendChild(option);
                        });
                    },
                    error: function () {
                        console.error('Error al cargar actividades económicas');
                    }
                });
            }
        }

        function filtrarActividadesEconomicas() {
            var busqueda = document.getElementById('actividadBusqueda').value.toLowerCase();
            var select = document.getElementById('actividadSelect');
            select.innerHTML = '<option value="">-- Seleccione una actividad --</option>';

            actividadesData.forEach(function (item) {
                var texto = (item.Codigo + ' - ' + item.Nombre).toLowerCase();
                if (texto.includes(busqueda)) {
                    var option = document.createElement('option');
                    option.value = item.Codigo;
                    option.textContent = item.Codigo + ' - ' + item.Nombre;
                    select.appendChild(option);
                }
            });
        }

