@model dynamic
@{
    ViewBag.Title = "Registro";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<!-- CSS separado -->
<link rel="stylesheet" href="@Url.Content("~/Content/cliente/cuenta.css")" />

<div class="section-pad" style="margin-top: 20px;">
    <div class="registro-title">Crear cuenta</div>
    <div class="registro-subtitle">Regístrate para conectar con la Agencia Virtual.</div>
</div>

<div class="section-pad mt-3">
    <div class="card-cliente">
        @using (Html.BeginForm("Registro", "Cuenta", FormMethod.Post, new { id = "registroForm" }))
        {
            @Html.AntiForgeryToken()

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success mt-3" style="font-size: 14px; font-weight: 700; padding:12px 16px; border-radius:12px;">
                    ✅ @TempData["Mensaje"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div class="alert alert-danger mt-3" style="font-size: 14px; font-weight: 700; padding:12px 16px; border-radius:12px;">
                    ❌ @ViewData.ModelState.Values.SelectMany(v => v.Errors).First().ErrorMessage
                </div>
            }

            <!-- ===== CÉDULA ===== -->
            <div class="field" id="cedulaGroup">
                <label>CÉDULA <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <circle cx="9" cy="12" r="2.5" />
                        <path d="M14 10h4M14 14h4" />
                    </svg>
                    <input type="text" name="Cedula" id="cedula" required placeholder="1-2345-6789" />
                    <span class="validation-icon" id="cedulaIcon"></span>
                </div>
                <div class="field-error" id="cedulaError"></div>
            </div>

            <!-- ===== NOMBRE ===== -->
            <div class="field" id="nombreGroup">
                <label>NOMBRE <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                    </svg>
                    <input type="text" name="Nombre" id="nombre" required placeholder="Su nombre" />
                    <span class="validation-icon" id="nombreIcon"></span>
                </div>
                <div class="field-error" id="nombreError"></div>
            </div>

            <!-- ===== APELLIDOS ===== -->
            <div class="field" id="apellidosGroup">
                <label>APELLIDOS <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                    </svg>
                    <input type="text" name="Apellidos" id="apellidos" required placeholder="Sus apellidos" />
                    <span class="validation-icon" id="apellidosIcon"></span>
                </div>
                <div class="field-error" id="apellidosError"></div>
            </div>

            <!-- ===== FECHA DE NACIMIENTO ===== -->
            <div class="field" id="fechaGroup">
                <label>FECHA DE NACIMIENTO <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    <input type="date" name="FechaNacimiento" id="fechaNacimiento" required />
                    <span class="validation-icon" id="fechaIcon"></span>
                </div>
                <div class="registro-hint" id="fechaHint">Ingresa tu fecha de nacimiento.</div>
                <div class="field-error" id="fechaError"></div>
            </div>

            <!-- ===== SEXO ===== -->
            <div class="field" id="sexoGroup">
                <label>SEXO <span style="color:var(--red);">*</span></label>
                <div class="inp" style="flex-wrap:wrap; gap:8px; padding:10px 15px;">
                    <label style="display:flex; align-items:center; gap:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        <input type="radio" name="Sexo" value="Masculino" required /> Masculino
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        <input type="radio" name="Sexo" value="Femenino" required /> Femenino
                    </label>
                    <!-- Opción 'Personalizado' eliminada por requerimiento: solo Masculino y Femenino -->
                </div>
                <div class="field-error" id="sexoError"></div>
            </div>

            <!-- NISE asociado eliminado del formulario: se gestiona desde la base de datos. -->

            <!-- ===== FACTURA ELECTRÓNICA ===== -->
            <div class="field" id="facturaElectronicaGroup">
                <label>¿Desea que le envíen una factura electrónica? <span style="color:var(--red);">*</span></label>
                <div class="inp" style="flex-wrap:wrap; gap:16px; padding:10px 15px;">
                    <label style="display:flex; align-items:center; gap:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        <input type="radio" name="FacturaElectronica" value="true" required onchange="toggleActividadEconomica()" /> Sí
                    </label>
                    <label style="display:flex; align-items:center; gap:6px; font-weight:600; font-size:14px; cursor:pointer;">
                        <input type="radio" name="FacturaElectronica" value="false" required onchange="toggleActividadEconomica()" /> No
                    </label>
                </div>
                <div class="field-error" id="facturaElectronicaError"></div>
            </div>

            <!-- ===== ACTIVIDAD ECONÓMICA (CONDICIONAL) ===== -->
            <div class="field" id="actividadEconomicaGroup" style="display: none;">
                <label>ACTIVIDAD ECONÓMICA <span style="color:var(--red);">*</span></label>
                <div class="inp" style="flex-direction: column; align-items: stretch; gap: 8px; padding: 10px 15px;">
                    <input type="text" id="actividadBusqueda" placeholder="Buscar por código o nombre..." onkeyup="filtrarActividadesEconomicas()" style="border:1.5px solid var(--line); border-radius:8px; padding:8px 12px; font-family:inherit; font-size:14px;" />
                    <select name="ActividadEconomicaCodigo" id="actividadSelect" required style="width:100%; border:1.5px solid var(--line); border-radius:8px; padding:8px 12px; font-family:inherit; font-size:14px; color:var(--ink); background:white;">
                        <option value="">-- Seleccione una actividad --</option>
                    </select>
                </div>
                <div class="field-error" id="actividadEconomicaError"></div>
            </div>

            <!-- ===== CORREO PRINCIPAL ===== -->
            <div class="field" id="correoGroup">
                <label>CORREO PRINCIPAL <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 5L2 7" />
                    </svg>
                    <input type="email" name="Correo" id="correo" required placeholder="usuario@correo.com" />
                    <span class="validation-icon" id="correoIcon"></span>
                </div>
                <div class="field-error" id="correoError"></div>
            </div>

            <!-- ===== CORREO SECUNDARIO (OPCIONAL) ===== -->
            <div class="field" id="correo2Group">
                <label>CORREO SECUNDARIO <span style="color:var(--muted);">(Opcional)</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 5L2 7" />
                    </svg>
                    <input type="email" name="CorreoSecundario" id="correoSecundario" placeholder="secundario@correo.com" />
                    <span class="validation-icon" id="correo2Icon"></span>
                </div>
                <div class="field-error" id="correo2Error"></div>
            </div>

            <!-- ===== TELÉFONO PRINCIPAL ===== -->
            <div class="field" id="telefonoGroup">
                <label>TELÉFONO PRINCIPAL <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    <input type="text" name="Telefono" id="telefono" required placeholder="8888-8888" />
                    <span class="validation-icon" id="telefonoIcon"></span>
                </div>
                <div class="field-error" id="telefonoError"></div>
            </div>

            <!-- ===== TELÉFONO SECUNDARIO (OPCIONAL) ===== -->
            <div class="field" id="telefono2Group">
                <label>TELÉFONO SECUNDARIO <span style="color:var(--muted);">(Opcional)</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 9.81 19.79 19.79 0 0 1 0 1.18 2 2 0 0 1 2 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                    <input type="text" name="TelefonoSecundario" id="telefonoSecundario" placeholder="8888-8888" />
                    <span class="validation-icon" id="telefono2Icon"></span>
                </div>
                <div class="field-error" id="telefono2Error"></div>
            </div>

            <!-- ===== DIRECCIÓN FÍSICA ===== -->
            <div class="field" id="direccionGroup">
                <label>DIRECCIÓN FÍSICA DONDE RESIDE <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                        <circle cx="12" cy="9" r="3" />
                    </svg>
                    <input type="text" name="Direccion" id="direccion" required placeholder="Calle, Avenida, Número, Detalles..." />
                    <span class="validation-icon" id="direccionIcon"></span>
                </div>
                <div class="field-error" id="direccionError"></div>
            </div>

            <!-- ===== PROVINCIA, CANTÓN, DISTRITO ===== -->
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <div class="field" style="flex: 1;" id="provinciaGroup">
                    <label>PROVINCIA <span style="color:var(--red);">*</span></label>
                    <div class="inp">
                        <select name="Provincia" id="provincia" required style="width:100%; border:none; background:transparent; font-family:inherit; font-size:14px; color:var(--ink);" onchange="cargarCantones()">
                            <option value="">-- Seleccione --</option>
                            <option value="San José">San José</option>
                            <option value="Alajuela">Alajuela</option>
                            <option value="Cartago">Cartago</option>
                            <option value="Heredia">Heredia</option>
                            <option value="Guanacaste">Guanacaste</option>
                            <option value="Puntarenas">Puntarenas</option>
                            <option value="Limón">Limón</option>
                        </select>
                        <span class="validation-icon" id="provinciaIcon"></span>
                    </div>
                    <div class="field-error" id="provinciaError"></div>
                </div>

                <div class="field" style="flex: 1;" id="cantonGroup">
                    <label>CANTÓN <span style="color:var(--red);">*</span></label>
                    <div class="inp">
                        <select name="Canton" id="canton" required style="width:100%; border:none; background:transparent; font-family:inherit; font-size:14px; color:var(--ink);" onchange="cargarDistritos()">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="validation-icon" id="cantonIcon"></span>
                    </div>
                    <div class="field-error" id="cantonError"></div>
                </div>

                <div class="field" style="flex: 1;" id="distritoGroup">
                    <label>DISTRITO <span style="color:var(--red);">*</span></label>
                    <div class="inp">
                        <select name="Distrito" id="distrito" required style="width:100%; border:none; background:transparent; font-family:inherit; font-size:14px; color:var(--ink);">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="validation-icon" id="distritoIcon"></span>
                    </div>
                    <div class="field-error" id="distritoError"></div>
                </div>
            </div>

            <!-- ===== USUARIO ===== -->
            <div class="field" id="usuarioGroup">
                <label>USUARIO (Para iniciar sesión) <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                    </svg>
                    <input type="text" name="UserName" id="userName" required placeholder="Escribe tu usuario" />
                    <span class="validation-icon" id="usuarioIcon"></span>
                </div>
                <div class="field-error" id="usuarioError"></div>
            </div>

            <!-- ===== CONTRASEÑA ===== -->
            <div class="field" id="contrasenaGroup">
                <label>CONTRASEÑA <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="10" width="16" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <input type="password" name="Contraseña" id="contrasena" required placeholder="••••••••" />
                    <span class="validation-icon" id="contrasenaIcon"></span>
                    <button type="button" class="toggle-password" onclick="togglePasswordById('contrasena')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <div class="field-error" id="contrasenaError"></div>
            </div>

            <!-- ===== CONFIRMAR CONTRASEÑA ===== -->
            <div class="field" id="confirmGroup">
                <label>CONFIRMAR CONTRASEÑA <span style="color:var(--red);">*</span></label>
                <div class="inp">
                    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="4" y="10" width="16" height="10" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <input type="password" name="Confirm" id="confirm" required placeholder="••••••••" />
                    <span class="validation-icon" id="confirmIcon"></span>
                    <button type="button" class="toggle-password" onclick="togglePasswordById('confirm')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    </button>
                </div>
                <div class="field-error" id="confirmError"></div>
            </div>

            <!-- ===== ACEPTACIÓN ===== -->
            <div class="field" style="margin-top:20px;">
                <div style="display:flex; flex-direction:column; gap:12px; background:#f8f9fe; padding:16px; border-radius:14px; border:1px solid var(--line);">
                    <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer; font-size:13px; font-weight:600; color:var(--ink);">
                        <input type="checkbox" name="AceptaPolitica" id="aceptaPolitica" required style="margin-top:2px; width:18px; height:18px; cursor:pointer;" />
                        <span>Acepto la <a href="#" onclick="abrirDocumento('politica')" style="color:var(--blue); text-decoration:underline;">Política de Privacidad</a> de la CNFL</span>
                    </label>
                    <label style="display:flex; align-items:flex-start; gap:10px; cursor:pointer; font-size:13px; font-weight:600; color:var(--ink);">
                        <input type="checkbox" name="AceptaConsentimiento" id="aceptaConsentimiento" required style="margin-top:2px; width:18px; height:18px; cursor:pointer;" />
                        <span>Acepto el <a href="#" onclick="abrirDocumento('consentimiento')" style="color:var(--blue); text-decoration:underline;">Consentimiento Informado</a> (F-085)</span>
                    </label>
                </div>
                <div class="field-error" id="aceptacionError" style="margin-top:8px;"></div>
            </div>

            <button type="submit" class="btn-register" id="btnRegistrar">
                Registrarme
            </button>
        }
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/cliente/cuenta.js")"></script>
    <script>
        // ==========================================================
        // FUNCIONES PARA LAS NUEVAS CARACTERÍSTICAS
        // ==========================================================

        // --- Abrir documentos con diseño mejorado ---
        function abrirDocumento(tipo) {
            var nombre = document.getElementById('nombre').value || 'Cliente';
            var cedula = document.getElementById('cedula').value || '0-0000-0000';
            var correo = document.getElementById('correo').value || 'cliente@correo.cr';
            var telefono = document.getElementById('telefono').value || '0000-0000';

            var fecha = new Date();
            var dia = fecha.getDate();
            var mes = fecha.toLocaleString('es-CR', { month: 'long' });
            var anio = fecha.getFullYear();

            var contenido = '';

            if (tipo === 'politica') {
                contenido = `
                        <div style="font-family:'Inter',sans-serif; max-width:900px; margin:0 auto; padding:24px; background:white; border-radius:20px; box-shadow:0 8px 40px rgba(0,0,0,0.15); position:relative; overflow:hidden;">
                            <div style="position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg, #1E23E6, #FF692D);"></div>
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
                                <h2 style="color:#1E23E6; margin:0;">Política de Privacidad</h2>
                                <span style="font-size:12px; color:#727A86;">CNFL</span>
                            </div>
                            <hr style="border:1px solid #EDEFF3; margin:12px 0;" />
                            <div style="background:#f8f9fe; padding:16px; border-radius:12px; margin:12px 0; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                                <p style="margin:0;"><strong>Cliente:</strong> ${nombre}</p>
                                <p style="margin:0;"><strong>Cédula:</strong> ${cedula}</p>
                                <p style="margin:0;"><strong>Correo:</strong> ${correo}</p>
                                <p style="margin:0;"><strong>Teléfono:</strong> ${telefono}</p>
                                <p style="margin:0; grid-column:span 2;"><strong>Fecha:</strong> ${dia} de ${mes} de ${anio}</p>
                            </div>
                            <div style="line-height:1.8; font-size:14px; color:#0E1116;">
                                <p><strong>1. Datos Personales</strong></p>
                                <p style="color:#727A86; margin:0 0 8px 0;">Los datos personales recopilados son: nombre completo, cédula, dirección, teléfonos, correo electrónico, NISE(s) asociados, datos de facturación y consumo eléctrico.</p>
                                <p><strong>2. Finalidad del Tratamiento</strong></p>
                                <p style="color:#727A86; margin:0 0 8px 0;">Los datos serán utilizados para la prestación del servicio eléctrico, facturación, atención de averías, trámites, comunicaciones y ofrecimiento de productos y servicios.</p>
                                <p><strong>3. Derechos del Titular</strong></p>
                                <p style="color:#727A86; margin:0 0 8px 0;">El titular tiene derecho a acceder, rectificar, actualizar y cancelar sus datos personales mediante los canales habilitados por la CNFL.</p>
                                <p><strong>4. Transferencia de Datos</strong></p>
                                <p style="color:#727A86; margin:0;">La CNFL puede transferir datos a entidades autorizadas para la prestación de servicios relacionados con el giro del negocio.</p>
                            </div>
                            <button onclick="this.closest('div[style]').remove()" style="width:100%; padding:14px; background:#1E23E6; color:white; border:none; border-radius:14px; font-weight:700; cursor:pointer; font-size:16px; margin-top:16px; transition:0.2s; box-shadow:0 4px 16px rgba(30,35,230,0.3);" onmouseover="this.style.transform='scale(0.98)'" onmouseout="this.style.transform='scale(1)'">Aceptar y Cerrar</button>
                        </div>
                    `;
            } else if (tipo === 'consentimiento') {
                contenido = `
                        <div style="font-family:'Inter',sans-serif; max-width:900px; margin:0 auto; padding:24px; background:white; border-radius:20px; box-shadow:0 8px 40px rgba(0,0,0,0.15); position:relative; overflow:hidden;">
                            <div style="position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg, #1E23E6, #FF692D);"></div>
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px;">
                                <h2 style="color:#1E23E6; margin:0;">Consentimiento Informado F-085</h2>
                                <span style="font-size:12px; color:#727A86;">CNFL</span>
                            </div>
                            <hr style="border:1px solid #EDEFF3; margin:12px 0;" />
                            <p style="color:#0E1116; margin:0;"><strong>COMPAÑÍA NACIONAL DE FUERZA Y LUZ S.A.</strong></p>
                            <p style="color:#727A86; margin:4px 0 12px 0;">Yo, <strong>${nombre}</strong>, cédula <strong>${cedula}</strong>, declaro haber sido informado sobre el uso de mis datos personales como cliente de la CNFL.</p>
                            <div style="background:#f8f9fe; padding:16px; border-radius:12px; margin:12px 0; display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                                <p style="margin:0;"><strong>Cliente:</strong> ${nombre}</p>
                                <p style="margin:0;"><strong>Cédula:</strong> ${cedula}</p>
                                <p style="margin:0;"><strong>Correo:</strong> ${correo}</p>
                                <p style="margin:0;"><strong>Teléfono:</strong> ${telefono}</p>
                                <p style="margin:0; grid-column:span 2;"><strong>Fecha:</strong> ${dia} de ${mes} de ${anio}</p>
                            </div>
