        function cargarCantones() {
            var provincia = document.getElementById('provincia').value;
            var cantonSelect = document.getElementById('canton');
            var distritoSelect = document.getElementById('distrito');

            cantonSelect.innerHTML = '<option value="">-- Seleccione --</option>';
            distritoSelect.innerHTML = '<option value="">-- Seleccione --</option>';

            if (provincia && ubicaciones[provincia]) {
                var cantones = Object.keys(ubicaciones[provincia].cantones);
                cantones.forEach(function (canton) {
                    var option = document.createElement('option');
                    option.value = canton;
                    option.textContent = canton;
                    cantonSelect.appendChild(option);
                });
            }
        }

        function cargarDistritos() {
            var provincia = document.getElementById('provincia').value;
            var canton = document.getElementById('canton').value;
            var distritoSelect = document.getElementById('distrito');

            distritoSelect.innerHTML = '<option value="">-- Seleccione --</option>';

            if (provincia && canton && ubicaciones[provincia] && ubicaciones[provincia].cantones[canton]) {
                var distritos = ubicaciones[provincia].cantones[canton];
                distritos.forEach(function (distrito) {
                    var option = document.createElement('option');
                    option.value = distrito;
                    option.textContent = distrito;
                    distritoSelect.appendChild(option);
                });
            }
        }

